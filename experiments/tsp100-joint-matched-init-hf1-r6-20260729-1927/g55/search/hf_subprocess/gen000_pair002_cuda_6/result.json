  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_rankgap_tanh_advantage",
    "intuition": "Shift from margin-based pairwise losses to a rank-gap based paradigm using the advantage signals and a smooth tanh link to penalize ranking errors proportionally to rank gap magnitude.",
    "pseudocode": "gap_raw = advantage_w - advantage_l\nscaled_gap = clamp(alpha * gap_raw, -10, 10)\nloss_per_pair = relu(tanh(scaled_gap) - (log_prob_w - log_prob_l))\nweighted_loss = loss_per_pair * weight\nfinal_loss = mean(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_gap",
      "signal_family": "advantage_gap",
      "link_family": "tanh",
      "agg_family": "mean",
      "constraint_family": "clamp_nonneg_relu"
    },
    "operators_used": [
      "sub",
      "clamp",
      "tanh",
      "relu",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gap_raw = ops.sub(adv_w, adv_l)\n    scaled_gap = ops.clamp(alpha * gap_raw, -10.0, 10.0)\n    link_val = ops.tanh(scaled_gap)\n    diff_log_prob = ops.sub(lpw, lpl)\n    raw_loss = ops.relu(ops.sub(link_val, diff_log_prob))\n    raw_loss = raw_loss * weight\n    return ops.mean(raw_loss)",
    "theoretical_basis": ""
  },
