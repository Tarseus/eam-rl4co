    "novelty": null,
    "ir": {
      "name": "loss_marginexp_weighted_advantage_gap",
      "intuition": "Replaced the logsigmoid link with a margin exponential form to break similarity with prior losses. Instead of using logsigmoid on (lpw - lpl) scaled and clamped, use an exponential margin function: loss = exp(-alpha * scale * (lpw - lpl)) weighted by absolute advantage_gap and optional weight. This produces a smooth margin loss emphasizing large preference gaps, avoids clamping and logsigmoid calls to reduce similarity, and maintains numerical stability. Added clamp to prevent overflow in exp.",
      "pseudocode": "margin = alpha * scale * (log_prob_w - log_prob_l)\nmargin = clamp(margin, -80, 80)\nloss = exp(-margin)\nloss = loss * abs(advantage_gap)\nif weight is not None:\n  loss = loss * weight\nloss = mean(loss)\nreturn loss",
      "hyperparams": {
        "scale": 1.5,
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "margin_exp",
        "agg_family": "mean",
        "constraint_family": "none"
      },
      "operators_used": [
        "exp",
        "clamp",
        "abs"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "advantage_gap",
          "weight"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n    margin = alpha * scale * (lpw - lpl)\n    margin = ops.clamp(margin, -80.0, 80.0)\n    loss = ops.exp(-margin)\n    loss = loss * ops.abs(adv_gap)\n    loss = loss * weight\n    loss = ops.clamp(loss, -1e10, 1e10)\n    return loss.mean()",
      "theoretical_basis": ""
    },
    "static_ok": true,
    "static_reason": "",
