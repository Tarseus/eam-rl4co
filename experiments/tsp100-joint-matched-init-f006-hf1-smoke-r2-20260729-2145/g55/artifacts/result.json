  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_003_cost_shifted_sum_weighted_scaled_margin",
    "intuition": "The original loss violated affine invariance due to a fixed beta scaling on the raw cost gap, which does not compensate for shifts in cost baseline. To fix this, I centered the cost gap by subtracting its batch mean, making the loss invariant to uniform cost shifts. This preserves the margin-based pairwise log-sigmoid formulation with clamping and sum aggregation, maintains weighting, and helps reduce delta loss under objective perturbations, thus restoring the affine invariance property.",
    "pseudocode": "gap = cost_b - cost_a\ncentered_gap = gap - mean(gap)\nx = alpha * scale * (log_prob_w - log_prob_l) - beta * centered_gap\nx = clamp(x, -20, 20)\nloss = sum(-logsigmoid(x) * weight)",
    "hyperparams": {
      "scale": "1.9496803035382082",
      "beta": "0.05",
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "mean",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('hyperparams', {}).get('beta', 0.05))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = cost_b - cost_a\n    mean_gap = ops.mean(gap)\n    centered_gap = gap - mean_gap\n    x = alpha * scale * (lpw - lpl) - beta * centered_gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x) * weight\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
