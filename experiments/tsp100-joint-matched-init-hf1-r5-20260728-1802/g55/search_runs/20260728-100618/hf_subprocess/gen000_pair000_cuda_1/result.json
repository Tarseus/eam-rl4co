  "g_ir": {
    "name": "diff_weight_all_pairs",
    "intuition": "All pairwise comparisons weighted by sum of absolute differences in objective and log_prob to ensure non-uniform instance weights.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "combined_diff",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    weight = (objective[b_idx, winner_idx] - objective[b_idx, loser_idx]).abs() + (log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]).abs()\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'diff_weight_all_pairs'})"
  },
  "f_ir": {
    "name": "loss_diff_squared_costgap",
    "intuition": "Use a regression paradigm on cost gap differences, penalizing squared error between predicted preference margin (log_prob difference) and cost gap signal, encouraging calibrated margin predictions.",
    "pseudocode": "predicted_margin = lpw - lpl\nerror = predicted_margin - cost_gap\nloss = mean(weight * error^2)",
    "hyperparams": {
      "paradigm_family": "pairwise_regression",
      "signal_family": "cost_gap",
      "link_family": "identity",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "mul",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    pred_margin = ops.sub(lpw, lpl)\n    error = ops.sub(pred_margin, cost_gap)\n    squared_error = ops.mul(error, error)\n    weighted_error = ops.mul(squared_error, weight)\n    return ops.mean(weighted_error)",
    "theoretical_basis": ""
  },
