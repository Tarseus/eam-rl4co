  "g_entry": {
    "id": "g005_003_f67a7ccb",
    "ir": {
      "name": "margin_rank_blend_weighted",
      "intuition": "Weights pairs by blending normalized log-prob margin (scaled by instance_obj_std) and rank discrepancy, upweighting pairs where winner is high-ranked and loser low-ranked, emphasizing discriminative comparisons within each instance.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob",
          "rank",
          "regret",
          "instance_obj_mad",
          "instance_obj_std",
          "instance_log_prob_std",
          "instance_regret_std"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "weight_scale": 1.0,
        "clamp_lo": 0.25,
        "clamp_hi": 4.0,
        "lambda_margin": 1.0,
        "lambda_rank": 1.0,
        "gamma": 0.5,
        "weight_family": "margin_rank_blend",
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "constraint_family": "clamp_only",
        "template": "all_pairs_reweight"
      },
      "operators_used": [
        "all_pairs_reweight",
        "margin_rank_blend"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    rank = feature_cache['rank']\n    regret = feature_cache['regret']\n    batch_size = int(objective.shape[0])\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if int(b_idx.numel()) <= 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_reweight_template', 'weight_family': 'margin_rank_blend'})\n    eps = 1e-6\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_scale = feature_cache.get('instance_obj_mad')\n    if instance_obj_scale is None:\n        instance_obj_scale = feature_cache.get('instance_obj_std')\n    if instance_obj_scale is None:\n        instance_obj_scale = torch.ones((batch_size,), dtype=objective.dtype, device=objective.device)\n    instance_log_prob_scale = feature_cache.get('instance_log_prob_std')\n    if instance_log_prob_scale is None:\n        instance_log_prob_scale = torch.ones((batch_size,), dtype=objective.dtype, device=objective.device)\n    instance_regret_scale = feature_cache.get('instance_regret_std')\n    if instance_regret_scale is None:\n        instance_regret_scale = torch.ones((batch_size,), dtype=objective.dtype, device=objective.device)\n    gap_scaled = gap / instance_obj_scale[b_idx].clamp_min(eps)\n    rank_span = rank[b_idx, loser_idx] - rank[b_idx, winner_idx]\n    margin_abs = (log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]).abs()\n    margin_scaled = margin_abs / instance_log_prob_scale[b_idx].clamp_min(eps)\n    raw = (torch.sigmoid(4.0 * rank_span) / (margin_scaled + eps).pow(0.5)) * 1\n    raw = torch.nan_to_num(raw, nan=0.0, posinf=0.0, neginf=0.0).clamp_min(0.0)\n    weight = raw.clamp(0.25, 4)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_reweight_template', 'weight_family': 'margin_rank_blend'})\n"
    }
  },
  "f_entry": {
    "id": "f005_003_619c11f6",
    "ir": {
      "name": "weighted_softplus_gap",
      "intuition": "Softplus loss on log-prob gap, weighted by builder's instance-conditioned weights, with temperature and gap_scale to control steepness.",
      "pseudocode": "gap = log_prob_w - log_prob_l; loss = weight * softplus((target_margin - gap) * gap_scale / temperature); return weighted_mean(loss, weights=weight)",
      "hyperparams": {
        "temperature": 1.0,
        "gap_scale": 0.5,
        "target_margin": 0.0,
        "template": "weighted_softplus_gap",
        "paradigm_family": "pairwise_margin",
        "agg_family": "weighted_mean",
        "constraint_family": "finite_softplus"
      },
      "operators_used": [
        "weighted_softplus_gap",
        "weighted_mean"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "delta_z",
          "weight"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    margin = log_prob_w - log_prob_l\n    weight = batch.get('weight', torch.ones_like(margin))\n    weight = torch.nan_to_num(weight, nan=0.0, posinf=0.0, neginf=0.0).clamp_min(0.0)\n    signal = batch.get('delta_z', torch.zeros_like(margin)).detach().clamp_min(0.0)\n    loss_vec = weight * F.softplus((0 + 0.5 * signal) - 1 * margin)\n    denom = weight.sum().clamp_min(1.0)\n    return loss_vec.sum() / denom\n",
      "theoretical_basis": ""
    }
  },
