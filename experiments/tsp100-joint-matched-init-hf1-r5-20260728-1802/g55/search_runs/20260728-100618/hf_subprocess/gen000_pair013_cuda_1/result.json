  "g_ir": {
    "name": "all_pairs_diff_weight_tiebreak",
    "intuition": "All pairs with tie-breaking using index order to ensure non-zero weight variation even when objectives are equal, increasing instance weight CV.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "objective_difference",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs",
      "weight_by_objective_diff"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    batch_size, seq_len = objective.shape\n    # Create mask including ties (<=) and exclude diagonal\n    mask = objective[:, :, None] <= objective[:, None, :]\n    eye = torch.eye(seq_len, device=objective.device).bool().unsqueeze(0)\n    mask = mask & (~eye)\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    # Weight = absolute objective difference + small index-based term to break ties\n    weight = (objective[b_idx, winner_idx] - objective[b_idx, loser_idx]).abs()\n    idx_diff = (loser_idx - winner_idx).abs().float() * 1e-6\n    weight = weight + idx_diff\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_diff_weight_tiebreak'})"
  },
  "f_ir": {
    "name": "pairwise_pref_loss",
    "intuition": "Uses a pairwise comparison of log probabilities weighted by costs or advantages to encourage preferred sequences. By combining the difference in log probabilities (indicating preference strength) with a cost or advantage signal, it promotes selecting higher-quality outputs. The signal ensures the loss aligns with the objective, especially in lower-is-better scenarios, making it suitable for preference-based training in RL4CO.",
    "pseudocode": "loss = mean(negative(logsigmoid((log_prob_w - log_prob_l) * weight)) * (cost_signal))",
    "hyperparams": {
      "paradigm_family": "preference",
      "signal_family": "cost_advantage",
      "link_family": "sigmoid",
      "agg_family": "pairwise",
      "constraint_family": "pairwise"
    },
    "operators_used": [
      "logsigmoid",
      "tanh",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    diff = log_prob_w - log_prob_l\n    weighted_diff = diff * weight\n    loss = -ops.logsigmoid(weighted_diff)\n    cost_signal = ops.tanh(cost_gap)\n    return ops.mean(loss * cost_signal)",
    "theoretical_basis": ""
  },
