  "g_ir": {
    "name": "objective_diff_weight_all_pairs",
    "intuition": "Weight each winner/loser pair by the absolute difference in objective values, using lower objective as winner (with tie-breaker on lower log_prob) to correct winner/loser semantics.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "objective_diff",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs",
      "objective_diff_weight"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    # lower objective is better; tie-break with lower log_prob\n    mask = (objective[:, :, None] < objective[:, None, :]) | ((objective[:, :, None] == objective[:, None, :]) & (log_prob[:, :, None] < log_prob[:, None, :]))\n    b_idx, i, j = mask.nonzero(as_tuple=True)\n    winner_idx = i\n    loser_idx = j\n    weight = (objective[b_idx, winner_idx] - objective[b_idx, loser_idx]).abs() + 1e-6\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'objective_diff_weight_all_pairs'})"
  },
  "f_ir": {
    "name": "pairwise_pref_cost_gap_stabilized",
    "intuition": "Original loss scales the difference of log probabilities by the reciprocal of the absolute cost gap, which can cause numerical instability or extremely large gradients if cost_gap is near zero. This version stabilizes by clamping the denominator to a minimum epsilon (1e-4) to avoid huge scale values, and ensures weight is non-negative as required. This normalization prevents instability and overly large updates while preserving the pairwise preference signal based on cost gap.",
    "pseudocode": "clamped_gap = clamp(abs(cost_gap), min=1e-4) scale = 1 / clamped_gap diff = log_prob_l - log_prob_w scaled_diff = diff * weight * scale loss = mean(logsigmoid(scaled_diff))",
    "hyperparams": {
      "paradigm_family": "ranking",
      "signal_family": "costs",
      "link_family": "pairwise",
      "agg_family": "mean",
      "constraint_family": "preference"
    },
    "operators_used": [
      "logsigmoid",
      "abs",
      "mul",
      "clamp",
      "mean",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    epsilon = 1e-4\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n\n    clamped_gap = ops.clamp(ops.abs(cost_gap), min=epsilon)\n    scale = 1.0 / clamped_gap\n    diff = log_prob_l - log_prob_w\n    scaled_diff = diff * weight * scale\n\n    loss = ops.mean(ops.logsigmoid(scaled_diff))\n    return loss",
    "theoretical_basis": ""
  },
