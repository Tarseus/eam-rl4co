  "name": "pairwise_cost_gap_logsigmoid_softsign_median_normalized",
  "intuition": "Repaired to reduce similarity with prior loss by replacing logsigmoid link with a softsign-based smoothed hinge, still emphasizing the cost_gap as quality signal. This eliminates exact logsigmoid usage and median normalization is preserved for scale invariance. The softsign transformation softens gradient behavior and better differentiates from prior implementations.",
  "pseudocode": "diff = alpha * scale * (log_prob_w - log_prob_l) - 0.1 * (cost_b - cost_a)\ndiff_clamped = clamp(diff, -20, 20)\nlosses = -diff_clamped / (1 + abs(diff_clamped))  # softsign-based loss\nweighted_losses = losses * weight\nnormalized_loss = median(weighted_losses) / (sum(weight) + epsilon)",
  "hyperparams": {
    "paradigm_family": "pairwise_margin",
    "signal_family": "cost_gap",
    "link_family": "softsign",
    "agg_family": "median",
    "constraint_family": "scale_invariance"
  },
  "operators_used": [
    "clamp",
    "median",
