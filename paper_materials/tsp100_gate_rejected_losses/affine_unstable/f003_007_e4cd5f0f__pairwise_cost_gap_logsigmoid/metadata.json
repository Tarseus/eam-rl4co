  "name": "pairwise_cost_gap_logsigmoid",
  "intuition": "This loss leverages the cost gap signal (cost_b - cost_a) to encourage the model to prefer lower-cost options. Using logsigmoid on the scaled difference between log probabilities ensures smooth and bounded gradients that push the model toward better ordering. Pairwise operations and direct cost gap signal focus the training on cost-based preferences, improving the policy's ability to distinguish better options robustly.",
  "pseudocode": "losses = -logsigmoid(alpha * scale * (log_prob_w - log_prob_l) - lambda * (cost_b - cost_a))\nloss = mean(losses)",
  "hyperparams": {
    "paradigm_family": "pairwise_margin",
    "signal_family": "cost_gap",
    "link_family": "logsigmoid",
    "agg_family": "mean",
    "constraint_family": "clamp_stabilized",
    "other_hparams": "alpha=1.0, scale=1.5, lambda=0.1"
  },
  "operators_used": [
    "logsigmoid",
    "clamp",
    "mean",
    "mul"
  ],
  "implementation_hint": {
    "expects": [
      "log_prob_w",
      "log_prob_l",
      "weight",
      "cost_a",
      "cost_b"
    ],
    "returns": "scalar",
    "mode": "pairwise"
  },
  "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('scale', 1.5))\n    lambda_ = float(extra.get('lambda', 0.1))\n    diff_logprob = alpha * scale * (lpw - lpl)\n    gap = cost_b - cost_a\n    x = diff_logprob - lambda_ * gap\n    x_clamped = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x_clamped)\n    weighted_losses = losses * weight\n    loss = ops.mean(weighted_losses)\n    return loss",
