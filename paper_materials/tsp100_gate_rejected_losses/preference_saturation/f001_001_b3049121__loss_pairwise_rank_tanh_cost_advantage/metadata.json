  "name": "loss_pairwise_rank_tanh_cost_advantage",
  "intuition": "A pairwise ranking loss that combines a tanh-transformed advantage gap with a cost gap penalty, using a hinge-like margin on the rank difference. This paradigm shift replaces the logistic link with a margin ranking approach linked via a tanh non-linearity, aggregating losses by weighted sum to emphasize significant pairwise disagreements prioritized by cost and advantage signals.",
  "pseudocode": "adv_gap = tanh(advantage_w - advantage_l)\ncost_penalty = relu(cost_gap)\nrank_diff = log_prob_w - log_prob_l\nmargin = 0.1\nmargin_diff = relu(margin - adv_gap * rank_diff)\nloss_per_pair = margin_diff * cost_penalty * weight\nloss = sum(loss_per_pair) / sum(weight)",
  "hyperparams": {
    "paradigm_family": "pairwise_ranking",
    "signal_family": "advantage_costgap",
    "link_family": "hinge_margin_tanh",
    "agg_family": "weighted_sum_normalized",
    "constraint_family": "nonnegative_relu"
  },
  "operators_used": [
    "tanh",
