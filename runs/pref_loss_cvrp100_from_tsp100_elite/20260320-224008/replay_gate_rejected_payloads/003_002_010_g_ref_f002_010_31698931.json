  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f002_010_31698931",
    "ir": {
      "name": "loss_logsigmoid_001_costgap_repair",
      "intuition": "Pairwise logsigmoid loss using log_prob_w, log_prob_l, weight, and robust cost_gap derived safely if missing.",
      "pseudocode": "eps=1e-8; lpw=batch['log_prob_w']; lpl=batch['log_prob_l']; weight=batch.get('weight', ones_like(lpw)); zeros=zeros_like(lpw); cost_gap=batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros)); cost_gap = cost_gap.detach(); alpha=extra.get('alpha',1.0); scale=0.6706; x=alpha*scale*(lpw-lpl)-0.1*cost_gap; x=clamp(x,-20,20); loss=-logsigmoid(x)*weight; return loss.mean()",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "cost_gap",
        "link_family": "logsigmoid",
        "agg_family": "mean",
        "constraint_family": "clamp_stabilized",
        "other_hparams": {
          "scale": "0.6706083718872656"
        }
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "ones_like",
        "zeros_like",
        "sub",
        "mul",
        "neg",
        "mean"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "cost_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    zeros = ops.zeros_like(lpw)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    cost_gap = cost_gap.detach()\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 0.6706083718872656))\n    x = alpha * scale * (lpw - lpl) - 0.1 * cost_gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x) * weight\n    return loss.mean()",
      "theoretical_basis": ""
    }
  },
