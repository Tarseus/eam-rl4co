  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_001_pairwise_weighted_deltaz_scale_adjusted",
    "intuition": "Fixed insensitivity to objective by incorporating delta_z directly into the loss weighting, amplifying the gradient signal for significant objective differences. Adjusted the scale factor and ensured stable clamping to maintain numeric stability while reflecting objective sensitivity.",
    "pseudocode": "x = clamp(alpha * scale * (lpw - lpl), -20, 20)\nloss = -logsigmoid(x) * weight * abs(delta_z)",
    "hyperparams": {
      "scale": 3.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_z",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "abs",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_z = batch['delta_z']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 3.0))\n    x = alpha * scale * (lpw - lpl)\n    x = ops.clamp(x, -20.0, 20.0)\n    base_loss = -ops.logsigmoid(x)\n    # Incorporate absolute delta_z to amplify loss with objective difference\n    weighted_loss = base_loss * weight * ops.abs(delta_z)\n    return ops.sum(weighted_loss)",
    "theoretical_basis": ""
  },
