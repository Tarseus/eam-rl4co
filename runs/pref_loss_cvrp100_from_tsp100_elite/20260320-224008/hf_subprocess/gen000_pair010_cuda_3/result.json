  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_margin_scaled_delta_rank_adaptive_bias_v4_safe_repair",
    "intuition": "Repair original loss by ensuring stable numeric domains, adding eps clamps before division and clamping where needed to prevent non-finite gradients while preserving adaptive bias and nonlinear scaling of delta_rank.",
    "pseudocode": "eps=1e-8\nmargin = log_prob_w - log_prob_l\nabs_delta_rank_mean = mean(abs(delta_rank)) + eps\nentropy_gap_safe = batch.get('entropy_gap', zeros)\nmean_entropy_gap = mean(entropy_gap_safe) + eps\nmean_log_prob_gap = mean(margin) + eps\nbeta_base=0.08\nsigmoid_log_prob_gap = 1 / (1 + exp(-mean_log_prob_gap))\nbeta=beta_base * sigmoid_log_prob_gap * abs_delta_rank_mean\nadaptive_bias=gamma * bias_base * (mean_entropy_gap ** 2)\nscaled_delta_rank = tanh(delta_rank)\nweighted_margin = alpha * margin - beta * scaled_delta_rank\nbiased_margin = weighted_margin + adaptive_bias\nx = clamp(biased_margin, -10, 10)\nloss_per_pair = -logsigmoid(x)\nloss = mean(loss_per_pair * weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank_entropy_logprob_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean_loss",
      "constraint_family": "clipping_with_adaptive_bias_and_smooth_scaling"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "mean",
      "abs",
      "tanh",
      "exp",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    zeros = lpw.new_zeros(lpw.shape)\n    entropy_gap = batch.get('entropy_gap', zeros)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    bias_base = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.5)))\n    gamma = float(extra.get('gamma', 1.2))\n\n    margin = ops.sub(lpw, lpl)\n\n    abs_delta_rank_mean = ops.mean(ops.abs(delta_rank)) + eps\n    mean_entropy_gap = ops.mean(entropy_gap) + eps\n    mean_log_prob_gap = ops.mean(margin) + eps\n\n    beta_base = 0.08\n    sigmoid_log_prob_gap = ops.div(\n        1.0,\n        ops.add(1.0, ops.exp(ops.neg(ops.clamp(mean_log_prob_gap, -20.0, 20.0))))\n    )\n    beta = beta_base * sigmoid_log_prob_gap * abs_delta_rank_mean\n\n    adaptive_bias = gamma * bias_base * (mean_entropy_gap * mean_entropy_gap)\n\n    scaled_delta_rank = ops.tanh(delta_rank)\n\n    weighted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, scaled_delta_rank))\n    biased_margin = ops.add(weighted_margin, adaptive_bias)\n    x = ops.clamp(biased_margin, -10.0, 10.0)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
