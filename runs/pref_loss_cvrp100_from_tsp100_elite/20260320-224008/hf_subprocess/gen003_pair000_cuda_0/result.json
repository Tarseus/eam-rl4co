  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_margin_clipped_normalized_bias_loss_meanagg",
    "intuition": "Keep the original pairwise margin loss with clipped normalized bias but aggregate the weighted loss using mean instead of sum for better gradient scale control and stability.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nabs_delta_rank_mean = mean(abs(delta_rank)) + 1e-6\nnormalized_bias = bias / abs_delta_rank_mean\nclipped_bias = clamp(normalized_bias, -1.0, 1.0)\ndelta_rank_mean = mean(delta_rank)\ndelta_rank_var = mean((delta_rank - delta_rank_mean)**2) + 1e-6\nbeta = 0.1 * sqrt(delta_rank_var)\nweighted_margin = alpha * margin - beta * delta_rank\nbiased_margin = weighted_margin + clipped_bias\nx = clamp(biased_margin, -15, 15)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight\nloss = mean(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "clipping_with_bias_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "mean",
      "abs",
      "sqrt"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    bias = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.5)))\n\n    abs_delta_rank_mean = ops.mean(ops.abs(delta_rank)) + eps\n    normalized_bias = bias / abs_delta_rank_mean\n    clipped_bias = ops.clamp(normalized_bias, -1.0, 1.0)\n\n    delta_rank_mean = ops.mean(delta_rank)\n    diff = ops.sub(delta_rank, delta_rank_mean)\n    delta_rank_var = ops.mean(ops.mul(diff, diff)) + eps\n    beta = 0.1 * ops.sqrt(delta_rank_var)\n\n    margin = ops.sub(lpw, lpl)\n    weighted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_rank))\n    biased_margin = ops.add(weighted_margin, clipped_bias)\n    x = ops.clamp(biased_margin, -15.0, 15.0)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
