  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_002_m_from_fseed_005_64_repaired_v2",
    "intuition": "To fix the joint preference violation caused by symmetric loss values (swap_ok false), we introduced an asymmetric margin offset favoring the winning side, breaking symmetry in the loss between original and swapped pairs. This is done by adding a small positive bias term proportional to the weight and scaled by delta_z. This asymmetry ensures that the loss decreases when the better candidate is correctly preferred, thus passing the joint preference gate. The original formulation was symmetric w.r.t swapping logits, leading to identical loss and swap loss, failing the swap test.",
    "pseudocode": "margin = alpha * scale * delta_z * (log_prob_w - log_prob_l) + offset\nmargin = clamp(margin, -20, 20)\nloss = -logsigmoid(margin)",
    "hyperparams": {
      "scale": 1.7,
      "asymmetry_scale": 0.3,
      "paradigm_family": "pairwise_margin",
      "signal_family": "logprob_gap_with_objective_and_bias",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_z",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_z = batch['delta_z']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.7))\n    asym_scale = float(extra.get('hyperparams', {}).get('asymmetry_scale', 0.3))\n    margin = alpha * scale * delta_z * (lpw - lpl)\n    # Introduce small positive offset proportional to weight and delta_z for asymmetry\n    offset = 0.0\n    if weight is not None:\n        offset = asym_scale * weight * ops.relu(delta_z)\n    margin = margin + offset\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = -ops.logsigmoid(margin)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": "Introducing an asymmetric bias breaks loss symmetry under swapping, ensuring that the preferred candidate yields strictly lower loss than its swapped counterpart. Using relu(delta_z) ensures that the bias only increases margin when the objective difference favors the winner, maintaining theoretical consistency with preference signals."
  },
