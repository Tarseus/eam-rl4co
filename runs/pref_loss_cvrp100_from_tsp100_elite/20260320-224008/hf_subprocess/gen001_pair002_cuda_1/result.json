  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_weighted_advantage_loss_symmetry_normalized_sum_to_one_v3_repaired",
    "intuition": "Fixed the missing key 'advantage_gap' by replacing it with 'delta_rank' for advantage modulation, and used 'delta_rank' for weighting to maintain modulation and symmetry. Removed 'advantage_gap' dependency to ensure required keys are present, preserving the Gaussian weighting on rank difference and normalized weighting for stability and proper weighting influence.",
    "pseudocode": "rank_weight_raw = clamp(1.0 + gamma * delta_rank, 0.1, 10.0)\ndiff = rank_weight_raw - 1.0\ndiff_sq = diff * diff\nsym_rank_weight = exp(-diff_sq)\nadv_weight = sigmoid(kappa * delta_rank)\ncombined_weight_unnormalized = weight * sym_rank_weight * adv_weight\nnorm = sum(combined_weight_unnormalized) + epsilon\ncombined_weight = combined_weight_unnormalized / norm\nmargin = log_prob_w - log_prob_l\nx = alpha * margin - beta * delta_rank\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * combined_weight\nloss = sum(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_weighted_normalized",
      "signal_family": "delta_rank_modulated",
      "link_family": "logsigmoid_linear_margin",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "symmetry_with_delta_rank_modulation_gaussian",
      "other_hparams": "kappa=2.0"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "exp",
      "sum",
      "div",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    kappa = float(extra.get('kappa', extra.get('hyperparams', {}).get('kappa', 2.0)))\n\n    rank_weight_raw = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.1, 10.0)\n    diff = ops.sub(rank_weight_raw, 1.0)\n    diff_sq = ops.mul(diff, diff)\n    sym_rank_weight = ops.exp(ops.neg(diff_sq))\n\n    adv_weight = ops.sigmoid(ops.mul(kappa, delta_rank))\n\n    combined_weight_unnormalized = ops.mul(ops.mul(weight, sym_rank_weight), adv_weight)\n    norm = ops.sum(combined_weight_unnormalized) + eps\n    combined_weight = ops.div(combined_weight_unnormalized, norm)\n\n    margin = ops.sub(lpw, lpl)\n    x = ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_rank))\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n\n    weighted_loss = ops.mul(loss_per_pair, combined_weight)\n    loss = ops.sum(weighted_loss)\n\n    return loss",
    "theoretical_basis": ""
  },
