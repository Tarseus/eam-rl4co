  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_weighted_advantage_loss_symmetry_normalized_sum_to_one_v2_repaired",
    "intuition": "The original loss failed because it required 'advantage_gap' which was missing. This repair handles the missing 'advantage_gap' key by defaulting it to zero, ensuring the loss computes without error and still applies the intended ranking and symmetry logic. The power=2 squared difference is preserved for smooth weighting. By accessing 'advantage_gap' with a fallback, the repair maintains backward compatibility and gate compliance.",
    "pseudocode": "rank_weight_raw = clamp(1.0 + gamma * delta_rank, 0.05, 15.0)\ndiff = abs(rank_weight_raw - 1.0)\nsym_rank_weight = exp(- (diff * diff))  # use mul for diff^2\nadvantage_gap = batch.get('advantage_gap', zeros)\nmargin = lpw - lpl\nx_pre_tanh = alpha * margin - beta * advantage_gap\nx = tanh(x_pre_tanh)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight * sym_rank_weight\nnorm = sum(weight * sym_rank_weight) + eps\nloss = sum(weighted_loss) / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_weighted_normalized",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "symmetry_with_explicit_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "tanh",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "exp",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch.get('advantage_gap', ops.zeros_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    power = float(extra.get('power', extra.get('hyperparams', {}).get('power', 2.0)))\n\n    rank_weight_raw = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.05, 15.0)\n    diff = ops.abs(ops.sub(rank_weight_raw, 1.0))\n    if power == 2.0:\n        diff_pow = ops.mul(diff, diff)\n    else:\n        diff_clamped = ops.clamp(diff, 1e-6)\n        diff_pow = diff_clamped\n    sym_rank_weight = ops.exp(ops.neg(diff_pow))\n\n    margin = ops.sub(lpw, lpl)\n    x_pre_tanh = ops.sub(ops.mul(alpha, margin), ops.mul(beta, advantage_gap))\n    x = ops.tanh(x_pre_tanh)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n\n    weighted_loss = ops.mul(ops.mul(loss_per_pair, weight), sym_rank_weight)\n    norm = ops.sum(ops.mul(weight, sym_rank_weight)) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n\n    return loss",
    "theoretical_basis": ""
  },
