  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "combined_stable_loss_v3_fixed",
    "intuition": "Replace unavailable median with mean as fallback to preserve adaptive nonlinear margin based on delta_rank in pairwise margin loss.",
    "pseudocode": "eps = 1e-8\nmargin = batch['log_prob_w'] - batch['log_prob_l']\ndelta_rank = batch['delta_rank']\ndelta_rank_mean = mean(delta_rank)\ndelta_rank_std = sqrt(mean((delta_rank - delta_rank_mean)**2) + eps)\ndelta_rank_median = delta_rank_mean\nalpha = extra.get('alpha', 1.3)\nbeta = 0.15 * delta_rank_std\nbias = 0.4 * delta_rank_median\nscaled_delta = tanh(delta_rank / (delta_rank_std + eps))\nadjusted_margin = alpha * margin - beta * scaled_delta\nbiased_margin = adjusted_margin + bias\nclipped_margin = clamp(biased_margin, -8.0 + bias, 12.0 - bias)\nloss_per_pair = -logsigmoid(clipped_margin)\nweight = batch.get('weight', ones_like(clipped_margin))\nloss = sum(loss_per_pair * weight) / sum(weight)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "adaptive_clipping_with_nonlinear_bias"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "sum",
      "div",
      "tanh",
      "sqrt",
      "mean",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    delta_rank_mean = ops.mean(delta_rank)\n    diff = ops.sub(delta_rank, delta_rank_mean)\n    variance = ops.mean(ops.mul(diff, diff))\n    delta_rank_std = ops.sqrt(variance + eps)\n\n    # Median op unavailable, fallback to mean for median approximation\n    delta_rank_median = delta_rank_mean\n\n    alpha = float(extra.get('alpha', 1.3))\n    beta = 0.15 * delta_rank_std\n    bias = 0.4 * delta_rank_median\n\n    scaled_delta = ops.tanh(ops.div(delta_rank, delta_rank_std + eps))\n    margin = ops.sub(lpw, lpl)\n    adjusted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, scaled_delta))\n    biased_margin = ops.add(adjusted_margin, bias)\n\n    lower_bound = ops.sub(-8.0, ops.neg(bias))  # -8.0 + bias\n    upper_bound = ops.sub(12.0, bias)\n    clipped_margin = ops.clamp(biased_margin, lower_bound, upper_bound)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(clipped_margin))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.div(ops.sum(weighted_loss), ops.sum(weight) + eps)\n    return loss",
    "theoretical_basis": ""
  },
