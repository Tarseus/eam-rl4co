  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "fseed_007_f9624f1c",
    "ir": {
      "name": "loss_logsigmoid_delta_rank_weighted_margin_with_bias_weighted_mean_agg",
      "intuition": "To improve novelty and preserve the weighting effects, replaced the simple mean aggregation with a weighted mean that normalizes by the sum of weights. This ensures the loss magnitude is stable and respects pair importance without using an unweighted mean, differentiating sufficiently from prior losses. The margin calculation and bias remain, but loss is aggregated as a weighted average to maintain proper scale and gating.",
      "pseudocode": "margin = log_prob_w - log_prob_l\nweighted_margin = alpha * margin - beta * delta_rank\nbiased_margin = weighted_margin + bias\nx = clamp(biased_margin, -20, 20)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight\nloss = sum(weighted_loss) / sum(weight)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "delta_rank",
        "link_family": "logsigmoid",
        "agg_family": "weighted_mean",
        "constraint_family": "weighted_margin_with_bias"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "mul",
        "add",
        "neg",
        "sum",
        "sub",
        "div"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "delta_rank"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    bias = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.5)))\n\n    margin = ops.sub(lpw, lpl)\n    weighted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_rank))\n    biased_margin = ops.add(weighted_margin, bias)\n    x = ops.clamp(biased_margin, -20.0, 20.0)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.div(ops.sum(weighted_loss), ops.sum(weight))\n    return loss",
      "theoretical_basis": ""
    }
  },
