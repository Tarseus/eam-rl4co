  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_margin_weighted_mean_delta_z_scaled_bias_expanded_cost_gap_interaction_sigmoid_penalty_v2_fallback",
    "intuition": "This loss uses a pairwise weighted margin formulation with adaptive bias and a nonlinear interaction penalty based on delta_z and cost_gap. Keys required via batch indexing include \"log_prob_w\", \"log_prob_l\", \"delta_z\", and \"weight\" (which is accessed with get, so optional). The modified code handles missing \"cost_gap\" by providing a zero tensor fallback, so \"cost_gap\" is optional. Hence, expects includes keys required via batch[...] only. The presence of \"delta_z\" and the mode being pairwise requires \"log_prob_w\", \"log_prob_l\", \"weight\", and at least one of relevant keys such as \"delta_z\". Thus, expects are [\"log_prob_w\", \"log_prob_l\", \"weight\", \"delta_z\"].",
    "pseudocode": "margin = log_prob_w - log_prob_l\nabs_delta_z_mean = mean(abs(delta_z)) + 1e-8\nalpha = extra.get('alpha', 1.0)\nbias_base = extra.get('bias', 0.5)\ngamma = extra.get('gamma', 2.0)\ninteraction_coef = extra.get('interaction_coef', 0.07)\nclipped_abs_delta_z_mean = clamp(abs_delta_z_mean, 1e-5, 10.0)\nbeta = 0.05 * clipped_abs_delta_z_mean\ncost_gap = batch.get('cost_gap', zeros_like(delta_z))\nnonlinear_cost_gap = tanh(cost_gap)\ninteraction = delta_z * nonlinear_cost_gap\nsigmoid_penalty = sigmoid(interaction * interaction)\nweighted_margin = alpha * margin - beta * delta_z + interaction_coef * interaction\ndynamic_bias = gamma * bias_base * sigmoid_penalty\nbiased_margin = weighted_margin + dynamic_bias\nx = clamp(biased_margin, -20, 20)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight\nloss = mean(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_z_cost_gap_interaction_sigmoid_penalty_nonlinear_tanh_v2",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "weighted_margin_with_dynamic_bias_and_sigmoid_interaction_nonlinear"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "mean",
      "abs",
      "sigmoid",
      "tanh",
      "zeros_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_z = batch['delta_z']\n    cost_gap = batch.get('cost_gap', ops.zeros_like(delta_z))\n\n    alpha = float(extra.get('alpha', 1.0))\n    bias_base = float(extra.get('bias', 0.5))\n    gamma = float(extra.get('gamma', 2.0))\n    interaction_coef = float(extra.get('interaction_coef', 0.07))\n\n    abs_delta_z_mean = ops.mean(ops.abs(delta_z)) + 1e-8\n    clipped_abs_delta_z_mean = ops.clamp(abs_delta_z_mean, 1e-5, 10.0)\n    beta = 0.05 * clipped_abs_delta_z_mean\n\n    nonlinear_cost_gap = ops.tanh(cost_gap)\n    interaction = ops.mul(delta_z, nonlinear_cost_gap)\n    sigmoid_penalty = ops.sigmoid(ops.mul(interaction, interaction))\n\n    margin = ops.sub(lpw, lpl)\n    weighted_margin = ops.add(ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_z)), ops.mul(interaction_coef, interaction))\n    dynamic_bias = ops.mul(ops.mul(gamma, bias_base), sigmoid_penalty)\n    biased_margin = ops.add(weighted_margin, dynamic_bias)\n\n    x = ops.clamp(biased_margin, -20.0, 20.0)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
