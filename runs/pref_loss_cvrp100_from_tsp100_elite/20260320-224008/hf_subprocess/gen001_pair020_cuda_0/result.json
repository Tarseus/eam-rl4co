  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_normalized_symmetry_advantage_weighted_loss",
    "intuition": "Fixed missing 'cost_gap' key by modifying the loss to not rely on 'cost_gap'. Instead, computed 'advantage_gap' directly using 'delta_rank' as a proxy signal, normalized by its absolute mean. This avoids dependency on the missing 'cost_gap' while preserving the semantic role of advantage weighting. Also updated implementation_hint.expects accordingly to match the accessed batch keys. This repair ensures the loss passes static and dynamic gates since all required keys are present and the advantage weighting is still effectively modulated by rank differences.",
    "pseudocode": "advantage_gap = delta_rank / (abs(mean(delta_rank)) + eps)\nrank_weight_raw = clamp(1.0 + gamma * delta_rank, 0.5, 2.0)\nrho = 1.5\nsym_rank_weight = exp(-rho * abs(rank_weight_raw - 1.0))\nadv_weight = sigmoid(kappa * advantage_gap)\nmargin = log_prob_w - log_prob_l\nx = alpha * margin - beta * advantage_gap\nloss_per_pair = -logsigmoid(x)\ncombined_weight = weight * sym_rank_weight * adv_weight\nweighted_loss = loss_per_pair * combined_weight\nnorm = sum(combined_weight) + eps\nloss = sum(weighted_loss) / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_weighted_normalized",
      "signal_family": "dynamic_advantage_gap_proxy_delta_rank_modulated",
      "link_family": "logsigmoid_linear_margin",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "symmetry_with_advantage_modulation",
      "other_hparams": "kappa=3.0, rho=1.5"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "exp",
      "sum",
      "div",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n\n    mean_abs_delta_rank = ops.sum(ops.abs(delta_rank)) / (delta_rank.shape[0] + eps)\n    advantage_gap = ops.div(delta_rank, ops.add(mean_abs_delta_rank, eps))\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    kappa = float(extra.get('kappa', extra.get('hyperparams', {}).get('kappa', 3.0)))\n    rho = float(extra.get('rho', extra.get('hyperparams', {}).get('rho', 1.5)))\n\n    rank_weight_raw = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.5, 2.0)\n    sym_rank_weight = ops.exp(ops.neg(ops.mul(rho, ops.abs(ops.sub(rank_weight_raw, 1.0)))))\n\n    adv_weight = ops.sigmoid(ops.mul(kappa, advantage_gap))\n\n    margin = ops.sub(lpw, lpl)\n    x = ops.sub(ops.mul(alpha, margin), ops.mul(beta, advantage_gap))\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n\n    combined_weight = ops.mul(ops.mul(weight, sym_rank_weight), adv_weight)\n    weighted_loss = ops.mul(loss_per_pair, combined_weight)\n\n    norm = ops.sum(combined_weight) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n\n    return loss",
    "theoretical_basis": ""
  },
