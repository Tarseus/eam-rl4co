  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_margin_bias_shift_scaled_normalized_v2_repaired",
    "intuition": "Preserves the original dynamic bias and scaling scheme but replaces unsupported std with manual std calculation using supported ops for safe execution.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nmean_margin_abs = mean(abs(margin)) + 1e-6\nmean_delta_rank = mean(delta_rank)\ndev = delta_rank - mean_delta_rank\nstd_delta_rank = sqrt(mean(dev * dev)) + 1e-6\nbeta = 0.05 * std_delta_rank / mean_margin_abs\nbias_per_pair = tanh(delta_rank / (std_delta_rank * 10)) * bias_scale\nweighted_margin = alpha * margin - beta * delta_rank\nbiased_margin = weighted_margin + gamma * bias_per_pair\nx = clamp(biased_margin, -20, 20)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight\nloss = sum(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "weighted_margin_with_dynamic_bounded_bias"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "sum",
      "abs",
      "mean",
      "sqrt",
      "tanh",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', 1.0))\n    gamma = float(extra.get('gamma', 1.5))\n    bias_scale = float(extra.get('bias_scale', 0.5))\n\n    margin = ops.sub(lpw, lpl)\n\n    mean_margin_abs = ops.mean(ops.abs(margin)) + eps\n\n    mean_delta_rank = ops.mean(delta_rank)\n    dev = ops.sub(delta_rank, mean_delta_rank)\n    variance = ops.mean(ops.mul(dev, dev))\n    std_delta_rank = ops.sqrt(variance.clamp(min=eps))\n\n    beta = 0.05 * std_delta_rank / mean_margin_abs\n\n    bias_per_pair_raw = ops.div(delta_rank, ops.mul(std_delta_rank, 10.0))\n    bias_per_pair = ops.mul(bias_scale, ops.tanh(bias_per_pair_raw))\n\n    weighted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_rank))\n    biased_margin = ops.add(weighted_margin, ops.mul(gamma, bias_per_pair))\n\n    x = ops.clamp(biased_margin, -20.0, 20.0)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n\n    loss = ops.sum(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
