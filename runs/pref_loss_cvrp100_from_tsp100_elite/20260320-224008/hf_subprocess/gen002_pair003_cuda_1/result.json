  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_weighted_loss_sum_aggregation_fixed_no_advantage_gap",
    "intuition": "Removed usage of the missing 'advantage_gap' key by replacing advantage-based weighting with a simpler modulation using only delta_rank. This fixes the failure caused by missing 'advantage_gap' while preserving the pairwise advantage-weighted loss structure as much as possible. The combined weight now uses a symmetric rank-based weight without the unavailable advantage modulation.",
    "pseudocode": "rank_weight_raw = clamp(1.0 + gamma * delta_rank, 0.5, 2.0)\nrho = 1.5\nsym_rank_weight = exp(-rho * abs(rank_weight_raw - 1.0))\nmargin = log_prob_w - log_prob_l\nx = alpha * margin\nloss_per_pair = -logsigmoid(x)\ncombined_weight = weight * sym_rank_weight\nweighted_loss = loss_per_pair * combined_weight\nloss = sum(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_weighted_normalized",
      "signal_family": "delta_rank_modulated",
      "link_family": "logsigmoid_linear_margin",
      "agg_family": "sum",
      "constraint_family": "symmetry_without_advantage_modulation"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    rho = float(extra.get('rho', extra.get('hyperparams', {}).get('rho', 1.5)))\n\n    rank_weight_raw = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.5, 2.0)\n    sym_rank_weight = ops.exp(ops.neg(ops.mul(rho, ops.abs(ops.sub(rank_weight_raw, 1.0)))))\n\n    margin = ops.sub(lpw, lpl)\n    x = ops.mul(alpha, margin)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n\n    combined_weight = ops.mul(weight, sym_rank_weight)\n    weighted_loss = ops.mul(loss_per_pair, combined_weight)\n\n    loss = ops.sum(weighted_loss)\n\n    return loss",
    "theoretical_basis": ""
  },
