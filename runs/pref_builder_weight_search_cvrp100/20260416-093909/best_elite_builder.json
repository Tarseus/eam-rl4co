    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() <= 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs', 'weight_family': 'gap_softmax'})\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    # Temperature parameter tau for softmax scaling, default 1.0\n    tau = float(extra.get('weight_tau', 1.0))\n    raw = (gap / tau).exp()\n    clamp_lo = 0.25\n    clamp_hi = 4.0\n    raw = torch.nan_to_num(raw, nan=0.0, posinf=4.0, neginf=0.0).clamp(clamp_lo, clamp_hi)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=raw, meta={'builder': 'all_pairs', 'weight_family': 'gap_softmax'})"
  },
