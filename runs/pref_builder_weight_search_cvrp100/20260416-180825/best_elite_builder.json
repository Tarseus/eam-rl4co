      "weight_family": "gap_sigmoid_scaled_clamped",
      "constraint_family": "clamp_only"
    },
    "operators_used": [
      "all_pairs",
      "sigmoid",
      "clamp",
      "sub",
      "mul"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    beta = float(extra.get('weight_beta', 1.5))\n    tau = float(extra.get('weight_tau', 3.0))\n    weight_raw = (gap - beta) * tau\n    weight_sig = weight_raw.sigmoid()\n    weight = weight_sig.clamp(min=0.25, max=3.0)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs', 'weight_family': 'gap_sigmoid_scaled_clamped'})"
  },
