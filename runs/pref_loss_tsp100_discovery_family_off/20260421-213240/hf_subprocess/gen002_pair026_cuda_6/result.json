  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_scaled_exp_weighted_combined_margin",
    "intuition": "To break similarity with prior candidates and enrich the margin signal, I replaced the linear combination of (log_prob difference, cost_gap, and advantage_gap) with a nonlinear softplus transformation on scaled log_prob differences, combined with a weighted sum of cost_gap and a tanh-transformed advantage_gap. This adds nonlinearity and asymmetry, softening large log_prob margins and bounding advantage_gap influence. I also normalized weights properly and kept pairwise signals as required. This design uses multiple quality signals (log_prob_w, log_prob_l, cost_gap, advantage_gap) and maintains the weighted average aggregation with clamping for numerical stability.",
    "pseudocode": "margin_logprob = softplus(beta * (log_prob_w - log_prob_l))\nadv_mod = tanh(delta * advantage_gap)\nmargin = clamp(margin_logprob + eta * cost_gap + zeta * adv_mod, -20, 20)\nloss = -logsigmoid(margin)\nif weight:\n  loss = sum(loss * weight) / (sum(weight) + 1e-8)\nelse:\n  loss = mean(loss)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "logprob_cost_advantage",
      "link_family": "logsigmoid",
      "agg_family": "weighted_avg",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "neg",
      "clamp",
      "sum",
      "div",
      "add",
      "mul",
      "softplus",
      "tanh"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_gap = batch['cost_gap']\n    advantage_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    beta = float(extra.get('beta', 1.5))\n    eta = float(extra.get('eta', 0.6))\n    delta = float(extra.get('delta', 0.9))\n    zeta = float(extra.get('zeta', 0.4))\n    margin_logprob = ops.softplus(ops.mul(ops.sub(lpw, lpl), beta))\n    adv_mod = ops.tanh(ops.mul(advantage_gap, delta))\n    margin_raw = ops.add(ops.add(margin_logprob, ops.mul(cost_gap, eta)), ops.mul(adv_mod, zeta))\n    margin = ops.clamp(margin_raw, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        denom = ops.add(ops.sum(weight), 1e-8)\n        normalized_loss = ops.div(ops.sum(weighted_loss), denom)\n    else:\n        normalized_loss = ops.mean(loss)\n    return normalized_loss",
    "theoretical_basis": ""
  },
