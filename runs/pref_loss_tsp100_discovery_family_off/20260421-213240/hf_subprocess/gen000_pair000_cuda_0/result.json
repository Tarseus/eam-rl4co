  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_002_cost_weighted_gap_sum_affine_invariant",
    "intuition": "This loss computes a margin-weighted log-sigmoid, scaling the log probability difference by (1 + cost_gap) to incorporate cost differences into the pairwise margin ranking loss, promoting affine-invariant weighting.",
    "pseudocode": "margin = alpha * scale * (log_prob_w - log_prob_l) * (1 + cost_gap); clamped_margin = clamp(margin, -20, 20); loss = sum(-logsigmoid(clamped_margin) * weight)",
    "hyperparams": {
      "scale": 1.9496803035382082,
      "paradigm_family": "pairwise_margin",
      "signal_family": "log_prob_diff",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_gap = batch['cost_gap']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    margin = alpha * scale * (lpw - lpl)\n    margin = margin * ops.add(ops.ones_like(margin), cost_gap)\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = -ops.logsigmoid(margin)\n    if weight is not None:\n        loss = loss * weight\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
