  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_logsigmoid_advantage_gap_weighted_avg_clip_norm",
    "intuition": "Inject explicit clipping normalization on the advantage_gap and weight signals before combination and aggregation to ensure numerical stability and bounded influence from extreme values, improving training robustness.",
    "pseudocode": "adv_clip = clamp(advantage_gap, adv_min, adv_max)\nweight_clip = clamp(weight, weight_min, weight_max)\nx = clamp(alpha * scale * (log_prob_w - log_prob_l) + beta * adv_clip, -20, 20)\nloss = -logsigmoid(x)\nweighted_loss = loss * weight_clip\nfinal_loss = sum(weighted_loss) / sum(weight_clip) + gamma * mean(softplus(entropy_gap))\nreturn final_loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_entropy_reg",
      "link_family": "logsigmoid",
      "agg_family": "weighted_avg_clip_norm",
      "constraint_family": "normalization_clipping"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "div",
      "mul",
      "add",
      "mean",
      "softplus",
      "neg",
      "sub",
      "maximum",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "entropy_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    entropy_gap = batch.get('entropy_gap', ops.zeros_like(lpw))\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.1)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n\n    adv_min = float(extra.get('adv_min', -5.0))\n    adv_max = float(extra.get('adv_max', 5.0))\n    weight_min = float(extra.get('weight_min', 1e-3))\n    weight_max = float(extra.get('weight_max', 10.0))\n\n    adv_clip = ops.clamp(advantage_gap, adv_min, adv_max)\n    weight_clip = ops.clamp(weight, weight_min, weight_max)\n\n    x = ops.add(ops.mul(alpha * scale, ops.sub(lpw, lpl)), ops.mul(beta, adv_clip))\n    x = ops.clamp(x, -20.0, 20.0)\n\n    loss = ops.neg(ops.logsigmoid(x))\n\n    weighted_loss = ops.mul(loss, weight_clip)\n    sum_weighted_loss = ops.sum(weighted_loss)\n    sum_weight_clip = ops.sum(weight_clip)\n    safe_sum_weight = ops.maximum(sum_weight_clip, ops.ones_like(sum_weight_clip))\n    weighted_avg_loss = ops.div(sum_weighted_loss, safe_sum_weight)\n\n    entropy_reg = ops.mul(gamma, ops.mean(ops.softplus(entropy_gap)))\n\n    final_loss = ops.add(weighted_avg_loss, entropy_reg)\n    return final_loss",
    "theoretical_basis": ""
  },
