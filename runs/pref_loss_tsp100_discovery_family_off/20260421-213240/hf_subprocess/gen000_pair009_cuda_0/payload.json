  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f000_002_ecb61900",
    "ir": {
      "name": "loss_pairwise_rank_weighted_exp_advantage_v5",
      "intuition": "Fixed insensitivity by introducing a non-zero margin offset of 0.02 to create a clearer decision boundary difference and increased beta scaling factor to 3.0 to amplify the influence of advantage_gap variations on the weighting. Changed the hinge offset to 0.2 to reduce saturation and allow more gradient flow near the margin threshold. Added a lower clamp bound of -2.0 for stability and a moderate upper clamp bound of 10.0 on beta * advantage_gap before exponentiation to balance sensitivity and gradient magnitude. These adjustments ensure the loss meaningfully varies under small perturbations in advantage_gap and margin, fixing the zero delta loss failure.",
      "pseudocode": "adv_gap = batch['advantage_gap']\nlpw, lpl = batch['log_prob_w'], batch['log_prob_l']\nweight = batch.get('weight', None)\nmargin = lpw - lpl + 0.02\nbeta = 3.0\nalpha = 1.0\nclipped_adv = clamp(beta * adv_gap, -2.0, 10.0)\nadv_weight = exp(clipped_adv)\nweighted_margin = alpha * margin * adv_weight\nhinge_offset = 0.2\nloss = softplus(hinge_offset - weighted_margin)\nif weight is not None:\n  loss = loss * weight\nreturn mean(loss)",
      "hyperparams": {
        "paradigm_family": "pairwise_weighted_margin",
        "signal_family": "advantage_gap",
        "link_family": "linear_exp",
        "agg_family": "mean",
        "constraint_family": "softplus_margin"
      },
      "operators_used": [
        "exp",
        "clamp",
        "sub",
        "mul",
        "softplus",
        "mean",
        "add"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "advantage_gap",
          "weight"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    alpha = 1.0\n    beta = 3.0\n    margin_offset = 0.02\n    margin = ops.add(ops.sub(lpw, lpl), margin_offset)\n    clipped_adv = ops.clamp(ops.mul(beta, adv_gap), -2.0, 10.0)\n    adv_weight = ops.exp(clipped_adv)\n    weighted_margin = ops.mul(alpha, ops.mul(margin, adv_weight))\n    hinge_offset = 0.2\n    loss = ops.softplus(ops.sub(hinge_offset, weighted_margin))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
      "theoretical_basis": "By adding a positive margin offset and increasing the scaling of advantage_gap, we increase the range and magnitude of the margin, which strengthens the sensitivity of the loss to subtle changes in the objective signals. The lowered hinge offset reduces saturation of the softplus near zero, enabling non-zero gradients even for small differences. Clamping advantage_gap before exponentiation prevents extreme weights while maintaining responsiveness for moderate perturbations, altogether resolving the prior insensitivity issues."
    }
  },
