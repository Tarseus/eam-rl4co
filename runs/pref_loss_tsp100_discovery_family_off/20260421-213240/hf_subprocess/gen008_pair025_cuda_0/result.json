  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_ratio_margin_adv_costgap_weighted_geo_reg_safe_v4_repaired",
    "intuition": "Removed unsafe manual clamping on ratio margin and advantage signals to ensure smooth affine invariance. Added epsilon-based normalization denominator without explicit clamp to maintain numerical stability. Used logsigmoid on combined signal without harsh clipping. Weighted loss by instance weight and included a soft regularization term based on squared normalized cost gap to keep scale invariant. This fixes the affine invariance violation by making the loss smoothly scale and shift-equivariant.",
    "pseudocode": "eps=1e-8\nlpw=batch['log_prob_w']\nlpl=batch['log_prob_l']\nweight=batch['weight']\nadv_gap=batch['advantage_gap']\nzeros=zeros_like(lpw)\ncost_gap=batch.get('cost_gap', batch.get('cost_b', zeros)-batch.get('cost_a', zeros))\ndenom=abs(lpw)+abs(lpl)+eps\nratio_margin=(lpw-lpl)/denom\nx=alpha*scale*ratio_margin + beta*adv_gap\nloss=-logsigmoid(x)\nweighted_loss=loss*weight\ncost_norm=normalize(cost_gap)\ncost_reg=gamma*mean(cost_norm**2)\nfinal_loss=mean(weighted_loss)+cost_reg\nreturn final_loss",
    "hyperparams": {
      "paradigm_family": "pairwise_ratio_margin",
      "signal_family": "advantage_gap_cost_gap_squared_reg",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean_norm_reg",
      "constraint_family": "normalization_scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "div",
      "mean",
      "normalize"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', ops.sub(batch.get('cost_b', zeros), batch.get('cost_a', zeros)))\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.1)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    denom = ops.add(ops.abs(lpw), ops.abs(lpl))\n    denom = ops.add(denom, eps)\n\n    ratio_margin = ops.div(ops.sub(lpw, lpl), denom)\n\n    x = ops.add(ops.mul(alpha * scale, ratio_margin), ops.mul(beta, advantage_gap))\n\n    loss = ops.neg(ops.logsigmoid(x))\n\n    weighted_loss = ops.mul(loss, weight)\n\n    cost_gap_norm = ops.normalize(cost_gap)\n    cost_reg = ops.mul(gamma, ops.mean(ops.mul(cost_gap_norm, cost_gap_norm)))\n\n    final_loss = ops.add(ops.mean(weighted_loss), cost_reg)\n    return final_loss",
    "theoretical_basis": ""
  },
