  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_logsigmoid_advantage_gap_weighted_sum_exp_agg",
    "intuition": "Transforms the weighted average aggregation into a weighted sum followed by a logsumexp-style softmax aggregation to stabilize gradients and better handle outliers. The pairwise score is scaled and clipped before applying the negative logsigmoid loss, then combined with weights, and aggregated by logsumexp normalization, preserving pairwise structure and using advantage_gap as signal.",
    "pseudocode": "x = clamp(alpha * scale * (log_prob_w - log_prob_l) + beta * advantage_gap, -20, 20)\nloss = -logsigmoid(x)\nweighted_loss = loss * weight\nagg = logsumexp(weighted_loss) - logsumexp(weight)\nreturn agg",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "logsumexp_normalized",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "log",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n\n    x = ops.add(ops.mul(alpha * scale, ops.sub(lpw, lpl)), ops.mul(beta, advantage_gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n\n    weighted_loss = ops.mul(loss, weight)\n\n    # LogSumExp aggregation by exp and log\n    max_wloss = ops.max(weighted_loss)\n    stable_wloss = ops.sub(weighted_loss, max_wloss)\n    sum_exp_wloss = ops.sum(ops.exp(stable_wloss))\n\n    max_wgt = ops.max(weight)\n    stable_wgt = ops.sub(weight, max_wgt)\n    sum_exp_wgt = ops.sum(ops.exp(stable_wgt))\n\n    agg = ops.add(max_wloss, ops.log(sum_exp_wloss))\n    norm = ops.add(max_wgt, ops.log(sum_exp_wgt))\n    normalized_loss = ops.sub(agg, norm)\n\n    return normalized_loss",
    "theoretical_basis": ""
  },
