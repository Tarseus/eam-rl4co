    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_bregman_div_adv_gap_delta_rank_weighted_median_reg_fixed_v2_repair",
    "intuition": "Repaired the loss by replacing the raw multiplication of delta_rank and advantage_gap with a smooth bounded tanh transform on advantage_gap, reducing sensitivity to large delta_rank values and improving affine invariance. Added clamping on the argument to avoid extreme exp values. Improved the median filtering by creating a strict boolean mask using comparison rank_loss <= median_rank_val (implemented via relu and sign) to avoid weighting by zero or negative masks, which prevents problematic normalization. These changes stabilize gradients and ensure the loss behaves consistently under affine perturbations, addressing the previous affine_invariance_violation.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    cost_b = batch['cost_b']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n\n    adv_skew = ops.tanh(ops.mul(beta, advantage_gap))\n    diff_log_prob = ops.sub(lpw, lpl)\n    breg_arg_raw = ops.add(\n        ops.mul(alpha * scale, diff_log_prob),\n        ops.mul(gamma, ops.mul(delta_rank, adv_skew))\n    )\n    breg_arg = ops.clamp(breg_arg_raw, -20.0, 20.0)\n\n    loss_point = ops.add(ops.sub(breg_arg, ops.exp(breg_arg)), ops.ones_like(breg_arg))\n    weighted_loss = ops.mul(loss_point, weight)\n\n    rank_loss = ops.rank_gap(weighted_loss, cost_b)\n    n = ops.sum(ops.ones_like(rank_loss))\n    median_rank_val = int(0.5 * n.item())\n\n    mask_float = ops.sign(ops.relu(ops.sub(median_rank_val, rank_loss)))\n\n    masked_weights = ops.mul(weight, mask_float)\n    denom = ops.maximum(ops.sum(masked_weights), ops.ones_like(weight[:1]))\n\n    weighted_median_loss = ops.div(ops.sum(ops.mul(weighted_loss, mask_float)), denom)\n\n    return weighted_median_loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_bregman_divergence",
      "signal_family": "advantage_gap_delta_rank_bounded_skew",
      "link_family": "bounded_tanh_bregman",
      "agg_family": "weighted_median",
      "constraint_family": "none",
      "alpha": 1.0,
      "beta": 1.0,
      "gamma": 0.5,
      "scale": 1.5
    },
    "operators_used": [
      "tanh",
