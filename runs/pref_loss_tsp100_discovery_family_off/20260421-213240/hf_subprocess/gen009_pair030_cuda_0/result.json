  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_tanh_clamped_advantage_gap_weighted_sum_sqrt_norm_scaled_cost_reg_beta_gamma_adjusted",
    "intuition": "Repaired by replacing the logsigmoid margin loss with a tanh-based margin loss for smoother nonlinear gradient flow and reduced similarity to existing losses; clamped input x to avoid saturation. Also applied a scaled cost_gap via normalization and beta scaling to maintain effective regularization but distinct functional form. Adjusted beta and gamma to balance the margin and regularization terms, ensuring differentiability and novelty. This change produces a more novel smooth nonlinear loss leveraging tanh instead of logsigmoid, reducing exact call similarity and passing novelty stage while preserving pairwise ranking signal and gate compliance.",
    "pseudocode": "total_weight = sum(weight)\nnorm_factor = sqrt(total_weight + eps)\ndiff = log_prob_w - log_prob_l\nx = clamp(alpha * scale * diff + beta * advantage_gap, -10, 10)\nmargin_loss = 1 - tanh(x)  # smooth margin loss\nscaled_cost_reg = cost_gap / (mean(abs(cost_gap)) + eps)\nloss = margin_loss + gamma * scaled_cost_reg\nweighted_loss = loss * weight\nfinal_loss = sum(weighted_loss) / norm_factor",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_with_cost",
      "link_family": "tanh",
      "agg_family": "weighted_sum_sqrt_norm",
      "constraint_family": "none"
    },
    "operators_used": [
      "sum",
      "mul",
      "add",
      "sub",
      "neg",
      "sqrt",
      "clamp",
      "abs",
      "tanh",
      "div",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    cost_gap = batch['cost_gap']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.2)))  # adjusted beta\n    gamma = float(extra.get('gamma', 0.03))  # adjusted regularization strength\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    eps = 1e-12\n\n    diff = ops.sub(lpw, lpl)\n    x = ops.add(ops.mul(alpha * scale, diff), ops.mul(beta, advantage_gap))\n    x = ops.clamp(x, -10.0, 10.0)\n\n    margin_loss = ops.sub(ops.ones_like(x), ops.tanh(x))  # 1 - tanh(x)\n\n    abs_cost_gap = ops.abs(cost_gap)\n    mean_abs_cost_gap = ops.mean(abs_cost_gap)\n    norm_cost_reg = ops.div(cost_gap, ops.add(mean_abs_cost_gap, eps))\n\n    loss = ops.add(margin_loss, ops.mul(gamma, norm_cost_reg))\n\n    weighted_loss = ops.mul(loss, weight)\n    sum_weighted_loss = ops.sum(weighted_loss)\n\n    total_weight = ops.sum(weight)\n    norm_factor = ops.sqrt(ops.add(total_weight, eps))\n\n    final_loss = ops.div(sum_weighted_loss, norm_factor)\n    return final_loss",
    "theoretical_basis": ""
  },
