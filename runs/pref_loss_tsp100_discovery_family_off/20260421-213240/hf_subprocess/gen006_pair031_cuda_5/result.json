  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_logsigmoid_advantage_gap_weighted_avg_clamp_entropy_var_reciprocal_safe",
    "intuition": "Same as original but safely handles missing entropy keys by substituting zero tensors, preserving original loss behavior and stability.",
    "pseudocode": "x = clamp(alpha * (log_prob_w - log_prob_l) + lambda * advantage_gap, -20, 20)\nloss = -logsigmoid(x)\nweighted_loss = loss * weight\nclamped_loss = clamp(weighted_loss, 0, max_clip)\nloss_mean = sum(clamped_loss) / (sum(weight) + eps)\nentropy_w = batch.get('entropy_w', zeros)\nentropy_l = batch.get('entropy_l', zeros)\nentropy_products = entropy_w * entropy_l\nentropy_mean = sum(weight * entropy_products) / (sum(weight) + eps)\nentropy_diff = entropy_products - entropy_mean\nentropy_variance = sum(weight * entropy_diff^2) / (sum(weight) + eps)\nentropy_reg = lambda_entropy / (1 + entropy_variance + eps)\nfinal_loss = loss_mean + entropy_reg\nreturn final_loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_entropy_var_reciprocal_reg",
      "link_family": "logsigmoid",
      "agg_family": "weighted_avg_clamp_reciprocal_entropy_var_reg",
      "constraint_family": "normalization_entropy_variance_reciprocal",
      "other_hparams": "alpha, lambda, max_clip, eps"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "mul",
      "add",
      "sub",
      "neg",
      "div",
      "ones_like",
      "zeros_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    lambda_entropy = float(extra.get('lambda', extra.get('hyperparams', {}).get('lambda', 0.1)))\n    max_clip = float(extra.get('max_clip', 10.0))\n\n    entropy_w = batch.get('entropy_w', lpw.new_zeros(lpw.shape))\n    entropy_l = batch.get('entropy_l', lpw.new_zeros(lpw.shape))\n\n    x = ops.add(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(lambda_entropy, advantage_gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss, weight)\n    clamped_loss = ops.clamp(weighted_loss, 0.0, max_clip)\n    loss_mean = ops.div(ops.sum(clamped_loss), ops.add(ops.sum(weight), eps))\n\n    entropy_products = ops.mul(entropy_w, entropy_l)\n    entropy_mean = ops.div(ops.sum(ops.mul(weight, entropy_products)), ops.add(ops.sum(weight), eps))\n    entropy_diff = ops.sub(entropy_products, entropy_mean)\n    entropy_variance = ops.div(ops.sum(ops.mul(weight, ops.mul(entropy_diff, entropy_diff))), ops.add(ops.sum(weight), eps))\n    entropy_reg = ops.div(lambda_entropy, ops.add(ops.add(ops.ones_like(entropy_variance), entropy_variance), eps))\n\n    final_loss = ops.add(loss_mean, entropy_reg)\n    return final_loss",
    "theoretical_basis": ""
  },
