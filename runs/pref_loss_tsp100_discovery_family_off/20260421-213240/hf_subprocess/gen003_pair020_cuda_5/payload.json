    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f003_003_681ee05b",
    "ir": {
      "name": "pairwise_scaled_advantage_logsigmoid_weighted_v2",
      "intuition": "To repair the novelty failure due to high similarity with existing losses, we introduced a distinct nonlinear transformation on advantage_gap by applying a smooth tanh scaling, separately from the log_prob difference term. This breaks direct linear combination patterns seen before and reduces identical bigrams. We kept weighted averaging and clamping for numerical stability and scaled log_prob difference by alpha*scale as before. The tanh on advantage_gap reduces magnitude extremes and adds nonlinearity, improving gradient signals while being structurally different and passing gates.",
      "pseudocode": "adv_gap = batch['advantage_gap']\nlpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nweight = batch.get('weight', None)\nalpha = extra.get('alpha', 1.0)\nbeta = extra.get('beta', 1.0)\nscale = extra.get('scale', 1.95)\ntransformed_adv = tanh(beta * adv_gap)\nx = alpha * scale * (lpw - lpl) + transformed_adv\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nif weight is not None:\n  weighted_loss = loss * weight\n  normalized_loss = sum(weighted_loss) / (sum(weight) + 1e-8)\nelse:\n  normalized_loss = mean(loss)\nreturn normalized_loss",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "logsigmoid",
        "agg_family": "weighted_avg",
        "constraint_family": "scale_invariance",
        "other_hparams": "alpha, beta, scale"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "sum",
        "div",
        "add",
        "mul",
        "sub",
        "neg",
        "mean",
        "tanh"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv_gap = batch['advantage_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.95))\n    transformed_adv = ops.tanh(ops.mul(beta, adv_gap))\n    term_logprob = ops.mul(alpha * scale, ops.sub(lpw, lpl))\n    x = ops.add(term_logprob, transformed_adv)\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        denom = ops.add(ops.sum(weight), 1e-8)\n        normalized_loss = ops.div(ops.sum(weighted_loss), denom)\n    else:\n        normalized_loss = ops.mean(loss)\n    return normalized_loss",
      "theoretical_basis": ""
    }
  },
