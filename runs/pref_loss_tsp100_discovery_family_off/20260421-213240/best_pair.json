  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rankprob_advantage_blend_weighted_logsumexp_reg_safe",
    "intuition": "Compute a stable pairwise ranking loss combining log probability differences and advantages, with entropy regularization for robustness, adding numerical clamps and safe defaults.",
    "pseudocode": "eps = 1e-12\nlpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nweight = batch['weight']\nadv_w = batch['advantage_w']\n\nalpha, beta, gamma, scale extracted from extra\n\nlogits = alpha * scale * (lpw - lpl) + beta * adv_w\nlogits_clamped = clamp(logits, -20, 20)\nmax_logits = max(0, logits_clamped)\nsum_exp = exp(0 - max_logits) + exp(logits_clamped - max_logits)\nlogsumexp_vals = max_logits + log(clamp(min=eps)(sum_exp))\nloss_terms = -logits_clamped + logsumexp_vals\nweighted_loss = loss_terms * weight\nagg_loss = sum(weighted_loss)\n\nweighted_adv = weight * adv_w\nadv_sum = sum(weighted_adv) + eps\nadv_prob = weighted_adv / adv_sum\nadv_entropy = -sum(adv_prob * log(clamp(min=eps)(adv_prob)))\nreg_loss = gamma * adv_entropy\nfinal_loss = agg_loss + reg_loss\nreturn final_loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_rankprob",
      "signal_family": "advantage_w_entropy_reg",
      "link_family": "logsumexp_manual",
      "agg_family": "weighted_sum",
      "constraint_family": "entropy_regularization"
    },
    "operators_used": [
      "exp",
      "log",
      "clamp",
      "sum",
      "mul",
      "add",
      "sub",
      "neg",
      "max",
      "zeros_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_w = batch['advantage_w']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.1)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n\n    logits = ops.add(ops.mul(alpha * scale, ops.sub(lpw, lpl)), ops.mul(beta, advantage_w))\n    logits = ops.clamp(logits, -20.0, 20.0)\n\n    zeros = ops.zeros_like(logits)\n    max_logits = ops.max(zeros, logits)\n    sum_exp = ops.add(ops.exp(ops.sub(zeros, max_logits)), ops.exp(ops.sub(logits, max_logits)))\n    sum_exp = ops.clamp(sum_exp, min=eps)\n    logsumexp_vals = ops.add(max_logits, ops.log(sum_exp))\n\n    loss_terms = ops.add(ops.neg(logits), logsumexp_vals)\n\n    weighted_loss = ops.mul(loss_terms, weight)\n    agg_loss = ops.sum(weighted_loss)\n\n    weighted_adv = ops.mul(weight, advantage_w)\n    adv_sum = ops.sum(weighted_adv) + eps\n    adv_prob = ops.div(weighted_adv, adv_sum)\n\n    adv_prob_safe = ops.clamp(adv_prob, min=eps)\n    adv_entropy = ops.neg(ops.sum(ops.mul(adv_prob_safe, ops.log(adv_prob_safe))))\n\n    reg_loss = ops.mul(gamma, adv_entropy)\n\n    final_loss = ops.add(agg_loss, reg_loss)\n    return final_loss.mean()",
    "theoretical_basis": ""
  },
