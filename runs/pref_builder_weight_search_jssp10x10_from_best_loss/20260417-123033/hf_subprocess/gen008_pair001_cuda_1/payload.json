    "ir": {
      "name": "all_pairs_gap_regret_blend_v2",
      "intuition": "Weight all pairs by normalized positive gap blended with a sigmoid of rank difference, modulated by instance regret max powered by gamma, providing a new instance-conditioned regret blend paradigm under full all-pairs topology.",
      "implementation_hint": {
        "expects": [
          "objective",
          "rank",
          "instance_obj_std",
          "instance_regret_max"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "gap_regret_blend",
        "constraint_family": "clamp_only"
      },
      "operators_used": [
        "all_pairs",
        "sigmoid",
        "clamp",
        "div",
        "sub",
        "mul",
        "pow",
        "exp"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    rank = feature_cache['rank']\n    instance_obj_std = feature_cache['instance_obj_std']\n    instance_regret_max = feature_cache['instance_regret_max']\n    eps = 1e-6\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_gap_regret_blend_v2', 'weight_family': 'gap_regret_blend'})\n    gap = (objective[b_idx, loser_idx] - objective[b_idx, winner_idx]).clamp_min(0.0)\n    norm_gap = gap / instance_obj_std[b_idx].clamp_min(eps)\n    rank_diff = rank[b_idx, loser_idx] - rank[b_idx, winner_idx]\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 4.0))\n    gamma = float(extra.get('gamma', 1.0))\n    base_weight = norm_gap.pow(alpha) * (instance_regret_max[b_idx].clamp_min(eps).pow(gamma))\n    blend = 1.0 / (1.0 + (-(beta * rank_diff)).exp())\n    raw_weight = base_weight * blend + 0.05 * (instance_regret_max[b_idx].clamp_min(eps).pow(gamma * 0.5))\n    weight = raw_weight.clamp(0.1, 3.5)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_gap_regret_blend_v2', 'weight_family': 'gap_regret_blend'})"
    }
  },
  "f_entry": {
    "id": "fseed_000_4bb86b21",
    "ir": {
      "name": "refined_hyperparameter_tuning_M2_v3_unique",
      "intuition": "To reduce similarity to the previous version, I replaced the L2 norm normalization with a stable L1 norm-based normalization (mean absolute advantage_gap), removed tanh to avoid duplicating a smooth transform, and replaced the logsigmoid link with sigmoid and its negative log. This switched to a different smooth margin margin style. Also added a small epsilon in denominator for numeric stability. These changes preserve the pairwise margin paradigm and use advantage_gap, but the math shape and key ops differ significantly, improving novelty while maintaining efficacy.",
      "pseudocode": "epsilon=1e-6\nnorm_adv = mean(abs(advantage_gap))\nnorm_adv = max(norm_adv, epsilon)\ndiff = (log_prob_w - log_prob_l) / norm_adv\nloss = -log(sigmoid(diff))\nweighted_loss = loss * weight\nreturn sum(weighted_loss) / max(sum(weight), epsilon)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "sigmoid",
        "agg_family": "weighted_sum_normalized",
        "constraint_family": "symmetric_smooth"
      },
      "operators_used": [
        "sigmoid",
        "log",
        "neg",
        "mul",
        "div",
        "sub",
        "sum",
        "mean",
        "abs",
        "maximum"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    abs_adv = ops.abs(advantage_gap)\n    mean_abs_adv = ops.mean(abs_adv)\n    norm_adv = ops.maximum(mean_abs_adv, epsilon)\n    diff = ops.div(ops.sub(lpw, lpl), norm_adv)\n    sigmoid_diff = ops.sigmoid(diff)\n    loss = ops.neg(ops.log(sigmoid_diff))\n    weighted_loss = ops.mul(loss, weight)\n    loss_sum = ops.sum(weighted_loss)\n    weight_sum = ops.sum(weight)\n    return ops.div(loss_sum, ops.maximum(weight_sum, epsilon))",
      "theoretical_basis": ""
    }
  },
