  "g_ir": {
    "name": "all_pairs_margin_rank_blend_sqrt_range_tiezone",
    "intuition": "Reweight all pairs by positive normalized margin blended with rank differences using instance_obj_range, applying tie-zone filtering to zero near-equal margin pairs for stability while preserving pairwise topology and clamp-based bounds.",
    "implementation_hint": {
      "expects": [
        "objective",
        "rank",
        "instance_obj_range",
        "instance_regret_std"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "margin_rank_blend",
      "constraint_family": "tie_zone"
    },
    "operators_used": [
      "all_pairs",
      "clamp",
      "sub",
      "sqrt",
      "div",
      "sigmoid",
      "mul",
      "pow",
      "abs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    rank = feature_cache['rank']\n    instance_obj_range = feature_cache['instance_obj_range']\n    instance_regret_std = feature_cache['instance_regret_std']\n    eps = 1e-6\n    tie_zone = float(extra.get('tie_zone', 0.05))\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_margin_rank_blend_sqrt_range_tiezone', 'weight_family': 'margin_rank_blend'})\n    margin_raw = (objective[b_idx, loser_idx] - objective[b_idx, winner_idx]).clamp_min(0.0)\n    norm_margin = margin_raw / instance_obj_range[b_idx].clamp_min(eps)\n    scaled_margin = norm_margin.sqrt()\n    scaled_margin = scaled_margin * instance_regret_std[b_idx].clamp_min(eps)\n    rank_diff = rank[b_idx, loser_idx] - rank[b_idx, winner_idx]\n    beta = float(extra.get('beta', 6.0))\n    blend = 1.0 / (1.0 + (-beta * rank_diff * instance_regret_std[b_idx].clamp_min(eps)).exp())\n    instance_modulation = instance_regret_std[b_idx].clamp_min(eps).sqrt()\n    raw_weight = scaled_margin * blend * instance_modulation\n    # Tie-zone filtering: zero weights when normalized margin below tie_zone\n    raw_weight = raw_weight * (norm_margin > tie_zone).to(dtype=raw_weight.dtype)\n    weight = raw_weight.clamp(min=0.15, max=3.0)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_margin_rank_blend_sqrt_range_tiezone', 'weight_family': 'margin_rank_blend'})"
  },
  "f_ir": {
    "name": "refined_hyperparameter_tuning_M2_v3_unique",
    "intuition": "To reduce similarity to the previous version, I replaced the L2 norm normalization with a stable L1 norm-based normalization (mean absolute advantage_gap), removed tanh to avoid duplicating a smooth transform, and replaced the logsigmoid link with sigmoid and its negative log. This switched to a different smooth margin margin style. Also added a small epsilon in denominator for numeric stability. These changes preserve the pairwise margin paradigm and use advantage_gap, but the math shape and key ops differ significantly, improving novelty while maintaining efficacy.",
    "pseudocode": "epsilon=1e-6\nnorm_adv = mean(abs(advantage_gap))\nnorm_adv = max(norm_adv, epsilon)\ndiff = (log_prob_w - log_prob_l) / norm_adv\nloss = -log(sigmoid(diff))\nweighted_loss = loss * weight\nreturn sum(weighted_loss) / max(sum(weight), epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "weighted_sum_normalized",
      "constraint_family": "symmetric_smooth"
    },
    "operators_used": [
      "sigmoid",
      "log",
      "neg",
      "mul",
      "div",
      "sub",
      "sum",
      "mean",
      "abs",
      "maximum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    abs_adv = ops.abs(advantage_gap)\n    mean_abs_adv = ops.mean(abs_adv)\n    norm_adv = ops.maximum(mean_abs_adv, epsilon)\n    diff = ops.div(ops.sub(lpw, lpl), norm_adv)\n    sigmoid_diff = ops.sigmoid(diff)\n    loss = ops.neg(ops.log(sigmoid_diff))\n    weighted_loss = ops.mul(loss, weight)\n    loss_sum = ops.sum(weighted_loss)\n    weight_sum = ops.sum(weight)\n    return ops.div(loss_sum, ops.maximum(weight_sum, epsilon))",
    "theoretical_basis": ""
  },
