  "ir": {
    "name": "stabilized_clamped_logsigmoid_advantage_loss",
    "intuition": "This loss stabilizes training by computing a margin between the log probabilities of the winning and losing sequences, scaled by alpha and adjusted by a detached cost gap to incorporate quality difference. The margin is clamped to prevent extreme values causing numerical instability. Applying the negative logsigmoid ensures a smooth, differentiable loss that penalizes incorrect rankings softly. Weighting the loss enables emphasis on important pairs. Mean aggregation normalizes the loss across the batch. This clear explanation aligns with the loss implementation and highlights the reasoning behind each step.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    margin = alpha * (lpw - lpl) - 0.05 * gap\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
    "hyperparams": {
