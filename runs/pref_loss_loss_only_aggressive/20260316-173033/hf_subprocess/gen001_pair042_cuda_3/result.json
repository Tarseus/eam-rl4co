  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_rank_gap_tanh_advantage_repaired_sum",
    "intuition": "This loss retains the pairwise log-probability difference and tanh-scaled delta_rank scoring but changes the aggregation from mean to sum. Summation emphasizes the total accumulated loss over the batch instead of the average, allowing more flexible weighting and interpretation in certain training regimes.",
    "pseudocode": "delta = log_prob_w - log_prob_l\nrank_scale = tanh(alpha * delta_rank)\nsigmoid_delta = sigmoid(delta)\nloss = relu(1 - rank_scale * sigmoid_delta) * weight\nfinal_loss = sum(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "log_prob",
      "link_family": "sigmoid_tanh",
      "agg_family": "sum",
      "constraint_family": "relu_nonnegative"
    },
    "operators_used": [
      "sigmoid",
      "tanh",
      "relu",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta = ops.sub(lpw, lpl)\n    rank_scale = ops.tanh(ops.mul(alpha, delta_rank))\n    sigmoid_delta = ops.sigmoid(delta)\n    loss = ops.relu(ops.sub(1, ops.mul(rank_scale, sigmoid_delta)))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
