        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale1 = 1.9496803035382082\n    scale2 = 0.6752757766189963\n    scale3 = 1.8664639436736863\n    scale = (scale1 + scale2 + scale3) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    x = ops.sub(ops.mul(ops.mul(alpha, scale), ops.sub(lpw, lpl)), ops.mul(0.05, gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss = ops.relu(loss)\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n        loss_sum = ops.sum(loss)\n        weight_sum = ops.sum(weight)\n        normalized_loss = loss_sum / (weight_sum + 1e-12)\n        return normalized_loss\n    else:\n        return ops.mean(loss)",
