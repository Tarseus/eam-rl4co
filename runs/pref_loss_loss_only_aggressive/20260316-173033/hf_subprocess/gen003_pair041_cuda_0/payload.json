    "ir": {
      "name": "Combined_E1_Loss_MeanAgg_ReLU_Normalized",
      "intuition": "Normalize the weighted loss by the sum of weights to ensure consistent scale regardless of batch weighting variations, preserving the relu non-negative activation and stable margin with detached cost gap.",
      "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = (1.9496803035382082 + 0.6752757766189963 + 1.8664639436736863) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) - 0.05 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss = ops.relu(loss)\n    if weight is not None:\n        loss = loss * weight\n        loss_sum = ops.sum(loss)\n        weight_sum = ops.sum(weight)\n        loss = loss_sum / (weight_sum + 1e-12)\n    else:\n        loss = ops.mean(loss)\n    return loss",
