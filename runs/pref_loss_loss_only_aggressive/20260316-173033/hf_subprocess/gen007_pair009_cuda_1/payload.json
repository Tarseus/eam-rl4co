    "ir": {
      "name": "Clamped_Logsigmoid_Advantage_Sum_With_DeltaRank_Weight",
      "intuition": "Changed aggregation from mean to sum to comply with the required operator contract and ensure the agg_family differs as required. This preserves the core margin ranking loss with clamping and delta_rank quality signal, maintaining detachment of quality for gradient stability. Summation aggregation aligns with standard pairwise loss practices and follows the parent tag constraints, resolving the gate failure caused by agg_family_not_changed.",
      "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_rank = batch['delta_rank']\n    margin = alpha * (lpw - lpl) - 0.1 * delta_rank.detach()\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        loss = loss * weight\n    return loss.sum()",
      "hyperparams": {
        "paradigm_family": "pairwise",
