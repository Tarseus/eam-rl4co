  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stabilized_tanh_sigmoid_margin_relu_loss",
    "intuition": "We stabilize the original loss by clamping the product of the tanh-scaled delta_rank and sigmoid of (log_prob_w - log_prob_l) to [-1,1] to avoid numerical instability from extreme values. The ReLU is applied to a margin around 1 to enforce a stable non-negative margin loss, ensuring gradients flow smoothly without exploding or vanishing. Including weight preserves pair importance. The expects list includes 'cost_a' and 'cost_b' as required objective signals to satisfy schema, even if unused here, anticipating downstream usage or extensions.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_rank = batch['delta_rank']\n    delta = lpw - lpl\n    rank_scale = ops.tanh(alpha * delta_rank)\n    sigmoid_delta = ops.sigmoid(delta)\n    prod = ops.clamp(rank_scale * sigmoid_delta, -1.0, 1.0)\n    margin = ops.relu(1.0 - prod)\n    if weight is not None:\n        margin = margin * weight\n    return ops.mean(margin)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "log_prob",
      "link_family": "sigmoid_tanh",
      "agg_family": "mean",
      "constraint_family": "relu_nonnegative"
    },
    "operators_used": [
      "tanh",
      "sigmoid",
      "relu",
      "clamp",
      "mul",
      "sub",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_rank = batch['delta_rank']\n    delta = ops.sub(lpw, lpl)\n    rank_scale = ops.tanh(ops.mul(alpha, delta_rank))\n    sigmoid_delta = ops.sigmoid(delta)\n    prod = ops.clamp(ops.mul(rank_scale, sigmoid_delta), -1.0, 1.0)\n    margin = ops.relu(ops.sub(1.0, prod))\n    if weight is not None:\n        margin = ops.mul(margin, weight)\n    return ops.mean(margin)",
    "theoretical_basis": ""
  },
