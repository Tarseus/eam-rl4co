      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale_parent1 = 1.9496803035382082\n    scale_parent2 = 0.6752757766189963\n    scale_parent3 = 1.8664639436736863\n    scale = (scale_parent1 + scale_parent2 + scale_parent3) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    margin = ops.sub(ops.mul(ops.mul(alpha, scale), ops.sub(lpw, lpl)), ops.mul(0.05, gap))\n    margin_clamped = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin_clamped))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.sum(loss)",
