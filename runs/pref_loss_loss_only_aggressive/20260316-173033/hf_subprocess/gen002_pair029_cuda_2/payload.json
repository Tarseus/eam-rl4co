    "ir": {
      "name": "Combined_E1_Loss_SumAgg_Stable",
      "intuition": "This loss improves numerical stability and gradient quality by combining log-probability differences between winner and loser with a detached cost gap. We scale the log-prob difference with a tuned average factor and a hyperparameter alpha, and subtract a small fraction of the detached cost gap to incorporate objective signal without backpropagating through costs. To prevent instability, we clamp the combined margin between -20 and 20 before applying a negative logsigmoid, ensuring smooth, stable gradients. Summing the loss over pairs provides a strong, interpretable aggregate, while optional weighting allows flexible importance scaling.",
      "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = (1.9496803035382082 + 0.6752757766189963 + 1.8664639436736863) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    margin = alpha * scale * (lpw - lpl) - 0.05 * gap\n    margin_clamped = ops.clamp(margin, -20.0, 20.0)\n    loss = -ops.logsigmoid(margin_clamped)\n    if weight is not None:\n        loss = loss * weight\n    return ops.sum(loss)",
      "hyperparams": {
