        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_regret = batch['delta_regret'].detach()\n    margin = ops.add(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(0.1, delta_regret))\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        norm = ops.clamp(ops.sum(weight), 1e-6, 1e6)\n        return ops.div(ops.sum(weighted_loss), norm)\n    else:\n        return ops.mean(loss)",
