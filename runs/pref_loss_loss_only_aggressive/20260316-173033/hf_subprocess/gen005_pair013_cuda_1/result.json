  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "normalized_weighted_logsigmoid_advantage_loss_with_delta_regret",
    "intuition": "Adjusted the loss to use 'delta_regret' as the quality signal instead of cost gap, introduced a positive margin offset to improve gradient signal, and changed aggregation to normalize the weighted loss sum by the sum of weights, ensuring stable gradients and passing novelty. This avoids previous near-duplicate signals and adds meaningful improvement by leveraging delta_regret detached for stable training.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_regret = batch['delta_regret'].detach()\n    margin = alpha * (lpw - lpl) + 0.1 * delta_regret\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = -ops.logsigmoid(margin)\n    if weight is not None:\n        weighted_loss = loss * weight\n        normalization = ops.sum(weight)\n        return ops.sum(weighted_loss) / ops.clamp(normalization, 1e-6, 1e6)\n    else:\n        return ops.mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "advantage",
      "link_family": "logsigmoid_margin",
      "agg_family": "normalized_sum",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "neg",
      "clamp",
      "mul",
      "add",
      "sum",
      "mean",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_regret = batch['delta_regret'].detach()\n    margin = ops.add(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(0.1, delta_regret))\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        norm = ops.clamp(ops.sum(weight), 1e-6, 1e6)\n        return ops.div(ops.sum(weighted_loss), norm)\n    else:\n        return ops.mean(loss)",
    "theoretical_basis": ""
  },
