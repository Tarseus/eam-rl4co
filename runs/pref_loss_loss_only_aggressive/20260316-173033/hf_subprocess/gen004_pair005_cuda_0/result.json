  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "Stable_Pairwise_LogSigmoid_Advantage_Loss",
    "intuition": "This loss function produces a numerically stable pairwise ranking loss by comparing the log probabilities of the winning and losing sequences, scaled by a hyperparameter alpha. It incorporates a detached advantage signal computed as the difference in costs (cost_b - cost_a) to adjust the margin, helping the model focus learning on pairs with meaningful cost differences. To prevent numerical instabilities during training, the margin expression is clipped to the range [-20, 20] before applying the log-sigmoid function. Optionally, per-example weights can modulate the loss contribution, and the final scalar loss is the mean over the batch. This approach stabilizes training by controlling gradients and leverages the advantage signal for informed weighting, improving convergence and interpretability.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    advantage = (cost_b - cost_a).detach()\n    margin = alpha * (lpw - lpl) - 0.05 * advantage\n    margin = clamp(margin, -20, 20)\n    loss = -logsigmoid(margin)\n    if weight is not None:\n        loss = loss * weight\n    return mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "advantage",
      "link_family": "logsigmoid_margin",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    advantage = ops.sub(cost_b, cost_a).detach()\n    margin = ops.sub(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(0.05, advantage))\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
