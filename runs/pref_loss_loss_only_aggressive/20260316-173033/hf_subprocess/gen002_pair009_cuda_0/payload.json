    "ir": {
      "name": "Combined_E1_Loss_MeanOfSqrtAgg",
      "intuition": "This variant aggregates pairwise losses by taking the mean of the square root of individual losses, offering a softer penalization that can reduce the impact of outliers compared to mean aggregation. It preserves the scaled logits difference with detached cost gap and clamping for numerical stability, maintaining the stable ranking signal while introducing a different aggregation structure.",
      "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = (1.9496803035382082 + 0.6752757766189963 + 1.8664639436736863) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) - 0.05 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    loss_sqrt = ops.sqrt(loss + 1e-12)\n    return loss_sqrt.mean()",
      "hyperparams": {
        "paradigm_family": "pairwise",
        "signal_family": "advantage",
        "link_family": "logsigmoid_margin",
        "agg_family": "mean_of_sqrt",
        "constraint_family": "none"
      },
      "operators_used": [
        "logsigmoid",
