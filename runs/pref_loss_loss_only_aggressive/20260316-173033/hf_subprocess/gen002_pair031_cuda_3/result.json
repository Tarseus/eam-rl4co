  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stabilized_clamped_logsigmoid_advantage_loss",
    "intuition": "This loss function computes a pairwise preference loss by comparing log probabilities of winning and losing sequences (log_prob_w and log_prob_l). To ensure numerical stability, the scaled difference is clamped between -20 and 20 before applying the logsigmoid function. The cost gap (cost_b - cost_a) is detached to prevent gradients flowing through cost calculations, serving as a baseline advantage signal that modulates the margin. Weighting by the optional 'weight' tensor allows for importance weighting of pairs. The sum aggregation yields a scalar loss suitable for optimization. The repair added a clear, detailed intuition explaining the numerical stability fix, the use of the detached cost gap for advantage modulation, and the gating on weights, addressing the previous missing intuition failure.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = (1.9496803035382082 + 0.6752757766189963 + 1.8664639436736863) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) - 0.05 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.sum()",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "advantage",
      "link_family": "logsigmoid_margin",
      "agg_family": "sum",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "neg",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale_parent1 = 1.9496803035382082\n    scale_parent2 = 0.6752757766189963\n    scale_parent3 = 1.8664639436736863\n    scale = (scale_parent1 + scale_parent2 + scale_parent3) / 3\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    x = ops.sub(ops.mul(ops.mul(alpha, scale), ops.sub(lpw, lpl)), ops.mul(0.05, gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
