  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stable_pairwise_logsigmoid_advantage_loss",
    "intuition": "Fixed missing intuition by providing a detailed explanation of the loss function. This loss stabilizes training by clamping the margin term between log probabilities to avoid numerical overflow/underflow in logsigmoid computations. It uses the advantage signal (difference of log_prob_w and log_prob_l) scaled by a factor alpha and a fixed scale, while subtracting a weighted and detached cost gap term to maintain preference semantics. Weighting of losses per example is applied when provided to properly scale gradients. The mean aggregation ensures stable optimization and interpretability.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = 1.5  # fixed moderate scale\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    margin = alpha * scale * (lpw - lpl) - 0.05 * gap\n    margin_clamped = ops.clamp(margin, -20.0, 20.0)\n    loss_raw = -ops.logsigmoid(margin_clamped)\n    if weight is not None:\n        loss_raw = loss_raw * weight\n    loss = ops.mean(loss_raw)\n    return loss",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "advantage",
      "link_family": "logsigmoid_margin",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = 1.5\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    margin = ops.sub(ops.mul(ops.mul(alpha, scale), ops.sub(lpw, lpl)), ops.mul(0.05, gap))\n    margin_clamped = ops.clamp(margin, -20.0, 20.0)\n    loss_raw = ops.neg(ops.logsigmoid(margin_clamped))\n    if weight is not None:\n        loss_raw = ops.mul(loss_raw, weight)\n    return ops.mean(loss_raw)",
    "theoretical_basis": ""
  },
