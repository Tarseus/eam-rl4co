    "ir": {
      "name": "normalized_tanh_sigmoid_rank_loss",
      "intuition": "Introducing a normalization constraint by dividing the weighted loss by the sum of weights ensures scale-invariance and consistent loss magnitude across batches with varying total weight, stabilizing training dynamics.",
      "pseudocode": "delta = log_prob_w - log_prob_l\nrank_scale = tanh(alpha * delta_rank)\nsigmoid_delta = sigmoid(delta)\nloss_raw = relu(1 - rank_scale * sigmoid_delta) * weight\nloss = sum(loss_raw) / (sum(weight) + eps)\nreturn loss",
      "hyperparams": {
        "paradigm_family": "pairwise_ranking",
        "signal_family": "log_prob",
        "link_family": "sigmoid_tanh",
        "agg_family": "normalized_sum",
        "constraint_family": "normalization"
      },
      "operators_used": [
        "sigmoid",
        "tanh",
        "relu",
        "sum",
        "div"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "delta_rank"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    if weight is None:\n        weight = ops.ones_like(lpw)\n    delta = ops.sub(lpw, lpl)\n    rank_scale = ops.tanh(ops.mul(alpha, delta_rank))\n    sigmoid_delta = ops.sigmoid(delta)\n    loss_raw = ops.relu(ops.sub(1.0, ops.mul(rank_scale, sigmoid_delta)))\n    weighted_loss = ops.mul(loss_raw, weight)\n    weight_sum = ops.sum(weight)\n    eps = 1e-8\n    loss = ops.div(ops.sum(weighted_loss), ops.add(weight_sum, eps))\n    return loss",
      "theoretical_basis": ""
    },
