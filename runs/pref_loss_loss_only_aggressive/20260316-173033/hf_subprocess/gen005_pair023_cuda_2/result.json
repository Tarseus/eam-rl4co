  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "Normalized_ReLU_Clamped_Logsigmoid_Advantage_Loss",
    "intuition": "Normalize the weighted loss by the sum of weights to ensure scale-invariance and apply ReLU to keep non-negative loss values, with margin clamping for stability.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    margin = alpha * (lpw - lpl) - 0.05 * gap\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    loss = ops.relu(loss)\n    if weight is not None:\n        weighted_loss = loss * weight\n        norm = ops.sum(weight)\n        normalized_loss = ops.sum(weighted_loss) / norm.clamp_min(1e-8)\n        return normalized_loss\n    else:\n        return ops.mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "advantage",
      "link_family": "logsigmoid_margin",
      "agg_family": "normalized_sum",
      "constraint_family": "relu_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "neg",
      "relu",
      "sum",
      "mean",
      "div",
      "clamp_min"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    margin = ops.sub(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(0.05, gap))\n    margin = ops.clamp(margin, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(margin))\n    loss = ops.relu(loss)\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        norm = ops.sum(weight).clamp_min(1e-8)\n        return ops.div(ops.sum(weighted_loss), norm)\n    else:\n        return ops.mean(loss)",
    "theoretical_basis": ""
  },
