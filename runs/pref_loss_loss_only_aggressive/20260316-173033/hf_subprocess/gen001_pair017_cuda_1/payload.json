    "ir": {
      "name": "Combined_E1_Loss_Normalized",
      "intuition": "This loss adds explicit normalization by scaling the log-probability difference by the inverse of the sum of the absolute differences, enforcing scale invariance and symmetry in the score differences before applying clamping and logsigmoid. This helps to stabilize gradients and make the loss less sensitive to absolute score magnitudes while preserving preference ranking.",
      "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    diff = lpw - lpl\n    norm_factor = ops.clamp(ops.abs(diff), min=1e-6).mean()  # normalize by mean absolute diff\n    scaled_diff = diff / norm_factor\n    scale_parent1 = 1.9496803035382082\n    scale_parent2 = 0.6752757766189963\n    scale_parent3 = 1.8664639436736863\n    scale = (scale_parent1 + scale_parent2 + scale_parent3) / 3\n    x = alpha * scale * scaled_diff - 0.05 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
      "hyperparams": {
        "paradigm_family": "pairwise",
        "signal_family": "logprob_cost_gap",
        "link_family": "logsigmoid",
        "agg_family": "mean",
