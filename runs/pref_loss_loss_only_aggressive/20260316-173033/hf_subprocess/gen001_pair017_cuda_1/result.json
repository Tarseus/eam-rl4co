  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "Combined_E1_Loss_Normalized",
    "intuition": "This loss adds explicit normalization by scaling the log-probability difference by the inverse of the sum of the absolute differences, enforcing scale invariance and symmetry in the score differences before applying clamping and logsigmoid. This helps to stabilize gradients and make the loss less sensitive to absolute score magnitudes while preserving preference ranking.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    diff = lpw - lpl\n    norm_factor = ops.clamp(ops.abs(diff), min=1e-6).mean()  # normalize by mean absolute diff\n    scaled_diff = diff / norm_factor\n    scale_parent1 = 1.9496803035382082\n    scale_parent2 = 0.6752757766189963\n    scale_parent3 = 1.8664639436736863\n    scale = (scale_parent1 + scale_parent2 + scale_parent3) / 3\n    x = alpha * scale * scaled_diff - 0.05 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "logprob_cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "neg",
      "mean",
      "abs",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = ops.sub(cost_b, cost_a).detach()\n    diff = ops.sub(lpw, lpl)\n    abs_diff = ops.abs(diff)\n    norm_factor = ops.clamp(abs_diff.mean(), min=1e-6)\n    scaled_diff = ops.div(diff, norm_factor)\n    scale_parent1 = 1.9496803035382082\n    scale_parent2 = 0.6752757766189963\n    scale_parent3 = 1.8664639436736863\n    scale = (scale_parent1 + scale_parent2 + scale_parent3) / 3\n    x = ops.sub(ops.mul(ops.mul(alpha, scale), scaled_diff), ops.mul(0.05, gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
