  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stable_scaled_pairwise_logsigmoid_loss",
    "intuition": "To improve numerical stability and preserve meaningful preference semantics, the loss normalizes the difference of log probabilities and scales it by a quality signal (delta_rank). It uses logsigmoid to stabilize gradients, clamps the scaled difference to avoid extreme values causing overflow, and applies weighting if present. Combining normalized and scaled differences provides robustness, and the formulation ensures valid expected inputs and avoids instability from large values.",
    "pseudocode": "diff = batch['log_prob_w'] - batch['log_prob_l']\ndelta_rank = batch['delta_rank']\nscaled_diff = diff * delta_rank\nscaled_diff_clamped = clamp(scaled_diff, min=-20, max=20)\nmean_diff = mean(diff)\nvar_diff = mean((diff - mean_diff)**2) + 1e-8\nnorm_diff = diff / sqrt(var_diff)\nnorm_diff_clamped = clamp(norm_diff, min=-10, max=10)\nloss = -logsigmoid(scaled_diff_clamped) + 0.5 * (-logsigmoid(norm_diff_clamped))\nif 'weight' in batch:\n    loss = loss * batch['weight']\nreturn mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "logprob_gap_delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "stabilized_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "mean",
      "clamp",
      "mul",
      "sub",
      "add",
      "sqrt"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    delta_rank = batch['delta_rank']\n    weight = batch['weight']\n\n    diff = ops.sub(log_prob_w, log_prob_l)\n    scaled_diff = ops.mul(diff, delta_rank)\n    scaled_diff_clamped = ops.clamp(scaled_diff, min=-20.0, max=20.0)\n\n    mean_diff = ops.mean(diff)\n    var_diff = ops.mean(ops.mul(ops.sub(diff, mean_diff), ops.sub(diff, mean_diff)))\n    var_diff = ops.add(var_diff, 1e-8)\n    norm_diff = ops.div(diff, ops.sqrt(var_diff))\n    norm_diff_clamped = ops.clamp(norm_diff, min=-10.0, max=10.0)\n\n    loss_scaled = ops.neg(ops.logsigmoid(scaled_diff_clamped))\n    loss_norm = ops.neg(ops.logsigmoid(norm_diff_clamped))\n    loss = ops.add(loss_scaled, ops.mul(loss_norm, 0.5))\n\n    loss_weighted = ops.mul(loss, weight)\n    return ops.mean(loss_weighted)",
    "theoretical_basis": ""
  },
