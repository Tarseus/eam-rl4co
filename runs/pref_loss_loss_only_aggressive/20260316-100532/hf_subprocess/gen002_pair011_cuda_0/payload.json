    "ir": {
      "name": "stable_scaled_pairwise_logsigmoid_loss_sum_aggregation",
      "intuition": "Preserving numerical stability and preference semantics, this loss normalizes and scales the difference of log probabilities using delta_rank, applies logsigmoid for gradient stability, clamps values to avoid overflow, weights by preference signals, and aggregates the per-pair losses by summation to emphasize the total accumulated preference loss.",
      "pseudocode": "diff = batch['log_prob_w'] - batch['log_prob_l']\ndelta_rank = batch['delta_rank']\nscaled_diff = diff * delta_rank\nscaled_diff_clamped = clamp(scaled_diff, min=-20, max=20)\nmean_diff = mean(diff)\nvar_diff = mean((diff - mean_diff)**2) + 1e-8\nnorm_diff = diff / sqrt(var_diff)\nnorm_diff_clamped = clamp(norm_diff, min=-10, max=10)\nloss = -logsigmoid(scaled_diff_clamped) + 0.5 * (-logsigmoid(norm_diff_clamped))\nif 'weight' in batch:\n    loss = loss * batch['weight']\nreturn sum(loss)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "logprob_gap_delta_rank",
        "link_family": "logsigmoid",
        "agg_family": "sum",
        "constraint_family": "stabilized_normalization"
      },
      "operators_used": [
        "logsigmoid",
        "sum",
        "clamp",
        "mul",
        "sub",
        "add",
        "sqrt"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "delta_rank"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    delta_rank = batch['delta_rank']\n    weight = batch['weight']\n\n    diff = ops.sub(log_prob_w, log_prob_l)\n    scaled_diff = ops.mul(diff, delta_rank)\n    scaled_diff_clamped = ops.clamp(scaled_diff, min=-20.0, max=20.0)\n\n    mean_diff = ops.mean(diff)\n    var_diff = ops.mean(ops.mul(ops.sub(diff, mean_diff), ops.sub(diff, mean_diff)))\n    var_diff = ops.add(var_diff, 1e-8)\n    norm_diff = ops.div(diff, ops.sqrt(var_diff))\n    norm_diff_clamped = ops.clamp(norm_diff, min=-10.0, max=10.0)\n\n    loss_scaled = ops.neg(ops.logsigmoid(scaled_diff_clamped))\n    loss_norm = ops.neg(ops.logsigmoid(norm_diff_clamped))\n    loss = ops.add(loss_scaled, ops.mul(loss_norm, 0.5))\n\n    loss_weighted = ops.mul(loss, weight)\n    return ops.sum(loss_weighted)",
      "theoretical_basis": ""
    },
