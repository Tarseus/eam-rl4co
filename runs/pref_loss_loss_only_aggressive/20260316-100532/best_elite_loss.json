      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch.get('cost_gap', None)\n    if cost_gap is not None:\n        modifier = ops.clamp(ops.zscore(cost_gap), min=0.0)\n        weight = ops.mul(weight, modifier)\n    diff = ops.sub(log_prob_l, log_prob_w)\n    weighted_diff = ops.mul(weight, diff)\n    loss = ops.sum(weighted_diff)\n    return loss",
