        "clamp",
        "exp",
        "sub",
        "mul",
        "neg",
        "sum",
        "maximum"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    clamped_adv = ops.clamp(advantage_gap, -1.0, 1.0)\n    margin_unclamped = ops.sub(ops.exp(ops.add(clamped_adv, 1.0)), 1.0)\n    margin = ops.clamp(margin_unclamped, 1.01, 5.0)\n    x_raw = ops.sub(lpw, lpl)\n    x = ops.mul(margin, x_raw)\n    x = ops.clamp(x, -10.0, 10.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss_weighted = ops.mul(loss, weight)\n    loss_mean = ops.div(ops.sum(loss_weighted), ops.maximum(ops.sum(weight), epsilon))\n    return loss_mean",
