      "pseudocode": "epsilon=1e-6\nclamped_adv = clamp(advantage_gap, -1, 1)\nmargin = clamp(exp(clamped_adv + 1) - 1, 1.01, 5)\nx = margin * (log_prob_w - log_prob_l)\nx = clamp(x, -10, 10)\nloss = -logsigmoid(x)\nloss_weighted = loss * weight\nreturn sum(loss_weighted) / max(sum(weight), epsilon)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "logsigmoid",
        "agg_family": "weighted_mean",
