    "ir": {
      "name": "builder_all_pairs_gap_regret_blend_instance_mad_std_clamp",
      "intuition": "Blend gap scaled by instance MAD with regret span scaled by instance regret std, using instance local statistics to weight pairs in all-pairs topology with stable clamping.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob",
          "obj_z",
          "rank",
          "regret",
          "instance_obj_mad",
          "instance_regret_std"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "gap_regret_blend",
        "constraint_family": "clamp_only"
      },
      "operators_used": [
        "all_pairs",
        "gap_regret_blend",
        "clamp",
        "nan_to_num"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    regret = feature_cache['regret']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_gap_regret_blend_instance_mad_std_clamp', 'weight_family': 'gap_regret_blend'})\n    eps = 1e-6\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_mad = feature_cache['instance_obj_mad']\n    instance_regret_std = feature_cache['instance_regret_std']\n    gap_scaled = gap / instance_obj_mad[b_idx].clamp_min(eps)\n    regret_span = (regret[b_idx, loser_idx] - regret[b_idx, winner_idx]) / instance_regret_std[b_idx].clamp_min(eps)\n    lambda_regret = float(extra.get('lambda_regret', 1.2))\n    beta_gap = float(extra.get('beta_gap', 1.0))\n    beta_regret = float(extra.get('beta_regret', 1.0))\n    # Weighted linear blend with configurable betas\n    raw_weight = (beta_gap * gap_scaled + lambda_regret * beta_regret * regret_span).clamp_min(0.0)\n    raw_weight = torch.nan_to_num(raw_weight, nan=0.0, posinf=0.0, neginf=0.0)\n    clamp_lo = float(extra.get('clamp_lo', 0.2))\n    clamp_hi = float(extra.get('clamp_hi', 3.5))\n    weight = raw_weight.clamp(clamp_lo, clamp_hi)\n    meta = {'builder': 'all_pairs_gap_regret_blend_instance_mad_std_clamp', 'weight_family': 'gap_regret_blend', 'constraint_family': 'clamp_only'}\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta=meta)"
    }
  },
