    "id": "fseed_000_9cfa032c",
    "ir": {
      "name": "weighted_advantage_exp_margin_logsigmoid_scaled_weighted_mean_loss_v7",
      "intuition": "Refined margin calculation to use a smoother exponential scaling of advantage_gap shifted and clamped to maintain positive margin above 1, ensuring strict monotonicity and preventing zero or near-zero margins that could cause swap violations. Reduced clamping range of advantage_gap to (-1,1) to avoid extreme exponentials and improved clamp of multiplier x to (-10,10) to prevent gradient explosion. These changes stabilize margin behavior and preserve pairwise ordering, resolving joint preference violation.",
      "pseudocode": "epsilon=1e-6\nclamped_adv = clamp(advantage_gap, -1, 1)\nmargin = clamp(exp(clamped_adv + 1) - 1, 1.01, 5)\nx = margin * (log_prob_w - log_prob_l)\nx = clamp(x, -10, 10)\nloss = -logsigmoid(x)\nloss_weighted = loss * weight\nreturn sum(loss_weighted) / max(sum(weight), epsilon)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "logsigmoid",
        "agg_family": "weighted_mean",
        "constraint_family": "exponential_margin_per_pair"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "exp",
        "sub",
        "mul",
        "neg",
        "sum",
        "maximum"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    clamped_adv = ops.clamp(advantage_gap, -1.0, 1.0)\n    margin_unclamped = ops.sub(ops.exp(ops.add(clamped_adv, 1.0)), 1.0)\n    margin = ops.clamp(margin_unclamped, 1.01, 5.0)\n    x_raw = ops.sub(lpw, lpl)\n    x = ops.mul(margin, x_raw)\n    x = ops.clamp(x, -10.0, 10.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss_weighted = ops.mul(loss, weight)\n    loss_mean = ops.div(ops.sum(loss_weighted), ops.maximum(ops.sum(weight), epsilon))\n    return loss_mean",
      "theoretical_basis": ""
    }
  },
