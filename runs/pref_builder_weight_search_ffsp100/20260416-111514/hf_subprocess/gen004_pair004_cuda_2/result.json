  "g_ir": {
    "name": "builder_all_pairs_margin_rank_blend_reweight_v1",
    "intuition": "Reweight all pairs by blending normalized margin and rank difference scaled by instance regret std and instance obj MAD, emphasizing confident pairs with smooth sigmoid weighting and tie-zone suppression.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob",
        "rank",
        "instance_obj_mad",
        "instance_log_prob_std",
        "instance_regret_std"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "margin_rank_blend",
      "constraint_family": "tiezone_clamp"
    },
    "operators_used": [
      "all_pairs",
      "sigmoid",
      "clamp",
      "abs",
      "pow",
      "sub",
      "div",
      "nan_to_num"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    rank = feature_cache['rank']\n    eps = 1e-6\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs', 'weight_family': 'margin_rank_blend', 'constraint_family': 'tiezone_clamp'})\n    margin_raw = log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]\n    instance_log_prob_std_b = feature_cache['instance_log_prob_std'][b_idx].clamp_min(eps)\n    margin_scaled = margin_raw / instance_log_prob_std_b\n    rank_span = (rank[b_idx, loser_idx] - rank[b_idx, winner_idx]).to(margin_scaled.dtype)\n    instance_regret_std_b = feature_cache['instance_regret_std'][b_idx].clamp_min(eps)\n    instance_obj_mad_b = feature_cache['instance_obj_mad'][b_idx].clamp_min(eps)\n    alpha = float(extra.get('alpha', 0.5))\n    beta = float(extra.get('beta', 3.0))\n    gamma = float(extra.get('gamma', 0.7))\n    # Sigmoid weighting on rank span to emphasize larger rank differences\n    rank_weight = 1.0 / (1.0 + (-beta * rank_span).exp())\n    margin_power = margin_scaled.abs().pow(gamma)\n    # Raw weight combines margin and rank info blended, modulated by instance regret std and obj MAD\n    raw_weight = (alpha * rank_weight / margin_power) * (instance_regret_std_b / instance_obj_mad_b)\n    raw_weight = raw_weight.nan_to_num(nan=0.0, posinf=0.0, neginf=0.0).clamp_min(0.0)\n    # Tie-zone suppression: zero weights where margin is too small\n    tiezone_threshold = float(extra.get('tiezone_threshold', 0.1))\n    tie_zone_mask = (margin_scaled.abs() > tiezone_threshold).to(raw_weight.dtype)\n    weight = (raw_weight * tie_zone_mask).clamp(float(extra.get('clamp_lo', 0.1)), float(extra.get('clamp_hi', 3.5)))\n    meta = {'builder': 'all_pairs', 'weight_family': 'margin_rank_blend', 'constraint_family': 'tiezone_clamp'}\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta=meta)"
  },
  "f_ir": {
    "name": "weighted_advantage_exp_margin_logsigmoid_scaled_weighted_mean_loss_v4",
    "intuition": "Replaced the linear scaling of (log_prob_w - log_prob_l) by normalizing advantage_gap with an exponential margin term to reduce similarity to prior losses. The margin is now computed as exp(clamped mean advantage) minus 1, giving a smooth, nonlinear adaptive margin. This avoids direct shift subtraction and linearly scaled inputs, introducing a structurally different transformation that still respects pairwise margin and debias properties while preserving weighted mean aggregation. This structural shift improves novelty and numeric stability.",
    "pseudocode": "epsilon=1e-6\nmean_adv = mean(advantage_gap)\nmargin = exp(clamp(abs(mean_adv), 0, 1)) - 1\nnorm = max(mean(norm(advantage_gap)), epsilon)\nx_raw = (log_prob_w - log_prob_l) / norm\nx = margin * x_raw\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nloss_weighted = loss * weight\nreturn sum(loss_weighted) / max(sum(weight), epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization_exponential_margin"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "norm",
      "mean",
      "maximum",
      "neg",
      "mul",
      "sub",
      "div",
      "abs",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    mean_adv = ops.mean(advantage_gap)\n    margin = ops.sub(ops.exp(ops.clamp(ops.abs(mean_adv), 0.0, 1.0)), 1.0)\n    norm_per_sample = ops.norm(advantage_gap)\n    norm = ops.maximum(ops.mean(norm_per_sample), epsilon)\n    x_raw = ops.div(ops.sub(lpw, lpl), norm)\n    x = ops.mul(margin, x_raw)\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss_weighted = ops.mul(loss, weight)\n    loss_mean = ops.div(ops.sum(loss_weighted), ops.maximum(ops.sum(weight), epsilon))\n    return loss_mean",
    "theoretical_basis": ""
  },
