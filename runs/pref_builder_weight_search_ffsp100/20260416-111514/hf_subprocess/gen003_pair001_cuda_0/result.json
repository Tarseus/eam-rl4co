  "g_ir": {
    "name": "all_pairs_gap_linear_range_std_instance_cond_v5",
    "intuition": "Weights pairs by objective gap scaled linearly and modulated multiplicatively by instance-level statistics including instance objective range and instance log-probability std deviation, explicitly conditioning pair weights on instance difficulty for stable and nonnegative weighting consistent across all pairs.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob",
        "instance_obj_range",
        "instance_log_prob_std"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "gap_linear",
      "constraint_family": "clamp_only"
    },
    "operators_used": [
      "all_pairs",
      "gap_linear",
      "clamp",
      "nan_to_num",
      "reciprocal",
      "mul"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    eps = 1e-6\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_gap_linear_range_std_instance_cond_v5', 'weight_family': 'gap_linear'})\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_range = feature_cache['instance_obj_range']\n    instance_log_prob_std = feature_cache['instance_log_prob_std']\n    range_safe = instance_obj_range[b_idx].clamp_min(eps)\n    log_prob_std_safe = instance_log_prob_std[b_idx].clamp_min(eps)\n    inv_range = 1.0 / range_safe\n    inv_log_prob_std = 1.0 / log_prob_std_safe\n    # Instance-stat conditioned multiplicative modulation\n    instance_modulation = inv_range * inv_log_prob_std\n    raw_weight = gap * instance_modulation\n    weight = raw_weight.nan_to_num(nan=0.0, posinf=0.0, neginf=0.0)\n    clamp_lo = 0.25\n    clamp_hi = 4.0\n    weight = weight.clamp(min=clamp_lo, max=clamp_hi)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_gap_linear_range_std_instance_cond_v5', 'weight_family': 'gap_linear'})"
  },
  "f_ir": {
    "name": "weighted_advantage_exp_margin_logsigmoid_scaled_weighted_mean_loss_v4_repaired",
    "intuition": "Clamp norm denominator and sum weights with clamp to avoid zero division; ensure weight read with fallback and clamp all marginal values for stability, preserving pairwise advantage margin scaling.",
    "pseudocode": "epsilon=1e-6\nweight = batch['weight'] if present else ones_like(log_prob_w)\nmean_adv = mean(advantage_gap)\nmargin = exp(clamp(abs(mean_adv), 0, 1)) - 1\nnorm_per_sample = norm(advantage_gap)\nnorm = max(mean(norm_per_sample), epsilon)\nx_raw = (log_prob_w - log_prob_l) / norm\nx = margin * x_raw\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nloss_weighted = loss * weight\nreturn sum(loss_weighted) / max(sum(weight), epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization_exponential_margin"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "norm",
      "mean",
      "maximum",
      "neg",
      "mul",
      "sub",
      "div",
      "abs",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    epsilon = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    advantage_gap = batch['advantage_gap']\n    mean_adv = ops.mean(advantage_gap)\n    margin = ops.sub(ops.exp(ops.clamp(ops.abs(mean_adv), 0.0, 1.0)), 1.0)\n    norm_per_sample = ops.norm(advantage_gap)\n    norm = ops.maximum(ops.mean(norm_per_sample), epsilon)\n    x_raw = ops.div(ops.sub(lpw, lpl), norm)\n    x = ops.mul(margin, x_raw)\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss_weighted = ops.mul(loss, weight)\n    loss_mean = ops.div(ops.sum(loss_weighted), ops.maximum(ops.sum(weight), epsilon))\n    return loss_mean",
    "theoretical_basis": ""
  },
