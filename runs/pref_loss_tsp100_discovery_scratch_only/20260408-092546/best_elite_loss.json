  "ir": {
    "name": "pairwise_softplus_weighted_margin_loss_with_clamping",
    "intuition": "Replaces the asymmetric softplus margin difference with a simpler signed margin linear in the log_prob difference clamped to avoid extreme values, then combines linearly with advantage_gap. The loss uses a negative tanh link for boundedness and aggregates via a weighted mean (sum weighted losses divided by sum weights) for numerical stability and interpretability. Clamping the margin difference prevents numerical overflow or instability from extreme log_prob differences. This simplification avoids logsumexp and max-shift computations, reducing complexity and potential instability while preserving preference guidance with advantage_gap and weighting.",
    "pseudocode": "diff = clamp(log_prob_w - log_prob_l, -10, 10)\nmargin = alpha * diff - beta * advantage_gap\nlosses = -tanh(margin)\nloss = sum(weight * losses) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_margin",
      "signal_family": "advantage_gap",
      "link_family": "tanh",
      "agg_family": "weighted_mean",
      "constraint_family": "bounded_loss",
      "other_hparams": "clamped_margin_simplification"
    },
    "operators_used": [
      "sub",
      "clamp",
      "mul",
      "neg",
      "tanh",
      "sum",
      "div",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv = batch['advantage_gap']\n    weight = batch.get('weight', ops.ones_like(adv))\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n\n    diff_raw = ops.sub(lpw, lpl)\n    diff = ops.clamp(diff_raw, -10.0, 10.0)\n\n    margin = ops.sub(ops.mul(alpha, diff), ops.mul(beta, adv))\n    losses = ops.neg(ops.tanh(margin))\n\n    weighted_losses = ops.mul(losses, weight)\n    sum_weighted_losses = ops.sum(weighted_losses)\n    sum_weight = ops.sum(weight)\n\n    loss = ops.div(sum_weighted_losses, sum_weight)\n    return loss",
