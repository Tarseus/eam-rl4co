  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_logmeanexp_loss_scaled_advantage",
    "intuition": "Modified the original pairwise advantage logmeanexp loss by scaling the margin with sigmoid-normalized advantage_gap to weight the loss dynamically by how informative each pair is. This reduces uniform weighting, increases focus on meaningful pairs with higher advantage gap, and introduces soft-normalization improving stability and learning signal richness. Also replaced direct weighting with this advantage-based dynamic scaling to reduce redundancy and differentiate this loss from the original, resolving the similarity failure.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nscaled_adv = sigmoid(advantage_gap)\nadjusted_margin = margin * scaled_adv\nlosses = -log(sigmoid(adjusted_margin))\nweighted_losses = weight * losses\nmax_val = max(weighted_losses)\nstabilized = weighted_losses - max_val\nsum_exp = sum(exp(stabilized))\nsum_weights = sum(weight)\nloss = max_val + log(sum_exp) - log(sum_weights)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_advantage",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "logmeanexp",
      "constraint_family": "log_loss"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "mul",
      "sub",
      "neg",
      "log",
      "exp",
      "sum",
      "max",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv = batch['advantage_gap']\n    if weight is None:\n        weight = ops.ones_like(lpw)\n    scaled_adv = ops.sigmoid(adv)\n    margin = ops.sub(lpw, lpl)\n    adjusted_margin = ops.mul(margin, scaled_adv)\n    losses = ops.neg(ops.logsigmoid(adjusted_margin))\n    weighted_losses = ops.mul(weight, losses)\n    max_val = ops.max(weighted_losses)\n    stabilized = ops.sub(weighted_losses, max_val)\n    sum_exp = ops.sum(ops.exp(stabilized))\n    sum_weights = ops.sum(weight)\n    loss = ops.add(max_val, ops.sub(ops.log(sum_exp), ops.log(sum_weights)))\n    return loss",
    "theoretical_basis": ""
  },
