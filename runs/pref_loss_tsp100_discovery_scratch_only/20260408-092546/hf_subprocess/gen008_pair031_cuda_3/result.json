  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_cdf_advantage_loss",
    "intuition": "Shift from margin-based pairwise ranking losses to a probabilistic CDF (cumulative distribution function) paradigm that models the winning log-probability as a sample from a logistic distribution shifted by the advantage signal. This loss interprets the difference in log probabilities adjusted by advantage as a latent logistic variable, and uses the logistic CDF (sigmoid) to represent the pairwise preference probability. The loss minimizes the negative log likelihood of this interpretation, weighted by example importance, and aggregates by a weighted mean to stabilize gradients and encourage correct probabilistic ranking rather than margin maximization.",
    "pseudocode": "logit = (log_prob_w - log_prob_l) - beta * advantage_gap\nprob_win = sigmoid(logit)\nlosses = -weight * log(prob_win + epsilon)\nloss = mean(losses)",
    "hyperparams": {
      "paradigm_family": "pairwise_probabilistic_cdf",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "mul",
      "sigmoid",
      "log",
      "neg",
      "mean",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv = batch['advantage_gap']\n    weight = batch.get('weight', ops.ones_like(adv))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    epsilon = 1e-12\n    logit = ops.sub(ops.sub(lpw, lpl), ops.mul(beta, adv))\n    prob_win = ops.sigmoid(logit)\n    safe_prob = ops.add(prob_win, epsilon)\n    losses = ops.neg(ops.mul(weight, ops.log(safe_prob)))\n    return ops.mean(losses)",
    "theoretical_basis": ""
  },
