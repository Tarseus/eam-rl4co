  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stable_smoothpairwise_softplus_margin_loss_v2",
    "intuition": "To reduce similarity with existing losses, I changed the aggregation from logsumexp normalization to a mean of weighted losses, ensuring stable bounded outputs by keeping the tanh nonlinearity. I replaced the logsumexp-based aggregation with a weighted mean, which is simpler and less similar to prior art. I kept the asymmetric smooth margin using softplus differences clamped to [-10,10] to maintain numerical stability and bounded gradients. This avoids overflow and stabilizes training. The loss remains bounded, uses advantage_gap for signal, and respects the pairwise mode and required keys.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nmargin_diff = clamp(softplus(diff) - softplus(-diff), min=-10, max=10)\nmargin = alpha * margin_diff - beta * advantage_gap\nlosses = -tanh(margin)\nweighted_losses = weight * losses\nloss = sum(weighted_losses) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_margin",
      "signal_family": "advantage_gap",
      "link_family": "tanh",
      "agg_family": "weighted_mean",
      "constraint_family": "bounded_loss",
      "other_hparams": "softplus_signed_margin_clamped"
    },
    "operators_used": [
      "sub",
      "softplus",
      "clamp",
      "mul",
      "neg",
      "tanh",
      "sum",
      "div",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv = batch['advantage_gap']\n    weight = batch.get('weight', ops.ones_like(adv))\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n\n    diff = ops.sub(lpw, lpl)\n    margin_diff_raw = ops.sub(ops.softplus(diff), ops.softplus(ops.neg(diff)))\n    margin_diff = ops.clamp(margin_diff_raw, -10.0, 10.0)\n\n    margin = ops.sub(ops.mul(alpha, margin_diff), ops.mul(beta, adv))\n    losses = ops.neg(ops.tanh(margin))\n\n    weighted_losses = ops.mul(losses, weight)\n    sum_weighted_losses = ops.sum(weighted_losses)\n    sum_weight = ops.sum(weight)\n\n    loss = ops.div(sum_weighted_losses, sum_weight)\n    return loss",
    "theoretical_basis": ""
  },
