  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_hinge_costgap_relay_loss",
    "intuition": "Shift paradigm from probabilistic sigmoid margin losses to a hinge-style constraint that enforces a minimum margin proportional to cost_gap, using a relay mechanism that stops gradient if margin already satisfies the hinge, focusing optimization on pairs violating the cost ordering.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nmin_margin = gamma * cost_gap\nhinge_loss = relu(min_margin - margin)\nweighted_loss = weight * hinge_loss\nloss = mean(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_hinge_margin",
      "signal_family": "cost_gap",
      "link_family": "relu",
      "agg_family": "weighted_mean",
      "constraint_family": "hinge_constraint"
    },
    "operators_used": [
      "sub",
      "mul",
      "relu",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_gap = batch['cost_gap']\n    weight = batch.get('weight', None)\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 1.0)))\n    margin = ops.sub(lpw, lpl)\n    min_margin = ops.mul(gamma, cost_gap)\n    hinge_loss = ops.relu(ops.sub(min_margin, margin))\n    if weight is None:\n        weight = ops.ones_like(hinge_loss)\n    weighted_loss = ops.mul(weight, hinge_loss)\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
