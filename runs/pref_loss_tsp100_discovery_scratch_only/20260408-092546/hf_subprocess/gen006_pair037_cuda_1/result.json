  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_tanh_advantage_rank_loss_negentropy_contrast",
    "intuition": "Shift from sigmoid-based margin ranking to a tanh-based scaled margin that directly contrasts win and loss log-probs adjusted by scaled advantage gap, and apply negative entropy regularization on the pairwise differences to encourage confident but smooth preference gradients. Aggregation uses mean followed by a smooth normalization with softplus to prevent collapse and keep gradients stable, adopting a contrastive learning signal paradigm.",
    "pseudocode": "margin = alpha * (log_prob_w - log_prob_l) - beta * advantage_gap\nscaled_margin = tanh(margin)\nentropy_term = -scaled_margin * log(sigmoid(margin)) - (1 - scaled_margin) * log(sigmoid(-margin))\nloss_per_pair = softplus(-scaled_margin * margin) + gamma * entropy_term\nweighted_loss = weight * loss_per_pair\nloss = mean(weighted_loss) / softplus(mean(abs(scaled_margin)))",
    "hyperparams": {
      "paradigm_family": "pairwise_contrastive_entropy",
      "signal_family": "advantage_gap",
      "link_family": "tanh_sigmoid_entropy",
      "agg_family": "softplus_normalized_mean",
      "constraint_family": "smoothness_entropy"
    },
    "operators_used": [
      "sub",
      "mul",
      "add",
      "neg",
      "logsigmoid",
      "tanh",
      "softplus",
      "abs",
      "mean",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.1)))\n\n    margin_diff = ops.sub(lpw, lpl)  # lpw - lpl\n    margin = ops.sub(ops.mul(alpha, margin_diff), ops.mul(beta, adv))  # alpha*(lpw - lpl) - beta*adv\n    scaled_margin = ops.tanh(margin)\n\n    # entropy term encourages meaningful confidence (negative entropy shape)\n    pos_term = ops.mul(scaled_margin, ops.logsigmoid(margin))  # scaled_margin * log(sigmoid(margin))\n    neg_term = ops.mul(ops.sub(ops.ones_like(scaled_margin), scaled_margin), ops.logsigmoid(ops.neg(margin)))  # (1 - scaled_margin) * log(sigmoid(-margin))\n    entropy_term = ops.neg(ops.add(pos_term, neg_term))\n\n    # contrastive loss component (softplus with flipped sign encourages margin sign correct)\n    contrast_loss = ops.softplus(ops.neg(ops.mul(scaled_margin, margin)))\n\n    loss_per_pair = ops.add(contrast_loss, ops.mul(gamma, entropy_term))\n\n    if weight is None:\n        weight = ops.ones_like(loss_per_pair)\n    weighted_loss = ops.mul(weight, loss_per_pair)\n\n    mean_weighted_loss = ops.mean(weighted_loss)\n    # normalization factor to keep loss stable, softplus(mean(abs(scaled_margin))) > 0\n    norm_factor = ops.softplus(ops.mean(ops.abs(scaled_margin)))\n\n    loss = ops.div(mean_weighted_loss, norm_factor)\n    return loss",
    "theoretical_basis": ""
  },
