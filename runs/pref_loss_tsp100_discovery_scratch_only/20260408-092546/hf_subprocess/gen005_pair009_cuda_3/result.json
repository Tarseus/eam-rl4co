  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stable_sigmoid_pairwise_loss_with_normalized_advantage_clamp",
    "intuition": "Added explicit pseudocode for clarity and fixed clarity by removing unnecessary sigmoid modifier. Normalized advantage_gap for numerical stability, clamped margin to avoid extreme logits, and used log-sigmoid loss for stability. Kept linear combination of log probabilities and advantage with weights. Using mean aggregation and safe defaults for weight if missing. This balances simplicity and numerical stability while maintaining semantics.",
    "pseudocode": "1. Read lpw, lpl, adv, weight from batch.\n2. Normalize adv by its norm plus small epsilon.\n3. Compute margin = (lpw - lpl) - beta * adv.\n4. Clamp margin to [-clip_val, clip_val].\n5. Scale margin by alpha.\n6. Compute loss = -log(sigmoid(scaled_margin)).\n7. Multiply loss by weight if provided, else 1.\n8. Return mean(loss).",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_margin",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "mean",
      "constraint_family": "normalization",
      "alpha": 1.0,
      "beta": 0.5,
      "clip_val": 10.0
    },
    "operators_used": [
      "logsigmoid",
      "mean",
      "mul",
      "sub",
      "clamp",
      "neg",
      "norm",
      "div",
      "maximum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "advantage_gap",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n    clip_val = float(extra.get('clip_val', extra.get('hyperparams', {}).get('clip_val', 10.0)))\n    epsilon = 1e-6\n    norm_adv = ops.maximum(ops.norm(adv), epsilon)\n    normalized_adv = ops.div(adv, norm_adv)\n    margin_pre_clamp = ops.sub(ops.sub(lpw, lpl), ops.mul(beta, adv))\n    margin = ops.clamp(margin_pre_clamp, -clip_val, clip_val)\n    scaled_margin = ops.mul(alpha, margin)\n    loss = ops.neg(ops.logsigmoid(scaled_margin))\n    if weight is None:\n        weight = ops.ones_like(loss)\n    weighted_loss = ops.mul(loss, weight)\n    return ops.mean(weighted_loss)",
    "theoretical_basis": ""
  },
