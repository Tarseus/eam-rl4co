  "g_ir": {
    "name": "all_pairs_margin_regret_blend_reweight",
    "intuition": "Preserves all pairs from the fixed all_pairs construction and reweights them with a smooth, nonnegative margin-regret blend normalized per instance, ensuring stable and balanced weighting without changing pair topology or selection.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob",
        "obj_z",
        "rank",
        "regret"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {},
    "operators_used": [],
    "code": "def generated_builder(feature_cache, extra):\n    eps = 1e-6\n    clamp_lo = 0.3\n    clamp_hi = 5.0\n    lambda_regret = float(extra.get('lambda_regret', 1.0))\n    gamma = float(extra.get('gamma', 0.5))\n\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    regret = feature_cache['regret']\n\n    # Construct all pairs where winner objective < loser objective (fixed pair topology)\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n\n    # Compute margin and regret span\n    margin_abs = (log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]).abs() + eps\n    regret_span = regret[b_idx, loser_idx] - regret[b_idx, winner_idx]\n\n    # Raw weight blending margin and regret powered by gamma\n    raw = (1.0 + lambda_regret * regret_span) / margin_abs.pow(gamma)\n    raw = raw.clamp_min(0.0)\n\n    batch_size = objective.shape[0]\n    counts = torch.bincount(b_idx, minlength=batch_size).to(dtype=objective.dtype)\n\n    mean_raw = torch.zeros(batch_size, dtype=objective.dtype, device=objective.device)\n    mean_raw.index_add_(0, b_idx, raw)\n    mean_raw = mean_raw / counts.clamp_min(1.0)\n\n    # Normalize raw weights per instance\n    weight = raw / mean_raw[b_idx].clamp_min(eps)\n    weight = weight.clamp(clamp_lo, clamp_hi)\n\n    mean_weight = torch.zeros(batch_size, dtype=objective.dtype, device=objective.device)\n    mean_weight.index_add_(0, b_idx, weight)\n    mean_weight = mean_weight / counts.clamp_min(1.0)\n\n    weight = weight / mean_weight[b_idx].clamp_min(eps)\n\n    # Preserve all pairs without capping (fixed pair topology)\n\n    return PrefBatch(\n        mode='pairwise',\n        pair_idx=(b_idx, winner_idx, loser_idx),\n        weight=weight,\n        meta={'builder': 'all_pairs', 'weight_family': 'margin_regret_blend_reweight'}\n    )"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired",
    "intuition": "Removed the additive offset term that violated affine invariance and replaced it with a purely multiplicative interaction between log_prob difference and normalized cost gap. This ensures the loss respects scale and shift invariance by depending only on the relative difference (lpw - lpl) scaled by a normalized cost gap factor rather than subtracting a fixed offset proportional to the cost gap. Clamping is preserved for numerical stability.",
    "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nnormalized_loss = sum(weighted_losses) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sum",
      "add",
      "sub",
      "abs",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss",
    "theoretical_basis": ""
  },
