    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    weight_scalar = float(extra.get('weight_scalar', 1.0))\n    # Clamp weight_scalar to [0.0, 10.0]\n    weight_scalar = max(0.0, min(weight_scalar, 10.0))\n    base_weight = objective.new_ones(b_idx.shape[0])\n    weight = base_weight * weight_scalar\n    return PrefBatch(\n        mode='pairwise',\n        pair_idx=(b_idx.long(), winner_idx.long(), loser_idx.long()),\n        weight=weight,\n        meta={'builder': 'reweighted_scalar_pref_fixed', 'weight_family': 'scalar'}\n    )"
