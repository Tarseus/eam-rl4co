  "ir": {
    "name": "pairwise_gap_rank_blend_tuned_006",
    "intuition": "Weight pairs by the positive objective gap multiplied by a smooth inverse softened regret difference using a tunable beta exponent, improving numerical stability and weight smoothness while preserving the gap-rank blend principle and finite nonnegative weights.",
    "implementation_hint": {
      "expects": [
        "objective",
        "regret"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "clamp_only",
      "weight_family": "gap_rank_blend",
      "constraint_family": "clamp_only"
    },
    "operators_used": [
      "all_pairs",
      "clamp",
      "abs",
      "pow",
      "nan_to_num"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    regret = feature_cache['regret']\n    b_idx, winner_idx, loser_idx = (objective[:, :, None] < objective[:, None, :]).nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'pairwise', 'weight_family': 'gap_rank_blend'})\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    gap_pos = gap.clamp(min=0.0)\n    regret_diff = (regret[b_idx, loser_idx] - regret[b_idx, winner_idx]).abs()\n    eps = float(extra.get('weight_eps', 1e-5))\n    beta = float(extra.get('weight_beta', 0.5))\n    inv_regret = 1.0 / (regret_diff + eps).pow(beta)\n    raw_weight = gap_pos * inv_regret\n    raw_weight = torch.nan_to_num(raw_weight, nan=0.0, posinf=0.0, neginf=0.0)\n    clamp_lo = float(extra.get('clamp_lo', 0.2))\n    clamp_hi = float(extra.get('clamp_hi', 4.5))\n    weight = raw_weight.clamp(clamp_lo, clamp_hi)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'pairwise', 'weight_family': 'gap_rank_blend'})"
  },
