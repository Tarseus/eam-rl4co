  "g_ir": {
    "name": "pairwise_weight_combined_001",
    "intuition": "Combine the pairwise margin-based signals from margin_rank_blend with the regret-aware weighting from margin_regret_blend, integrating the primary pairwise structure with a monotone transform and a safeguard against regret influence. This creates a robust, flexible weighting scheme that leverages both rank margins and regret signals while maintaining simplicity and compatibility with reweight_only constraints.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob",
        "obj_z",
        "regret"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "gap_regret_rank_blend",
      "constraint_family": "clamp_only"
    },
    "operators_used": [
      "all_pairs",
      "margin_rank_blend",
      "margin_regret_blend"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    regret = feature_cache['regret']\n    b_idx, winner_idx, loser_idx = (objective[:, :, None] < objective[:, None, :]).nonzero(as_tuple=True)\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    eps = 1e-6\n    # Compute margin-based raw weight\n    margin_raw = torch.sigmoid(extra.get('beta_margin', 4.0) * (objective[b_idx, loser_idx] - objective[b_idx, winner_idx]))\n    margin_raw = torch.nan_to_num(margin_raw, nan=0.0, posinf=0.0, neginf=0.0).clamp_min(0.0)\n    # Compute regret-based adjustment\n    regret_span = regret[b_idx, loser_idx] - regret[b_idx, winner_idx]\n    regret_weight = 1.0 / (1.0 + torch.abs(regret_span))\n    # Combine signals multiplicatively for robustness\n    combined_weight = margin_raw * regret_weight\n    # Clamp combined weight to avoid instability\n    combined_weight = combined_weight.clamp(0.0, 4.0)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=combined_weight, meta={'builder': 'pairwise_weight_combined', 'weight_family': 'gap_regret_rank_blend'})"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired",
    "intuition": "Removed the additive offset term that violated affine invariance and replaced it with a purely multiplicative interaction between log_prob difference and normalized cost gap. This ensures the loss respects scale and shift invariance by depending only on the relative difference (lpw - lpl) scaled by a normalized cost gap factor rather than subtracting a fixed offset proportional to the cost gap. Clamping is preserved for numerical stability.",
    "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nnormalized_loss = sum(weighted_losses) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sum",
      "add",
      "sub",
      "abs",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss",
    "theoretical_basis": ""
  },
