{"generation": -1, "pair_index": -1, "g_id": "g_ref", "f_id": "fseed_000_1ec7ffff", "g_ir": {"name": "ref_all_pairs_builder", "intuition": "Reference builder: all winner/loser pairs by objective ordering.", "implementation_hint": {"expects": ["objective", "log_prob"], "returns": "PrefBatch", "mode": "pairwise"}, "hyperparams": {"geometry_family": "dense_all_pairs", "cap_family": "uncapped_full", "weight_family": "uniform_none", "constraint_family": "none"}, "operators_used": ["ref_all_pairs"], "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"}, "f_ir": {"name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired", "intuition": "Removed the additive offset term that violated affine invariance and replaced it with a purely multiplicative interaction between log_prob difference and normalized cost gap. This ensures the loss respects scale and shift invariance by depending only on the relative difference (lpw - lpl) scaled by a normalized cost gap factor rather than subtracting a fixed offset proportional to the cost gap. Clamping is preserved for numerical stability.", "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nnormalized_loss = sum(weighted_losses) / (sum(weight) + eps)", "hyperparams": {"paradigm_family": "pairwise_margin", "signal_family": "cost_gap", "link_family": "logsigmoid", "agg_family": "mean", "constraint_family": "scale_invariance"}, "operators_used": ["logsigmoid", "clamp", "mul", "sum", "add", "sub", "abs", "div"], "implementation_hint": {"expects": ["log_prob_w", "log_prob_l", "weight", "cost_a", "cost_b"], "returns": "scalar", "mode": "pairwise"}, "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss", "theoretical_basis": ""}, "device": "cuda:0", "device_str": "cuda:0", "device_physical_str": "cuda:0", "device_logical_str": "cuda:0", "cheap_gate_on": true, "high_fidelity_on": true, "eval_budget_signature": "4cca2a2fd7c2917c", "score": Infinity, "proxy_metrics": null, "seed_signature": null, "descriptor": null, "joint_gate_repaired": false, "joint_gate_repair_attempts": 8, "f_id_before_repair": null, "f_id_after_repair": null, "joint_gate_repair_reports": [{"record_type": "joint_gate_repair_attempt", "ts": "2026-04-14 11:06:17", "generation": -1, "pair_index": -1, "stage": "joint_gate", "g_id": "g_ref", "f_id_before": "fseed_000_1ec7ffff", "attempt": 1, "failure_kind_before": "sandbox_builder_gate_failed", "joint_gate_trace_before": {"failed_gate": "PreferenceBuilder", "failure_kind": "sandbox_builder_gate_failed", "metric": {"metric_name": "instance_weight_cv_pass_rate", "observed_value": 0.0, "threshold": 0.75, "direction": ">="}, "cv_threshold": 0.1, "eligible_instances": 8, "observed_cv_min": 0.0, "observed_cv_mean": 0.0, "observed_cv_max": 0.0, "sandbox": {"reason": "buil