  "g_entry": {
    "id": "g001_010_3df71b82",
    "ir": {
      "name": "builder_all_pairs_gap_regret_blend_reweight_001",
      "intuition": "Rearranged gap and regret scaling by instance stats with multiplicative margin modulation and smooth clamp windows to stabilize pair weights without changing pair topology.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob",
          "regret",
          "instance_obj_mad",
          "instance_log_prob_std",
          "instance_regret_std"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "gap_regret_blend",
        "constraint_family": "clamp_only"
      },
      "operators_used": [
        "all_pairs",
        "sub",
        "abs",
        "pow",
        "mul",
        "div",
        "clamp",
        "nan_to_num"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    regret = feature_cache['regret']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs', 'weight_family': 'gap_regret_blend'})\n    eps = 1e-6\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_mad = feature_cache['instance_obj_mad'][b_idx].clamp_min(eps)\n    instance_log_prob_std = feature_cache['instance_log_prob_std'][b_idx].clamp_min(eps)\n    instance_regret_std = feature_cache['instance_regret_std'][b_idx].clamp_min(eps)\n    gap_scaled = gap / instance_obj_mad\n    regret_span = regret[b_idx, loser_idx] - regret[b_idx, winner_idx]\n    regret_scaled = regret_span / (1.0 + instance_regret_std)\n    margin_abs = (log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]).abs()\n    margin_norm = margin_abs / instance_log_prob_std\n    beta = float(extra.get('beta', 4.0))\n    lambda_regret = float(extra.get('lambda_regret', 1.0))\n    gamma = float(extra.get('gamma', 0.5))\n    raw = (gap_scaled + lambda_regret * regret_scaled) * margin_norm.pow(gamma)\n    raw = raw.clamp_min(0.0)\n    clamp_lo = 0.25\n    clamp_hi = 4.0\n    weight = raw.clamp(clamp_lo, clamp_hi)\n    weight = weight.nan_to_num(nan=0.0, posinf=clamp_hi, neginf=clamp_lo)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs', 'weight_family': 'gap_regret_blend'})"
    }
  },
  "f_entry": {
    "id": "fseed_000_1ec7ffff",
    "ir": {
      "name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired",
      "intuition": "Removed the additive offset term that violated affine invariance and replaced it with a purely multiplicative interaction between log_prob difference and normalized cost gap. This ensures the loss respects scale and shift invariance by depending only on the relative difference (lpw - lpl) scaled by a normalized cost gap factor rather than subtracting a fixed offset proportional to the cost gap. Clamping is preserved for numerical stability.",
      "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nnormalized_loss = sum(weighted_losses) / (sum(weight) + eps)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "cost_gap",
        "link_family": "logsigmoid",
        "agg_family": "mean",
        "constraint_family": "scale_invariance"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "mul",
        "sum",
        "add",
        "sub",
        "abs",
        "div"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "cost_a",
          "cost_b"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss",
      "theoretical_basis": ""
    }
  },
