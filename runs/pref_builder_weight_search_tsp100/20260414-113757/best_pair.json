  "g_ir": {
    "name": "all_pairs_gap_linear_margin_regret_clamped_reweight_v2",
    "intuition": "Preserve margin_regret_blend weighting but add explicit clamping and denominator epsilon guards to stabilize weights without tie-zone suppression.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob",
        "instance_obj_mad",
        "instance_log_prob_std",
        "instance_regret_mean"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "margin_regret_blend",
      "constraint_family": "clamp_eps_guard"
    },
    "operators_used": [
      "all_pairs",
      "sub",
      "abs",
      "clamp",
      "mul",
      "div",
      "nan_to_num",
      "ge"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    log_prob = feature_cache['log_prob']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    eps = 1e-6\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_mad = feature_cache['instance_obj_mad'].clamp_min(eps)\n    gap_scaled = gap / instance_obj_mad[b_idx]\n    margin_abs = (log_prob[b_idx, winner_idx] - log_prob[b_idx, loser_idx]).abs()\n    instance_log_prob_std = feature_cache['instance_log_prob_std'].clamp_min(eps)\n    margin_norm = margin_abs / instance_log_prob_std[b_idx]\n    instance_regret_mean = feature_cache['instance_regret_mean'].clamp_min(eps)\n    regret_scale = instance_regret_mean[b_idx]\n    raw_weight = gap_scaled * margin_norm * regret_scale\n    clamp_lo = float(extra.get('clamp_lo', 0.2))\n    clamp_hi = float(extra.get('clamp_hi', 2.5))\n    weight_clamped = raw_weight.clamp(min=clamp_lo, max=clamp_hi)\n    weight_clean = weight_clamped.nan_to_num(nan=clamp_lo, posinf=clamp_hi, neginf=clamp_lo)\n    # Additional clamp to handle any extreme values post nan_to_num\n    weight_final = weight_clean.clamp(min=clamp_lo, max=clamp_hi)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight_final, meta={\n        'builder': 'all_pairs',\n        'geometry_family': 'dense_all_pairs',\n        'cap_family': 'uncapped_full',\n        'weight_family': 'margin_regret_blend',\n        'constraint_family': 'clamp_eps_guard'\n    })"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired",
    "intuition": "Removed the additive offset term that violated affine invariance and replaced it with a purely multiplicative interaction between log_prob difference and normalized cost gap. This ensures the loss respects scale and shift invariance by depending only on the relative difference (lpw - lpl) scaled by a normalized cost gap factor rather than subtracting a fixed offset proportional to the cost gap. Clamping is preserved for numerical stability.",
    "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nnormalized_loss = sum(weighted_losses) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sum",
      "add",
      "sub",
      "abs",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss",
    "theoretical_basis": ""
  },
