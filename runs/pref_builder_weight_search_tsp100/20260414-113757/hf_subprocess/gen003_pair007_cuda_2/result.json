  "g_ir": {
    "name": "all_pairs_gap_linear_multiplicative_clamp_reweight_v3",
    "intuition": "Reweight all pairs by multiplying normalized objective gap with instance log_prob range, then clamp for stability, preserving pair topology and instance conditioning.",
    "implementation_hint": {
      "expects": [
        "objective",
        "instance_obj_mad",
        "instance_log_prob_range"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "gap_linear",
      "constraint_family": "clamp_only"
    },
    "operators_used": [
      "all_pairs",
      "sub",
      "div",
      "mul",
      "clamp",
      "nan_to_num"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    eps = 1e-6\n    gap = objective[b_idx, loser_idx] - objective[b_idx, winner_idx]\n    instance_obj_mad = feature_cache['instance_obj_mad'].clamp_min(eps)\n    gap_scaled = gap / instance_obj_mad[b_idx]\n    instance_log_prob_range = feature_cache['instance_log_prob_range'].clamp_min(eps)\n    raw_weight = gap_scaled * instance_log_prob_range[b_idx]\n    clamp_lo = float(extra.get('clamp_lo', 0.05))\n    clamp_hi = float(extra.get('clamp_hi', 3.0))\n    weight = raw_weight.clamp(min=clamp_lo, max=clamp_hi)\n    weight = weight.nan_to_num(nan=0.0, posinf=clamp_hi, neginf=clamp_lo)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={\n        'builder': 'all_pairs',\n        'geometry_family': 'dense_all_pairs',\n        'cap_family': 'uncapped_full',\n        'weight_family': 'gap_linear',\n        'constraint_family': 'clamp_only'\n    })"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_shifted_sum_normalized_repaired2",
    "intuition": "Preserves the original multiplicative interaction between log_prob difference and normalized cost gap, clamps inputs safely, and uses weighted mean with eps to avoid division by zero.",
    "pseudocode": "gap = cost_b - cost_a\nnorm_gap = gap / (1 + abs(gap))\nmargin = (lpw - lpl) * (1 - beta * norm_gap)\nx = alpha * scale * margin\nlosses = -logsigmoid(clamp(x, -20, 20))\nweighted_losses = losses * weight\nloss = sum(weighted_losses) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sum",
      "add",
      "sub",
      "abs",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', 0.05))\n    gap = cost_b - cost_a\n    norm_gap = gap / (1.0 + ops.abs(gap))\n    margin = (lpw - lpl) * (1.0 - beta * norm_gap)\n    x = alpha * scale * margin\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    norm_factor = ops.sum(weight) + eps\n    loss = ops.sum(weighted_losses) / norm_factor\n    return loss",
    "theoretical_basis": ""
  },
