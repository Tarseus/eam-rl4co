  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_advantage_ratio_log_clamped_repaired",
    "intuition": "Repaired by adding numerical stability clamps and explicit tensor creation for scalars to avoid internal PyTorch storage_module bug, preserving original advantage ratio with delta_rank and log prob ratio with stable softplus-log operation.",
    "pseudocode": "prob_ratio = exp(clamp(log_prob_w - log_prob_l, min_val))\nadv_ratio = 1 + delta_rank * prob_ratio\nadv_ratio_stable = adv_ratio + epsilon\nloss_raw = -log(softplus(adv_ratio_stable))\nloss = mean(weight * loss_raw)",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_ratio",
      "signal_family": "delta_rank",
      "link_family": "log_softplus",
      "agg_family": "mean",
      "constraint_family": "softplus_stabilized"
    },
    "operators_used": [
      "exp",
      "log",
      "add",
      "mul",
      "mean",
      "neg",
      "softplus",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n\n    diff = ops.sub(lpw, lpl)\n    diff_clamped = ops.clamp(diff, min=-20.0, max=20.0)\n    prob_ratio = ops.exp(diff_clamped)\n\n    one = lpw.new_ones(lpw.shape)\n    adv_ratio = ops.add(one, ops.mul(delta_rank, prob_ratio))\n    adv_ratio_stable = ops.add(adv_ratio, lpw.new_full(lpw.shape, eps))\n\n    softplus_val = ops.softplus(adv_ratio_stable)\n    loss = ops.neg(ops.log(softplus_val))\n    weighted_loss = ops.mul(loss, weight)\n\n    return ops.mean(weighted_loss)",
    "theoretical_basis": ""
  },
