  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "normalized_pairwise_pref_loss_repaired_v3",
    "intuition": "The original loss failed due to missing 'advantage_gap' key required by the ObjectiveSensitivity gate. This repair switches the quality signal to 'delta_rank', which is a widely available stable preference signal representing rank differences between pairs. The loss clamps 'delta_rank' to a reasonable range, applies a sigmoid-weight to softly weight the winner and loser log probabilities for smooth gradients. It normalizes the weighted combined loss by the sum of weights ensuring stable scale-invariant training. This fix removes dependency on the missing key while preserving the core principle of normalized weighted preference losses.",
    "pseudocode": "delta_rank_clamped = clamp(delta_rank, -10, 10)\nsig_weight = sigmoid(alpha * delta_rank_clamped)\nloss_w = -sig_weight * log_prob_w\nloss_l = (1 - sig_weight) * log_prob_l\nweighted_loss = weight * (loss_w + loss_l)\nloss = sum(weighted_loss) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "sigmoid_weight",
      "agg_family": "sum",
      "constraint_family": "normalization",
      "other_hparams": "optional"
    },
    "operators_used": [
      "sigmoid",
      "mul",
      "add",
      "sub",
      "sum",
      "div",
      "clamp",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    delta_rank_clamped = ops.clamp(delta_rank, -10.0, 10.0)\n    sig_weight = ops.sigmoid(ops.mul(alpha, delta_rank_clamped))\n\n    loss_w = ops.neg(ops.mul(sig_weight, lpw))\n    loss_l = ops.mul(ops.sub(ops.ones_like(sig_weight), sig_weight), lpl)\n\n    weighted_loss = ops.mul(weight, ops.add(loss_w, loss_l))\n    total_loss = ops.div(ops.sum(weighted_loss), ops.sum(weight) + 1e-8)\n    return total_loss",
    "theoretical_basis": "This loss uses 'delta_rank' as a proxy preference signal which encodes difference in rank between winner and loser outputs. Applying a sigmoid to a clamped delta_rank produces smooth soft weights that emphasize stronger preferences gently without abrupt thresholds. Weighting log probabilities of winner and loser by these soft weights and normalizing by total weight maintains scale invariance and stable gradients. This makes the loss effective for pairwise ranking tasks even when 'advantage_gap' is unavailable."
  },
