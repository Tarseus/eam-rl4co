  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "shifted_scaled_tanh_advantage_with_delta_rank",
    "intuition": "The original candidate failed because it required 'cost_gap', which was missing in the batch. To fix this, I replaced 'cost_gap' with 'delta_rank', a commonly available quality signal representing the difference in rank between pair elements, which preserves the relative preference ordering. The nonlinear transformation applies a shifted and scaled tanh to delta_rank instead of cost_gap, maintaining the smooth nonlinear weighting effect. This adjustment ensures the candidate only requires keys present in the batch, passes all gates, and retains meaningful pairwise comparison behavior.",
    "pseudocode": "delta_rank_scaled = delta_rank * alpha + bias\ntransformed = tanh(delta_rank_scaled) * sigmoid(gamma)\nloss_w = -transformed * log_prob_w * weight\nloss_l = transformed * log_prob_l * weight\nloss = mean(loss_w + loss_l)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "shifted_scaled_tanh_sigmoid_weight",
      "agg_family": "mean",
      "constraint_family": "none",
      "alpha": 1.0,
      "bias": 0.3,
      "gamma": 2.0
    },
    "operators_used": [
      "tanh",
      "sigmoid",
      "mul",
      "add",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    w = batch.get('weight', lpw.new_ones(lpw.shape))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    bias = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.3)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 2.0)))\n\n    delta_rank_scaled = ops.add(ops.mul(alpha, delta_rank), bias)\n    tanh_val = ops.tanh(delta_rank_scaled)\n    scale = ops.sigmoid(ops.mul(ops.ones_like(delta_rank_scaled), gamma))\n    scaled_val = ops.mul(tanh_val, scale)\n\n    loss_w = ops.mul(ops.neg(ops.mul(scaled_val, lpw)), w)\n    loss_l = ops.mul(scaled_val, ops.mul(lpl, w))\n    loss = ops.mean(ops.add(loss_w, loss_l))\n    return loss",
    "theoretical_basis": ""
  },
