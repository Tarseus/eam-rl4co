  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "exp_weighted_advantage_loss_stabilized_repaired_v2",
    "intuition": "The original candidate failed because it required the key 'advantage_gap' which was missing from the input batch, causing the co_gate failure. To repair it, the loss function was modified to use 'delta_regret' instead, which is a commonly available quality signal reflecting advantage differences. The signal is clamped to [-10,10] for numerical stability before applying exponential weighting, preserving intended weighting behavior. The expects list and loss implementation were updated to depend on 'delta_regret' rather than 'advantage_gap', ensuring successful gate evaluation with only available keys, maintaining pairwise mode and expected inputs.",
    "pseudocode": "delta = clamp(delta_regret, -10, 10)\nweight_exp = exp(alpha * delta)\nloss = mean(weight * weight_exp * (-log_prob_w + log_prob_l))",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_regret",
      "link_family": "exponential_weight",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "exp",
      "mul",
      "add",
      "neg",
      "mean",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    delta = ops.clamp(delta_regret, -10.0, 10.0)  # stabilize large regret differences\n    exp_weight = ops.exp(ops.mul(alpha, delta))\n\n    loss = ops.mean(ops.mul(weight, ops.mul(exp_weight, ops.add(ops.neg(lpw), lpl))))\n    return loss",
    "theoretical_basis": ""
  },
