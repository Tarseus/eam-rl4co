  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_weighted_exp_softmax_loss_repaired_v2",
    "intuition": "The original candidate failed because 'advantage_gap' key was missing, which was essential for weighting the loss. This repair replaces 'advantage_gap' with 'delta_rank', a required and always present pairwise signal reflecting ranking differences. We clamp and scale 'delta_rank' similarly to before and apply the softmax exponential weighting to produce balanced weights that depend on the rank difference. This avoids missing key errors, preserves the weighting mechanism correlated with ranking, and respects the required keys. Normalization by sum of weights ensures stable training.",
    "pseudocode": "adv_diff = clamp(delta_rank, -10, 10)\nscaled_adv_diff = alpha * adv_diff\nexp_adv = exp(scaled_adv_diff)\nsoftmax_w = exp_adv / (exp_adv + 1)\nsoftmax_l = 1 - softmax_w\nloss_w = -softmax_w * log_prob_w\nloss_l = softmax_l * log_prob_l\nweighted_loss = weight * (loss_w + loss_l)\nfinal_loss = sum(weighted_loss) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "softmax_exp_weight",
      "agg_family": "mean",
      "constraint_family": "normalization",
      "other_hparams": "alpha controls sharpness of weighting"
    },
    "operators_used": [
      "log",
      "sub",
      "mul",
      "add",
      "clamp",
      "neg",
      "ones_like",
      "exp",
      "div",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    adv_diff = ops.clamp(delta_rank, -10.0, 10.0)\n    scaled_adv_diff = ops.mul(alpha, adv_diff)\n\n    exp_adv = ops.exp(scaled_adv_diff)\n    denom = ops.add(exp_adv, ops.ones_like(exp_adv))\n    softmax_w = ops.div(exp_adv, denom)\n    softmax_l = ops.sub(ops.ones_like(softmax_w), softmax_w)\n\n    loss_w = ops.neg(ops.mul(softmax_w, lpw))\n    loss_l = ops.mul(softmax_l, lpl)\n\n    weighted_loss = ops.mul(weight, ops.add(loss_w, loss_l))\n    sum_loss = ops.sum(weighted_loss)\n    weight_sum = ops.sum(weight)\n    normalized_loss = ops.div(sum_loss, ops.add(weight_sum, eps))\n    return normalized_loss",
    "theoretical_basis": ""
  },
