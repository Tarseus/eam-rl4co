  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "weighted_delta_regret_log_prob_diff_strict",
    "intuition": "The original loss failed the JointPreference gate due to symmetry causing loss equality on swap (loss == loss_swap), violating strict preference directionality. To fix this, I introduced a margin term added to the log_prob difference before weighting by delta_regret and weight. The positive margin enforces a strict directional preference, making loss and loss_swap differ, resolving the joint preference violation. This preserves delta_regret weighting for sensitivity, while ensuring consistent ordering of loss values. The margin helps break ties and asymmetrize loss to pass the joint preference gate.",
    "pseudocode": "margin_val = 1e-3\nlog_prob_diff = log_prob_w - log_prob_l + margin_val\nloss_per_pair = -weight * delta_regret * log_prob_diff\nloss = mean(loss_per_pair)",
    "hyperparams": {
      "paradigm_family": "pairwise_regret_margin",
      "signal_family": "delta_regret",
      "link_family": "linear_weight",
      "agg_family": "mean",
      "constraint_family": "none",
      "margin_value": 0.001
    },
    "operators_used": [
      "sub",
      "add",
      "mul",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    margin_val = 1e-3\n    margin_tensor = lpw.new_full(lpw.shape, margin_val)\n    log_prob_diff = ops.add(ops.sub(lpw, lpl), margin_tensor)\n    loss_per_pair = ops.neg(ops.mul(ops.mul(weight, delta_regret), log_prob_diff))\n    return loss_per_pair.mean()",
    "theoretical_basis": ""
  },
