  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "rank_gap_exp_weighted_preference_mean_aggregation_repaired_v2",
    "intuition": "Fixed failure by removing dependency on missing key 'advantage_gap' and switching to 'delta_rank' as the quality signal, which is guaranteed provided. Changed exponential weighting to use -alpha * delta_rank for stable weighting reflecting rank differences. Kept weighted loss with clamping and mean aggregation to ensure robust, bounded gradients and stable training.",
    "pseudocode": "adv = delta_rank\nweighted = exp(-alpha * adv)\nloss_w = -weighted * log_prob_w\nloss_l = weighted * log_prob_l\nloss_per_pair = loss_w + loss_l\nweighted_loss = weight * loss_per_pair\nclamped_loss = clamp(weighted_loss, min=-1e2, max=1e2)\nloss = mean(clamped_loss)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "exponential_weight",
      "agg_family": "mean",
      "constraint_family": "bounded"
    },
    "operators_used": [
      "exp",
      "mul",
      "add",
      "neg",
      "clamp",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    weighted = ops.exp(ops.neg(ops.mul(alpha, delta_rank)))\n    loss_w = ops.neg(ops.mul(weighted, lpw))\n    loss_l = ops.mul(weighted, lpl)\n    loss_per_pair = ops.add(loss_w, loss_l)\n    weighted_loss = ops.mul(weight, loss_per_pair)\n    clamped_loss = ops.clamp(weighted_loss, -1e2, 1e2)\n    loss = ops.mean(clamped_loss)\n    return loss",
    "theoretical_basis": ""
  },
