  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_weighted_delta_rank_tanh_squared_sigmoid_repaired",
    "intuition": "The original candidate failed because the key 'cost_gap' was missing from the batch. To repair this, I replaced the use of 'cost_gap' with 'delta_rank', which is a commonly available quality signal in pairwise batches and guaranteed to be present. I preserved the nonlinear transform (tanh squared followed by sigmoid) applied to 'delta_rank' to maintain the smooth nonlinear weighting behavior. This fix avoids missing keys and keeps the intended weighting scheme, ensuring the loss passes all gates.",
    "pseudocode": "delta_rank_tanh = tanh(delta_rank)\ndelta_rank_tanh_sq = delta_rank_tanh * delta_rank_tanh\nsig_weight = sigmoid(alpha * delta_rank_tanh_sq)\nloss_w = -sig_weight * log_prob_w\nloss_l = (1 - sig_weight) * log_prob_l\nloss = mean(weight * (loss_w + loss_l))",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "sigmoid_weight",
      "agg_family": "mean",
      "constraint_family": "tanh_squared_smooth"
    },
    "operators_used": [
      "tanh",
      "mul",
      "sigmoid",
      "neg",
      "add",
      "mean",
      "sub",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    delta_rank_tanh = ops.tanh(delta_rank)\n    delta_rank_tanh_sq = ops.mul(delta_rank_tanh, delta_rank_tanh)\n    sig_weight = ops.sigmoid(ops.mul(alpha, delta_rank_tanh_sq))\n\n    loss_w = ops.neg(ops.mul(sig_weight, lpw))\n    loss_l = ops.mul(ops.sub(ops.ones_like(sig_weight), sig_weight), lpl)\n\n    loss = ops.mul(weight, ops.add(loss_w, loss_l))\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
