  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_preference_log_weighted_with_advantage_gap",
    "intuition": "The loss computes a weighted, sigmoid-scaled difference of log probabilities between winning and losing samples, using delta_rank as a quality signal to modulate the scaling. This encourages the model to prefer outputs with better rank differences by applying a log-weighted scaling factor derived from delta_rank.",
    "pseudocode": "delta_rank_shifted = delta_rank - 1\nlog_weight = log(1 + exp(-beta * delta_rank_shifted))\npref_score = weight * log_weight * (log_prob_w - log_prob_l)\nloss = sum(sigmoid(-pref_score))",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "delta_rank",
      "link_family": "sigmoid",
      "agg_family": "sum",
      "constraint_family": "log_weighted_scaling"
    },
    "operators_used": [
      "exp",
      "log",
      "sigmoid",
      "sub",
      "mul",
      "add",
      "neg",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n\n    shifted = ops.sub(delta_rank, ops.exp(ops.mul(0, delta_rank)))  # delta_rank - 1\n    neg_beta_shifted = ops.mul(-beta, shifted)  # -beta * (delta_rank - 1)\n    exp_term = ops.exp(neg_beta_shifted)\n    log_weight = ops.log(ops.add(exp_term, ops.exp(ops.mul(0, delta_rank))))  # log(1 + exp(-beta*(delta_rank-1)))\n\n    logprob_diff = ops.sub(lpw, lpl)\n    pref_score = ops.mul(weight, ops.mul(log_weight, logprob_diff))\n    loss = ops.sigmoid(ops.neg(pref_score))\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
