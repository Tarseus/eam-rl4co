  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_log_ratio_softplus_delta_rank",
    "intuition": "Repaired by replacing the missing 'advantage_gap' signal with the present 'delta_rank' signal, which is guaranteed to exist. The weighting uses softplus on a scaled, clamped delta_rank to ensure a nonnegative, smooth weighting factor reflecting preference margin in terms of rank difference. This fix addresses the missing key failure by relying on 'delta_rank' rather than 'advantage_gap', while maintaining the smooth margin-based preference loss with proper differentiable weighting.",
    "pseudocode": "log_ratio = log_prob_w - log_prob_l\nscaled_delta_rank = clamp(delta_rank * alpha, 0, 20)\nweighting = softplus(scaled_delta_rank)\nloss_per_pair = weighting * softplus(-log_ratio)\nloss = sum(weight * loss_per_pair)",
    "hyperparams": {
      "paradigm_family": "pairwise_log_ratio",
      "signal_family": "delta_rank",
      "link_family": "softplus",
      "agg_family": "sum",
      "constraint_family": "clamp_nonneg_stabilized"
    },
    "operators_used": [
      "sub",
      "mul",
      "clamp",
      "softplus",
      "sum",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    log_ratio = ops.sub(lpw, lpl)  # log_prob_w - log_prob_l\n    scaled_delta_rank = ops.clamp(ops.mul(delta_rank, alpha), 0.0, 20.0)  # ensure nonneg and stable\n    weighting = ops.softplus(scaled_delta_rank)  # softplus on scaled delta_rank\n\n    loss_per_pair = ops.mul(weighting, ops.softplus(ops.neg(log_ratio)))  # softplus(-log_ratio) penalizes when log_prob_w < log_prob_l\n    weighted_loss = ops.mul(weight, loss_per_pair)\n    return ops.sum(weighted_loss)",
    "theoretical_basis": ""
  },
