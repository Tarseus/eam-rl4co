  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_weighted_advantage_tanh_exp_asymmetric_clipped_repaired",
    "intuition": "The original candidate failed because the batch lacked the required 'cost_gap' key, causing the evaluation to fail. To fix it, I replaced the missing signal 'cost_gap' with 'delta_rank', which is a valid, available quality signal indicating rank differences in pairs. The loss function clips and applies tanh to delta_rank, computes asymmetric exponential weights emphasizing larger rank gaps, and combines these weights with log probabilities of winners and losers. This maintains the nonlinear asymmetric weighting mechanism, keeps the 'pairwise' mode, includes required keys, and ensures the loss passes all gates successfully.",
    "pseudocode": "delta_rank_clipped = clamp(delta_rank, -10, 10)\ndelta_rank_tanh = tanh(delta_rank_clipped)\nexp_weight = exp(alpha * delta_rank_tanh - 0.2)\nweight_w = exp_weight / (1 + exp_weight)\nweight_l = 1 / (1 + exp_weight)\nloss_w = -weight_w * log_prob_w\nloss_l = weight_l * log_prob_l\nloss = mean(weight * (loss_w + loss_l))",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_gap",
      "signal_family": "delta_rank",
      "link_family": "exp_weight_asymmetric",
      "agg_family": "mean",
      "constraint_family": "clipped"
    },
    "operators_used": [
      "clamp",
      "tanh",
      "exp",
      "neg",
      "add",
      "mean",
      "ones_like",
      "div",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    delta_rank_clipped = ops.clamp(delta_rank, -10.0, 10.0)\n    delta_rank_tanh = ops.tanh(delta_rank_clipped)\n    exp_weight = ops.exp(ops.sub(ops.mul(alpha, delta_rank_tanh), 0.2))\n    denom = ops.add(exp_weight, ops.ones_like(exp_weight))\n    weight_w = ops.div(exp_weight, denom)\n    weight_l = ops.div(ops.ones_like(exp_weight), denom)\n    loss_w = ops.neg(ops.mul(weight_w, lpw))\n    loss_l = ops.mul(weight_l, lpl)\n    combined_loss = ops.mul(weight, ops.add(loss_w, loss_l))\n    return ops.mean(combined_loss)",
    "theoretical_basis": ""
  },
