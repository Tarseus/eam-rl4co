  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_000_cost_scale_invariant_v3",
    "intuition": "Fixed the insensitivity to the objective by incorporating the 'delta_regret' signal into the loss, which directly reflects changes in regret and enhances the loss sensitivity to objective perturbations. The loss now combines the original margin term with a weighted delta_regret term, ensuring the loss changes meaningfully when the objective changes.",
    "pseudocode": "eps=1e-6; margin = (log_prob_w - log_prob_l) / (abs(seq_len_w - seq_len_l) + eps); raw = alpha * scale * margin - 0.1 * cost_gap + 0.5 * delta_regret; x=clamp(raw,-20,20); loss = -logsigmoid(x) weighted mean",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap+delta_regret",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "abs",
      "add",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap",
        "delta_regret",
        "seq_len_w",
        "seq_len_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    cost_gap = batch.get('cost_gap', None)\n    if cost_gap is None:\n        zeros = lpw.new_zeros(lpw.shape)\n        cost_gap = batch.get('cost_b', zeros) - batch.get('cost_a', zeros)\n    delta_regret = batch.get('delta_regret', None)\n    if delta_regret is None:\n        delta_regret = lpw.new_zeros(lpw.shape)\n    seq_len_w = batch.get('seq_len_w', None)\n    seq_len_l = batch.get('seq_len_l', None)\n    if seq_len_w is None or seq_len_l is None:\n        denom = lpw.new_ones(lpw.shape)\n    else:\n        denom = ops.abs(seq_len_w - seq_len_l) + eps\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    margin = (lpw - lpl) / denom\n    raw = alpha * scale * margin - 0.1 * cost_gap + 0.5 * delta_regret\n    x = ops.clamp(raw, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": ""
  },
