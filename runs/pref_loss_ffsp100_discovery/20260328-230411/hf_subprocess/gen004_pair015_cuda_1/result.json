  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_001_cost_scale_invariant_delta_rank_v1",
    "intuition": "Repaired missing 'advantage_gap' signal by replacing it with 'delta_rank', which is available and also reflects objective-related ranking difference between winner and loser. This maintains scale-invariance and ensures gradients remain sensitive to objective signals. Kept the same structure of normalizing margin by sequence length difference and sum aggregation.",
    "pseudocode": "seq_len_diff = abs(seq_len_w - seq_len_l) if available else 1\neps = 1e-6\nmargin = (log_prob_w - log_prob_l) / (seq_len_diff + eps)\naugment = delta_rank * delta_rank_scale\nx = alpha * scale * margin + augment\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nif weight present:\n  loss = loss * weight\nloss = sum(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "abs",
      "add",
      "sum",
      "sub",
      "mul",
      "div",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    seq_len_w = batch.get('seq_len_w', None)\n    seq_len_l = batch.get('seq_len_l', None)\n    if seq_len_w is not None and seq_len_l is not None:\n        seq_len_diff = ops.abs(ops.sub(seq_len_w, seq_len_l))\n    else:\n        seq_len_diff = lpw.new_ones(lpw.shape)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    delta_rank_scale = float(extra.get('hyperparams', {}).get('delta_rank_scale', 1.0))\n    margin = ops.div(ops.sub(lpw, lpl), ops.add(seq_len_diff, eps))\n    augment = ops.mul(delta_rank_scale, delta_rank)\n    x = ops.add(ops.mul(alpha * scale, margin), augment)\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss = ops.mul(loss, weight)\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
