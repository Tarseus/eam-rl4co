  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_gap_weighted_repair_v5",
    "intuition": "Increased the scale factor from 7.0 to 10.0 to further amplify the margin term, increasing sensitivity to log-prob differences. Increased the normalized cost gap weight from 1.5 to 2.0 to put even stronger emphasis on cost gap signals relative to log-prob margin. Added a slightly larger epsilon (1e-5) when computing std_gap to stabilize normalization and avoid near-zero denominator effects. These changes enhance the loss's responsiveness to objective perturbations, addressing the prior failure on objective sensitivity.",
    "pseudocode": "gap = (cost_b - cost_a).detach()\nmean_gap = mean(gap)\nvar_gap = mean((gap - mean_gap)^2)\nstd_gap = sqrt(var_gap + 1e-5)\nnorm_gap = gap / std_gap\nx = alpha * scale * (log_prob_w - log_prob_l) - 2.0 * norm_gap\nx = clamp(x, -10, 10)\nloss = -logsigmoid(x) * weight\nreturn sum(loss)",
    "hyperparams": {
      "scale": "10.0",
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "mean",
      "sqrt",
      "sub",
      "mul",
      "add",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-5\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 10.0))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    mean_gap = ops.mean(gap)\n    var_gap = ops.mean(ops.mul(ops.sub(gap, mean_gap), ops.sub(gap, mean_gap)))\n    std_gap = (var_gap + eps).sqrt()\n    norm_gap = gap / std_gap\n    x = alpha * scale * (lpw - lpl) - 2.0 * norm_gap\n    x = ops.clamp(x, -10.0, 10.0)\n    loss = -ops.logsigmoid(x) * weight\n    return ops.sum(loss)",
    "theoretical_basis": ""
  },
