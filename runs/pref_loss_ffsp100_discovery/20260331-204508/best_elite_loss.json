      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    eps = 1e-8\n    ratio = ops.sub(lpw, lpl)\n    norm_factor = ops.add(ops.abs(lpw), ops.abs(lpl))\n    norm_factor = ops.add(norm_factor, eps)\n    normed_ratio = ops.div(ratio, norm_factor)\n    scale_factor = ops.exp(adv_gap)\n    scaled_ratio = ops.mul(normed_ratio, scale_factor)\n    loss = ops.softplus(ops.neg(scaled_ratio))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
