  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_exp_contrastive_delta_regret",
    "intuition": "This loss shifts from advantage-based ranking losses to a contrastive paradigm using the exponential of the negative regret difference as a similarity measure. It encourages the model to assign higher probabilities to options with lower regret by minimizing an exponential contrastive loss that emphasizes pairs with large delta_regret gaps, promoting robust preference signals.",
    "pseudocode": "pos_score = log_prob_w - log_prob_l\nneg_regret = -delta_regret\nscaled_score = pos_score * exp(neg_regret)\nloss = mean(weight * softplus(-scaled_score))",
    "hyperparams": {
      "paradigm_family": "pairwise_contrastive",
      "signal_family": "delta_regret",
      "link_family": "multiplicative_exponential",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "exp",
      "softplus",
      "mul",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    pos_score = ops.sub(lpw, lpl)\n    neg_regret = ops.neg(delta_regret)\n    scale = ops.exp(neg_regret)\n    scaled_score = ops.mul(pos_score, scale)\n    loss = ops.softplus(ops.neg(scaled_score))\n    weighted_loss = ops.mul(loss, weight)\n    return ops.mean(weighted_loss)",
    "theoretical_basis": ""
  },
