  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "preference_ratio_softplus_advantage_linear",
    "intuition": "Repaired to reduce similarity by replacing the exponential scaling of advantage_gap with a bounded linear scaling. This less aggressive scaling stabilizes training and differentiates the loss from exponential-based variants. It uses a sigmoid to smoothly map advantage_gap to (0,1), then scales the log-probability ratio by this bounded factor before applying softplus. It preserves the emphasis on stronger preferences but avoids the explosive effect of exp(), reducing novelty issues while maintaining effectiveness.",
    "pseudocode": "ratio = log_prob_w - log_prob_l\nscale = sigmoid(advantage_gap)\nloss = softplus(-ratio * scale)\nfinal_loss = mean(loss * weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_log_ratio",
      "signal_family": "advantage_gap",
      "link_family": "multiplicative_sigmoid",
      "agg_family": "mean",
      "constraint_family": "none",
      "other_hparams": ""
    },
    "operators_used": [
      "sub",
      "sigmoid",
      "softplus",
      "mul",
      "mean",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    ratio = ops.sub(lpw, lpl)\n    scale = ops.sigmoid(adv_gap)\n    scaled_ratio = ops.mul(ratio, scale)\n    loss = ops.softplus(ops.neg(scaled_ratio))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": "Using sigmoid instead of exp on the advantage_gap keeps the scaling bounded between 0 and 1, preventing excessive emphasis on very large advantage gaps and improving numerical stability. This introduces smoother gradients for moderate preferences, ensuring stable training while preserving the intuition to weigh preferences by strength."
  },
