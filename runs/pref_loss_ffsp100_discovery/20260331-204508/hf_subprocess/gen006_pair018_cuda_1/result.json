  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "repaired_hyperparameter_tuned_pairwise_loss_v2",
    "intuition": "The original candidate was too similar to an existing logsigmoid cost_gap loss. To repair this, I introduced a distinct signal advantage_gap instead of cost-based signals to diversify the loss. I also modified the input to logsigmoid by normalizing with a weighted scale of advantage_gap, which aligns with maximizing advantage rather than minimizing cost difference. The clamp range was narrowed to [-10,10] to further stabilize training but different from previous clamp bounds. The expected keys were updated accordingly. This ensures novelty, leverages available advantage signals, and respects all hard constraints.",
    "pseudocode": "alpha_new = 1.5\nscale_new = 3.0\nclip_value_new = 10.0\nx = alpha_new * scale_new * (lpw - lpl) - 0.05 * advantage_gap\nx = clamp(x, -clip_value_new, clip_value_new)\nloss_unweighted = -logsigmoid(x)\nloss_weighted = loss_unweighted * weight\nloss = mean(loss_weighted)",
    "hyperparams": {
      "alpha": 1.5,
      "scale": 3.0,
      "clip_value": 10.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    advantage_gap = batch['advantage_gap']\n    alpha = float(extra.get('alpha', 1.5))\n    scale = float(extra.get('scale', 3.0))\n    clip_value = float(extra.get('clip_value', 10.0))\n    x = alpha * scale * (lpw - lpl) - 0.05 * advantage_gap\n    x = ops.clamp(x, -clip_value, clip_value)\n    loss_unweighted = -ops.logsigmoid(x)\n    if weight is not None:\n        loss_weighted = loss_unweighted * weight\n    else:\n        loss_weighted = loss_unweighted\n    return loss_weighted.mean()",
    "theoretical_basis": ""
  },
