  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_softplus_log_ratio_exp_advantage_diff",
    "intuition": "To fix the novelty failure, I replaced the purely multiplicative exponential scaling of the log-probability difference by incorporating both the difference and the advantage gap linearly inside the softplus. This reduces direct exponential scaling that caused excessive similarity to prior losses. The loss now directly encourages higher log-prob_w relative to log-prob_l, offset by advantage_gap, improving gradient stability and distinctiveness.",
    "pseudocode": "ratio = log_prob_w - log_prob_l\nloss_value = softplus(-ratio + advantage_gap)\nfinal_loss = mean(loss_value * weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_log_ratio",
      "signal_family": "advantage_gap",
      "link_family": "additive",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "add",
      "softplus",
      "mul",
      "mean",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    ratio = ops.sub(lpw, lpl)  # shape (batch,)\n    diff = ops.add(ops.neg(ratio), adv_gap)  # -ratio + advantage_gap\n    loss_value = ops.softplus(diff)\n    if weight is not None:\n        loss_value = ops.mul(loss_value, weight)\n    return ops.mean(loss_value)",
    "theoretical_basis": ""
  },
