  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_log_ratio_softplus_advantage_tanh_exp_agg",
    "intuition": "To repair the loss and increase novelty while preserving the original goal of emphasizing advantage gaps, I replaced the pure exponential scaling of advantage_gap with a smooth bounded transform using tanh(advantage_gap) before exponentiation. This limits extreme scaling factors and changes the shape, improving numerical stability and introducing non-linearity that differs from the original exponential scaling alone. The log-probability ratio remains multiplied by this scaled tanh of advantage_gap, followed by softplus to maintain stability and smoothness. This modification preserves the expressive relationship between preference strength and advantage signal but lowers similarity by using tanh and adjusting scale factor calculation.",
    "pseudocode": "ratio = log_prob_w - log_prob_l\nscale_factor = exp(tanh(advantage_gap))\nloss = softplus(-ratio * scale_factor) * weight\nfinal_loss = mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_log_ratio",
      "signal_family": "advantage_gap",
      "link_family": "multiplicative_exponential_tanh",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "tanh",
      "exp",
      "softplus",
      "mul",
      "mean",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    ratio = ops.sub(lpw, lpl)\n    tanh_adv = ops.tanh(adv_gap)\n    scale_factor = ops.exp(tanh_adv)\n    scaled_ratio = ops.mul(ratio, scale_factor)\n    loss = ops.softplus(ops.neg(scaled_ratio))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
