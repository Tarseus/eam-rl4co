  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_regret_normalized_tanh_mean",
    "intuition": "Shift to a pairwise regret-based loss normalizing log-probability difference by total regret magnitude, using a tanh link to softly saturate the penalty, and mean aggregation for smooth gradient signals.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nregret = delta_regret.abs() + epsilon\nnormalized_diff = diff / regret\nloss = tanh(-normalized_diff) * weight\nfinal_loss = mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_regret_normalized",
      "signal_family": "delta_regret",
      "link_family": "tanh",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "abs",
      "add",
      "div",
      "tanh",
      "mul",
      "mean",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    weight = batch.get('weight', None)\n    epsilon = 1e-8\n    diff = ops.sub(lpw, lpl)\n    regret_abs = ops.add(ops.abs(delta_regret), epsilon)\n    normalized_diff = ops.div(diff, regret_abs)\n    loss = ops.tanh(ops.neg(normalized_diff))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
