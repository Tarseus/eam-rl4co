  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_log_ratio_softplus_advantage_scaleinv",
    "intuition": "Normalize the log-probability ratio by the sum of magnitudes to achieve scale-invariance, then apply an exponential scaling on the advantage gap before computing the softplus loss. This ensures that the loss remains stable under arbitrary scaling of log probabilities.",
    "pseudocode": "ratio = log_prob_w - log_prob_l\nnorm_factor = abs(log_prob_w) + abs(log_prob_l) + epsilon\nscale_factor = exp(advantage_gap)\nscaled_ratio = (ratio / norm_factor) * scale_factor\nloss = softplus(-scaled_ratio) * weight\nfinal_loss = mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_log_ratio",
      "signal_family": "advantage_gap",
      "link_family": "multiplicative_exponential",
      "agg_family": "mean",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "sub",
      "abs",
      "add",
      "div",
      "exp",
      "softplus",
      "mul",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    eps = 1e-8\n    ratio = ops.sub(lpw, lpl)\n    norm_factor = ops.add(ops.abs(lpw), ops.abs(lpl))\n    norm_factor = ops.add(norm_factor, eps)\n    normed_ratio = ops.div(ratio, norm_factor)\n    scale_factor = ops.exp(adv_gap)\n    scaled_ratio = ops.mul(normed_ratio, scale_factor)\n    loss = ops.softplus(ops.neg(scaled_ratio))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
