    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv = batch['advantage_gap']\n\n    margin_raw = ops.sub(lpw, lpl)\n    margin_clamped = ops.clamp(margin_raw, 0.0, 1e9)\n    margin = ops.mul(margin_clamped, adv)\n\n    loss = margin\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
