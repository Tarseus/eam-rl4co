  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f003_000_73939e83",
    "ir": {
      "name": "loss_margin_contrastive_loss_delta_regret_softmax_weighted",
      "intuition": "Introduce a contrastive loss paradigm using a softmax over scaled score margins adjusted by delta_regret. This shifts from classical sigmoid/logsigmoid losses to a softmax probability distribution that contrasts the winning and losing scores with regret-based weighting. The aggregation is a weighted mean with a softmax link, enabling better discrimination among pairs and capturing richer interactions from regret signals.",
      "pseudocode": "margin = clamp(log_prob_w - log_prob_l + beta * delta_regret, -10, 10)\nexp_margin = exp(margin)\nexp_neg_margin = exp(-margin)\nsoftmax_prob = exp_margin / (exp_margin + exp_neg_margin + epsilon)\npair_loss = -log(clamp(softmax_prob, 1e-7, 1.0))\nweighted_loss = pair_loss * weight\nloss = sum(weighted_loss) / (sum(weight) + epsilon)",
      "hyperparams": {
        "paradigm_family": "contrastive_pairwise",
        "signal_family": "delta_regret",
        "link_family": "softmax",
        "agg_family": "weighted_mean",
        "constraint_family": "clamp_stabilized"
      },
      "operators_used": [
        "clamp",
        "log",
        "mul",
        "div",
        "sum",
        "exp",
        "add",
        "sub",
        "neg"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "delta_regret"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n    margin_raw = ops.add(ops.sub(lpw, lpl), ops.mul(beta, delta_regret))\n    margin = ops.clamp(margin_raw, -10.0, 10.0)\n    exp_margin = ops.exp(margin)\n    exp_neg_margin = ops.exp(ops.neg(margin))\n    denom = ops.add(ops.add(exp_margin, exp_neg_margin), 1e-7)\n    softmax_prob = ops.div(exp_margin, denom)\n    softmax_prob_clamped = ops.clamp(softmax_prob, 1e-7, 1.0)\n    pair_loss = ops.neg(ops.log(softmax_prob_clamped))\n    weighted_loss = ops.mul(pair_loss, weight)\n    total_weight = ops.sum(weight) + 1e-7\n    loss = ops.div(ops.sum(weighted_loss), total_weight)\n    return loss",
      "theoretical_basis": ""
    }
  },
