    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f007_007_771bdf00",
    "ir": {
      "name": "loss_kl_divergence_001_advantage_stabilized",
      "intuition": "Simplified and stabilized the KL divergence computation by clamping the probabilities to avoid log(0) and numerical instability. Replaced mean aggregation to better stabilize gradient scale with weighted mean respecting sample weights. Ensured weights default safely to ones if missing. This reduces numerical stress and avoids instability with very small or large values in target and predicted probabilities.",
      "pseudocode": "p = sigmoid(log_prob_w - log_prob_l)\ntarget = sigmoid(advantage_w - advantage_l)\np = clamp(p, epsilon, 1 - epsilon)\ntarget = clamp(target, epsilon, 1 - epsilon)\nloss = target * log(target / p) + (1 - target) * log((1 - target) / (1 - p))\nweighted_loss = loss * weight\nfinal_loss = mean(weighted_loss)",
      "hyperparams": {
        "paradigm_family": "pairwise_kl_divergence",
        "signal_family": "advantage_gap",
        "link_family": "sigmoid",
        "agg_family": "mean",
        "constraint_family": "clamp_stabilized"
      },
      "operators_used": [
        "sigmoid",
        "log",
        "sub",
        "mul",
        "add",
        "mean",
        "clamp"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_w",
          "advantage_l"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_w = batch['advantage_w']\n    advantage_l = batch['advantage_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    \n    p = ops.sigmoid(ops.sub(lpw, lpl))\n    target = ops.sigmoid(ops.sub(advantage_w, advantage_l))\n    \n    epsilon = 1e-6\n    p = ops.clamp(p, epsilon, 1 - epsilon)\n    target = ops.clamp(target, epsilon, 1 - epsilon)\n    \n    term1 = ops.mul(target, ops.log(ops.div(target, p)))\n    term2 = ops.mul(ops.sub(ops.ones_like(target), target),\n                     ops.log(ops.div(ops.sub(ops.ones_like(target), target), ops.sub(ops.ones_like(p), p))))\n    kl = ops.add(term1, term2)\n    weighted_kl = ops.mul(kl, weight)\n    return ops.mean(weighted_kl)",
      "theoretical_basis": ""
    }
  },
