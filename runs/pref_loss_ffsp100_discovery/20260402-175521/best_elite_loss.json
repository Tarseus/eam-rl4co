    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    abs_adv = ops.add(ops.abs(adv_gap), epsilon)\n    inv_adv = ops.div(ops.ones_like(abs_adv), abs_adv)\n    l_diff = ops.sub(lpw, lpl)\n    score = ops.mul(l_diff, inv_adv)\n    neg_score = ops.neg(score)\n    loss_vec = ops.softplus(neg_score)\n    if weight is not None:\n        loss_vec = ops.mul(loss_vec, weight)\n    return ops.mean(loss_vec)",
