    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f001_006_21472ebe",
    "ir": {
      "name": "pairwise_margin_rank_advantage_squared",
      "intuition": "To reduce similarity with prior margin-based losses, we replace the linear weighting by advantage_gap's square root with a squared weighting, and flip the hinge to penalize margin violations more sharply. We use the squared advantage_gap to emphasize larger quality differences more strongly, enhancing training signal for more distinguishable pairs while preserving the margin ranking principle.",
      "pseudocode": "diff = log_prob_w - log_prob_l\nhinge = max(0, margin - diff)\nweighting = (abs(advantage_gap)) ** 2\nloss = weighting * hinge\nreturn mean(loss * weight)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "quadratic",
        "agg_family": "mean",
        "constraint_family": "nonnegative"
      },
      "operators_used": [
        "max",
        "abs",
        "mul",
        "mean",
        "pow",
        "sub",
        "zeros_like"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    margin = float(extra.get('margin', 1.0))\n    diff = ops.sub(lpw, lpl)\n    zero = ops.zeros_like(diff)\n    hinge = ops.max(ops.sub(margin, diff), zero)\n    weighting = ops.mul(ops.abs(adv_gap), ops.abs(adv_gap))\n    loss = ops.mul(weighting, hinge)\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.mean(loss)",
      "theoretical_basis": ""
    }
  },
