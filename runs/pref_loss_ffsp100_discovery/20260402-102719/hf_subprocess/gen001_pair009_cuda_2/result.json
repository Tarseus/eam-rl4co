  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_weighted_ranknorm_advantage_gap",
    "intuition": "A pairwise ranking loss that replaces the logistic/logsigmoid link with a rank-normalization approach. It computes a normalized rank gap between winning and losing pairs, then weights this rank difference by a sigmoid-transformed advantage gap. This paradigm uses rank-based normalization for signal contrast combined with soft non-linear weighting, promoting stable and smooth preference gradients while emphasizing pairs with meaningful advantage gaps.",
    "pseudocode": "rank_diff = rank_gap(log_prob_w, log_prob_l)\nweight_sigmoid = sigmoid(advantage_gap)\nweighted_rank_loss = weight * rank_diff * weight_sigmoid\nloss = mean(weighted_rank_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranknorm",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "mean",
      "constraint_family": "weighted_nonnegative"
    },
    "operators_used": [
      "rank_gap",
      "sigmoid",
      "mul",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv_gap = batch['advantage_gap']\n    rank_diff = ops.rank_gap(lpw, lpl)\n    weight_sigmoid = ops.sigmoid(adv_gap)\n    weighted_loss = ops.mul(rank_diff, weight_sigmoid)\n    if weight is not None:\n        weighted_loss = ops.mul(weighted_loss, weight)\n    return ops.mean(weighted_loss)",
    "theoretical_basis": ""
  },
