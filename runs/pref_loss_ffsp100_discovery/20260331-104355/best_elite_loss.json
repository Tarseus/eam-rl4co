  "ir": {
    "name": "loss_advantage_ratio_000",
    "intuition": "Instead of margin-based hinge or logsigmoid losses, this loss normalizes the log probability gap by the advantage gap, creating a ratio that reflects confidence relative to preference strength. The ratio is softly penalized with a smoothplus on the negated ratio, encouraging large positive normalized gaps and actively down-weighting weak preference signals.",
    "pseudocode": "ratio = (log_prob_w - log_prob_l) / (abs(advantage_gap) + epsilon)\nloss = mean(weight * softplus(-ratio))",
