  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_sigmoid_margin_loss",
    "intuition": "Repaired the original tanh-based pairwise loss by replacing the tanh transformation with a sigmoid function on the advantage-weighted log probability difference minus a margin. This formulation provides a smooth, monotonic margin loss that encourages a positive margin between winning and losing log probabilities weighted by advantage difference. It resolves high similarity issues by changing the non-linear transform and adds a margin hyperparameter to enhance separation and training stability.",
    "pseudocode": "adv_gap = advantage_w - advantage_l\nscore_diff = log_prob_w - log_prob_l\nmargin = float(extra.get('margin', 0.1))\nsigmoid_input = beta * adv_gap * (score_diff - margin)\nscaled = sigmoid(sigmoid_input)\nloss = mean(weight * (1 - scaled))",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid_margin",
      "agg_family": "mean",
      "constraint_family": "none",
      "beta": 2.0,
      "margin": 0.1
    },
    "operators_used": [
      "sigmoid",
      "mul",
      "sub",
      "mean",
      "ones_like"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 2.0)))\n    margin = float(extra.get('margin', 0.1))\n    adv_gap = ops.sub(adv_w, adv_l)\n    score_diff = ops.sub(lpw, lpl)\n    offset_score = ops.sub(score_diff, margin)\n    scaled = ops.sigmoid(ops.mul(beta, ops.mul(adv_gap, offset_score)))\n    loss_per_pair = ops.mul(weight, ops.sub(ops.ones_like(scaled), scaled))\n    return ops.mean(loss_per_pair)",
    "theoretical_basis": "This loss encourages the model to assign higher log probabilities to winners than losers by a margin, scaled by the advantage difference. Using sigmoid with a positive margin enforces a margin-based ranking objective that is smooth and gradient-friendly, improving training dynamics and reducing similarity to existing tanh-based losses."
  },
