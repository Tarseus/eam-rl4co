  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_rank_gap_negexp_weighted_mean",
    "intuition": "Transform the pairwise weighted loss using an exponential negative rank gap weighting but aggregate using a weighted mean instead of sum to normalize across pairs. This normalizes the overall loss by total weights, stabilizing updates across batches of varying size or importance weighting.",
    "pseudocode": "delta = log_prob_w - log_prob_l\nrank_scale = exp(-clamp(delta_rank, 0, 20))\nweighted_loss = weight * (-delta * rank_scale)\nloss = sum(weighted_loss) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_weighted_ranking_decay",
      "signal_family": "delta_rank",
      "link_family": "negexp_scale",
      "agg_family": "weighted_mean",
      "constraint_family": "clamp_bounded"
    },
    "operators_used": [
      "exp",
      "clamp",
      "mul",
      "sub",
      "sum",
      "div",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    delta_rank = batch['delta_rank']\n    delta = lpw - lpl\n    rank_scale = ops.exp(-ops.clamp(delta_rank, 0.0, 20.0))\n    loss = -delta * rank_scale\n    if weight is not None:\n        weighted_loss = loss * weight\n        total_weight = ops.sum(weight)\n        total_weight = total_weight if total_weight > 0 else 1.0\n        return ops.sum(weighted_loss) / total_weight\n    else:\n        return ops.mean(loss)",
    "theoretical_basis": ""
  },
