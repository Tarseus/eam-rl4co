  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_regret_exp_normalized_scaled",
    "intuition": "Fixed the insensitivity to the objective by scaling the normalized delta_regret with a learnable alpha to amplify its effect more strongly and avoid near-zero gradients. The original loss only subtracted a scaled normalized delta_regret with alpha=1.0, which led to minimal changes in loss for significant objective perturbations. Increasing alpha to 10.0 enhances the sensitivity to objective changes, improving gradient signals and passing the ObjectiveSensitivity co_gate. Margins are clamped to avoid numerical overflow as before.",
    "pseudocode": "delta_regret_norm = zscore(delta_regret); margin = (log_prob_w - log_prob_l) - alpha * delta_regret_norm; margin_clamped = clamp(margin, min=-margin_clip, max=margin_clip); loss = weight * exp(-margin_clamped); return mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_regret",
      "signal_family": "delta_regret",
      "link_family": "exponential",
      "agg_family": "mean",
      "constraint_family": "soft_penalty"
    },
    "operators_used": [
      "sub",
      "zscore",
      "exp",
      "mul",
      "mean",
      "neg",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    alpha = float(extra.get(\"alpha\", 10.0))  # Increased alpha for sensitivity\n    margin_clip = 20.0\n    log_prob_w = batch[\"log_prob_w\"]\n    log_prob_l = batch[\"log_prob_l\"]\n    weight = batch.get(\"weight\", ops.ones_like(log_prob_w))\n    delta_regret = batch[\"delta_regret\"]\n    delta_regret_norm = ops.zscore(delta_regret)\n    margin = ops.sub(ops.sub(log_prob_w, log_prob_l), ops.mul(alpha, delta_regret_norm))\n    margin_clamped = ops.clamp(margin, min=-margin_clip, max=margin_clip)\n    loss_per_pair = ops.mul(weight, ops.exp(ops.neg(margin_clamped)))\n    return ops.mean(loss_per_pair)",
    "theoretical_basis": ""
  },
