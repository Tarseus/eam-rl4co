  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_logistic_margin_delta_rank_scaled_repaired",
    "intuition": "The original candidate failed because the loss was insensitive to changes in delta_rank, likely due to a fixed margin that did not scale with delta_rank magnitude. To fix this, replaced the fixed margin with a scaled margin proportional to the absolute value of delta_rank, preserving sign direction using safe division. This makes the margin dynamic and sensitive to the objective signal delta_rank, ensuring the loss varies with ranking differences.",
    "pseudocode": "eps = 1e-8\nmargin_base = float(extra.get(\"margin\", 0.1))\ndelta = batch[\"delta_rank\"]\nabs_delta = abs(delta)\nsign_delta = delta / (abs_delta + eps)\nscaled_margin = margin_base * abs_delta * sign_delta\ndiff = log_prob_w - log_prob_l\nadjusted_diff = diff - scaled_margin\npreference = log_sigmoid(weight * adjusted_diff)\nloss = -preference\nreturn mean(loss)",
    "hyperparams": {
      "paradigm_family": "ranking",
      "signal_family": "scalar",
      "link_family": "logistic_margin",
      "agg_family": "pairwise",
      "constraint_family": "preference"
    },
    "operators_used": [
      "logsigmoid",
      "mul",
      "sub",
      "mean",
      "abs",
      "add",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    margin_base = float(extra.get(\"margin\", 0.1))\n    log_prob_w = batch[\"log_prob_w\"]\n    log_prob_l = batch[\"log_prob_l\"]\n    weight = batch[\"weight\"]\n    delta_rank = batch[\"delta_rank\"]\n    abs_delta = ops.abs(delta_rank)\n    sign_delta = ops.div(delta_rank, ops.add(abs_delta, eps))\n    scaled_margin = ops.mul(margin_base, ops.mul(abs_delta, sign_delta))\n    diff = ops.sub(log_prob_w, log_prob_l)\n    adjusted_diff = ops.sub(diff, scaled_margin)\n    preference = ops.logsigmoid(ops.mul(weight, adjusted_diff))\n    loss = ops.mul(preference, -1.0)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
