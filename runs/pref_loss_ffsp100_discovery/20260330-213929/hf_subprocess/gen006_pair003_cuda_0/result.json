  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_loss_logsigmoid_weighted_delta_rank",
    "intuition": "The original loss failed because it required the 'advantage_gap' key which was missing. To fix this, I replaced 'advantage_gap' with another available quality signal 'delta_rank', which also reflects relative ranking changes between winning and losing sequences. This replacement maintains the loss's sensitivity to ranking differences while relying only on keys guaranteed to be present. The logistic weighting structure and the weighting by 'weight' are preserved as in the original design.",
    "pseudocode": "preference_score = logsigmoid(weight * (log_prob_w - log_prob_l + alpha * delta_rank)); loss = -sum(preference_score)",
    "hyperparams": {
      "paradigm_family": "ranking",
      "signal_family": "scalar",
      "link_family": "logistic",
      "agg_family": "sum",
      "constraint_family": "preference"
    },
    "operators_used": [
      "logsigmoid",
      "sum",
      "mul",
      "add",
      "neg",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    alpha = float(extra.get(\"alpha\", 1.0))\n    log_prob_w = batch[\"log_prob_w\"]\n    log_prob_l = batch[\"log_prob_l\"]\n    weight = batch[\"weight\"]\n    delta_rank = batch[\"delta_rank\"]\n    combined_signal = ops.add(ops.sub(log_prob_w, log_prob_l), ops.mul(alpha, delta_rank))\n    scaled_signal = ops.mul(weight, combined_signal)\n    preference = ops.logsigmoid(scaled_signal)\n    loss = ops.neg(ops.sum(preference))\n    return loss",
    "theoretical_basis": ""
  },
