  "ir": {
    "name": "pairwise_preference_loss",
    "intuition": "This loss computes a preference score based on the difference in log_probs scaled by their associated quality signals such as cost gap or advantage. By encouraging the model to assign higher probabilities to better options, it directly optimizes for the preference indicated by the signals, leading to better ranking and decision quality.",
    "pseudocode": "preference_score = log_sigmoid(weight * (log_prob_w - log_prob_l) + alpha * signal); loss = -preference_score; return mean(loss)",
    "hyperparams": {
      "paradigm_family": "ranking",
      "signal_family": "scalar",
      "link_family": "logistic",
      "agg_family": "pairwise",
      "constraint_family": "preference"
    },
