    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    alpha = float(extra.get(\"alpha\", 1.0))\n    log_prob_w = batch[\"log_prob_w\"]\n    log_prob_l = batch[\"log_prob_l\"]\n    weight = batch[\"weight\"]\n    cost_gap = batch.get(\"cost_gap\", ops.zeros_like(log_prob_w))\n    # Compute preference score using logistic link\n    signal = cost_gap\n    # Preference based on scaled difference in log probs\n    diff = log_prob_w - log_prob_l\n    preference = ops.logsigmoid(ops.mul(weight, diff) + ops.mul(alpha, signal))\n    loss = -preference\n    return ops.mean(loss)",
