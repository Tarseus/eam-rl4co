      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    epsilon = 1e-6\n    norm_adv = ops.norm(advantage_gap)\n    norm_value = ops.maximum(norm_adv, epsilon)\n    diff = ops.div(ops.sub(lpw, lpl), norm_value)\n    smooth_diff = ops.tanh(diff)\n    scaled_diff = ops.mul(scale, smooth_diff)\n    loss = ops.neg(ops.logsigmoid(scaled_diff))\n    weighted_loss = ops.mul(loss, weight)\n    loss_sum = ops.sum(weighted_loss)\n    total_weight = ops.sum(weight)\n    return ops.div(loss_sum, ops.maximum(total_weight, epsilon))",
