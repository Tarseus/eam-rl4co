  "f_entry": {
    "id": "f000_010_8c1f3fbe",
    "ir": {
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    advantage_gap = batch['advantage_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    epsilon = 1e-6\n    norm_adv_gap = ops.maximum(ops.norm(advantage_gap), epsilon)\n    x = alpha * scale * (lpw - lpl) / norm_adv_gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
      "hyperparams": {
        "agg_family": "mean",
        "constraint_family": "normalization_injected",
        "link_family": "logsigmoid",
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap"
      },
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "mode": "pairwise",
        "returns": "scalar"
      },
      "intuition": "Inject explicit normalization by dividing the scaled log-probability difference by the norm of the advantage gap to ensure scale-invariance and stable gradient magnitudes.",
      "name": "loss_logsigmoid_001_cost_normalized",
      "operators_used": [
        "logsigmoid",
        "clamp",
        "norm",
        "maximum"
      ],
      "pseudocode": "norm = max(norm(advantage_gap), epsilon)\nx = clamp(alpha * scale * (log_prob_w - log_prob_l) / norm, -20, 20)\nloss = -logsigmoid(x)\nloss = loss * weight (if weight exists)\nreturn mean(loss)",
      "theoretical_basis": ""
    }
  },
