  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f000_013_87b4c8d2",
    "ir": {
      "name": "pairwise_advantage_cost_gap_loss",
      "intuition": "This loss encourages the model to prefer pairs with higher advantage scores and larger cost gaps, effectively combining quality and performance signals to promote better decision-making. Using logsigmoid on advantage signals emphasizes confident preferences, while weighting by cost_gap balances the importance of the pairwise differences.",
      "pseudocode": "loss = -mean(logsigmoid(advantage_w - advantage_l) * logsigmoid(cost_gap))",
      "hyperparams": {
        "paradigm_family": "pairwise",
        "signal_family": "advantage",
        "link_family": "sigmoid",
        "agg_family": "mean",
        "constraint_family": "cost_gap",
        "other_hparams": ""
      },
      "operators_used": [
        "logsigmoid",
        "mul",
        "mean"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_w",
          "advantage_l",
          "cost_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    advantage_w = batch['advantage_w']\n    advantage_l = batch['advantage_l']\n    cost_gap = batch['cost_gap']\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n\n    advantage_diff = ops.sub(advantage_w, advantage_l)\n    cost_diff = ops.logsigmoid(cost_gap)\n    pairwise_adv = ops.logsigmoid(advantage_diff)\n    pairwise_cost = ops.logsigmoid(cost_diff)\n    weighted_score = ops.mul(pairwise_adv, pairwise_cost)\n    loss = ops.neg(ops.mean(weighted_score))\n    return loss",
      "theoretical_basis": ""
    }
  },
