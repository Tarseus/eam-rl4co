    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f003_001_002685cb",
    "ir": {
      "name": "advantage_weighted_logsigmoid_pairwise_mean_margin_v1",
      "intuition": "Aggregate the pairwise losses by first computing the weighted negative logsigmoid of a scaled tanh margin normalized by the L2 norm of advantage_gap, then take the mean of weighted losses rather than a normalized sum. This changes the aggregation structure to a weighted mean loss, preserving pairwise semantics and stable scaling.",
      "pseudocode": "epsilon = 1e-6\nnorm_adv = sqrt(mean(advantage_gap * advantage_gap))\nnorm_adv = max(norm_adv, epsilon)\ndiff = (log_prob_w - log_prob_l) / norm_adv\nscaled_diff = scale * tanh(diff)\nloss = -logsigmoid(scaled_diff)\nweighted_loss = loss * weight\ntotal_loss = mean(weighted_loss)\nreturn total_loss",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "logsigmoid",
        "agg_family": "weighted_mean",
        "constraint_family": "symmetric_smooth"
      },
      "operators_used": [
        "logsigmoid",
        "tanh",
        "mul",
        "div",
        "sub",
        "mean",
        "sqrt",
        "maximum",
        "neg"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    advantage_gap = batch['advantage_gap']\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n    epsilon = 1e-6\n\n    sq_adv = ops.mul(advantage_gap, advantage_gap)\n    mean_sq_adv = ops.mean(sq_adv)\n    norm_adv = ops.maximum(ops.sqrt(mean_sq_adv), epsilon)\n\n    diff = ops.div(ops.sub(lpw, lpl), norm_adv)\n    scaled_diff = ops.mul(scale, ops.tanh(diff))\n    loss = ops.neg(ops.logsigmoid(scaled_diff))\n\n    if weight is not None:\n        weighted_loss = ops.mul(loss, weight)\n        total_loss = ops.mean(weighted_loss)\n    else:\n        total_loss = ops.mean(loss)\n\n    return total_loss",
      "theoretical_basis": ""
    }
  },
