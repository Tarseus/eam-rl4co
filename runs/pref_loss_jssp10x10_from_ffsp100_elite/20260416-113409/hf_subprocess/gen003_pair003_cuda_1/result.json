  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_advantage_gap_006_repaired",
    "intuition": "The previous version applied a hard non-negative clamp on advantage_gap, causing zero gradients for negative gaps and leading to joint preference violations. To fix this, I replaced the hard max with a smooth softplus transform on advantage_gap to ensure a non-zero, smooth positive signal that preserves gradient flow even for negative advantages. This adjustment avoids saturation and zero gradients, enabling better gradient direction for both winners and losers. I retained the clamp for numeric stability and scaled the transformed advantage smoothly. This repair ensures gradients push in correct directions, improves swap pass rates, and resolves joint preference failures.",
    "pseudocode": "scale = 1.2\nadv_soft = softplus(advantage_gap)\nx = clamp(scale * adv_soft * (log_prob_w - log_prob_l), -10, 10)\nloss = -logsigmoid(x)",
    "hyperparams": {
      "scale": 1.2,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_modulated_logprob",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "sub",
      "softplus",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    adv_soft = ops.softplus(adv_gap)\n    diff = ops.sub(lpw, lpl)\n    x = ops.mul(scale, adv_soft)\n    x = ops.mul(x, diff)\n    x = ops.clamp(x, -10.0, 10.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return loss.mean()",
    "theoretical_basis": ""
  },
