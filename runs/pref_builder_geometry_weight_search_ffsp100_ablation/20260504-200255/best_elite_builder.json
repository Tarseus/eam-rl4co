    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    rank = feature_cache['rank']\n    # shapes: [batch_size, n]\n    rank_w = rank.unsqueeze(2)  # [batch_size, n, 1]\n    rank_l = rank.unsqueeze(1)  # [batch_size, 1, n]\n    # winner rank exactly one better (lower) than loser\n    is_adjacent = (rank_l - rank_w) == 1\n    # winner objective better than loser (assuming lower_is_better)\n    gap = objective.unsqueeze(2) - objective.unsqueeze(1)  # w - l\n    valid_mask = (gap < 0) & is_adjacent\n    b_idx, w_idx, l_idx = valid_mask.nonzero(as_tuple=True)\n    return PrefBatch(\n        mode='pairwise',\n        pair_idx=(b_idx.to(dtype=torch.int64), w_idx.to(dtype=torch.int64), l_idx.to(dtype=torch.int64)),\n        weight=None,\n        meta={'builder': 'rank_adjacent_positive_gap_pairs'}\n    )"
  },
