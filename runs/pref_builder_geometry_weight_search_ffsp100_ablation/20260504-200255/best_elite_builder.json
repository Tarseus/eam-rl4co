  "ir": {
    "name": "rank_adjacent_positive_gap_pairs",
    "intuition": "Select pairs where the winner rank is exactly one better (lower) than the loser rank and the winner's objective is strictly better (lower) than the loser's, ensuring meaningful adjacent ranking pairs with positive gap for pairwise training.",
    "implementation_hint": {
      "expects": [
        "objective",
        "rank"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
