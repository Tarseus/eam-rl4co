  "g_entry": {
    "id": "g002_004_3282e052",
    "ir": {
      "name": "obj_gap_pos_rank_diff_two_relaxed",
      "intuition": "Select pairs where the winner's rank is one or two positions better (lower) than the loser's and the winner's objective is strictly better (lower) than the loser's, enabling a broader range of ranking gaps with positive objective difference to ensure sufficient pairs for robust pairwise training.",
      "implementation_hint": {
        "expects": [
          "objective",
          "rank"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "rank_two_step_pairs_filter_relaxed",
        "cap_family": "no_cap",
        "weight_family": "gap_linear",
        "constraint_family": "none"
      },
      "operators_used": [
        "sub",
        "ge",
        "le",
        "lt",
        "logical_and",
        "logical_or",
        "nonzero",
        "to"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    rank = feature_cache['rank']\n    rank_w = rank.unsqueeze(2)  # [batch_size, n, 1]\n    rank_l = rank.unsqueeze(1)  # [batch_size, 1, n]\n    diff = rank_l - rank_w\n    is_one_step = diff == 1\n    is_two_step = diff == 2\n    valid_step = is_one_step.logical_or(is_two_step)\n    gap = objective.unsqueeze(2) - objective.unsqueeze(1)  # w - l\n    valid_mask = valid_step.logical_and(gap < 0)\n    b_idx, w_idx, l_idx = valid_mask.nonzero(as_tuple=True)\n    return PrefBatch(\n        mode='pairwise',\n        pair_idx=(b_idx.to(dtype=torch.int64), w_idx.to(dtype=torch.int64), l_idx.to(dtype=torch.int64)),\n        weight=None,\n        meta={'builder': 'obj_gap_pos_rank_diff_two_relaxed'}\n    )"
    }
  },
  "f_entry": {
    "id": "fseed_000_9cfa032c",
    "ir": {
      "name": "weighted_advantage_exp_margin_logsigmoid_scaled_weighted_mean_loss_v4",
      "intuition": "Replaced the linear scaling of (log_prob_w - log_prob_l) by normalizing advantage_gap with an exponential margin term to reduce similarity to prior losses. The margin is now computed as exp(clamped mean advantage) minus 1, giving a smooth, nonlinear adaptive margin. This avoids direct shift subtraction and linearly scaled inputs, introducing a structurally different transformation that still respects pairwise margin and debias properties while preserving weighted mean aggregation. This structural shift improves novelty and numeric stability.",
      "pseudocode": "epsilon=1e-6\nmean_adv = mean(advantage_gap)\nmargin = exp(clamp(abs(mean_adv), 0, 1)) - 1\nnorm = max(mean(norm(advantage_gap)), epsilon)\nx_raw = (log_prob_w - log_prob_l) / norm\nx = margin * x_raw\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nloss_weighted = loss * weight\nreturn sum(loss_weighted) / max(sum(weight), epsilon)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap",
        "link_family": "logsigmoid",
        "agg_family": "weighted_mean",
        "constraint_family": "normalization_exponential_margin"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "norm",
        "mean",
        "maximum",
        "neg",
        "mul",
        "sub",
        "div",
        "abs",
        "exp",
        "sum"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    mean_adv = ops.mean(advantage_gap)\n    margin = ops.sub(ops.exp(ops.clamp(ops.abs(mean_adv), 0.0, 1.0)), 1.0)\n    norm_per_sample = ops.norm(advantage_gap)\n    norm = ops.maximum(ops.mean(norm_per_sample), epsilon)\n    x_raw = ops.div(ops.sub(lpw, lpl), norm)\n    x = ops.mul(margin, x_raw)\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    loss_weighted = ops.mul(loss, weight)\n    loss_mean = ops.div(ops.sum(loss_weighted), ops.maximum(ops.sum(weight), epsilon))\n    return loss_mean",
      "theoretical_basis": ""
    }
  },
