  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_008_advcost_regret_weighted_logsumexp_margin",
    "intuition": "Introduce a nonlinear aggregation by applying log-sum-exp on weighted margins combining advantage gap and cost gap signals, promoting smooth maximum margin emphasis and stabilizing gradients. The aggregation shifts from averaging margins to a soft maximum form, preserving pairwise structure and normalization constraints.",
    "pseudocode": "adv_margin = softplus(advantage_gap * 4.0 - 1.5) * 0.04\ncost_margin = softplus(cost_gap * 3.0 - 1.0) * 0.03\ncombo_margin = adv_margin + cost_margin\nweighted_margins = combo_margin + log(weight + epsilon)\nmax_margin = reduce_max(weighted_margins)\nshifted = weighted_margins - max_margin\nexp_shifted = exp(shifted)\nsum_exp_shifted = sum(exp_shifted)\nlogsumexp_margin = max_margin + log(sum_exp_shifted)\nmargin = logsumexp_margin / (sum(weight) + epsilon)\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -logsigmoid(x) * weight\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_cost_gap",
      "link_family": "logsigmoid_softplus_logsumexp",
      "agg_family": "weighted_logsumexp",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "log",
      "exp",
      "sum",
      "div",
      "add",
      "sub",
      "mul",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n\n    adv_margin = ops.softplus(ops.sub(ops.mul(advantage_gap, 4.0), 1.5)) * 0.04\n    cost_margin = ops.softplus(ops.sub(ops.mul(cost_gap, 3.0), 1.0)) * 0.03\n    combo_margin = ops.add(adv_margin, cost_margin)\n\n    safe_weight = ops.add(weight, eps)\n    weighted_margins = ops.add(combo_margin, ops.log(safe_weight))\n\n    max_margin = ops.sum(weighted_margins)  # replaced ops.max with ops.sum as ops.max missing\n    # For correct logsumexp, we approximate max by sum here as a small patch to fix missing ops.max error\n    shifted = ops.sub(weighted_margins, max_margin)\n    exp_shifted = ops.exp(shifted)\n    sum_exp_shifted = ops.sum(exp_shifted)\n\n    logsumexp_margin = ops.add(max_margin, ops.log(sum_exp_shifted + eps))\n    sum_weight = ops.sum(weight) + eps\n    margin = ops.div(logsumexp_margin, sum_weight)\n\n    x = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), margin)\n    loss_per_pair = ops.mul(ops.neg(ops.logsigmoid(x)), weight)\n    loss = ops.div(ops.sum(loss_per_pair), sum_weight)\n\n    return loss",
    "theoretical_basis": ""
  },
