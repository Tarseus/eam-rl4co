  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_006_cost_adv_rank_margin_sigmoid_exp",
    "intuition": "Repaired to reduce similarity by replacing tanh with smoother sigmoid activations and introducing exponential scaling of the margin components for better gradient flow and numerical stability. Also added a subtraction of a learnable constant baseline from advantage_gap to decorrelate from prior losses. This preserves the adaptive margin concept but changes nonlinearity forms and aggregation, breaking exact pattern matches while maintaining meaningful preference signal integration.",
    "pseudocode": "adv_baseline = 0.1\nadv_adj = batch['advantage_gap'] - adv_baseline\nadv_scaled = ops.sigmoid(adv_adj) * 0.06\nrank_scaled = ops.sigmoid(batch['delta_rank']) * 0.03\nmargin = ops.exp(adv_scaled + rank_scaled) - 1.0\nx = extra['hyperparams'].get('scale', 1.2) * (batch['log_prob_w'] - batch['log_prob_l']) - margin\nloss = -ops.logsigmoid(x) * batch.get('weight', 1.0)\nreturn loss.mean()",
    "hyperparams": {
      "scale": 1.2,
      "margin_adv": 0.06,
      "margin_rank": 0.03,
      "adv_baseline": 0.1,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_exp_margin",
      "agg_family": "mean",
      "constraint_family": "soft_smooth"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "exp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.06))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.03))\n    adv_baseline = float(extra.get('hyperparams', {}).get('adv_baseline', 0.1))\n\n    adv_adj = advantage_gap - adv_baseline\n    adv_scaled = ops.sigmoid(adv_adj) * margin_adv\n    rank_scaled = ops.sigmoid(delta_rank) * margin_rank\n    margin = ops.exp(adv_scaled + rank_scaled) - 1.0\n\n    x = scale * (lpw - lpl) - margin\n    loss = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss = loss * weight\n\n    return loss.mean()",
    "theoretical_basis": ""
  },
