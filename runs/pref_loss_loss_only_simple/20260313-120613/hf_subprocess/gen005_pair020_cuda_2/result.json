  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_bayesian_inference_weighted_pairwise",
    "intuition": "This loss adopts a Bayesian inference paradigm where each pairwise comparison represents evidence updating a latent preference probability. The difference of log probabilities, adjusted by weighted Bayesian update terms derived from advantage_gap as likelihoods, modulates posterior preference confidence. Instead of margin or contrastive frameworks, it models preference likelihoods multiplicatively and aggregates via log posterior odds normalized by total weight, encouraging coherent probabilistic preference estimates sensitive to advantage signals.",
    "pseudocode": "log_odds_prior = 0\nlikelihood = sigmoid(advantage_gap * scale)\nlog_likelihood_ratio = log(likelihood / (1 - likelihood) + epsilon)\nlog_odds_posterior = log_odds_prior + weight * (log_prob_w - log_prob_l) * log_likelihood_ratio\nloss_per_pair = -logsigmoid(log_odds_posterior)\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_bayesian_inference",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid_bayesian_update",
      "agg_family": "weighted_sum_normalized",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "log",
      "mul",
      "sub",
      "add",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    epsilon = 1e-12\n\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    likelihood = ops.sigmoid(ops.mul(advantage_gap, scale))\n    inv_likelihood = ops.sub(ops.ones_like(likelihood), likelihood)\n    likelihood_ratio = ops.div(ops.add(likelihood, epsilon), ops.add(inv_likelihood, epsilon))\n    log_likelihood_ratio = ops.log(likelihood_ratio)\n\n    score_diff = ops.sub(lpw, lpl)\n    posterior_log_odds = ops.mul(score_diff, log_likelihood_ratio)\n\n    if weight is None:\n        weight = ops.ones_like(posterior_log_odds)\n\n    weighted_loss = ops.mul(weight, -ops.logsigmoid(posterior_log_odds))\n    loss = ops.sum(weighted_loss) / (ops.sum(weight) + epsilon)\n\n    return loss",
    "theoretical_basis": ""
  },
