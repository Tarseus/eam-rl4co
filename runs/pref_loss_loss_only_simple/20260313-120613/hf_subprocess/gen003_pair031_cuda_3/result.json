  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_sigmoid_ranked_advantage_gap_weighted_entropy",
    "intuition": "Shift from pairwise margin models to a pairwise comparison paradigm using sigmoid link with ranking-based advantage signals and entropy regularization. The loss encourages the model to prefer winners with higher advantage gaps while also leveraging the difference in entropy between winner and loser to regularize prediction confidence. Aggregation is a weighted sum emphasizing pairs with larger advantage gaps, diverging structurally from margin-based losses and introducing a ranking and entropy-based signal fusion.",
    "pseudocode": "adv_weight = abs(advantage_gap) / (mean(abs(advantage_gap)) + 1e-8)\nrank_factor = rank_gap(delta_rank)\nentropy_diff = entropy_l - entropy_w\nscore = (log_prob_w - log_prob_l) + beta * entropy_diff\nloss_pair = weight * adv_weight * softplus(-score)\nloss = sum(loss_pair) / (sum(weight * adv_weight) + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_comparison",
      "signal_family": "advantage_gap_delta_rank_entropy_diff",
      "link_family": "sigmoid_softplus",
      "agg_family": "weighted_sum_by_advantage",
      "constraint_family": "none"
    },
    "operators_used": [
      "abs",
      "mean",
      "softplus",
      "sum",
      "sub",
      "add",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank",
        "entropy_w",
        "entropy_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    entropy_w = batch.get('entropy_w', ops.zeros_like(lpw))\n    entropy_l = batch.get('entropy_l', ops.zeros_like(lpl))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n\n    adv_abs = ops.abs(advantage_gap)\n    adv_weight = adv_abs / (ops.mean(adv_abs) + 1e-8)\n\n    entropy_diff = entropy_l - entropy_w\n    score = (lpw - lpl) + beta * entropy_diff\n\n    loss_pair = weight * adv_weight * ops.softplus(-score)\n\n    denom = ops.sum(weight * adv_weight) + 1e-8\n    return ops.sum(loss_pair) / denom",
    "theoretical_basis": ""
  },
