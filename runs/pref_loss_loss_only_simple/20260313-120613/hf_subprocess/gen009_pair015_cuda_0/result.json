  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_margin_leakyrelu_v2_fixed",
    "intuition": "Replaced unknown ops.leakyrelu with a valid safe approximation using ops.relu and ops.neg to emulate leakyrelu, preserving original margin smoothing.",
    "pseudocode": "neg_adv_clip = clamp(-advantage_gap, 0, None)\nleaky(neg_adv_clip) = 0.2 * neg_adv_clip + (1 - 0.2) * relu(neg_adv_clip)\nadv_factor = margin_adv * (0.01 * neg_adv_clip + leaky(neg_adv_clip))\ndelta_z_clipped = clamp(delta_z, -3, 3)\ndelta_factor = margin_rank * sigmoid(delta_z_clipped)\nmargin = adv_factor + delta_factor\nx_raw = alpha * scale * (log_prob_w - log_prob_l) - margin\nx_clipped = clamp(x_raw, -4, 4)\nloss_per_pair = -logsigmoid(x_clipped) * weight\nloss = sum(loss_per_pair) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_z",
      "link_family": "logsigmoid_leakyrelu_sigmoid_margin_additive",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_normalization",
      "other_hparams": "scale=1.0, margin_adv=0.05, margin_rank=0.06"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "relu",
      "sigmoid",
      "sum",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_z = batch['delta_z']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.06))\n\n    neg_adv_clip = ops.clamp(-advantage_gap, 0.0, None)\n    # approximate leakyrelu(x, 0.2) = 0.2 * x + 0.8 * relu(x)\n    leaky = 0.2 * neg_adv_clip + 0.8 * ops.relu(neg_adv_clip)\n    adv_factor = margin_adv * (0.01 * neg_adv_clip + leaky)\n\n    delta_z_clipped = ops.clamp(delta_z, -3.0, 3.0)\n    delta_factor = margin_rank * ops.sigmoid(delta_z_clipped)\n\n    margin = adv_factor + delta_factor\n\n    x_raw = alpha * scale * (lpw - lpl) - margin\n    x_clipped = ops.clamp(x_raw, -4.0, 4.0)\n\n    loss_vec = -ops.logsigmoid(x_clipped)\n    loss_vec = loss_vec * weight\n\n    loss = loss_vec.sum() / (ops.sum(weight) + eps)\n    return loss",
    "theoretical_basis": ""
  },
