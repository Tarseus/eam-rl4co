  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_delta_z_cost_interaction_weighted_logmeanexp_v2_repaired",
    "intuition": "This loss weights the log probability difference by an interaction of sigmoid(delta_z) and relu(cost_gap), clamping cost_gap and intermediate values to ensure numerical stability, then applies a weighted log-mean-exponential aggregation.",
    "pseudocode": "eps=1e-12\ncost_gap_nonneg = relu(cost_gap.clamp(min=0))\ninteraction = sigmoid(delta_z) * cost_gap_nonneg\ndiff = log_prob_w - log_prob_l\nscaled_diff = interaction * diff\nexp_arg = -scaled_diff\nexp_clamped = exp(exp_arg).clamp(min=eps)\nweighted_exp = weight * exp_clamped\nsum_weighted_exp = sum(weighted_exp).clamp(min=eps)\nsum_weight = sum(weight).clamp(min=eps)\nlogmeanexp = log(sum_weighted_exp) - log(sum_weight)\nloss = logmeanexp.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_interaction",
      "signal_family": "delta_z_cost_gap",
      "link_family": "logmeanexp_weighted",
      "agg_family": "weighted_logmeanexp",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "log",
      "exp",
      "sigmoid",
      "relu",
      "sum",
      "mul",
      "sub",
      "neg",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_z",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch[\"log_prob_w\"]\n    lpl = batch[\"log_prob_l\"]\n    delta_z = batch[\"delta_z\"]\n    cost_gap_raw = batch[\"cost_gap\"]\n    cost_gap = ops.relu(cost_gap_raw.clamp(min=0))\n    weight = batch[\"weight\"]\n\n    interaction = ops.mul(ops.sigmoid(delta_z), cost_gap)\n    diff = ops.sub(lpw, lpl)\n    scaled_diff = ops.mul(interaction, diff)\n\n    exp_arg = ops.neg(ops.clamp(scaled_diff, max=100))\n    exp_clamped = ops.exp(exp_arg).clamp(min=eps)\n    weighted_exp = ops.mul(weight, exp_clamped)\n\n    sum_weighted_exp = ops.sum(weighted_exp).clamp(min=eps)\n    sum_weight = ops.sum(weight).clamp(min=eps)\n\n    logmeanexp = ops.log(sum_weighted_exp) - ops.log(sum_weight)\n    return logmeanexp.mean()",
    "theoretical_basis": ""
  },
