  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_regret_regularized_sigmoid_diff_loss",
    "intuition": "Shift the paradigm to a pairwise regularization loss that uses the sigmoid difference directly on weighted log probability differences, modulated by a soft regret penalty derived from delta_regret and cost_gap. Instead of margin-based contrastive loss, the loss enforces preference via a smooth probabilistic margin with explicit penalty encouraging robust regret-sensitive preference separation, aggregating via trimmed mean to reduce outlier effect.",
    "pseudocode": "score_diff = log_prob_w - log_prob_l\nsigmoid_diff = sigmoid(score_diff.clamp(min=1e-8, max=1-1e-8))\nregret_penalty = relu(delta_regret * 10 + cost_gap * 5) * 0.1\nweighted_loss = weight * (-log(sigmoid_diff) + regret_penalty * (1 - sigmoid_diff))\ntrimmed_loss = trimmed_mean(weighted_loss, trim_prop=0.1)\nreturn trimmed_loss",
    "hyperparams": {
      "paradigm_family": "pairwise_regret_regularization",
      "signal_family": "delta_regret_cost_gap",
      "link_family": "sigmoid_penalty_linear_combination",
      "agg_family": "trimmed_mean",
      "constraint_family": "relu_trimming"
    },
    "operators_used": [
      "sigmoid",
      "log",
      "relu",
      "sub",
      "mul",
      "add",
      "mean",
      "clamp",
      "sort"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    score_diff = ops.sub(lpw, lpl)\n    # clamp sigmoid input to avoid log(0) domain errors\n    scaled_score_diff = ops.clamp(score_diff, min=eps, max=1.0 - eps)\n    sigmoid_diff = ops.sigmoid(score_diff)\n    # clamp sigmoid outputs away from 0 and 1 for numeric stability\n    sigmoid_clamped = ops.clamp(sigmoid_diff, min=eps, max=1.0 - eps)\n\n    penalty_base = ops.add(ops.mul(delta_regret, 10.0), ops.mul(cost_gap, 5.0))\n    regret_penalty = ops.relu(penalty_base)\n    regret_penalty = ops.mul(regret_penalty, 0.1)\n\n    loss_per_pair = ops.mul(weight, ops.add(-ops.log(sigmoid_clamped), ops.mul(regret_penalty, ops.sub(1.0, sigmoid_clamped))))\n\n    n = loss_per_pair.shape[0]\n    sorted_loss, _ = loss_per_pair.sort()\n    trim = int(n * 0.1)\n    if n > 2 * trim:\n        trimmed = sorted_loss[trim:n - trim]\n    else:\n        trimmed = sorted_loss\n\n    return ops.mean(trimmed)",
    "theoretical_basis": ""
  },
