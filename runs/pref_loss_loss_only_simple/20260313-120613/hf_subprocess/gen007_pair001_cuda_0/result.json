  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_pairwise_weighted_mean_margin_adaptive_smooth_clamped_v2_repair",
    "intuition": "This loss uses a stable adaptive smooth margin incorporating advantage gap and delta rank, combined with a weighted mean of log-sigmoid differences between winning and losing log probabilities.",
    "pseudocode": "adv_tanh = tanh(advantage_gap)\nadv_sigmoid = sigmoid(advantage_gap)\nadv_scaled = margin_adv * (adv_tanh + epsilon * adv_sigmoid)\nrank_scaled = margin_rank * tanh(delta_rank)\nmargin = adv_scaled + rank_scaled\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nif weight is None: weight = ones_like(loss)\nweighted_mean_loss = sum(exp(log(loss+eps)+log(weight+eps))) / sum(weight)\nreturn weighted_mean_loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_adaptive_smooth_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "tanh",
      "sigmoid",
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "sum",
      "div",
      "exp",
      "log"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.02))\n    epsilon = 0.01\n\n    adv_tanh = ops.tanh(advantage_gap)\n    adv_sigmoid = ops.sigmoid(advantage_gap)\n    adv_scaled = ops.mul(margin_adv, ops.add(adv_tanh, ops.mul(epsilon, adv_sigmoid)))\n    rank_scaled = ops.mul(margin_rank, ops.tanh(delta_rank))\n    margin = ops.add(adv_scaled, rank_scaled)\n\n    x = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), margin)\n    x = ops.clamp(x, -20.0, 20.0)\n\n    loss = -ops.logsigmoid(x)\n\n    if weight is None:\n        weight = ops.ones_like(loss)\n\n    log_weight = ops.log(weight + eps)\n    log_loss = ops.log(loss + eps)\n\n    w_loss_exp = ops.exp(log_loss + log_weight)\n    weighted_sum = ops.sum(w_loss_exp)\n    weight_sum = ops.sum(weight)\n\n    weighted_mean_loss = weighted_sum / weight_sum.clamp(min=eps)\n    return weighted_mean_loss",
    "theoretical_basis": ""
  },
