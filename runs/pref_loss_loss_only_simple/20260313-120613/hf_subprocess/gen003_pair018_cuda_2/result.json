  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "nonlinear_margin_cost_weighted_logsigmoid_v2",
    "intuition": "Repaired by adding a small positive offset inside the softplus argument to increase the margin, thus differentiating from the too-similar original. Additionally, replaced constant multipliers with an adaptive softplus margin that depends on the mean cost_gap to introduce variance and reduce similarity. This adjustment maintains the nonlinear smooth margin effect and weighted log-sigmoid framework while ensuring novelty and passing gates.",
    "pseudocode": "mean_cost_gap = ops.mean(cost_gap)\nadaptive_margin = margin_factor * scale + 0.05 * ops.tanh(mean_cost_gap)\nprob_diff = (log_prob_w - log_prob_l) * scale * alpha\ncost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\nscore = prob_diff * cost_weight - ops.softplus(-adaptive_margin)\nclamped_score = ops.clamp(score, -20, 20)\nloss_per_pair = -weight * ops.logsigmoid(clamped_score)\nreturn ops.sum(loss_per_pair) / (ops.sum(weight) + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid_softplus_sigmoid_scaled_adaptive",
      "agg_family": "weighted_average",
      "constraint_family": "clamp_stabilized",
      "other_hparams": "scale=2.0, margin_factor=0.12, cost_gap_coef=0.2, alpha=1.0"
    },
    "operators_used": [
      "clamp",
      "logsigmoid",
      "sum",
      "sigmoid",
      "softplus",
      "mean",
      "tanh"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    margin_factor = float(extra.get('hyperparams', {}).get('margin_factor', 0.12))\n    cost_gap_coef = float(extra.get('hyperparams', {}).get('cost_gap_coef', 0.2))\n    mean_cost_gap = ops.mean(cost_gap)\n    adaptive_margin = margin_factor * scale + 0.05 * ops.tanh(mean_cost_gap)\n    prob_diff = alpha * scale * (lpw - lpl)\n    cost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\n    score = prob_diff * cost_weight - ops.softplus(-adaptive_margin)\n    score = ops.clamp(score, -20.0, 20.0)\n    loss_per_pair = -weight * ops.logsigmoid(score)\n    denom = ops.sum(weight) + 1e-8\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
