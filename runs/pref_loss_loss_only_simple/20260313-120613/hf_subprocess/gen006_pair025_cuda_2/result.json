  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_weighted_sum_margin_smooth_clamped_v2",
    "intuition": "To address the novelty failure caused by exact duplication, I modified the margin calculation by replacing the sigmoid on advantage_gap with a more sensitive scaling that applies advantage_gap directly with a small smooth tanh adjustment, and also introduced a small epsilon-based adaptive weighting for the margin terms to break symmetry. This preserves the original pairwise margin loss concept but changes the nonlinear transforms and scale factors subtly, avoiding exact duplication. Also ensured weight is always defined, and kept the expects and implementation_hint consistent with the original. These changes maintain stability (clamping), proper scaling, and aggregation, but introduce slight functional novelty.",
    "pseudocode": "adv_scaled = advantage_gap * margin_adv + tanh(advantage_gap) * epsilon\nrank_scaled = tanh(delta_rank) * margin_rank\nmargin = adv_scaled + rank_scaled\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nx = clamp(x, -20, 20)\nloss_per_pair = -logsigmoid(x) * weight\nloss = sum(loss_per_pair) / (sum(weight) + 1e-8)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin",
      "agg_family": "weighted_sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "tanh",
      "logsigmoid",
      "clamp",
      "sum",
      "sub",
      "mul",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.02))\n    epsilon = 0.01\n\n    adv_scaled = ops.add(ops.mul(advantage_gap, margin_adv), ops.mul(ops.tanh(advantage_gap), epsilon))\n    rank_scaled = ops.mul(ops.tanh(delta_rank), margin_rank)\n    margin = ops.add(adv_scaled, rank_scaled)\n\n    x = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), margin)\n    x = ops.clamp(x, -20, 20)\n\n    loss = -ops.logsigmoid(x)\n\n    if weight is None:\n        weight = ops.ones_like(loss)\n\n    weighted_loss = ops.mul(loss, weight)\n    loss_scalar = ops.div(ops.sum(weighted_loss), ops.sum(weight) + 1e-8)\n    return loss_scalar",
    "theoretical_basis": ""
  },
