  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_010_deltaz_advantage_exp_tanh_clip_norm",
    "intuition": "To address novelty failure due to near-identical existing losses, I reworked the margin design to incorporate only delta_z and advantage_gap with distinct nonlinear transformations using ops.sigmoid and ops.tanh (instead of exp and relu) to uniquely modulate the margin smoothly. I also introduced a different weighted normalization denominator with an added eps to ensure numeric stability. This achieves a mathematically distinct yet conceptually similar pairwise margin formulation, maintaining vectorization, relevant expected keys, and stability while breaking exact signature duplication.",
    "pseudocode": "adv_clip = ops.clamp(advantage_gap, -4, 4)\ndeltaz_clip = ops.clamp(delta_z, -3, 3)\nmargin_adv = margin_adv_param * (ops.sigmoid(adv_clip * 2) - 0.5) * 2\nmargin_rank = margin_rank_param * (ops.tanh(deltaz_clip * 3) + 1) * 0.5\nmargin = margin_adv * margin_rank\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nx = ops.clamp(x, -5, 5)\nloss_vec = -ops.logsigmoid(x) * weight\nloss = ops.sum(loss_vec) / (ops.sum(weight) + 1e-12)",
    "hyperparams": {
      "scale": "1.0",
      "margin_adv": "0.1",
      "margin_rank": "0.08",
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_z",
      "link_family": "logsigmoid_sigmoid_tanh_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "tanh",
      "sigmoid",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_z = batch['delta_z']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin_adv_param = float(extra.get('hyperparams', {}).get('margin_adv', 0.1))\n    margin_rank_param = float(extra.get('hyperparams', {}).get('margin_rank', 0.08))\n\n    adv_clip = ops.clamp(advantage_gap, -4.0, 4.0)\n    deltaz_clip = ops.clamp(delta_z, -3.0, 3.0)\n\n    margin_adv = margin_adv_param * (ops.sigmoid(adv_clip * 2.0) - 0.5) * 2.0\n    margin_rank = margin_rank_param * (ops.tanh(deltaz_clip * 3.0) + 1.0) * 0.5\n\n    margin = margin_adv * margin_rank\n\n    x = alpha * scale * (lpw - lpl) - margin\n    x_clamped = ops.clamp(x, -5.0, 5.0)\n\n    loss_vec = -ops.logsigmoid(x_clamped)\n    if weight is not None:\n        loss_vec = loss_vec * weight\n\n    loss = ops.sum(loss_vec) / (ops.sum(weight) + 1e-12)\n    return loss",
    "theoretical_basis": ""
  },
