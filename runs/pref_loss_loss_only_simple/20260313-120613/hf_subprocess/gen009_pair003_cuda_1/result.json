  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "rankregret_exponential_regret_margin_loss",
    "intuition": "Transforms the pairwise loss into a regret-focused paradigm by explicitly incorporating delta_regret as a penalization factor via an exponential link function. The loss models the regret-weighted margin between winning and losing log-probs. It aggregates using a normalized weighted sum with a squared weight regularization constraint to encourage stable gradients and control overdominant pairs. This shifts from margin-based preference to regret-aware optimization emphasizing pairs with larger ranking regret.",
    "pseudocode": "regret_factor = exp(clamp(delta_regret, 0, 5))\nmargin = margin_base * regret_factor\nscore = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = weight * -logsigmoid(score)\nreg_constraint = mean(weight ** 2)\nloss = (sum(loss_per_pair) / (sum(weight) + 1e-12)) + lambda_reg * reg_constraint",
    "hyperparams": {
      "paradigm_family": "pairwise_regret",
      "signal_family": "delta_regret",
      "link_family": "logsigmoid_exp_margin",
      "agg_family": "weighted_normalized_sum_plus_l2_constraint",
      "constraint_family": "weight_sqr_regularization"
    },
    "operators_used": [
      "logsigmoid",
      "exp",
      "clamp",
      "sum",
      "mean",
      "mul",
      "div",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin_base = float(extra.get('hyperparams', {}).get('margin_base', 0.05))\n    lambda_reg = float(extra.get('hyperparams', {}).get('lambda_reg', 0.1))\n\n    delta_regret_clamped = ops.clamp(delta_regret, 0.0, 5.0)\n    regret_factor = ops.exp(delta_regret_clamped)\n\n    margin = margin_base * regret_factor\n    score = alpha * scale * (lpw - lpl) - margin\n\n    loss_per_pair = -ops.logsigmoid(score) * weight\n\n    weighted_loss = ops.sum(loss_per_pair)\n    weight_sum = ops.sum(weight) + 1e-12\n    normalized_loss = weighted_loss / weight_sum\n\n    reg_constraint = ops.mean(weight * weight)\n\n    loss = normalized_loss + lambda_reg * reg_constraint\n    return loss",
    "theoretical_basis": ""
  },
