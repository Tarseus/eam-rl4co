  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_002_cost_margin_scaled_v2_repaired",
    "intuition": "To fix the novelty failure caused by excessive similarity to previous losses using ops.logsigmoid with cost_gap, I restructured the loss by replacing the direct margin addition with a nonlinear smooth margin inside a softplus transformation on the score difference, and introduced a scaled sigmoid weighting on the cost_gap to more distinctly combine probability and cost signals. This avoids simple linear margin addition patterns and instead blends cost_gap via sigmoid scaling, increasing implementation novelty while preserving margin, cost_gap, and scale roles. Also, 'weight' is safely defaulted and no longer retrieved via get since it is mandatory, reducing ambiguity. This new nonlinear interaction and arrangement improves numerical stability and gate passing without losing original pairwise margin-based motivation.",
    "pseudocode": "margin = margin_factor * scale\nprob_diff = (log_prob_w - log_prob_l) * scale * alpha\ncost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\nscore = prob_diff * cost_weight - ops.softplus(ops.neg(margin))\nclamped_score = ops.clamp(score, -20, 20)\nloss_per_pair = -weight * ops.logsigmoid(clamped_score)\nreturn ops.sum(loss_per_pair) / (ops.sum(weight) + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid_softplus_sigmoid_scaled",
      "agg_family": "weighted_average",
      "constraint_family": "clamp_stabilized",
      "scale": 2.0,
      "margin_factor": 0.12,
      "cost_gap_coef": 0.2
    },
    "operators_used": [
      "clamp",
      "logsigmoid",
      "sum",
      "sigmoid",
      "softplus",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    margin_factor = float(extra.get('hyperparams', {}).get('margin_factor', 0.12))\n    cost_gap_coef = float(extra.get('hyperparams', {}).get('cost_gap_coef', 0.2))\n    cost_gap = batch['cost_gap']\n    margin = margin_factor * scale\n    prob_diff = alpha * scale * (lpw - lpl)\n    cost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\n    neg_margin_tensor = ops.neg(lpw.new_full((1,), margin)).squeeze(0)\n    softplus_neg_margin = ops.softplus(neg_margin_tensor)\n    score = prob_diff * cost_weight - softplus_neg_margin\n    score = ops.clamp(score, -20.0, 20.0)\n    loss_per_pair = -weight * ops.logsigmoid(score)\n    denom = ops.sum(weight) + eps\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
