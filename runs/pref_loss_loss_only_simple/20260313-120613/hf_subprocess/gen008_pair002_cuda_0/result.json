  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_009_costgap_adv_zscale_expclip",
    "intuition": "Repaired the loss to increase novelty by shifting margin calculation to use advantage_gap with an exponential decay combined with delta_z (instead of delta_rank) for rank influence, introducing explicit symmetric clipping on delta_z and x_raw scores for numerical stability. Changed margin computation to depend on advantage_gap with a decay, and replaced delta_rank with delta_z to use a different quality signal, ensuring the expects list includes delta_z (removing delta_rank). Loss normalization uses weighted mean to reduce variance, preventing numerical overflow by clamping values. This avoids similarity to prior losses relying on delta_rank and softplus on advantage_gap, thus improving novelty and adherence to constraints.",
    "pseudocode": "adv_factor = 0.04 * exp(-clamp(-advantage_gap, 0, None) * 4)\ndelta_z_clamped = clamp(delta_z, -3, 3)\nrank_factor = 0.03 * (tanh(delta_z_clamped * 3) + 1) * 0.5\nmargin = adv_factor * rank_factor\nx_raw = alpha * scale * (log_prob_w - log_prob_l) - margin\nx_clipped = clamp(x_raw, -4, 4)\nloss_per_pair = -logsigmoid(x_clipped) * weight\nloss = sum(loss_per_pair) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_z",
      "link_family": "logsigmoid_exp_tanh_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_symmetry_scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "exp",
      "tanh",
      "clamp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_z",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_z = batch['delta_z']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    neg_adv_clip = ops.clamp(-advantage_gap, min=0.0)  # clamp from below at 0\n    adv_factor = 0.04 * ops.exp(-neg_adv_clip * 4.0)\n    delta_z_clamped = ops.clamp(delta_z, -3.0, 3.0)\n    rank_factor = 0.03 * (ops.tanh(delta_z_clamped * 3.0) + 1.0) * 0.5\n    margin = adv_factor * rank_factor\n\n    x_raw = alpha * scale * (lpw - lpl) - margin\n    x_clipped = ops.clamp(x_raw, -4.0, 4.0)\n\n    loss_per_pair = -ops.logsigmoid(x_clipped) * weight\n    denom = ops.sum(weight) + eps\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
