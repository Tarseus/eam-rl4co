  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_009_cost_adv_rank_smooth_clipnorm_v4_diffmargin",
    "intuition": "This loss function balances multiple quality signals by combining advantage gap, delta rank, and cost gap with smooth nonlinear transforms and margins. It applies clipping and normalization to ensure stability and scale invariance while preventing excessive similarity between candidates.",
    "pseudocode": "adv_component = margin_adv * (ops.tanh(advantage_gap * 5) * 0.5 + 0.5)\nrank_component = margin_rank * ops.tanh(delta_rank * 4)\ncost_component = ops.clamp(cost_gap * 0.12 - 0.01, -0.06, 0.06)\nmargin_raw = adv_component + rank_component + cost_component - 0.02\nmargin = ops.clamp(margin_raw, -0.06, 0.12)\nscaled_diff = alpha * scale * (log_prob_w - log_prob_l)\nx_raw = scaled_diff - margin\nx_clipped = ops.clamp(x_raw, -5, 5)\nloss_per_pair = -ops.logsigmoid(x_clipped) * weight\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "scale": "1.4",
      "margin_adv": "0.055",
      "margin_rank": "0.073",
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank_costgap",
      "link_family": "logsigmoid_smooth_tanh_margin_additive",
      "agg_family": "mean",
      "constraint_family": "clipping_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "tanh",
      "clamp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.4))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.055))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.073))\n\n    adv_component = margin_adv * (ops.tanh(advantage_gap * 5) * 0.5 + 0.5)\n    rank_component = margin_rank * ops.tanh(delta_rank * 4)\n    cost_component = ops.clamp(cost_gap * 0.12 - 0.01, -0.06, 0.06)\n\n    margin_raw = adv_component + rank_component + cost_component - 0.02\n    margin = ops.clamp(margin_raw, -0.06, 0.12)\n\n    scaled_diff = alpha * scale * (lpw - lpl)\n    x_raw = scaled_diff - margin\n    x_clipped = ops.clamp(x_raw, -5.0, 5.0)\n\n    loss_vec = -ops.logsigmoid(x_clipped) * weight\n    loss = loss_vec.sum() / (weight.sum() + eps)\n    return loss",
    "theoretical_basis": ""
  },
