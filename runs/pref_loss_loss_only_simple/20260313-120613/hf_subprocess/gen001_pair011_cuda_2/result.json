  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_ranking_margin_softplus_advantage",
    "intuition": "Introduce a pairwise ranking loss paradigm that replaces the classic log-sigmoid margin with a pairwise hinge-like margin softened by softplus, incorporating advantage_gap as a smooth scaling factor inside the margin. This paradigm shifts from probabilistic preference learning to a margin-based ranking loss that maintains gradient flow via softplus and uses a different aggregation (mean of positive margins) emphasizing pairwise ranking constraints with smoothly scaled margins reflecting advantage signals.",
    "pseudocode": "adv_scale = sigmoid(advantage_gap)\nmargin = softplus(margin_base - adv_scale * (log_prob_w - log_prob_l))\nloss = mean(weight * margin)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "advantage_gap",
      "link_family": "softplus_hinge",
      "agg_family": "mean",
      "constraint_family": "smooth_margin"
    },
    "operators_used": [
      "sigmoid",
      "softplus",
      "mean",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    weight = batch.get('weight', None)\n    margin_base = float(extra.get('margin_base', 1.0))\n\n    adv_scale = ops.sigmoid(advantage_gap)\n    diff = lpw - lpl\n    margin = ops.softplus(margin_base - adv_scale * diff)\n\n    if weight is not None:\n        loss = margin * weight\n    else:\n        loss = margin\n\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
