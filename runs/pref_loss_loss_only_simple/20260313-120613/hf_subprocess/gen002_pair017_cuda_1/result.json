  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_005_adv_rank_smooth_margin_clamped",
    "intuition": "Added clamping to advantage_gap and delta_rank inputs to limit extreme values, improving numerical stability. Used sigmoid and tanh to smoothly scale advantage_gap and delta_rank, then combined them as a soft margin adjustment inside a logsigmoid pairwise loss. Clamping avoids invalid expects or gradient explosions from extremely large magnitude signals. Kept mean aggregation and weighting by provided weight. This simplifies and stabilizes the margin incorporation, ensuring gradients flow while preventing instability.",
    "pseudocode": "adv_clamped = clamp(advantage_gap, -10, 10)\nrank_clamped = clamp(delta_rank, -10, 10)\nadv_scaled = sigmoid(adv_clamped) * margin_adv\nrank_scaled = tanh(rank_clamped) * margin_rank\nmargin = adv_scaled + rank_scaled\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss = -logsigmoid(x) * weight\nloss = mean(loss)",
    "hyperparams": {
      "scale": 1.2,
      "margin_adv": 0.05,
      "margin_rank": 0.02,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin",
      "agg_family": "mean",
      "constraint_family": "clamp_smooth"
    },
    "operators_used": [
      "clamp",
      "sigmoid",
      "tanh",
      "logsigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.02))\n\n    adv_clamped = ops.clamp(advantage_gap, -10.0, 10.0)\n    rank_clamped = ops.clamp(delta_rank, -10.0, 10.0)\n\n    adv_scaled = ops.sigmoid(adv_clamped) * margin_adv\n    rank_scaled = ops.tanh(rank_clamped) * margin_rank\n    margin = adv_scaled + rank_scaled\n\n    x = alpha * scale * (lpw - lpl) - margin\n    loss = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss = loss * weight\n\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
