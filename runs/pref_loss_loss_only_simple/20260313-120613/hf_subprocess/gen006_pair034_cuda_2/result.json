  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_ranked_binary_cross_entropy_exp_advantage_gap",
    "intuition": "This loss adopts a ranking paradigm different from margin-based or smooth margin formulations by interpreting pairwise preferences as noisy binary classification problems. It uses the advantage gap as a signal to scale the logistic sigmoid of the difference in log probabilities, turning the problem into a weighted cross-entropy where the positive label probability depends on the transformed advantage gap. The aggregation is a normalized sum of pairwise binary cross-entropy losses weighted by given weights, promoting sharper separability based on advantage_gap signals. This paradigm shift moves from margin-based continuous relaxations to probabilistic binary classification-based preference modeling.",
    "pseudocode": "pos_prob = sigmoid(advantage_gap * adv_scale)\nlogits = log_prob_w - log_prob_l\nloss_per_pair = -weight * (pos_prob * log_sigmoid(logits) + (1 - pos_prob) * log_sigmoid(-logits))\nreturn sum(loss_per_pair) / (sum(weight) + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking_binary_classification",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid_logsigmoid_bce_mixture",
      "agg_family": "weighted_sum_normalized",
      "constraint_family": "none"
    },
    "operators_used": [
      "sigmoid",
      "logsigmoid",
      "sub",
      "mul",
      "add",
      "sum",
      "div",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    advantage_gap = batch['advantage_gap']\n\n    adv_scale = float(extra.get('adv_scale', extra.get('hyperparams', {}).get('adv_scale', 1.0)))\n\n    pos_prob = ops.sigmoid(advantage_gap * adv_scale)\n    logits = ops.sub(lpw, lpl)\n\n    log_sigmoid_pos = ops.logsigmoid(logits)\n    log_sigmoid_neg = ops.logsigmoid(ops.neg(logits))\n\n    loss_per_pair = -weight * (ops.mul(pos_prob, log_sigmoid_pos) + ops.mul((1 - pos_prob), log_sigmoid_neg))\n\n    denom = ops.sum(weight) + 1e-8\n    loss = ops.sum(loss_per_pair) / denom\n    return loss",
    "theoretical_basis": ""
  },
