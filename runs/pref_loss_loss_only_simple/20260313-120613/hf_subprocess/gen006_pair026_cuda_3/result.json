  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_007_cost_adv_gap_normalized_l2",
    "intuition": "Inject explicit normalization to make the loss scale-invariant by normalizing the weighted negative logsigmoid loss with the L2 norm of the weights, ensuring stable gradients and preventing trivial scaling of weights to manipulate loss magnitude.",
    "pseudocode": "margin = margin_factor * scale\nprob_diff = (log_prob_w - log_prob_l) * scale * alpha\ncost_weight = sigmoid(cost_gap_coef * cost_gap)\nscore = prob_diff * cost_weight - softplus(-margin_tensor)\nclamped_score = clamp(score, -20, 20)\nloss_per_pair = -weight * logsigmoid(clamped_score)\nnorm_factor = sqrt(sum(weight^2)) + eps\nloss = sum(loss_per_pair) / norm_factor",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid_softplus_sigmoid_scaled",
      "agg_family": "weighted_sum_normalized_l2",
      "constraint_family": "normalization_l2"
    },
    "operators_used": [
      "clamp",
      "logsigmoid",
      "sum",
      "sigmoid",
      "softplus",
      "sqrt",
      "pow"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    margin_factor = float(extra.get('hyperparams', {}).get('margin_factor', 0.12))\n    cost_gap_coef = float(extra.get('hyperparams', {}).get('cost_gap_coef', 0.2))\n    margin = margin_factor * scale\n    margin_tensor = lpw.new_full(lpw.shape, margin)\n    prob_diff = alpha * scale * (lpw - lpl)\n    cost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\n    score = prob_diff * cost_weight - ops.softplus(-margin_tensor)\n    score = ops.clamp(score, -20.0, 20.0)\n    loss_per_pair = -weight * ops.logsigmoid(score)\n    norm_factor = ops.sqrt(ops.sum(weight.pow(2))) + eps\n    return ops.sum(loss_per_pair) / norm_factor",
    "theoretical_basis": ""
  },
