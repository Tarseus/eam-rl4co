  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_clipped_normalized_loss",
    "intuition": "This loss applies a clipping to the scaled difference between log probabilities to reduce the influence of outliers and stabilize gradients. Normalizing the weighted loss ensures scale invariance and fair contribution across pairs. The signals used (log_prob_w, log_prob_l, weight, advantage_gap, delta_z) are selected to guide the model to prefer higher quality pairs while controlling for scale and outliers, making it effective in RL4CO settings.",
    "pseudocode": "scale_factor = 1.3\nclipping_threshold = 4.0\nmargin_adjustment = advantage_gap * exp(-abs(delta_z))\nraw_diff = scale_factor * (log_prob_w - log_prob_l) - margin_adjustment\nclipped_diff = raw_diff.clamp(min=-clipping_threshold, max=clipping_threshold)\nloss_per_pair = -logsigmoid(clipped_diff) * weight\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_z",
      "link_family": "logsigmoid_clip",
      "agg_family": "mean",
      "constraint_family": "clipping_normalization",
      "other_hparams": "scale=1.3, clipping_threshold=4.0"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_z = batch['delta_z']\n    weight = batch['weight']\n\n    scale_factor = float(extra.get('hyperparams', {}).get('scale', 1.3))\n    clipping_threshold = float(extra.get('hyperparams', {}).get('clipping_threshold', 4.0))\n\n    margin_adjustment = advantage_gap * ops.exp(-ops.abs(delta_z))\n    raw_diff = scale_factor * (lpw - lpl) - margin_adjustment\n    clipped_diff = raw_diff.clamp(min=-clipping_threshold, max=clipping_threshold)\n\n    loss_vec = -ops.logsigmoid(clipped_diff) * weight\n\n    loss = loss_vec.sum() / (ops.sum(weight) + eps)\n    return loss",
    "theoretical_basis": ""
  },
