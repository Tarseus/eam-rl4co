  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_rank_margin_shifted_scaled_v2",
    "intuition": "The original loss failed novelty due to being too similar to an existing loss, mainly because the margin computation and scaling closely matched a prior implementation. To fix this, I introduced a more distinct and nonlinear margin by using a sigmoid instead of a simple exponential decay on the shifted advantage_gap, providing a smoother yet different modulation. Additionally, the margin incorporates a shifted and scaled delta_rank inside a sigmoid to create a sigmoid-based smooth margin instead of tanh, further differentiating this shape. The overall margin is then combined multiplicatively with a modified alpha * scale factor that varies the strength adaptively based on the weight, ensuring functional difference while retaining the core advantage/rank combination intuition. These changes alter the nonlinear margin shape and scaling to reduce similarity while preserving meaningful pairwise margin behavior and stable gradients.",
    "pseudocode": "shifted_adv = ops.relu(advantage_gap + 0.02)\nsig_adv = margin_adv * ops.sigmoid(-shifted_adv * 6 + 1.5)\nshifted_rank = ops.relu(delta_rank + 0.3)\nsig_rank = margin_rank * ops.sigmoid(shifted_rank * 3 - 1.2)\nmargin = sig_adv * sig_rank\nadaptive_scale = scale * (1 + 0.3 * (weight / (weight.sum() + 1e-12)))\nx = alpha * adaptive_scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -ops.logsigmoid(x) * weight\nloss = loss_per_pair.sum() / (weight.sum() + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_sigmoid_margin_shifted_scaled",
      "agg_family": "mean",
      "constraint_family": "soft_smooth",
      "other_hparams": "scale=1.1, margin_adv=0.035, margin_rank=0.045"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "relu"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.1))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.035))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.045))\n\n    shifted_adv = ops.relu(advantage_gap + 0.02)\n    sig_adv = margin_adv * ops.sigmoid(-shifted_adv * 6 + 1.5)\n\n    shifted_rank = ops.relu(delta_rank + 0.3)\n    sig_rank = margin_rank * ops.sigmoid(shifted_rank * 3 - 1.2)\n\n    margin = sig_adv * sig_rank\n\n    weight_sum = weight.sum() + 1e-12\n    adaptive_scale = scale * (1.0 + 0.3 * (weight / weight_sum))\n\n    x = alpha * adaptive_scale * (lpw - lpl) - margin\n    loss = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss = loss * weight\n\n    return loss.sum() / weight_sum",
    "theoretical_basis": ""
  },
