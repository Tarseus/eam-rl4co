    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_005_cost_gap_normalized_scale_clipped",
    "intuition": "Introduce explicit normalization of weights, apply scale invariance through normalization of score differences, and clip the final score to a fixed range to stabilize training and enforce consistent magnitude, improving robustness and novelty.",
    "pseudocode": "weight_sum = sum(weight) + epsilon\nnorm_weight = weight / weight_sum\nscaled_prob_diff = scale * (log_prob_w - log_prob_l)\ncost_weight = sigmoid(cost_gap_coef * cost_gap)\nscore = scaled_prob_diff * cost_weight\nclamped_score = clamp(score, -10, 10)\nloss_per_pair = -norm_weight * logsigmoid(clamped_score)\nloss = sum(loss_per_pair)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid_sigmoid_scaled",
      "agg_family": "weighted_normalized_sum",
      "constraint_family": "normalization_scale_clipping"
    },
    "operators_used": [
      "sum",
      "sigmoid",
      "logsigmoid",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    cost_gap_coef = float(extra.get('hyperparams', {}).get('cost_gap_coef', 0.2))\n    eps = 1e-8\n\n    weight_sum = ops.sum(weight) + eps\n    norm_weight = weight / weight_sum\n\n    scaled_prob_diff = scale * (lpw - lpl)\n    cost_weight = ops.sigmoid(cost_gap_coef * cost_gap)\n    score = scaled_prob_diff * cost_weight\n\n    score = ops.clamp(score, -10.0, 10.0)\n\n    loss_per_pair = -norm_weight * ops.logsigmoid(score)\n    loss = ops.sum(loss_per_pair)\n    return loss",
    "theoretical_basis": ""
  },
