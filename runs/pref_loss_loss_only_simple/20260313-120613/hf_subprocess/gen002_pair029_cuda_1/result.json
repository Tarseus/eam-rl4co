  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_softplus_margin",
    "intuition": "This preference loss employs a smoothly scaled margin based on advantage gap and delta rank signals, enabling adaptive preference separation while maintaining differentiability. Using softplus instead of hard functions preserves gradient flow and stability, encouraging the model to learn nuanced preferences without abrupt barriers.",
    "pseudocode": "advantage_scaled = softplus(advantage_gap) * margin_factor\nrank_scaled = softplus(delta_rank) * margin_factor\nmargin = advantage_scaled + rank_scaled\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss = -logsigmoid(x) * weight\nloss = loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth",
      "agg_family": "mean",
      "constraint_family": "softplus_smooth",
      "other_hparams": "optional"
    },
    "operators_used": [
      "logsigmoid",
      "softplus"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    margin_factor = float(extra.get('hyperparams', {}).get('margin_factor', 1.0))\n\n    advantage_scaled = ops.softplus(advantage_gap) * margin_factor\n    rank_scaled = ops.softplus(delta_rank) * margin_factor\n    margin = advantage_scaled + rank_scaled\n\n    x = alpha * (ops.logsigmoid(lpw - lpl)) - margin\n    loss = -x\n\n    if weight is not None:\n        loss = loss * weight\n\n    return loss.mean()",
    "theoretical_basis": ""
  },
