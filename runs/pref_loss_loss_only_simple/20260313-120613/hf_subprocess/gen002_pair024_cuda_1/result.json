  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_contrastive_advgap_exp_scale",
    "intuition": "A pairwise contrastive loss that uses an exponential scale of the advantage gap to weigh the log-probability difference, enhancing the distinction between winning and losing sequences more strongly for large advantage gaps. This shifts paradigm from margin-based surrogate to a contrastive weighting approach, linking advantage gap multiplicatively rather than additively, and aggregates via weighted mean without explicit margin subtraction, promoting sharper preference separation.",
    "pseudocode": "adv_gap = advantage_w - advantage_l\nscale = exp(clamp(adv_gap, 0, max_clip))\nx = (log_prob_w - log_prob_l) * scale\nloss = -logsigmoid(x) * weight\nreturn mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_contrastive",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid_multiplicative_exp_scaling",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "sub",
      "exp",
      "clamp",
      "mean",
      "mul",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    weight = batch.get('weight', None)\n    max_clip = float(extra.get('max_clip', 10.0))  # to avoid numerical explosion\n\n    adv_gap = ops.sub(adv_w, adv_l)\n    adv_gap_clamped = ops.clamp(adv_gap, 0.0, max_clip)\n    scale = ops.exp(adv_gap_clamped)\n\n    x = ops.mul(ops.sub(lpw, lpl), scale)\n    loss = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
