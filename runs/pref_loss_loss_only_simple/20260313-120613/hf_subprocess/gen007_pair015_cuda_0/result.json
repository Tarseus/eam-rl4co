  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_008_costgap_adv_clip_exp_tanh_norm_patch",
    "intuition": "Replace missing delta_z with cost_gap for stable margin calculation; clamp variables; keep original idea and operators; ensure safe weighted mean loss.",
    "pseudocode": "adv_factor = margin_adv * exp(-clamp(-advantage_gap, 0, None) * 5)\ncost_gap_clamped = clamp(cost_gap, -3, 3)\nrank_factor = margin_rank * (tanh(cost_gap_clamped * 3) + 1) * 0.5\nmargin = adv_factor * rank_factor\nx_raw = alpha * scale * (log_prob_w - log_prob_l) - margin\nx_clipped = clamp(x_raw, -4, 4)\nloss_per_pair = -logsigmoid(x_clipped) * weight\nloss = sum(loss_per_pair) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_cost_gap",
      "link_family": "logsigmoid_exp_tanh_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "exp",
      "clamp",
      "tanh",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    weight = batch['weight']\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', zeros)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.06))\n\n    neg_adv_clip = ops.clamp(-advantage_gap, 0.0, None)\n    adv_factor = margin_adv * ops.exp(-neg_adv_clip * 5.0)\n\n    cost_gap_clamped = ops.clamp(cost_gap, -3.0, 3.0)\n    rank_factor = margin_rank * (ops.tanh(cost_gap_clamped * 3.0) + 1.0) * 0.5\n\n    margin = adv_factor * rank_factor\n\n    x_raw = alpha * scale * (lpw - lpl) - margin\n    x_clipped = ops.clamp(x_raw, -4.0, 4.0)\n\n    loss_vec = -ops.logsigmoid(x_clipped) * weight\n    loss = ops.sum(loss_vec) / (ops.sum(weight) + eps)\n    return loss",
    "theoretical_basis": ""
  },
