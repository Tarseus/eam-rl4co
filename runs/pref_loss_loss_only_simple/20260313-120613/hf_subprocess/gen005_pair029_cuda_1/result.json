  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_006_cost_margin_normalized",
    "intuition": "Normalize the cost gap by weighted mean absolute gap to reduce sensitivity to scale and maintain stable margin effects.",
    "pseudocode": "gap_raw = cost_b - cost_a\nmean_abs_gap = sum(weight * abs(gap_raw)) / (sum(weight) + eps)\nnormalized_gap = gap_raw / (mean_abs_gap + eps)\nx = clamp(alpha * scale * (log_prob_w - log_prob_l) - cost_gap_coef * normalized_gap + margin, -20, 20)\nloss = -weight * logsigmoid(x)\nresult = sum(loss) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap_normalized",
      "link_family": "logsigmoid_variant",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization",
      "scale": "float",
      "margin_factor": "float",
      "cost_gap_coef": "float",
      "alpha": "float"
    },
    "operators_used": [
      "abs",
      "clamp",
      "sum",
      "logsigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('scale', 1.9496803035382082))\n    margin_factor = float(extra.get('margin_factor', 0.1))\n    cost_gap_coef = float(extra.get('cost_gap_coef', 0.15))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap_raw = cost_b - cost_a\n    mean_abs_gap = ops.sum(weight * ops.abs(gap_raw)) / (ops.sum(weight) + eps)\n    normalized_gap = gap_raw / (mean_abs_gap + eps)\n    margin = margin_factor * scale\n    x = alpha * scale * (lpw - lpl) - cost_gap_coef * normalized_gap + margin\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -weight * ops.logsigmoid(x)\n    return ops.sum(loss) / (ops.sum(weight) + eps)",
    "theoretical_basis": ""
  },
