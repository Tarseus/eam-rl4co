  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_006_cost_adv_rank_margin_prod_then_weighted_v2",
    "intuition": "To reduce similarity to prior losses, replaced the additive margin aggregation by a product of weighted averages of adv_margin and rank_margin, introducing a nonlinear interaction and thus increasing novelty. The adv_margin and rank_margin are computed as before but then aggregated via their weighted means multiplicatively rather than summed. Also applied sigmoid scaling on rank_margin to smooth it differently. This new margin aggregation changes the gradient structure meaningfully while preserving the pairwise margin philosophy. Maintained the pairwise mode and included all required signals.",
    "pseudocode": "adv_margin = softplus(advantage_gap * 5.0 - 2.0) * 0.03\nrank_margin_raw = tanh(delta_rank * 3.0) * 0.025\nrank_margin = sigmoid(rank_margin_raw * 5.0) * 0.025\nweighted_adv_margin = sum(adv_margin * weight) / (sum(weight) + epsilon)\nweighted_rank_margin = sum(rank_margin * weight) / (sum(weight) + epsilon)\nmargin = weighted_adv_margin * (1 + weighted_rank_margin)\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -logsigmoid(x)\nsum_loss = sum(loss_per_pair)\nsum_weight = sum(weight) + epsilon\nloss = sum_loss / sum_weight",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin_v3",
      "agg_family": "product_then_weighted_average",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "tanh",
      "sigmoid",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    eps = 1e-8\n\n    adv_margin = ops.softplus(advantage_gap * 5.0 - 2.0) * 0.03\n    rank_margin_raw = ops.tanh(delta_rank * 3.0) * 0.025\n    rank_margin = ops.sigmoid(rank_margin_raw * 5.0) * 0.025\n\n    sum_weight = ops.sum(weight) + eps\n    weighted_adv_margin = ops.sum(adv_margin * weight) / sum_weight\n    weighted_rank_margin = ops.sum(rank_margin * weight) / sum_weight\n\n    margin = weighted_adv_margin * (1 + weighted_rank_margin)\n\n    x = alpha * scale * (lpw - lpl) - margin\n    loss_per_pair = -ops.logsigmoid(x)\n\n    sum_loss = ops.sum(loss_per_pair)\n    loss = sum_loss / sum_weight\n\n    return loss",
    "theoretical_basis": ""
  },
