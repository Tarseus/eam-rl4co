  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_product_diff_klstyle_advdelta_regret_clipnorm",
    "intuition": "Instead of the usual margin-based paradigm using a single logits difference, this loss models a product-based interaction between exponentiated log probabilities and a scaled advantage-regret gap difference. It mimics a KL-like multiple term interaction by weighting the exponentials of log_prob_w and log_prob_l against advantage-gap and regret-gap signals. The loss clips intermediate terms to prevent exploding gradients and normalizes by total weight. This approach captures joint pairwise dynamics rather than additive margin shifts, exploiting multiplicative interactions of preference signals.",
    "pseudocode": "exp_w = exp(log_prob_w)\nexp_l = exp(log_prob_l)\nadv_regret_scaled = advantage_gap - margin_regret * delta_regret\nadv_regret_clipped = clamp(adv_regret_scaled, -3, 3)\nloss_terms = (exp_l - exp_w) * adv_regret_clipped\nloss_weighted = loss_terms * weight\nloss = sum(loss_weighted) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_product_interaction",
      "signal_family": "advantage_gap_delta_regret",
      "link_family": "exp_diff_linear_clip",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_normalization"
    },
    "operators_used": [
      "exp",
      "clamp",
      "sub",
      "mul",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_regret = batch['delta_regret']\n    weight = batch['weight']\n\n    margin_regret = float(extra.get('hyperparams', {}).get('margin_regret', 0.1))\n\n    exp_w = ops.exp(lpw)\n    exp_l = ops.exp(lpl)\n\n    adv_regret_scaled = ops.sub(advantage_gap, ops.mul(margin_regret, delta_regret))\n    adv_regret_clipped = ops.clamp(adv_regret_scaled, -3.0, 3.0)\n\n    loss_terms = ops.mul(ops.sub(exp_l, exp_w), adv_regret_clipped)\n    loss_weighted = ops.mul(loss_terms, weight)\n\n    loss = ops.sum(loss_weighted) / (ops.sum(weight) + eps)\n    return loss",
    "theoretical_basis": ""
  },
