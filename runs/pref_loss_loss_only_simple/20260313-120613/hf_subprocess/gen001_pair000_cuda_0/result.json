  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_ranked_advantage_margin_softplus_repaired",
    "intuition": "Same pairwise softplus with adaptive margin modulated by advantage gap and delta rank, but replace non-existent argsort with a weighted mean for aggregation to ensure runtime compatibility.",
    "pseudocode": "adv_gap = advantage_w - advantage_l\nbase_margin = scale * adv_gap\nrank_gap_scaled = tanh(delta_rank)\nx = (log_prob_w - log_prob_l) - base_margin * rank_gap_scaled\nlosses = softplus(-x) * weight\nloss = sum(losses) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_weighted",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "softplus_adaptive_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "sub",
      "mul",
      "softplus",
      "mean",
      "tanh",
      "add",
      "div",
      "sum",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    adv_gap = ops.sub(adv_w, adv_l)\n    base_margin = ops.mul(scale, adv_gap)\n    rank_gap_scaled = ops.tanh(delta_rank)\n\n    margin_adaptive = ops.mul(base_margin, rank_gap_scaled)\n    x = ops.sub(ops.sub(lpw, lpl), margin_adaptive)\n\n    losses = ops.mul(ops.softplus(ops.neg(x)), weight)\n\n    sum_loss = ops.sum(losses)\n    sum_weight = ops.sum(weight).clamp(min=eps)\n    loss = sum_loss / sum_weight\n\n    return loss",
    "theoretical_basis": ""
  },
