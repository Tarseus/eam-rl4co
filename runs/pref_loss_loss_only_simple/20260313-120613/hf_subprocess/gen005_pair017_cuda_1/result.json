  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_006_advantage_gap_symmetry_scale_inv_fixed",
    "intuition": "Inject symmetry and scale-invariance by normalizing advantage_gap to zero mean and unit variance across the batch and symmetrically scaling the logit margin. This enforces balanced contribution from positive and negative advantages, removes bias from the margin, and stabilizes training by controlling scale, preserving pairwise preference consistency. Replaced nonexistent ops.std with safe manual std computation.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap'].detach()\n    weight = batch['weight']\n\n    adv_mean = ops.mean(advantage_gap)\n    adv_var = ops.mean((advantage_gap - adv_mean) * (advantage_gap - adv_mean))\n    adv_std = (adv_var + eps).sqrt()\n    adv_norm = (advantage_gap - adv_mean) / adv_std\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n\n    x = alpha * scale * (lpw - lpl) + adv_norm\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_norm_symmetric",
      "link_family": "logsigmoid_symmetric_scaled",
      "agg_family": "mean",
      "constraint_family": "symmetry_scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "mean",
      "sub",
      "mul",
      "add",
      "sqrt"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap'].detach()\n    weight = batch['weight']\n\n    adv_mean = ops.mean(advantage_gap)\n    adv_var = ops.mean(ops.mul(ops.sub(advantage_gap, adv_mean), ops.sub(advantage_gap, adv_mean)))\n    adv_std = ops.sqrt(adv_var + eps)\n    adv_norm = ops.div(ops.sub(advantage_gap, adv_mean), adv_std)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n\n    x = alpha * scale * ops.sub(lpw, lpl) + adv_norm\n    loss = -ops.logsigmoid(x)\n    loss = ops.mul(loss, weight)\n    return loss.mean()",
    "theoretical_basis": ""
  },
