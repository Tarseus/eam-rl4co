    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f000_013_c8d69886",
    "ir": {
      "name": "pairwise_pref_loss_repaired",
      "intuition": "Fixed the loss by removing redundant expected keys log_prob_w_mean and log_prob_l_mean from expects which are unused, and replaced the direct addition of alpha * cost_gap inside logsigmoid with a clamped/smoothed weighting to prevent destabilizing large cost_gap values. This increases numerical stability and novelty. The loss remains a pairwise logistic preference but now includes clamping cost_gap to [-1,1] before scaling, ensuring smoother gradients and stable training, addressing the original failure due to high similarity and lack of novelty.",
      "pseudocode": "clamped_cost_gap = clamp(cost_gap, -1.0, 1.0)\npreference_score = logsigmoid(log_prob_w - log_prob_l + alpha * clamped_cost_gap)\nloss = -mean(preference_score)",
      "hyperparams": {
        "paradigm_family": "pairwise_comparison",
        "signal_family": "preference",
        "link_family": "logistic",
        "agg_family": "mean",
        "constraint_family": "ranking"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "mean"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "cost_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    alpha = float(extra.get(\"alpha\", 1.0))\n    log_prob_w = batch[\"log_prob_w\"]\n    log_prob_l = batch[\"log_prob_l\"]\n    cost_gap = batch[\"cost_gap\"]\n    clamped_cost_gap = ops.clamp(cost_gap, -1.0, 1.0)\n    preference_score = ops.logsigmoid(log_prob_w - log_prob_l + alpha * clamped_cost_gap)\n    loss = -ops.mean(preference_score)\n    return loss",
      "theoretical_basis": ""
    }
  },
