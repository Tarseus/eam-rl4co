  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_smooth_margin_loss_varnorm_adaptive_scale_normalized",
    "intuition": "Inject an explicit normalization constraint by normalizing the weighted loss sum by the total weight, ensuring loss scale is invariant to varying total sample weights and stabilizing training especially when weights vary dynamically.",
    "pseudocode": "eps=1e-6\nvar_adv = ops.mean((advantage_gap - ops.mean(advantage_gap))**2) + eps\nvar_rank = ops.mean((delta_rank - ops.mean(delta_rank))**2) + eps\ninv_var = 1.0 / (var_adv + var_rank)\nadv_norm = advantage_gap / var_adv\nrank_norm = delta_rank / var_rank\nadv_scaled = ops.sigmoid(adv_norm) * margin_adv\nrank_scaled = ops.tanh(rank_norm) * margin_rank\nmargin = adv_scaled + rank_scaled\nadaptive_scale = scale * inv_var\nx = alpha * adaptive_scale * (log_prob_w - log_prob_l) - margin\nloss = -ops.logsigmoid(x) * weight\nloss = loss.sum() / (weight.sum() + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin_varnorm_adaptive",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization",
      "other_hparams": "alpha, scale, margin_adv, margin_rank, eps"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "tanh",
      "mean",
      "add",
      "sub",
      "mul",
      "div",
      "pow"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_gap = batch['advantage_gap']\n    delta_r = batch['delta_rank']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.02))\n    eps = float(extra.get('hyperparams', {}).get('eps', 1e-6))\n\n    mean_adv = ops.mean(adv_gap)\n    mean_rank = ops.mean(delta_r)\n\n    var_adv = ops.mean((adv_gap - mean_adv) * (adv_gap - mean_adv)) + eps\n    var_rank = ops.mean((delta_r - mean_rank) * (delta_r - mean_rank)) + eps\n    inv_var = 1.0 / (var_adv + var_rank)\n\n    adv_normed = adv_gap / var_adv\n    rank_normed = delta_r / var_rank\n\n    adv_scaled = ops.sigmoid(adv_normed) * margin_adv\n    rank_scaled = ops.tanh(rank_normed) * margin_rank\n    margin = adv_scaled + rank_scaled\n\n    adaptive_scale = scale * inv_var\n\n    x = alpha * adaptive_scale * (lpw - lpl) - margin\n\n    loss = -ops.logsigmoid(x) * weight\n    return loss.sum() / (weight.sum() + eps)",
    "theoretical_basis": ""
  },
