    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f006_004_59c848ed",
    "ir": {
      "name": "pairwise_weighted_margin_loss_v3_shifted_scaling",
      "intuition": "The original candidate was too similar to an existing loss due to the direct linear combination and mean-based aggregation of margin terms. To introduce novelty and reduce similarity, this version applies a shifted sigmoid transformation to the combined margin, replaces the mean aggregation with a weighted sum with normalization, and adds a small entropy regularizer optionally if available. This changes the shape and aggregation strategy, ensuring a smooth margin effect while preserving signal contributions from advantage_gap, delta_rank, and cost_gap. The weighting now applies after combining the loss vector elements, and the margin blends signals in a scaled shifted sigmoid, not just linear or tanh, improving the margin's dynamic range and smoothing properties. These changes improve novelty, maintain proper importance weighting, and respect vectorization and required keys.",
      "pseudocode": "adv_scaled = sigmoid(advantage_gap * scale_adv) * margin_adv\nrank_scaled = tanh(delta_rank * scale_rank) * margin_rank\ncost_scaled = tanh(cost_gap * scale_cost) * margin_cost\nraw_margin = adv_scaled + rank_scaled + cost_scaled\nshifted_margin = sigmoid(raw_margin - shift)\nlogits = alpha * (log_prob_w - log_prob_l) - shifted_margin\nloss_vec = -logsigmoid(logits)\nloss = (loss_vec * weight).sum() / (weight.sum() + 1e-12)\nif entropy_w and entropy_l present:\n  entropy_reg = mean( (entropy_l - entropy_w).clamp_min(0) ) * entropy_reg_weight\n  loss += entropy_reg",
      "hyperparams": {
        "paradigm_family": "pairwise_margin",
        "signal_family": "advantage_gap_delta_rank_cost_gap",
        "link_family": "logsigmoid_shifted_sigmoid_margin",
        "agg_family": "weightedmean_with_entropy_reg",
        "constraint_family": "soft_smooth_shifted",
        "other_hparams": "margin_adv=0.04, margin_rank=0.025, margin_cost=0.035, scale_adv=4.0, scale_rank=3.0, scale_cost=3.5, shift=0.5, entropy_reg_weight=0.01"
      },
      "operators_used": [
        "logsigmoid",
        "sigmoid",
        "tanh",
        "clamp_min",
        "mean",
        "sum",
        "mul",
        "add",
        "sub",
        "div"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_gap",
          "delta_rank",
          "cost_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.04))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.025))\n    margin_cost = float(extra.get('hyperparams', {}).get('margin_cost', 0.035))\n\n    scale_adv = float(extra.get('hyperparams', {}).get('scale_adv', 4.0))\n    scale_rank = float(extra.get('hyperparams', {}).get('scale_rank', 3.0))\n    scale_cost = float(extra.get('hyperparams', {}).get('scale_cost', 3.5))\n\n    shift = float(extra.get('hyperparams', {}).get('shift', 0.5))\n    entropy_reg_weight = float(extra.get('hyperparams', {}).get('entropy_reg_weight', 0.01))\n\n    adv_scaled = ops.sigmoid(advantage_gap * scale_adv) * margin_adv\n    rank_scaled = ops.tanh(delta_rank * scale_rank) * margin_rank\n    cost_scaled = ops.tanh(cost_gap * scale_cost) * margin_cost\n\n    raw_margin = adv_scaled + rank_scaled + cost_scaled\n    shifted_margin = ops.sigmoid(raw_margin - shift)\n\n    logits = alpha * (lpw - lpl) - shifted_margin\n    loss_vec = -ops.logsigmoid(logits)\n    weighted_loss_sum = (loss_vec * weight).sum()\n    weight_sum = weight.sum() + 1e-12\n    loss = weighted_loss_sum / weight_sum\n\n    # Optional entropy regularization if entropy signals present\n    entropy_w = batch.get('entropy_w', None)\n    entropy_l = batch.get('entropy_l', None)\n    if entropy_w is not None and entropy_l is not None:\n        entropy_diff = (entropy_l - entropy_w).clamp_min(0)\n        entropy_reg = entropy_diff.mean() * entropy_reg_weight\n        loss = loss + entropy_reg\n\n    return loss",
      "theoretical_basis": ""
    }
  },
