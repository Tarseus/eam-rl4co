  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_inverse_cost_diff_logsigmoid_with_delta_regret",
    "intuition": "Instead of using advantage_gap and delta_rank as signals, this loss pivots to directly use the cost difference and delta_regret signals, incorporating an inverse cost difference scaling to focus more on difficult pairs. The loss applies a log-sigmoid to the scaled log-probability difference modulated inversely by clipped cost_gap, with the output weighted and aggregated via a softplus-transformed nonlinear weighting scheme. This paradigm shift emphasizes penalizing pairs with small cost differences but potentially large regret, changing the signal and aggregation patterns and departing from margin-based losses.",
    "pseudocode": "cost_gap_clipped = clamp(abs(cost_gap), 1e-4, 10)\ninv_cost_scale = 1.0 / cost_gap_clipped\nregret_activation = softplus(delta_regret * 10)\nx = alpha * scale * inv_cost_scale * (log_prob_w - log_prob_l)\nloss_vec = -logsigmoid(x) * weight * regret_activation\nloss = sum(loss_vec) / (sum(weight * regret_activation) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_scaled_inverse",
      "signal_family": "cost_gap_delta_regret",
      "link_family": "logsigmoid_scaled_inversecost_softplus_regret",
      "agg_family": "weighted_sum_normalized",
      "constraint_family": "clamp_softplus_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "clamp",
      "sum",
      "abs",
      "div",
      "mul",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_gap = batch['cost_gap']\n    delta_regret = batch['delta_regret']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    cost_gap_abs = ops.abs(cost_gap)\n    cost_gap_clipped = ops.clamp(cost_gap_abs, 1e-4, 10.0)\n    inv_cost_scale = ops.div(1.0, cost_gap_clipped)\n\n    regret_activation = ops.softplus(delta_regret * 10.0)\n\n    x = ops.mul(alpha * scale, ops.mul(inv_cost_scale, ops.sub(lpw, lpl)))\n\n    loss_vec = -ops.logsigmoid(x)\n    loss_vec_weighted = ops.mul(loss_vec, ops.mul(weight, regret_activation))\n\n    denom = ops.sum(ops.mul(weight, regret_activation)) + 1e-12\n    loss = ops.div(ops.sum(loss_vec_weighted), denom)\n\n    return loss",
    "theoretical_basis": ""
  },
