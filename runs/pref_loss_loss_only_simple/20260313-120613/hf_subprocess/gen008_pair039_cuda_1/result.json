  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_exp_regret_sigmoid_contrast_regularized_safe",
    "intuition": "Same contrastive exponential loss with regret weighting and regularization, fixed for numeric stability by clamping inputs to exp and sigmoid to safe ranges and stabilizing the denominator sum.",
    "pseudocode": "eps = 1e-8\nscaled_diff = scale * (log_prob_w - log_prob_l)\nsigmoid_regret = sigmoid(clamp(delta_regret, -10, 10) * 10)\nexp_term = exp(clamp(-scaled_diff * sigmoid_regret, -50, 50))\nreg_term = reg_coef * abs(delta_regret)\nloss_vec = weight * (exp_term + reg_term)\nloss = sum(loss_vec) / (sum(weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_contrastive",
      "signal_family": "regret_gap",
      "link_family": "product_sigmoid_exponential",
      "agg_family": "weighted_sum_exp_regularized",
      "constraint_family": "regularization_stability"
    },
    "operators_used": [
      "sigmoid",
      "exp",
      "abs",
      "add",
      "mul",
      "sum",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    weight = batch['weight']\n\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    reg_coef = float(extra.get('hyperparams', {}).get('reg_coef', 0.1))\n\n    scaled_diff = scale * (lpw - lpl)\n    safe_delta_regret = ops.clamp(delta_regret, -10.0, 10.0)\n    sigmoid_regret = ops.sigmoid(safe_delta_regret * 10.0)\n    exp_arg = ops.clamp(-scaled_diff * sigmoid_regret, -50.0, 50.0)\n    exp_term = ops.exp(exp_arg)\n    reg_term = ops.mul(reg_coef, ops.abs(delta_regret))\n\n    loss_vec = ops.mul(weight, ops.add(exp_term, reg_term))\n    denom = ops.sum(weight) + eps\n    loss = ops.sum(loss_vec) / denom\n    return loss",
    "theoretical_basis": ""
  },
