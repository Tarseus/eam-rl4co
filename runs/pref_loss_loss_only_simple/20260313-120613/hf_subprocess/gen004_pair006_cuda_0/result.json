  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_bayesian_preference_softplus_advantage_multiplicative",
    "intuition": "Shift paradigm from margin-based to a Bayesian-inspired preference probability loss integrating advantage signals multiplicatively inside a softplus link, emphasizing uncertainty and smooth preference probabilities. It modulates the margin nonlinearly by the product of advantage signals and normalizes aggregation by total weight, enforcing scale invariance and smooth gradient flow without direct linear margin addition.",
    "pseudocode": "adv_product = advantage_w * advantage_l\nmargin = softplus(adv_product * margin_scale + bias) * margin_amp\nscore = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -weight * logsigmoid(score)\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_bayesian",
      "signal_family": "advantage_product",
      "link_family": "logsigmoid_softplus_multiplicative",
      "agg_family": "weighted_average",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "mul",
      "add",
      "sub",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_w = batch['advantage_w']\n    advantage_l = batch['advantage_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin_scale = float(extra.get('hyperparams', {}).get('margin_scale', 4.0))\n    margin_amp = float(extra.get('hyperparams', {}).get('margin_amp', 0.05))\n    bias = float(extra.get('hyperparams', {}).get('bias', -1.0))\n\n    adv_product = ops.mul(advantage_w, advantage_l)\n    margin = ops.softplus(ops.add(ops.mul(adv_product, margin_scale), bias))\n    margin = ops.mul(margin, margin_amp)\n\n    score = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), margin)\n    loss_per_pair = ops.mul(weight, -ops.logsigmoid(score))\n\n    denom = ops.sum(weight) + 1e-8\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
