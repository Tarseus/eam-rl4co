  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_regret_margin_ratio_loss",
    "intuition": "Shift from additive margin pairwise losses to a ratio-based margin loss using delta_regret and cost_gap signals. Instead of computing a margin to subtract from the log-probability difference, the loss forms a normalized ratio that captures relative regret-scaled advantage, promoting robust scale-invariant preference learning without clipping or additive margins.",
    "pseudocode": "regret_margin = relu(delta_regret) * cost_gap * margin_scale\nmargin_ratio = 1 + regret_margin\nraw_score = (log_prob_w - log_prob_l) / margin_ratio\nloss_vec = weight * softplus(-raw_score)\nloss = sum(loss_vec) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_ratio",
      "signal_family": "delta_regret_cost_gap",
      "link_family": "softplus_inverse_ratio",
      "agg_family": "weighted_mean",
      "constraint_family": "scale_invariance_no_clip"
    },
    "operators_used": [
      "relu",
      "softplus",
      "div",
      "add",
      "sub",
      "mul",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_regret = batch['delta_regret']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    margin_scale = float(extra.get('margin_scale', extra.get('hyperparams', {}).get('margin_scale', 0.1)))\n\n    regret_margin = ops.relu(delta_regret) * cost_gap * margin_scale\n    margin_ratio = ops.add(regret_margin, 1.0)\n\n    raw_score = ops.div(ops.sub(lpw, lpl), margin_ratio)\n\n    loss_vec = ops.mul(weight, ops.softplus(ops.neg(raw_score)))\n\n    denom = ops.sum(weight) + 1e-12\n    return ops.sum(loss_vec) / denom",
    "theoretical_basis": ""
  },
