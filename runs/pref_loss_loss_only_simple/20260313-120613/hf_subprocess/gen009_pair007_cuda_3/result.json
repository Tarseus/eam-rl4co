  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_nce_objective_with_cost_regret_weighting",
    "intuition": "Shift paradigm from margin-based losses to a noise-contrastive estimation (NCE) style loss for preference learning, where the model must distinguish the winner's log-probability from the loser's, combined with a multiplicative weighting based on normalized cost_gap and scaled delta_regret to prioritize difficult comparisons. This uses cost_gap and delta_regret signals directly and aggregates the final loss as a weighted negative log-softmax over pairs, providing a different decomposition and signal usage from pairwise margin formulations.",
    "pseudocode": "logits_w = alpha * scale * log_prob_w\nlogits_l = alpha * scale * log_prob_l\nnorm_cost_gap = zscore(cost_gap)\nscaled_delta_regret = clamp(delta_regret * delta_scale, 0, None)\nweight_mod = sigmoid(norm_cost_gap + scaled_delta_regret)\nweights_final = weight * weight_mod\npair_logits = stack([logits_w, logits_l], dim=1)  # shape (N,2)\nlog_softmax = logits_w - logsumexp(pair_logits, dim=1)\nloss_vec = -log_softmax * weights_final\nloss = sum(loss_vec) / (sum(weights_final) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_nce",
      "signal_family": "cost_gap_delta_regret",
      "link_family": "logsoftmax_sigmoid_weighting",
      "agg_family": "weighted_mean",
      "constraint_family": "clamp_zscore_normalize"
    },
    "operators_used": [
      "stack",
      "log",
      "sum",
      "sigmoid",
      "clamp",
      "zscore",
      "sub",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    delta_regret = batch['delta_regret']\n\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    delta_scale = float(extra.get('hyperparams', {}).get('delta_scale', 5.0))\n\n    logits_w = alpha * scale * lpw\n    logits_l = alpha * scale * lpl\n\n    # Defensive fallback zscore and clamp in case of missing values\n    cost_gap_z = ops.zscore(cost_gap)\n    delta_regret_scaled = ops.clamp(delta_regret * delta_scale, 0.0, None)\n\n    weight_mod = ops.sigmoid(cost_gap_z + delta_regret_scaled)\n    weights_final = weight * weight_mod\n\n    pair_logits = ops.stack([logits_w, logits_l], dim=1)  # shape (N,2)\n    logsumexp = ops.log(ops.exp(pair_logits).sum(dim=1))\n    log_softmax = logits_w - logsumexp  # log P(winner)\n\n    loss_vec = -log_softmax * weights_final\n    denom = ops.sum(weights_final) + 1e-12\n    return ops.sum(loss_vec) / denom",
    "theoretical_basis": ""
  },
