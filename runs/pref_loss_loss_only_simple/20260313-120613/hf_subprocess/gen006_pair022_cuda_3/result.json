  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_007_cost_adv_rank_smooth_sum_then_mean",
    "intuition": "Changes the aggregation by summing the weighted pairwise losses first and then taking the mean over the batch size, emphasizing the average loss magnitude per batch element with smooth margin using sigmoid and tanh on advantage_gap and delta_rank.",
    "pseudocode": "adv_scaled = sigmoid(advantage_gap) * margin_adv\nrank_scaled = tanh(delta_rank) * margin_rank\nmargin = adv_scaled + rank_scaled\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_vec = -logsigmoid(x) * weight\nloss = loss_vec.sum() / loss_vec.shape[0]",
    "hyperparams": {
      "scale": "1.2",
      "margin_adv": "0.05",
      "margin_rank": "0.02",
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin",
      "agg_family": "sum_then_mean",
      "constraint_family": "soft_smooth"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "tanh",
      "sum",
      "div",
      "mul"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', None)\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.05))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.02))\n\n    adv_scaled = ops.sigmoid(advantage_gap) * margin_adv\n    rank_scaled = ops.tanh(delta_rank) * margin_rank\n    margin = adv_scaled + rank_scaled\n\n    x = alpha * scale * (lpw - lpl) - margin\n    loss_vec = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss_vec = loss_vec * weight\n\n    loss = loss_vec.sum() / loss_vec.shape[0]\n    return loss",
    "theoretical_basis": ""
  },
