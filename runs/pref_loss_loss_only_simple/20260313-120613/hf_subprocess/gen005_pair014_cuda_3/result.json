  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_006_cost_adv_rank_smooth_v4",
    "intuition": "To address the novelty failure due to high similarity with previous versions, I restructured the margin calculation by incorporating an additional cost-based modulation factor and replaced one exponential term with a smooth softplus transformation for better numerical stability and smoother gradients. Specifically, I introduced 'cost_gap' as an additional signal to influence the margin multiplicatively, combining advantage_gap, delta_rank, and cost_gap. The margin now smoothly depends on advantage and rank via tanh and relu, but is moderated by a softplus-scaled cost factor. Also, I explicitly scaled the margin with a new hyperparameter 'margin_scale' to improve flexibility. These changes maintain the pairwise log-sigmoid framework but enhance expressiveness and reduce direct overlap with prior loss variants.",
    "pseudocode": "adv_factor = margin_adv * ops.softplus(-advantage_gap * 5)\nrank_factor = margin_rank * (ops.tanh(delta_rank * 3) + 1) * 0.5\ncost_factor = margin_cost * ops.sigmoid(cost_gap * 10)\nmargin = margin_scale * adv_factor * rank_factor * cost_factor\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -ops.logsigmoid(x) * weight\nloss = loss_per_pair.sum() / (weight.sum() + epsilon)",
    "hyperparams": {
      "scale": 1.2,
      "margin_adv": 0.04,
      "margin_rank": 0.05,
      "margin_cost": 0.03,
      "margin_scale": 1.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank_cost_gap",
      "link_family": "logsigmoid_softplus_tanh_sigmoid_margin",
      "agg_family": "mean",
      "constraint_family": "soft_smooth"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "sigmoid",
      "relu",
      "tanh"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n    margin_adv = float(extra.get('hyperparams', {}).get('margin_adv', 0.04))\n    margin_rank = float(extra.get('hyperparams', {}).get('margin_rank', 0.05))\n    margin_cost = float(extra.get('hyperparams', {}).get('margin_cost', 0.03))\n    margin_scale = float(extra.get('hyperparams', {}).get('margin_scale', 1.0))\n\n    adv_factor = margin_adv * ops.softplus(-advantage_gap * 5)\n    rank_factor = margin_rank * (ops.tanh(delta_rank * 3) + 1.0) * 0.5\n    cost_factor = margin_cost * ops.sigmoid(cost_gap * 10)\n\n    margin = margin_scale * adv_factor * rank_factor * cost_factor\n\n    x = alpha * scale * (lpw - lpl) - margin\n    loss = -ops.logsigmoid(x)\n\n    if weight is not None:\n        loss = loss * weight\n\n    return loss.sum() / (weight.sum() + 1e-12)",
    "theoretical_basis": ""
  },
