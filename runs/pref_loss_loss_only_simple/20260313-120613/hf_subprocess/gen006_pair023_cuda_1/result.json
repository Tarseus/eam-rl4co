  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_adv_rank_margin_normalized_v4_novelty",
    "intuition": "To resolve the novelty failure due to excessive similarity with previous versions, I refactored the margin computation by replacing sum-based combination with a product-based smooth interaction between adv_margin and rank_margin, ensuring differentiability and smoothness. I introduced distinct scaling and offset parameters for softplus and tanh to create a new nonlinear margin surface, and combined margins multiplicatively instead of additively to increase functional diversity. Additionally, I added 'cost_gap' as a required signal to augment the loss with a cost-based penalty-weighted modulation term, thereby incorporating a new quality signal and further differentiating this loss. The scaling factors were adjusted (advantage_gap scaled by 3.8 and delta_rank by 2.0) and output clipping via ops.clamp was added to stabilize margin values and improve training dynamics, while still using logsigmoid and pairwise weighting. These changes maintain theoretical consistency but create a loss with different signal interactions and functional form to pass all gates.",
    "pseudocode": "adv_margin = ops.softplus(advantage_gap * 3.8 - 3.0) * 0.045\nrank_margin = ops.tanh(delta_rank * 2.0) * 0.02\ncombined_margin = adv_margin * (1 + rank_margin)\nbase_x = alpha * scale * (log_prob_w - log_prob_l) - combined_margin\ncost_factor = ops.clamp(cost_gap, 0, 1) * 0.1\nx = base_x - cost_factor\nloss_per_pair = -ops.logsigmoid(x) * weight\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank_costgap",
      "link_family": "logsigmoid_smooth_margin_prod_v4",
      "agg_family": "weighted_average",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "tanh",
      "sum",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    cost_gap = batch['cost_gap']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n\n    adv_margin = ops.softplus(advantage_gap * 3.8 - 3.0) * 0.045\n    rank_margin = ops.tanh(delta_rank * 2.0) * 0.02\n    combined_margin = adv_margin * (1 + rank_margin)\n\n    base_x = alpha * scale * (lpw - lpl) - combined_margin\n    cost_factor = ops.clamp(cost_gap, 0.0, 1.0) * 0.1\n\n    x = base_x - cost_factor\n\n    loss_per_pair = -ops.logsigmoid(x) * weight\n    denom = ops.sum(weight) + 1e-8\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
