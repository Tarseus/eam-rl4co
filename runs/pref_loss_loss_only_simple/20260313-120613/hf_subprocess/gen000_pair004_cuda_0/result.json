  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "cross_parent_loss_repaired",
    "intuition": "To address the novelty failure due to high similarity with existing losses, I modified the loss to incorporate delta_regret as an additional adjustment factor inside the logitsigmoid input, scaled and detached, to provide a more unique margin term while preserving numerical stability and pairwise semantics. Also, I explicitly removed the weight default fallback to 1.0 to ensure consistency without optional None usage and replaced clamping upper bound from 20.0 to 10.0 to reduce saturation and provide a smoother gradient profile. These changes maintain the rationale of cost gap margin and scaled log probability difference but incorporate additional pairwise quality signal, making the loss less similar yet still stable and meaningful.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    delta_regret = batch['delta_regret'].detach()\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) + 0.5 * gap + 0.3 * delta_regret\n    x = ops.clamp(x, -20.0, 10.0)\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return loss.mean()",
    "hyperparams": {},
    "operators_used": [
      "logsigmoid",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    delta_regret = batch['delta_regret'].detach()\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) + 0.5 * gap + 0.3 * delta_regret\n    x = ops.clamp(x, -20.0, 10.0)\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": "Adding delta_regret detached term modifies the margin inside logsigmoid to include a distinct quality signal beyond just cost gap, lowering similarity to prior losses while still preserving the pairwise margin intuition and numerical stability. The clamping range is tightened to reduce saturation on the upper bound and promote stable gradients. Weight is required to avoid None branches improving clarity. This repair retains stable log probability difference scaling and cost gap margin semantics enhanced with an additional preference signal foundational for preference learning."
  },
