  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_002_cost_margin_scaled_sum_then_mean",
    "intuition": "Re-structured the original weighted log-mean-exp aggregation into a two-level aggregation: first summing the weighted loss per pair, then averaging over the batch dimension. This changes the overall aggregation family while preserving the pairwise margin-based structure with clamp stabilization and the cost gap signal.",
    "pseudocode": "x = clamp(alpha * scale * (log_prob_w - log_prob_l) - cost_gap_coef * (cost_b - cost_a) + margin, -20, 20)\nloss_per_pair = -weight * x + weight * log(1 + exp(x))\nsum_loss = sum(loss_per_pair)\nresult = sum_loss / (batch_size + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid_variant",
      "agg_family": "sum_then_mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "clamp",
      "log",
      "exp",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    margin_factor = float(extra.get('hyperparams', {}).get('margin_factor', 0.1))\n    cost_gap_coef = float(extra.get('hyperparams', {}).get('cost_gap_coef', 0.15))\n\n    gap = (cost_b - cost_a).detach()\n    margin = margin_factor * scale\n\n    x = alpha * scale * (lpw - lpl) - cost_gap_coef * gap + margin\n    x = ops.clamp(x, -20.0, 20.0)\n\n    if weight is None:\n        weight = ops.ones_like(x)\n\n    loss_per_pair = -weight * x + weight * ops.log(1 + ops.exp(x))\n\n    loss_sum = ops.sum(loss_per_pair)\n    denom = float(x.shape[0]) + 1e-8\n    return loss_sum / denom",
    "theoretical_basis": ""
  },
