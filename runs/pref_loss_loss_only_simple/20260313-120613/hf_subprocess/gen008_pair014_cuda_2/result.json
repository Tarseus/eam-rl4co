  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_z_clamped_loss_v2_repaired",
    "intuition": "Fixed hyperparameter retrieval to consistently extract all required values directly from 'extra' with proper fallback to avoid ambiguity. Simplified variable retrieval for clarity. Ensured that 'weight' is always a tensor and replaced the conditional multiplication with a safe default (weight=1 if None) to avoid NoneType errors. Used only tensor ops with proper vectorization and maintained all original logic and clamping for stability. This resolves prior runtime failures and ensures proper, stable margin computation while preserving the original loss behavior.",
    "pseudocode": "adv_factor = margin_adv * exp(-clamp(-advantage_gap, 0, None) * scale_factor)\ndelta_z_clamped = clamp(delta_z, -clamp_value, clamp_value)\nrank_modulation = margin_rank * (tanh(delta_z_clamped * tanh_scale) + offset) * factor\nmargin = adv_factor * rank_modulation\nx_raw = alpha * scale * (log_prob_w - log_prob_l) - margin\nx_clipped = clamp(x_raw, -max_margin, max_margin)\nloss = -logsigmoid(x_clipped) * weight\nreturn sum(loss) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_z",
      "link_family": "logsigmoid_exp_tanh_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "clipping_normalization",
      "other_hparams": "scale_factor=1.0, clamp_value=3.0, tanh_scale=3.0, offset=1.0, factor=1.0, margin_adv=0.05, margin_rank=0.06, max_margin=4.0, epsilon=1e-12, alpha=1.0, scale=1.0"
    },
    "operators_used": [
      "logsigmoid",
      "exp",
      "clamp",
      "tanh",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_z = batch['delta_z']\n    weight = batch['weight']\n\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('scale', 1.0))\n    scale_factor = float(extra.get('scale_factor', 1.0))\n    clamp_value = float(extra.get('clamp_value', 3.0))\n    tanh_scale = float(extra.get('tanh_scale', 3.0))\n    offset = float(extra.get('offset', 1.0))\n    factor = float(extra.get('factor', 1.0))\n    margin_adv = float(extra.get('margin_adv', 0.05))\n    margin_rank = float(extra.get('margin_rank', 0.06))\n    max_margin = float(extra.get('max_margin', 4.0))\n    epsilon = float(extra.get('epsilon', 1e-12))\n\n    # ensure weight is tensor, fallback to ones if None\n    if weight is None:\n        weight = ops.ones_like(lpw)\n\n    neg_adv_clip = ops.clamp(-advantage_gap, 0.0, None)\n    adv_factor = margin_adv * ops.exp(-neg_adv_clip * scale_factor)\n\n    delta_z_clamped = ops.clamp(delta_z, -clamp_value, clamp_value)\n    rank_modulation = margin_rank * (ops.tanh(delta_z_clamped * tanh_scale) + offset) * factor\n\n    margin = adv_factor * rank_modulation\n\n    x_raw = alpha * scale * (lpw - lpl) - margin\n    x_clipped = ops.clamp(x_raw, -max_margin, max_margin)\n\n    loss_vec = -ops.logsigmoid(x_clipped) * weight\n\n    loss = ops.sum(loss_vec) / (ops.sum(weight) + epsilon)\n    return loss",
    "theoretical_basis": ""
  },
