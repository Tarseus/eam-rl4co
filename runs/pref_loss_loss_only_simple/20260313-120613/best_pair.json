  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_adv_rank_margin_normalized_v2",
    "intuition": "Fixed the loss to reduce similarity by replacing simple sigmoid and tanh scaling with smoother nonlinear transforms and adding a shifted softplus to create a margin that varies nonlinearly with the signals. Also, replaced static margins by smooth, differentiable functions of advantage_gap and delta_rank, ensuring a more nuanced margin and hence distinct formula. This adjustment improves novelty while keeping the normalization constraint for scale invariance and preserving all required inputs and pairwise operations.",
    "pseudocode": "adv_margin = softplus(advantage_gap * 5 - 2) * 0.03\nrank_margin = tanh(delta_rank * 3) * 0.025\nmargin = adv_margin + rank_margin\nx = alpha * scale * (log_prob_w - log_prob_l) - margin\nloss_per_pair = -logsigmoid(x) * weight\nloss = sum(loss_per_pair) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap_delta_rank",
      "link_family": "logsigmoid_smooth_margin_v2",
      "agg_family": "weighted_average",
      "constraint_family": "normalization"
    },
    "operators_used": [
      "logsigmoid",
      "softplus",
      "tanh",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.2))\n\n    adv_margin = ops.softplus(advantage_gap * 5.0 - 2.0) * 0.03\n    rank_margin = ops.tanh(delta_rank * 3.0) * 0.025\n    margin = adv_margin + rank_margin\n\n    x = alpha * scale * (lpw - lpl) - margin\n    loss_per_pair = -ops.logsigmoid(x) * weight\n    denom = ops.sum(weight) + 1e-8\n    return ops.sum(loss_per_pair) / denom",
    "theoretical_basis": ""
  },
