  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_rankgap_weighted_exp_advantage_gradsafe",
    "intuition": "Preserves the exponential weighting by advantage gap and rank gap, ensuring all tensors require grad by using log_prob differences and integrating weighting safely.",
    "pseudocode": "alpha = param\nadv_gap = batch['advantage_gap']\nrank_gap = batch['delta_rank']\nweight = batch.get('weight', ones)\nlog_prob_w = batch['log_prob_w']\nlog_prob_l = batch['log_prob_l']\nscore = exp(-alpha * rank_gap * adv_gap) * weight * (log_prob_w - log_prob_l)\nloss = -mean(score)",
    "hyperparams": {
      "paradigm_family": "pairwise_soft_ranking",
      "signal_family": "advantage_gap",
      "link_family": "exponential",
      "agg_family": "weighted_mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "exp",
      "mean",
      "mul",
      "neg",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "advantage_gap",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch[\"log_prob_w\"]\n    lpl = batch[\"log_prob_l\"]\n    weight = batch.get(\"weight\", lpw.new_ones(lpw.shape))\n    adv_gap = batch[\"advantage_gap\"]\n    rank_gap = batch[\"delta_rank\"]\n    alpha = float(extra.get(\"alpha\", extra.get(\"hyperparams\", {}).get(\"alpha\", 1.0)))\n    # Use differentiable expression involving log_prob to ensure grad\n    log_prob_diff = lpw - lpl\n    score = ops.exp(ops.neg(alpha * rank_gap * adv_gap)) * weight * log_prob_diff\n    loss = -score.mean()\n    return loss",
    "theoretical_basis": ""
  },
