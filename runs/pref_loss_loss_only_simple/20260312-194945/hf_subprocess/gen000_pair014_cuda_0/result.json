  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_loss",
    "intuition": "This loss encourages the model to prefer outputs with higher log_prob_w over log_prob_l, weighted by the cost gap signal. It aligns with RL4CO goals by emphasizing better-quality pairs and penalizing pairs where the cost gap indicates a worse outcome, thereby promoting preference for higher-quality outputs. Using pairwise comparisons helps stabilize training and directly models preferences, which is effective for ranking tasks.",
    "pseudocode": "loss = mean over pairs of [weight * (log_prob_l - log_prob_w)]",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "preference",
      "link_family": "identity",
      "agg_family": "mean",
      "constraint_family": "none",
      "other_hparams": "none"
    },
    "operators_used": [
      "logsigmoid",
      "mul",
      "sub",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    # Compute pairwise preference: higher log_prob_w preferred over log_prob_l\n    preference = log_prob_l - log_prob_w\n    # Weight the preferences by the cost_gap signal\n    weighted_pref = weight * preference\n    # Compute mean to get scalar loss\n    loss = ops.mean(weighted_pref)\n    return loss",
    "theoretical_basis": ""
  },
