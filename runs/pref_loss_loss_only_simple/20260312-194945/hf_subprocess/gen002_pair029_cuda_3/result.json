  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_relativistic_advantage_ratio_loss",
    "intuition": "This loss models preference by the ratio of exponentiated log-prob differences relativized by advantage gaps, turning the pairwise difference into a probabilistic ratio modulated by advantage signals. Instead of additive difference or margin, it uses a relativistic multiplicative signal with logarithmic stabilization, promoting proportional preference scoring weighted by advantage ratios.",
    "pseudocode": "log_ratio = log_prob_w - log_prob_l\nadv_ratio = (advantage_w + epsilon) / (advantage_l + epsilon)\nscaled_ratio = exp(log_ratio) / adv_ratio\nloss_elements = -log(sigmoid(scaled_ratio))\nloss = mean(weight * loss_elements)",
    "hyperparams": {
      "paradigm_family": "pairwise_relativistic",
      "signal_family": "advantage_ratio",
      "link_family": "sigmoid",
      "agg_family": "mean",
      "constraint_family": "log_stabilized"
    },
    "operators_used": [
      "exp",
      "log",
      "sigmoid",
      "div",
      "add",
      "sub",
      "mul",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    eps = 1e-8\n    adv_w_safe = ops.add(adv_w, eps)\n    adv_l_safe = ops.add(adv_l, eps)\n    log_ratio = ops.sub(lpw, lpl)\n    adv_ratio = ops.div(adv_w_safe, adv_l_safe)\n    scaled_ratio = ops.div(ops.exp(log_ratio), adv_ratio)\n    # To stabilize, apply logsigmoid on scaled_ratio via transforming back to log domain:\n    # logsigmoid(x) = -softplus(-x), but we only have sigmoid operator\n    # approximate by applying sigmoid to scaled_ratio and then -log(sigmoid(scaled_ratio))\n    sigmoid_val = ops.sigmoid(scaled_ratio)\n    loss_elements = ops.neg(ops.log(sigmoid_val))\n    weighted_loss = ops.mul(weight, loss_elements)\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
