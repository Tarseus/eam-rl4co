  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_diffsigmoid_advantage_penalty_clamped_repaired",
    "intuition": "Clamps the advantage_gap to a safe range and ensures weight is always present, preserving the squared penalty with clamping to prevent large gradients.",
    "pseudocode": "p_w = sigmoid(lpw - lpl)\nadv_gap_clamped = clamp(advantage_gap, -clip_threshold, clip_threshold)\ndiff = p_w - adv_gap_clamped\npenalty = diff^2\nclipped_penalty = clamp(penalty, 0, clip_threshold)\nloss = mean(weight * clipped_penalty)",
    "hyperparams": {
      "paradigm_family": "pairwise_probability_difference",
      "signal_family": "advantage_gap",
      "link_family": "sigmoid",
      "agg_family": "mean",
      "constraint_family": "clamping"
    },
    "operators_used": [
      "sigmoid",
      "sub",
      "mul",
      "mean",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    advantage_gap = batch['advantage_gap']\n    clip_threshold = 1.0\n    adv_gap_clamped = ops.clamp(advantage_gap, -clip_threshold, clip_threshold)\n    p_w = ops.sigmoid(ops.sub(lpw, lpl))\n    diff = ops.sub(p_w, adv_gap_clamped)\n    penalty = ops.mul(diff, diff)  # squared penalty\n    clipped_penalty = ops.clamp(penalty, 0.0, clip_threshold)\n    loss = ops.mul(clipped_penalty, weight)\n    return ops.mean(loss)",
    "theoretical_basis": ""
  },
