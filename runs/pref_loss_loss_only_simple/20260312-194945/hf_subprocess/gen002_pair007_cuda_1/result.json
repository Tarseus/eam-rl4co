  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_logsigmoid_costgap_loss",
    "intuition": "The original loss was essentially a weighted difference of log probabilities, which caused a novelty failure due to high similarity with existing pairwise preference losses. To fix this, I replaced the raw difference by a smooth hinge-like surrogate using logsigmoid(log_prob_w - log_prob_l), which better models pairwise ranking and provides a smooth gradient signal. I kept the weighting by cost_gap and ensured the loss aggregates properly with mean. This change introduces a novel smooth pairwise formulation that encourages higher probability for preferred outputs with stable training, reducing similarity to existing losses.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nloss = mean(weight * -logsigmoid(diff))",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "preference",
      "link_family": "logsigmoid_neg",
      "agg_family": "mean",
      "constraint_family": "none",
      "other_hparams": "none"
    },
    "operators_used": [
      "logsigmoid",
      "mul",
      "neg",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    diff = log_prob_w - log_prob_l\n    weighted_loss = weight * cost_gap * (-ops.logsigmoid(diff))\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": "This loss applies a smooth pairwise hinge surrogate via -logsigmoid of the margin (log_prob_w - log_prob_l), weighted by preference strength (cost_gap and weight). It encourages the model to assign higher log probability to the preferred output in each pair. This yields smooth gradients and can improve stability and convergence over raw differences, while being distinct from prior pairwise logprob difference losses."
  },
