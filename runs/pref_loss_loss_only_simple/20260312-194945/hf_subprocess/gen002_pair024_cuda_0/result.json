  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_001_cost_norm_shifted_sum_advgap_v2_repaired",
    "intuition": "Replace unsupported ops.sign with safe sign approximation using clamp and relu to fix runtime error while preserving original loss logic.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nnorm = abs(log_prob_w) + abs(log_prob_l) + epsilon\nscaled_diff = diff / norm\ncost_diff = cost_b - cost_a\ncost_gap_sign = sign(cost_diff) approximated as relu(clamp(cost_diff, -1,1)) - relu(clamp(-cost_diff, -1,1))\nquality_signal = -0.1 * cost_gap_sign + 0.2 * advantage_gap\nx = alpha * scale * scaled_diff + quality_signal\nx = clamp(x, -20, 20)\nloss = -logsigmoid(x)\nloss = loss * weight\nloss_mean = sum(loss) / sum(weight)\nreturn loss_mean",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap_sign_advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization_scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "abs",
      "relu",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    advantage_gap = batch['advantage_gap']\n    epsilon = 1e-6\n    diff = lpw - lpl\n    norm = ops.abs(lpw) + ops.abs(lpl) + epsilon\n    scaled_diff = diff / norm\n    cost_diff = cost_b - cost_a\n    # Approximate sign using relu and clamp\n    pos = ops.relu(ops.clamp(cost_diff, -1.0, 1.0))\n    neg = ops.relu(ops.clamp(-cost_diff, -1.0, 1.0))\n    cost_gap_sign = pos - neg\n    quality_signal = -0.1 * cost_gap_sign + 0.2 * advantage_gap\n    x = alpha * scale * scaled_diff + quality_signal\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return ops.sum(loss) / ops.sum(weight)",
    "theoretical_basis": ""
  },
