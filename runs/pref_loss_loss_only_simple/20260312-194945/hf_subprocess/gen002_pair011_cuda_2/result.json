  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_gap_weighted_scaled",
    "intuition": "To reduce novelty failure caused by excessive similarity with the original loss, I replaced the simple linear combination inside the logsigmoid with a normalized and scaled margin, improving numerical stability and gradient signal. I normalized the cost gap by its absolute mean to calibrate its influence relative to log probability differences, ensuring consistent sensitivity across batches. Also added a small positive margin shift (0.05) inside the logsigmoid to encourage a margin between better and worse samples. This fixes originality while preserving the pairwise margin rationale and respecting the required signals.",
    "pseudocode": "mean_abs_cost_gap = ops.mean(ops.abs(cost_b - cost_a)).detach()\nnormalized_cost_gap = (cost_b - cost_a) / (mean_abs_cost_gap + 1e-8)\nscore = scale * (lpw - lpl) - 0.1 * normalized_cost_gap - 0.05\nclamped_score = ops.clamp(score, -20, 20)\nloss = -ops.logsigmoid(clamped_score) * weight\nloss = ops.sum(loss)",
    "hyperparams": {
      "scale": 2.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "abs",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    gap = (cost_b - cost_a)\n    mean_abs_gap = ops.mean(ops.abs(gap)).detach()\n    normalized_gap = gap / (mean_abs_gap + 1e-8)\n    score = scale * (lpw - lpl) - 0.1 * normalized_gap - 0.05\n    score = ops.clamp(score, -20.0, 20.0)\n    loss = -ops.logsigmoid(score)\n    loss = loss * weight\n    loss = loss.sum()\n    return loss",
    "theoretical_basis": ""
  },
