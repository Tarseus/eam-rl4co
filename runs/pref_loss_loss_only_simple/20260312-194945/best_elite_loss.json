  "ir": {
    "name": "pairwise_preference_loss",
    "intuition": "This loss encourages the model to prefer outputs with higher log_prob_w over log_prob_l, weighted by the cost gap signal. It aligns with RL4CO goals by emphasizing better-quality pairs and penalizing pairs where the cost gap indicates a worse outcome, thereby promoting preference for higher-quality outputs. Using pairwise comparisons helps stabilize training and directly models preferences, which is effective for ranking tasks.",
    "pseudocode": "loss = mean over pairs of [weight * (log_prob_l - log_prob_w)]",
    "hyperparams": {
      "paradigm_family": "pairwise",
      "signal_family": "preference",
