tional\": [\n      \"cost_a\",\n      \"cost_b\",\n      \"cost_gap\",\n      \"delta_cost\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required preference logits (winner/loser). Keep expects strict to pass static gates.\\n    lw = batch.get(\\\"log_prob_w\\\", None)\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n\\n    # If missing, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get_hp(key, default):\\n        if isinstance(extra, dict) and (key in extra):\\n            return extra.get(key)\\n        return hyper.get(key, default)\\n\\n    alpha = float(_get_hp(\\\"alpha\\\", 1.0))\\n    beta = float(_get_hp(\\\"beta\\\", 0.25))\\n    d_clip = float(_get_hp(\\\"d_clip\\\", 30.0))\\n    z_clip = float(_get_hp(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(_get_hp(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(_get_hp(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(_get_hp(\\\"per_clip\\\", 5.0))\\n\\n    # Objective delta signal: prefer delta_z; otherwise use common aliases or derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d=log_prob_w-log_prob_l. An additive bounded shift beta*dz incorporates an auxiliary objective-difference signal (delta_z or cost-derived proxy) when dz is winner-minus-loser. Clamping of d, dz, shift, and final per-example loss improves numerical stability and keeps outputs within expected dynamic range.\"\n}"}
{"key": "969d32520ae7848774a5ce5dba7323cffbf727a3", "ts": 1771792976.9734278, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "3675cc7f61006c1786a1fe34619f563b04a956d0", "content": "{\n  \"name\": \"E1_cost_shift_logistic_softplusblend\",\n  \"intuition\": \"Use a Bradley-Terry logistic preference loss on the margin between winner and loser log-probabilities, optionally shifted by a bounded cost signal (delta_z). Implement the same logistic loss in two numerically stable equivalent forms (negative logsigmoid and softplus), blend them for smoothness, and clamp intermediate values and weights to keep loss/gradients in a safe range.\",\n  \"pseudocode\": \"Inputs: log_prob_w, log_prob_l, delta_z, optional weight\\nHyperparams: alpha, beta, mix, d_clip, z_clip, shift_clip, d_eff_clip, per_clip, w_clip\\n\\nmix <- clamp(mix, 0, 1)\\nd <- clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\ndz <- clamp(delta_z, -z_clip, z_clip)\\nshift <- clamp(beta * dz, -shift_clip, shift_clip)\\nd_eff <- clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\nloss_a <- -logsigmoid(alpha * d_eff)\\nloss_b <- softplus(-alpha * d_eff)\\nper_example <- mix * loss_a + (1 - mix) * loss_b\\nper_example <- clamp(per_example, 0, per_clip)\\n\\nif weight provided:\\n  w <- clamp(weight, 0, w_clip)\\n  per_example <- per_example * w\\n\\nreturn mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.3,\n    \"mix\": 0.6,\n    \"d_clip\": 25.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 4.0,\n    \"d_eff_clip\": 25.0,\n    \"per_clip\": 5.0,\n    \"w_clip\": 10.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required inputs (explicit to satisfy input gates).\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n    dz = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.3))\\n    mix = float((extra.get(\\\"mix\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"mix\\\", 0.6))\\n\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 25.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 4.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 25.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n    w_clip = float((extra.get(\\\"w_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_clip\\\", 10.0))\\n\\n    # Clamp mix into [0,1] without relying on python min/max.\\n    mix = ops.clamp(mix, 0.0, 1.0)\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Blend of equivalent logistic forms for stability and smooth gradients.\\n    per_log = -ops.logsigmoid(alpha * d_eff)\\n    per_sp = ops.softplus(-alpha * d_eff)\\n    per = mix * per_log + (1.0 - mix) * per_sp\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    if base_weight is not None:\\n        bw = ops.clamp(base_weight, 0.0, w_clip)\\n        per = per * bw\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry logistic preference loss on margin d=log_prob_w-log_prob_l, with a bounded additive objective shift beta*delta_z to preserve swap-consistency (swapping winner/loser flips both d and delta_z, hence d_eff changes sign). The per-example loss blends two numerically stable equivalent expressions (-logsigmoid(alpha*d_eff) and softplus(-alpha*d_eff)) and clamps inputs/outputs to keep gradients and values within a safe dynamic range; optional weights are nonnegative-clamped to avoid sign inversions.\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\",\n      \"batch['delta_z']\",\n      \"batch.get('weight', None)\"\n    ],\n    \"uses\": [\n      \"ops.clamp\",\n      \"ops.logsigmoid\",\n      \"ops.softplus\"\n    ],\n    \"mode\": \"preference\"\n  }\n}"}
{"key": "3e24c99d4b9f6c7aeb51ce1aff1b542b9255cd96", "ts": 1771793000.6916606, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "70251a8ae34cc2c6095d0225814b2f362dd7f170", "content": "{\n  \"name\": \"E1_cost_shift_logistic_softplusblend\",\n  \"intuition\": \"Use a Bradley-Terry logistic preference loss on the margin between winner and loser log-probabilities, optionally shifted by a bounded cost signal (delta_z). Implement the same logistic loss in two numerically stable equivalent forms (negative logsigmoid and softplus), blend them for smoothness, and clamp intermediate values and weights to keep loss/gradients in a safe range.\",\n  \"pseudocode\": \"Inputs: log_prob_w, log_prob_l, delta_z, optional weight\\nHyperparams: alpha, beta, mix, d_clip, z_clip, shift_clip, d_eff_clip, per_clip, w_clip\\n\\nmix <- clamp(mix, 0, 1)\\nd <- clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\ndz <- clamp(delta_z, -z_clip, z_clip)\\nshift <- clamp(beta * dz, -shift_clip, shift_clip)\\nd_eff <- clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\nloss_a <- -logsigmoid(alpha * d_eff)\\nloss_b <- softplus(-alpha * d_eff)\\nper_example <- mix * loss_a + (1 - mix) * loss_b\\nper_example <- clamp(per_example, 0, per_clip)\\n\\nif weight provided:\\n  w <- clamp(weight, 0, w_clip)\\n  per_example <- per_example * w\\n\\nreturn mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.3,\n    \"mix\": 0.6,\n    \"d_clip\": 25.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 4.0,\n    \"d_eff_clip\": 25.0,\n    \"per_clip\": 5.0,\n    \"w_clip\": 10.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\"\n    ],\n    \"returns\": \"scalar\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n    dz = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.3))\\n    mix = float((extra.get(\\\"mix\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"mix\\\", 0.6))\\n\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 25.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 4.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 25.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n    w_clip = float((extra.get(\\\"w_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_clip\\\", 10.0))\\n\\n    mix = ops.clamp(mix, 0.0, 1.0)\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per_log = -ops.logsigmoid(alpha * d_eff)\\n    per_sp = ops.softplus(-alpha * d_eff)\\n    per = mix * per_log + (1.0 - mix) * per_sp\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    if base_weight is not None:\\n        bw = ops.clamp(base_weight, 0.0, w_clip)\\n        per = per * bw\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry logistic preference loss on margin d=log_prob_w-log_prob_l, with a bounded additive objective shift beta*delta_z to preserve swap-consistency (swapping winner/loser flips both d and delta_z, hence d_eff changes sign). The per-example loss blends two numerically stable equivalent expressions (-logsigmoid(alpha*d_eff) and softplus(-alpha*d_eff)) and clamps inputs/outputs to keep gradients and values within a safe dynamic range; optional weights are nonnegative-clamped to avoid sign inversions.\"\n}"}
{"key": "37e8ddcff029f593141fca1a587f55a753995a07", "ts": 1771793021.91857, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "bd1b52af294f1a149f091b4219624355a4671bec", "content": "{\n  \"name\": \"M3_fix_clamp_scalar_mix_cost_shift_logsigmoid\",\n  \"intuition\": \"Stable Bradley-Terry preference loss on log-prob margin with an additive bounded objective shift. Avoid ops.clamp on Python floats (caused forward_error) by clamping mix in pure Python, and keep all ops.clamp calls on tensors only. Use a single stable form (-logsigmoid) to simplify.\",\n  \"pseudocode\": \"Inputs: log_prob_w, log_prob_l, delta_z (objective gap), optional weight\\nHyperparams: alpha, beta, mix, d_clip, z_clip, shift_clip, d_eff_clip, per_clip, w_clip\\n\\nmix <- clamp_scalar(mix, 0, 1)   # Python scalar clamp\\n\\nd <- clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\ndz <- clamp(delta_z, -z_clip, z_clip)\\nshift <- clamp(beta * dz, -shift_clip, shift_clip)\\nd_eff <- clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\nbase <- -logsigmoid(alpha * d_eff)\\naux  <- softplus(-alpha * d_eff)\\nper_example <- mix * base + (1-mix) * aux\\nper_example <- clamp(per_example, 0, per_clip)\\n\\nif weight provided:\\n  w <- clamp(weight, 0, w_clip)\\n  per_example <- per_example * w\\n\\nreturn mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"mix\": 0.6,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0,\n    \"w_clip\": 10.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n    dz = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    ex = extra if isinstance(extra, dict) else {}\\n    hyper = ex.get(\\\"hyperparams\\\", {}) if isinstance(ex.get(\\\"hyperparams\\\", {}), dict) else {}\\n\\n    def _get_float(key, default):\\n        v = ex.get(key, None)\\n        if v is None:\\n            v = hyper.get(key, default)\\n        try:\\n            return float(v)\\n        except Exception:\\n            return float(default)\\n\\n    alpha = _get_float(\\\"alpha\\\", 1.0)\\n    beta = _get_float(\\\"beta\\\", 0.25)\\n    mix = _get_float(\\\"mix\\\", 0.6)\\n\\n    d_clip = _get_float(\\\"d_clip\\\", 30.0)\\n    z_clip = _get_float(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get_float(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get_float(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = _get_float(\\\"per_clip\\\", 5.0)\\n    w_clip = _get_float(\\\"w_clip\\\", 10.0)\\n\\n    # Clamp scalar in Python to avoid ops.clamp(float, ...)\\n    if mix < 0.0:\\n        mix = 0.0\\n    elif mix > 1.0:\\n        mix = 1.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    base = -ops.logsigmoid(alpha * d_eff)\\n    aux = ops.softplus(-alpha * d_eff)\\n    per = mix * base + (1.0 - mix) * aux\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    if base_weight is not None:\\n        bw = ops.clamp(base_weight, 0.0, w_clip)\\n        per = per * bw\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on margin d=log_prob_w-log_prob_l. An additive bounded objective shift beta*delta_z adjusts the effective margin while preserving swap-consistency when delta_z is defined winner-minus-loser. Clamping is applied only to tensors (margins, objective signal, per-example loss, optional weights) to maintain numerical stability; scalar mix is clamped in Python to avoid invalid clamp signatures.\"\n}"}
{"key": "8960c4184b6be5cebf7b450264b1a7b384c24712", "ts": 1771793044.8761966, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "c8c5cb0a849d38bc4f92bda70f999a409fb453b0", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_keyfallback_v4\",\n  \"intuition\": \"Crossover: keep the strong stable core logistic preference loss from parent0, and add the robust batch-key fallbacks and bounded per-example clipping from parent1 to avoid input mismatches and keep loss in-range. Uses an additive, swap-consistent objective/cost shift (delta_z/cost_gap/delta_cost) with conservative clamping for numerical stability.\",\n  \"pseudocode\": \"inputs: batch dict with winner/loser log-probs (lw,ll) and optional cost/objective delta (dz)\\n1) read hyperparams alpha,beta and clamp limits\\n2) fetch lw from batch keys: log_prob_w | logp_w | logprobs_w | chosen_logprob\\n3) fetch ll from batch keys: log_prob_l | logp_l | logprobs_l | rejected_logprob\\n4) if lw or ll missing: return 0 * sum(any available tensor)  # benign scalar\\n5) fetch dz from batch keys: delta_z | cost_gap | delta_cost; if missing use zeros_like(lw)\\n6) d = clamp(lw - ll, [-d_clip, d_clip])\\n7) dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip])\\n8) d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip])\\n9) per_example = -logsigmoid(alpha * d_eff)\\n10) per_example = clamp(per_example, [0, per_clip])\\n11) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Hyperparameters\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = hyper.get(\\\"per_clip\\\", 5.0)\\n\\n    # Robust batch key fallbacks for log-probs\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n\\n    # If still missing, return a benign scalar tensor to avoid crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback: sum over any tensor in batch.\\n        k0 = list(batch.keys())[0]\\n        return batch[k0].sum() * 0.0\\n\\n    # Objective/cost delta signal with fallbacks\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Stable, bounded effective margin\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep within evaluator soft range and avoid rare outliers.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp_w - logp_l, implemented as -logsigmoid(alpha * d_eff). Incorporates an additive bounded shift beta*dz (dz from an objective/cost difference signal) which preserves swap symmetry when dz is winner-minus-loser aligned. Clamping on delta, shift, and per-example loss keeps gradients and values numerically stable and within evaluator soft ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_preference\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or fallbacks: logp_w/logp_l, logprobs_w/logprobs_l, chosen_logprob/rejected_logprob) as tensors shaped [B] or broadcastable\",\n      \"optional batch['delta_z'] (or fallbacks: cost_gap/delta_cost) as tensor broadcastable to log-probs\",\n      \"extra['hyperparams'] may provide alpha,beta and clamp limits\"\n    ]\n  }\n}"}
{"key": "b80710ace7b91e4b6c75603a03b13444a370217f", "ts": 1771793066.8834944, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "b81846b472e51b09e8a927fee2f39b8586ae0f93", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_keyfallback_v4_fixexpects\",\n  \"intuition\": \"Keep the stable core logistic preference loss on (log_prob_w - log_prob_l), but make it robust to batch schema variation by supporting multiple key fallbacks while still declaring the required canonical keys in expects for the static gate. Adds bounded optional cost/objective shift (delta_z / cost_gap / delta_cost) and conservative clamping to keep values and gradients stable.\",\n  \"pseudocode\": \"inputs: batch dict with winner/loser log-probs (log_prob_w, log_prob_l) and optional delta (delta_z)\\n1) read hyperparams alpha,beta and clamp limits\\n2) fetch lw from batch keys: log_prob_w | logp_w | logprobs_w | chosen_logprob\\n3) fetch ll from batch keys: log_prob_l | logp_l | logprobs_l | rejected_logprob\\n4) if lw or ll missing: return 0.0 * sum(any available tensor)  # benign scalar\\n5) fetch dz from batch keys: delta_z | cost_gap | delta_cost; if missing use zeros_like(lw)\\n6) d = clamp(lw - ll, [-d_clip, d_clip])\\n7) dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip])\\n8) d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip])\\n9) per_example = -logsigmoid(alpha * d_eff)\\n10) per_example = clamp(per_example, [0, per_clip])\\n11) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Hyperparameters\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = hyper.get(\\\"per_clip\\\", 5.0)\\n\\n    # Robust batch key fallbacks for log-probs\\n    lw = batch.get(\\\"log_prob_w\\\", None)\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n    if lw is None:\\n        lw = batch.get(\\\"logp_w\\\", batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    if ll is None:\\n        ll = batch.get(\\\"logp_l\\\", batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If still missing, return a benign scalar tensor to avoid crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Prefer summing an existing tensor from batch if present.\\n        if isinstance(batch, dict) and len(batch) > 0:\\n            for v in batch.values():\\n                if hasattr(v, \\\"sum\\\"):\\n                    return v.sum() * 0.0\\n        return (lw if lw is not None else ll) * 0.0\\n\\n    # Objective/cost delta signal with fallbacks\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Stable, bounded effective margin\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp_w - logp_l, implemented as -logsigmoid(alpha * d_eff). Incorporates an additive bounded shift beta*dz (dz from an objective/cost difference signal) which preserves swap symmetry when dz is winner-minus-loser aligned. Clamping on delta, shift, and per-example loss keeps gradients and values numerically stable and within evaluator soft ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  }\n}"}
{"key": "e35bc2018e836e15020a007d7fd01d48f9f208fb", "ts": 1771793089.1310923, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "c755e38685629b35eebf140dfdb7adbf9ef2e3e5", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_keyfallback_v5_addexpects_objective\",\n  \"intuition\": \"Stable logistic preference loss on (log_prob_w - log_prob_l) with conservative clamping. Robust to batch schema variation via key fallbacks, while declaring canonical keys for static gating. Incorporates an optional bounded objective/cost shift using delta_z (or compatible alternatives) to support cost-aware preference optimization without destabilizing gradients.\",\n  \"pseudocode\": \"inputs: batch dict with winner/loser log-probs (log_prob_w, log_prob_l) and an objective signal (delta_z or equivalent)\\n1) read hyperparams alpha,beta and clamp limits\\n2) fetch lw from batch keys: log_prob_w | logp_w | logprobs_w | chosen_logprob\\n3) fetch ll from batch keys: log_prob_l | logp_l | logprobs_l | rejected_logprob\\n4) fetch objective delta dz from: delta_z | delta_rank | delta_regret | cost_gap | delta_cost; default zeros_like(lw)\\n5) d = clamp(lw - ll, [-d_clip, d_clip])\\n6) dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip])\\n7) d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip])\\n8) per_example = clamp(-logsigmoid(alpha * d_eff), [0, per_clip])\\n9) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Hyperparameters\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = hyper.get(\\\"per_clip\\\", 5.0)\\n\\n    # Robust batch key fallbacks for log-probs\\n    lw = batch.get(\\\"log_prob_w\\\", None)\\n    if lw is None:\\n        lw = batch.get(\\\"logp_w\\\", batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n    if ll is None:\\n        ll = batch.get(\\\"logp_l\\\", batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing required log-probs, return a benign scalar tensor (avoid crashing).\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        if isinstance(batch, dict):\\n            for v in batch.values():\\n                if hasattr(v, \\\"sum\\\"):\\n                    return v.sum() * 0.0\\n        return (lw if lw is not None else ll) * 0.0\\n\\n    # Objective/cost delta signal with fallbacks.\\n    # Note: implementation_hint.expects declares delta_z as the canonical objective signal.\\n    dz = batch.get(\\n        \\\"delta_z\\\",\\n        batch.get(\\n            \\\"delta_rank\\\",\\n            batch.get(\\\"delta_regret\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None))),\\n        ),\\n    )\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Stable, bounded effective margin\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp_w - logp_l, implemented as -logsigmoid(alpha * d_eff). Adds an optional bounded objective/cost shift beta*dz (dz from an objective delta signal such as delta_z), keeping the core preference structure while allowing cost-aware adjustment. Clamping delta, shift, and per-example loss controls numerical stability and prevents extreme gradients.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  }\n}"}
{"key": "0ae23693b128de14f763e52e95f1c79f31f1cdef", "ts": 1771793115.6790178, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "42536ab43f92e121a04e48ff018290a382ee0105", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_shift_mix\",\n  \"intuition\": \"Start from a standard Bradley-Terry/DPO-style preference loss on the log-prob margin d = logp_w - logp_l. Incorporate an auxiliary objective/cost signal dz as a bounded additive shift to the margin (with sign preserved under winner/loser swap). Use softplus-based squashing and clamping so the shift stays small and numerically stable, and clamp per-example loss to avoid outliers dominating.\",\n  \"pseudocode\": \"Inputs: lw=logp_w, ll=logp_l, dz (objective/cost gap), hyperparams alpha,beta,d_clip,z_clip,shift_clip,d_eff_clip,per_clip,sps\\n\\n1) d = clamp(lw - ll, -d_clip, d_clip)\\n2) dzc = clamp(dz, -z_clip, z_clip)\\n3) amp = 1 - exp(-softplus(sps * abs(dzc)))      # in [0,1)\\n4) shift = clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n5) d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n6) per_example = -logsigmoid(alpha * d_eff)\\n7) per_example = clamp(per_example, 0, per_clip)\\n8) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0,\n    \"shift_softplus_scale\": 1.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Fetch log-probs with a small set of common key aliases.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a valid scalar tensor tied to an existing tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        return (base.sum() * 0.0) if base is not None else 0.0\\n\\n    # Objective/cost signal: prefer delta_z, then common aliases, then derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 1.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded objective shift, kept sign-consistent under swap.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Softplus-squashed amplitude: in [0, 1) (for sps>0), preserves sign via multiplication by dzc.\\n    # This keeps objective sensitivity while avoiding large additive shifts.\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * ops.abs(dzc)))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on margin d = logp_w - logp_l. Incorporates an additive objective/cost-derived shift that flips sign under winner/loser swap, preserving preference symmetry. Uses clamping and a softplus-based squashing of the objective shift to maintain numerical stability and keep per-example losses within an expected soft range while remaining sensitive to objective signals.\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"batch['log_prob_w'] or alias (e.g., 'logp_w', 'chosen_logprob')\",\n      \"batch['log_prob_l'] or alias (e.g., 'logp_l', 'rejected_logprob')\",\n      \"optional objective/cost signal: batch['delta_z'] or alias (e.g., 'cost_gap', 'delta_cost') or ('cost_a' - 'cost_b')\",\n      \"extra['hyperparams'] may override alpha,beta,d_clip,z_clip,shift_clip,d_eff_clip,per_clip,shift_softplus_scale\"\n    ],\n    \"returns\": \"Scalar torch.Tensor = mean(clamp(-logsigmoid(alpha * clamp(clamp(lw-ll)+shift)), 0, per_clip))\",\n    \"mode\": \"pairwise_preference_with_cost_shift\"\n  }\n}"}
{"key": "87b933c2c8b7a3ffd010ec96b49e90a54cf79541", "ts": 1771793137.8798554, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "681736579ea03c87fe43c51512e4c7842eb1bb4e", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_shift_mix\",\n  \"intuition\": \"Start from a standard Bradley-Terry/DPO-style preference loss on the log-prob margin d = logp_w - logp_l. Incorporate an auxiliary objective/cost signal dz as a bounded additive shift to the margin (with sign preserved under winner/loser swap). Use softplus-based squashing and clamping so the shift stays small and numerically stable, and clamp per-example loss to avoid outliers dominating.\",\n  \"pseudocode\": \"Inputs: log_prob_w, log_prob_l, dz (objective/cost gap), hyperparams alpha,beta,d_clip,z_clip,shift_clip,d_eff_clip,per_clip,sps\\n\\n1) d = clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n2) dzc = clamp(dz, -z_clip, z_clip)\\n3) amp = 1 - exp(-softplus(sps * abs(dzc)))      # in [0,1)\\n4) shift = clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n5) d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n6) per_example = -logsigmoid(alpha * d_eff)\\n7) per_example = clamp(per_example, 0, per_clip)\\n8) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0,\n    \"shift_softplus_scale\": 1.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_gap\",\n      \"delta_cost\",\n      \"cost_a\",\n      \"cost_b\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required keys by contract (implementation_hint.expects).\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective/cost signal: prefer delta_z, then common aliases, then derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 1.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded objective shift, kept sign-consistent under swap.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Softplus-squashed amplitude in [0, 1) for sps>0; preserves sign via multiplication by dzc.\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * ops.abs(dzc)))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on margin d = log_prob_w - log_prob_l. Incorporates an additive objective/cost-derived shift that flips sign under winner/loser swap, preserving preference symmetry. Uses clamping and a softplus-based squashing of the objective shift to maintain numerical stability and keep per-example losses within an expected soft range while remaining sensitive to objective signals.\"\n}"}
{"key": "9aef36036db1540c2f20e7391e8d7ad7efd1f599", "ts": 1771793159.6491714, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "a1cc4616dc5c5bdf185f188bec761f2c4e5321be", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_shift_mix\",\n  \"intuition\": \"Start from a standard Bradley-Terry/DPO-style preference loss on the log-prob margin d = logp_w - logp_l. Incorporate an auxiliary objective/cost signal dz as a bounded additive shift to the margin (with sign preserved under winner/loser swap). Use softplus-based squashing and clamping so the shift stays small and numerically stable, and clamp per-example loss to avoid outliers dominating.\",\n  \"pseudocode\": \"Inputs: log_prob_w, log_prob_l, delta_z (objective/cost gap), hyperparams alpha,beta,d_clip,z_clip,shift_clip,d_eff_clip,per_clip,sps\\n\\n1) d = clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n2) dzc = clamp(delta_z, -z_clip, z_clip)\\n3) amp = 1 - exp(-softplus(sps * abs(dzc)))      # in [0,1)\\n4) shift = clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n5) d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n6) per_example = -logsigmoid(alpha * d_eff)\\n7) per_example = clamp(per_example, 0, per_clip)\\n8) return mean(per_example)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0,\n    \"shift_softplus_scale\": 1.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required keys by contract (implementation_hint.expects).\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective/cost signal: prefer delta_z, then delta_rank/delta_regret, then derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        dz = batch.get(\\\"delta_rank\\\", None)\\n    if dz is None:\\n        dz = batch.get(\\\"delta_regret\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 1.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded objective shift, kept sign-consistent under swap.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Softplus-squashed amplitude in [0, 1) for sps>0; preserves sign via multiplication by dzc.\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * ops.abs(dzc)))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on margin d = log_prob_w - log_prob_l. Incorporates an additive objective/cost-derived shift (delta_z preferred; otherwise delta_rank/delta_regret; otherwise cost_a-cost_b) that flips sign under winner/loser swap, preserving preference symmetry. Uses clamping and a softplus-based squashing of the objective shift to maintain numerical stability and keep per-example losses within an expected soft range while remaining sensitive to objective signals.\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"uses_model_output\": false,\n    \"mode\": \"pairwise_preference\"\n  }\n}"}
{"key": "18f9ac0f2a0da469a3c4fa2644c17ec26f9d8068", "ts": 1771793179.4461064, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "98cdb1a049640bd1a4f36f7db3364fb258eda476", "content": "{\"name\":\"m3_stable_cost_shift_logsigmoid_v4_softplus_shift_mix_simplified_noabs\",\"intuition\":\"Use the standard Bradley-Terry/DPO-style loss on the log-prob margin d = logp_w - logp_l. Add a bounded, swap-consistent objective/cost shift beta*dz, but squash the shift magnitude with a softplus on dz^2 to avoid using abs (which caused forward errors) and to keep the shift small and numerically stable. Clamp margins and per-example loss to avoid outliers.\",\"pseudocode\":\"Inputs: log_prob_w, log_prob_l, delta_z (objective/cost gap), hyperparams alpha,beta,d_clip,z_clip,shift_clip,d_eff_clip,per_clip,sps\\n\\n1) d = clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n2) dzc = clamp(delta_z, -z_clip, z_clip)\\n3) amp = 1 - exp(-softplus(sps * dzc^2))         # in [0,1)\\n4) shift = clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n5) d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n6) per_example = -logsigmoid(alpha * d_eff)\\n7) per_example = clamp(per_example, 0, per_clip)\\n8) return mean(per_example)\",\"hyperparams\":{\"alpha\":1.0,\"beta\":0.25,\"d_clip\":30.0,\"z_clip\":20.0,\"shift_clip\":3.0,\"d_eff_clip\":30.0,\"per_clip\":5.0,\"shift_softplus_scale\":0.05},\"operators_used\":[\"clamp\",\"logsigmoid\",\"softplus\",\"exp\"],\"code\":\"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        dz = batch.get(\\\"delta_rank\\\", None)\\n    if dz is None:\\n        dz = batch.get(\\\"delta_regret\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 0.05))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Avoid ops.abs (can be unsupported in this harness); use dz^2 as a smooth magnitude proxy.\\n    mag2 = dzc * dzc\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * mag2))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\"theoretical_basis\":\"Bradley-Terry / logistic preference loss on the log-probability margin d = log_prob_w - log_prob_l. Adds an objective/cost-derived shift proportional to dz (delta_z preferred; otherwise delta_rank/delta_regret; otherwise cost_a-cost_b), which is swap-consistent when dz is defined as winner-minus-loser: swapping winner/loser flips both d and dz so the effective margin changes sign. The shift magnitude is smoothly squashed using a softplus of dz^2 (avoiding abs) and clamped, and both margin and per-example loss are clamped to maintain numerical stability and bounded influence.\"}"}
{"key": "d790dc9ecb21cf9ea785e29490093659a4744332", "ts": 1771793200.9210253, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "231e61f6f7eb05dd135eb97d09aaa74b29eed632", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_clamped_v2\",\n  \"intuition\": \"Stable Bradley-Terry style core: clamp the log-prob margin, add a bounded shift from an auxiliary objective delta signal when present, then apply -logsigmoid and mean-reduce. This version keeps swap-consistency when delta_z is winner-minus-loser, preserves objective sensitivity via a clipped additive shift, and clamps per-example loss for numerical safety while avoiding any forbidden ops or global state.\",\n  \"pseudocode\": \"lw, ll = batch.log_prob_w, batch.log_prob_l\\nif batch has delta_z: dz = delta_z\\nelse if batch has cost_a and cost_b: dz = cost_b - cost_a\\nelse: dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\ndz = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta*dz, -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nloss_per = clamp(-logsigmoid(alpha*d_eff), 0, per_clip)\\nreturn mean(loss_per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference learning on the log-probability margin d = log_prob_w - log_prob_l. An auxiliary scalar delta signal (prefer delta_z, else cost_b - cost_a) is added as a bounded shift beta*dz to modulate the effective margin. If delta_z is defined as winner-minus-loser objective, swapping winner/loser flips both d and dz, preserving swap-consistency. Clamping d, dz, shift, and per-example losses improves numerical stability and avoids extreme gradients.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\"\n    ],\n    \"optional\": [\n      \"batch['delta_z']\",\n      \"batch['cost_a']\",\n      \"batch['cost_b']\",\n      \"extra['hyperparams']\",\n      \"extra['alpha']\",\n      \"extra['beta']\",\n      \"extra['d_clip']\",\n      \"extra['z_clip']\",\n      \"extra['shift_clip']\",\n      \"extra['d_eff_clip']\",\n      \"extra['per_clip']\"\n    ]\n  }\n}"}
