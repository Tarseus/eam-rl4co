 None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"logp_w\",\n      \"logp_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\",\n      \"cost_gap\",\n      \"delta_cost\",\n      \"cost_a\",\n      \"cost_b\"\n    ],\n    \"uses_model_output\": false,\n    \"notes\": \"Requires winner/loser log-probabilities. Optionally uses an objective signal (prefer delta_z; else cost_gap/delta_cost; else derive from cost_a-cost_b) to apply a bounded additive shift to the preference margin. Returns mean per-example loss as a scalar tensor.\"\n  }\n}"}
{"key": "ac8b713292f9b3ffdc7c32c21b8a9059b82ac68d", "ts": 1771793352.7710295, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "4a7b90dc0ff7c97c66ad893c6bc401544540c784", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_softplus_gate\",\n  \"intuition\": \"Consensus-stable Bradley-Terry preference loss on the log-prob margin (log_prob_w - log_prob_l) with a bounded, swap-consistent additive objective shift (delta_z preferred; else cost_gap/delta_cost; else cost_b-cost_a). To improve objective sensitivity without destabilizing scale, apply a mild softplus-based gating factor that depends on |objective_delta|, while keeping all signals clamped to safe ranges and returning a scalar tensor.\",\n  \"pseudocode\": \"Inputs: batch with log_prob_w, log_prob_l; optional objective delta (delta_z/cost_gap/delta_cost or cost_b-cost_a); hyperparams.\\n1) Read lw, ll; if missing, return 0 * sum(any_tensor).\\n2) Compute dz from (delta_z else cost_gap/delta_cost else cost_b - cost_a else 0).\\n3) Clamp margin: d = clamp(lw - ll, [-d_clip, d_clip]).\\n4) Clamp objective: dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip]).\\n5) Effective margin: d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip]).\\n6) Gate: base_sp = softplus(0); mag = 0.5*(softplus(gate_k*dzc) + softplus(gate_k*(-dzc))); gate = 1 + gate_scale*clamp(mag - base_sp, [0, gate_clip]).\\n7) Per-example loss: per = gate * (-logsigmoid(alpha * d_eff)); clamp to [0, per_clip].\\n8) Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"gate_k\": 0.2,\n    \"gate_scale\": 0.25,\n    \"gate_clip\": 1.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust log-prob key fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing required tensors, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal: prefer delta_z; then cost_gap/delta_cost; else derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get(name, default):\\n        if isinstance(extra, dict) and (name in extra):\\n            return float(extra.get(name))\\n        return float(hp.get(name, default))\\n\\n    alpha = _get(\\\"alpha\\\", 1.0)\\n    beta = _get(\\\"beta\\\", 0.25)\\n    d_clip = _get(\\\"d_clip\\\", 30.0)\\n    z_clip = _get(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get(\\\"d_eff_clip\\\", 30.0)\\n    gate_k = _get(\\\"gate_k\\\", 0.2)\\n    gate_scale = _get(\\\"gate_scale\\\", 0.25)\\n    gate_clip = _get(\\\"gate_clip\\\", 1.0)\\n    per_clip = _get(\\\"per_clip\\\", 5.0)\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent if dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Mild objective-magnitude gating to avoid objective insensitivity.\\n    # gate >= 1, and is bounded to [1, 1+gate_scale*gate_clip].\\n    base_sp = ops.softplus(dzc * 0.0)\\n    mag = ops.softplus(gate_k * ops.clamp(dzc, -z_clip, z_clip)) + ops.softplus(gate_k * ops.clamp(-dzc, -z_clip, z_clip))\\n    mag = 0.5 * mag\\n    gate_raw = gate_scale * ops.clamp(mag - base_sp, 0.0, gate_clip)\\n    gate = 1.0 + gate_raw\\n\\n    per = gate * (-ops.logsigmoid(alpha * d_eff))\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Starts from the standard logistic pairwise preference objective: L = E[-log sigma(alpha * d_eff)], where d_eff is an effective margin. Incorporates an auxiliary objective difference dz via an additive bounded shift beta*dz to preserve swap-consistency when dz is defined as winner-minus-loser objective (swapping winner/loser flips both d and dz). Adds a bounded multiplicative gate g(dz)=1+gate_scale*clamp(0.5*(softplus(k*dz)+softplus(-k*dz)) - softplus(0), [0, gate_clip]) to increase sensitivity to objective magnitude while maintaining numerical stability through clamping of d, dz, shift, and final loss.\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or fallbacks: 'logp_w'/'logp_l' or 'chosen_logprob'/'rejected_logprob')\",\n      \"optional objective delta: batch['delta_z'] or batch['cost_gap'] or batch['delta_cost'] or (batch['cost_b']-batch['cost_a'])\",\n      \"extra may contain hyperparams either at top-level keys or in extra['hyperparams']\"\n    ]\n  }\n}"}
{"key": "39ed417771c949b9e30fb40c93339ebeeaba00e3", "ts": 1771793381.346816, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "35b530393ada574083a381e2b0847efe4f5a6b38", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_softplus_gate\",\n  \"intuition\": \"Consensus-stable Bradley-Terry preference loss on the log-prob margin (log_prob_w - log_prob_l) with a bounded, swap-consistent additive objective shift (delta_z preferred; else cost_gap/delta_cost; else cost_b-cost_a). To improve objective sensitivity without destabilizing scale, apply a mild softplus-based gating factor that depends on |objective_delta|, while keeping all signals clamped to safe ranges and returning a scalar tensor.\",\n  \"pseudocode\": \"Inputs: batch with log_prob_w, log_prob_l; optional objective delta (delta_z/cost_gap/delta_cost or cost_b-cost_a); hyperparams.\\n1) Read lw, ll; if missing, return 0 * sum(any_tensor).\\n2) Compute dz from (delta_z else cost_gap/delta_cost else cost_b - cost_a else 0).\\n3) Clamp margin: d = clamp(lw - ll, [-d_clip, d_clip]).\\n4) Clamp objective: dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip]).\\n5) Effective margin: d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip]).\\n6) Gate: base_sp = softplus(0); mag = 0.5*(softplus(gate_k*dzc) + softplus(gate_k*(-dzc))); gate = 1 + gate_scale*clamp(mag - base_sp, [0, gate_clip]).\\n7) Per-example loss: per = gate * (-logsigmoid(alpha * d_eff)); clamp to [0, per_clip].\\n8) Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"gate_k\": 0.2,\n    \"gate_scale\": 0.25,\n    \"gate_clip\": 1.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required inputs per implementation_hint.expects.\\n    lw = batch.get(\\\"log_prob_w\\\", None)\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n\\n    # If missing required tensors, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal: prefer delta_z; then cost_gap/delta_cost; else derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get(name, default):\\n        if isinstance(extra, dict) and (name in extra):\\n            return float(extra.get(name))\\n        return float(hp.get(name, default))\\n\\n    alpha = _get(\\\"alpha\\\", 1.0)\\n    beta = _get(\\\"beta\\\", 0.25)\\n    d_clip = _get(\\\"d_clip\\\", 30.0)\\n    z_clip = _get(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get(\\\"d_eff_clip\\\", 30.0)\\n    gate_k = _get(\\\"gate_k\\\", 0.2)\\n    gate_scale = _get(\\\"gate_scale\\\", 0.25)\\n    gate_clip = _get(\\\"gate_clip\\\", 1.0)\\n    per_clip = _get(\\\"per_clip\\\", 5.0)\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent if dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Mild objective-magnitude gating to avoid objective insensitivity.\\n    # gate >= 1, and is bounded to [1, 1+gate_scale*gate_clip].\\n    base_sp = ops.softplus(dzc * 0.0)\\n    mag = ops.softplus(gate_k * dzc) + ops.softplus(gate_k * (-dzc))\\n    mag = 0.5 * mag\\n    gate_raw = gate_scale * ops.clamp(mag - base_sp, 0.0, gate_clip)\\n    gate = 1.0 + gate_raw\\n\\n    per = gate * (-ops.logsigmoid(alpha * d_eff))\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Starts from the standard logistic pairwise preference objective: L = E[-log sigma(alpha * d_eff)], where d_eff is an effective margin. Incorporates an auxiliary objective difference dz via an additive bounded shift beta*dz to preserve swap-consistency when dz is defined as winner-minus-loser objective (swapping winner/loser flips both d and dz). Adds a bounded multiplicative gate g(dz)=1+gate_scale*clamp(0.5*(softplus(k*dz)+softplus(-k*dz)) - softplus(0), [0, gate_clip]) to increase sensitivity to objective magnitude while maintaining numerical stability through clamping of d, dz, shift, and final loss.\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise_logprob\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  }\n}"}
{"key": "cebb08768cf61f3acc550c7ffb5309f3cc1d0350", "ts": 1771793409.9567933, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "fb7f7b1caaac2f0fec0f8847c4bdcffc4d68b2d0", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_softplus_gate\",\n  \"intuition\": \"Consensus-stable Bradley-Terry preference loss on the log-prob margin (log_prob_w - log_prob_l) with a bounded, swap-consistent additive objective shift (delta_z preferred; else cost_b-cost_a). To improve objective sensitivity without destabilizing scale, apply a mild softplus-based gating factor that depends on |objective_delta|, while keeping all signals clamped to safe ranges and returning a scalar tensor.\",\n  \"pseudocode\": \"Inputs: batch with log_prob_w, log_prob_l; optional objective delta (delta_z preferred else cost_b-cost_a); hyperparams.\\n1) Read lw, ll; if missing, return 0 * sum(any_tensor).\\n2) Compute dz from (delta_z else cost_b - cost_a else 0).\\n3) Clamp margin: d = clamp(lw - ll, [-d_clip, d_clip]).\\n4) Clamp objective: dzc = clamp(dz, [-z_clip, z_clip]); shift = clamp(beta * dzc, [-shift_clip, shift_clip]).\\n5) Effective margin: d_eff = clamp(d + shift, [-d_eff_clip, d_eff_clip]).\\n6) Gate: base_sp = softplus(0); mag = 0.5*(softplus(gate_k*dzc) + softplus(gate_k*(-dzc))); gate = 1 + gate_scale*clamp(mag - base_sp, [0, gate_clip]).\\n7) Per-example loss: per = gate * (-logsigmoid(alpha * d_eff)); clamp to [0, per_clip].\\n8) Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"gate_k\": 0.2,\n    \"gate_scale\": 0.25,\n    \"gate_clip\": 1.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch.get(\\\"log_prob_w\\\", None)\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n\\n    # If missing required tensors, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal: prefer delta_z; else derive from costs if available.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get(name, default):\\n        if isinstance(extra, dict) and (name in extra):\\n            return float(extra.get(name))\\n        return float(hp.get(name, default))\\n\\n    alpha = _get(\\\"alpha\\\", 1.0)\\n    beta = _get(\\\"beta\\\", 0.25)\\n    d_clip = _get(\\\"d_clip\\\", 30.0)\\n    z_clip = _get(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get(\\\"d_eff_clip\\\", 30.0)\\n    gate_k = _get(\\\"gate_k\\\", 0.2)\\n    gate_scale = _get(\\\"gate_scale\\\", 0.25)\\n    gate_clip = _get(\\\"gate_clip\\\", 1.0)\\n    per_clip = _get(\\\"per_clip\\\", 5.0)\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Mild objective-magnitude gating to avoid objective insensitivity.\\n    base_sp = ops.softplus(dzc * 0.0)\\n    mag = ops.softplus(gate_k * dzc) + ops.softplus(gate_k * (-dzc))\\n    mag = 0.5 * mag\\n    gate_raw = gate_scale * ops.clamp(mag - base_sp, 0.0, gate_clip)\\n    gate = 1.0 + gate_raw\\n\\n    per = gate * (-ops.logsigmoid(alpha * d_eff))\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Starts from the standard logistic pairwise preference objective: L = E[-log sigma(alpha * d_eff)], where d_eff is an effective margin. Incorporates an auxiliary objective difference dz via an additive bounded shift beta*dz to preserve swap-consistency when dz is defined as winner-minus-loser objective (swapping winner/loser flips both d and dz). Adds a bounded multiplicative gate g(dz)=1+gate_scale*clamp(0.5*(softplus(k*dz)+softplus(-k*dz)) - softplus(0), [0, gate_clip]) to increase sensitivity to objective magnitude while maintaining numerical stability through clamping of d, dz, shift, and final loss.\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"cost_a\",\n      \"cost_b\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise_preference\"\n  }\n}"}
{"key": "2a5cc214debe46fa38b8df844b923637f07b6cc5", "ts": 1771793434.688504, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "d426a7f75442eccf3f40437777097b4b282a239e", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_v2_blend\",\n  \"intuition\": \"Blend a stable logistic preference core with a bounded auxiliary objective shift. Compute a clamped log-prob margin d = log_prob_w - log_prob_l and add a small, clamped shift proportional to an external delta_z/cost signal. Apply -logsigmoid(alpha * d_eff) and clamp per-example loss to keep gradients stable. When the objective delta is defined consistently (winner minus loser), swapping winner/loser flips both terms and preserves antisymmetry.\",\n  \"pseudocode\": \"lw = batch.log_prob_w (or alias)\\nll = batch.log_prob_l (or alias)\\nif lw or ll missing: return 0-tensor scalar\\n\\ndz = batch.delta_z or batch.cost_gap or batch.delta_cost\\nif dz missing:\\n  if cost_a and cost_b exist: dz = cost_a - cost_b\\n  else: dz = 0 (like lw*0)\\n\\nread hyperparams: alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, per_clip\\n\\nd = clamp(lw - ll, -d_clip, d_clip)\\ndz_c = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta * dz_c, -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\nper_ex = -logsigmoid(alpha * d_eff)\\nper_ex = clamp(per_ex, 0, per_clip)\\nreturn mean(per_ex)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Preference log-prob margin.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases; else derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on delta=logp_w-logp_l. A bounded additive shift beta*dz incorporates an external objective difference signal; when dz is defined as winner-minus-loser objective, swapping winner/loser flips both delta and dz, preserving antisymmetry of the effective margin. Clamping ensures numerical stability and bounded per-example contribution.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_gap\",\n      \"delta_cost\",\n      \"cost_a\",\n      \"cost_b\",\n      \"logp_w\",\n      \"logp_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\"\n    ]\n  }\n}"}
{"key": "97e2fb3bea0f500257bbb6e61586b2eb1c0989f9", "ts": 1771793459.9058926, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "6b2e482d05cb89b0826fe94ec7bb737b70d5a083", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_v2_blend_fix_expects\",\n  \"intuition\": \"Use a standard stable logistic preference core on the log-prob margin d = log_prob_w - log_prob_l, and incorporate an external objective/cost difference signal via a bounded additive shift. The objective signal is read from delta_z (preferred) or derived from cost_a - cost_b. All auxiliary contributions are clamped to keep gradients stable. If the objective signal is defined as winner-minus-loser, swapping winner/loser flips both d and dz, preserving antisymmetry of the effective margin.\",\n  \"pseudocode\": \"lw = batch.log_prob_w (or alias)\\nll = batch.log_prob_l (or alias)\\nif missing: return scalar 0-tensor\\n\\ndz = batch.delta_z if present\\nelse if cost_a and cost_b present: dz = cost_a - cost_b\\nelse: dz = 0 (lw*0)\\n\\nread hyperparams: alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, per_clip\\n\\nd = clamp(lw - ll, -d_clip, d_clip)\\ndz_c = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta * dz_c, -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\nper_ex = -logsigmoid(alpha * d_eff)\\nper_ex = clamp(per_ex, 0, per_clip)\\nreturn mean(per_ex)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"logp_w\",\n      \"logp_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\",\n      \"cost_a\",\n      \"cost_b\"\n    ],\n    \"notes\": \"Uses delta_z when present; otherwise derives an objective gap from cost_a - cost_b. If none are present, falls back to a zero shift (lw*0) so the loss reduces to standard logistic preference.\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Preference log-prob margin.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0\\n\\n    # Objective/cost signal: prefer delta_z; else derive from cost_a/cost_b; else zero.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on the log-prob margin d = logp_w - logp_l. A bounded additive shift beta*dz injects an external objective gap (delta_z or cost_a - cost_b). When the objective gap is defined as winner-minus-loser, swapping winner/loser flips both d and dz, preserving antisymmetry of the effective margin. Clamping improves numerical stability and bounds per-example influence.\"\n}"}
{"key": "2d4f5feee8f92cebdc96d8461b418524903747a2", "ts": 1771813895.9273574, "model": "gpt-5.2", "llm_op": "M2", "prompt_path": "PTP/prompts/free_loss_m2.txt", "prompt_sha1": "1dd19f3f94a21cf815c90c47194822ec6f2a57f9", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_cap_M2_tuned\",\n  \"intuition\": \"Keep the parent’s robust, swap-consistent cost-shifted preference loss, but tune hyperparameters to (a) increase sensitivity to the auxiliary objective via a slightly larger beta and shift_clip, (b) reduce unnecessary saturation by tightening extreme margin clamps, and (c) avoid any loss-range issues by lowering the smooth cap while keeping it positive (so the tanh-based cap path remains active).\",\n  \"pseudocode\": \"Inputs: batch dict with winner/loser log-probs and optional objective delta; model_output tensor-like; extra dict.\\n1) Read lw from batch['log_prob_w'|'logp_w'|'chosen_logprob']; ll from batch['log_prob_l'|'logp_l'|'rejected_logprob'].\\n2) If lw or ll missing: return 0 * sum(any available tensor) to produce a scalar tensor.\\n3) Read objective delta dz from batch['delta_z'|'cost_gap'|'delta_cost']; else if cost_a and cost_b exist set dz = cost_a - cost_b; else dz = 0.\\n4) Load hyperparams alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, cap from extra/hyperparams with defaults.\\n5) Compute margin d = clamp(lw - ll, -d_clip, d_clip).\\n6) Clamp dz: dzc = clamp(dz, -z_clip, z_clip); shift = clamp(beta * dzc, -shift_clip, shift_clip).\\n7) Effective margin: d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip).\\n8) Per-example loss: per = softplus(-alpha * d_eff).\\n9) Smooth cap (optional): per = cap * 0.5 * (tanh(per / cap) + 1) if cap > 0.\\n10) Return mean(per) as scalar tensor.\",\n  \"hyperparams\": {\n    \"alpha\": 1.15,\n    \"beta\": 0.35,\n    \"d_clip\": 20.0,\n    \"z_clip\": 12.0,\n    \"shift_clip\": 4.0,\n    \"d_eff_clip\": 24.0,\n    \"cap\": 3.5\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"softplus\",\n    \"tanh\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust key fallbacks for log-probabilities.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor tied to available tensors.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"implementation_hint\": \"Use ops.clamp/ops.softplus/ops.tanh exactly as in the provided code; pass hyperparameters via extra['hyperparams'] (or top-level extra keys) with positive cap to enable the smooth tanh cap. Provide log-prob keys using one of the supported aliases; objective delta can be delta_z/cost_gap/delta_cost or derived from cost_a-cost_b.\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\",\n  \"metrics\": {\n    \"hf_like_score\": 8.797432865905762,\n    \"validation_objective\": 7.797432865905762,\n    \"generalization_penalty\": 0.0,\n    \"pair_count\": 9891906357\n  }\n}"}
