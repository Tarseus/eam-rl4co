= batch.get(\\\"log_prob_w\\\", None)\\n    ll = batch.get(\\\"log_prob_l\\\", None)\\n\\n    # If missing, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get_hp(key, default):\\n        if isinstance(extra, dict) and (key in extra):\\n            return extra.get(key)\\n        return hyper.get(key, default)\\n\\n    alpha = float(_get_hp(\\\"alpha\\\", 1.0))\\n    beta = float(_get_hp(\\\"beta\\\", 0.25))\\n    d_clip = float(_get_hp(\\\"d_clip\\\", 30.0))\\n    z_clip = float(_get_hp(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(_get_hp(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(_get_hp(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(_get_hp(\\\"per_clip\\\", 5.0))\\n\\n    # Objective delta signal: prefer delta_z; otherwise use common aliases or derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d=log_prob_w-log_prob_l. An additive bounded shift beta*dz incorporates an auxiliary objective-difference signal (delta_z or cost-derived proxy) when dz is winner-minus-loser. Clamping of d, dz, shift, and final per-example loss improves numerical stability and keeps outputs within expected dynamic range.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_gap\",\n      \"delta_cost\",\n      \"cost_a\",\n      \"cost_b\"\n    ]\n  }\n}"}
