{"key": "633afadb2cfb10305d20c97a16f6ea9390d6bac6", "ts": 1771755397.8697999, "model": "gpt-5.2", "llm_op": "E1_GENERATE", "prompt_path": "PTP/prompts/free_loss_generation.txt", "prompt_sha1": "73300410e163481a101c1758f257918fe487f235", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting that depends on the (z-scored) objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded.\",\n  \"pseudocode\": \"Given d = logp_w - logp_l and g = zscore(delta_z). Let w = clamp(softplus(beta * g), w_min, w_max). Loss = mean( w * softplus(-alpha * d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-6\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\",\n      \"weight\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = extra[\\\"log_prob_w\\\"]\\n    log_prob_l = extra[\\\"log_prob_l\\\"]\\n    delta_z = extra[\\\"delta_z\\\"]\\n    base_weight = extra.get(\\\"weight\\\", None)\\n\\n    alpha = float(extra.get(\\\"alpha\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\\n\"\n}"}
