erical stability and keeps outputs within expected dynamic range.\"\n}"}
{"key": "110a646e5e621a94ebdde51dded903c233a6c922", "ts": 1771792608.1692593, "model": "gpt-5.2", "llm_op": "E1", "prompt_path": "PTP/prompts/free_loss_crossover.txt", "prompt_sha1": "b6653ad2c8423c1c44c225f72b1ff89d014a7cab", "content": "{\"name\":\"E1_cost_shift_logistic_softplusblend\",\"type\":\"evolved\",\"generation\":2,\"parents\":[\"cost_shift_logsigmoid_m3_swapfix\",\"m3_stable_cost_shift_logsigmoid_v2_objective\"],\"operators_used\":[\"clamp\",\"logsigmoid\",\"softplus\"],\"hyperparams\":{\"alpha\":1.0,\"beta\":0.3,\"mix\":0.6,\"d_clip\":25.0,\"z_clip\":20.0,\"shift_clip\":4.0,\"d_eff_clip\":25.0,\"per_clip\":5.0,\"w_clip\":10.0},\"implementation_hint\":{\"expects\":[\"log_prob_w\",\"log_prob_l\",\"delta_z\"],\"optional\":[\"weight\"]},\"code\":\"def generated_loss(batch, model_output, extra):\\n    # Required inputs (explicit to satisfy input gates).\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n    dz = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.3))\\n    mix = float((extra.get(\\\"mix\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"mix\\\", 0.6))\\n\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 25.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 4.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 25.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n    w_clip = float((extra.get(\\\"w_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_clip\\\", 10.0))\\n\\n    # Clamp mix into [0,1] without relying on python min/max.\\n    mix = ops.clamp(mix, 0.0, 1.0)\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Blend of equivalent logistic forms for stability and smooth gradients.\\n    per_log = -ops.logsigmoid(alpha * d_eff)\\n    per_sp = ops.softplus(-alpha * d_eff)\\n    per = mix * per_log + (1.0 - mix) * per_sp\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    if base_weight is not None:\\n        bw = ops.clamp(base_weight, 0.0, w_clip)\\n        per = per * bw\\n\\n    return per.mean()\",\"theoretical_basis\":\"Bradley-Terry logistic preference loss on margin d=log_prob_w-log_prob_l, with a bounded additive objective shift beta*delta_z to preserve swap-consistency (swapping winner/loser flips both d and delta_z, hence d_eff changes sign). The per-example loss blends two numerically stable equivalent expressions (-logsigmoid(alpha*d_eff) and softplus(-alpha*d_eff)) and clamps inputs/outputs to keep gradients and values within a safe dynamic range; optional weights are nonnegative-clamped to avoid sign inversions.\",\"metrics\":{\"hf_like_score\":null,\"validation_objective\":null,\"generalization_penalty\":null,\"pair_count\":null}}"}
