\\n    if \\\"delta_z\\\" in batch:\\n        s = batch[\\\"delta_z\\\"]\\n    elif (\\\"cost_w\\\" in batch) and (\\\"cost_l\\\" in batch):\\n        s = batch[\\\"cost_l\\\"] - batch[\\\"cost_w\\\"]\\n    else:\\n        s = d * 0.0\\n\\n    g = ops.zscore(s, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Starts from a Bradley-Terry/logistic pairwise preference objective softplus(-alpha*(logp_w-logp_l)). Adds a bounded multiplicative weight based on a standardized auxiliary objective signal (delta_z preferred; otherwise cost difference) to emphasize higher-separation examples while maintaining stability via clamping.\"\n}"}
