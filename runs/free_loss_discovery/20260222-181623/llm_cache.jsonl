m cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on delta=logp_w-logp_l. A bounded additive shift beta*dz incorporates an external objective difference signal; when dz is defined as winner-minus-loser objective, swapping winner/loser flips both delta and dz, preserving antisymmetry of the effective margin. Clamping ensures numerical stability and bounded per-example contribution.\"\n}"}
{"key": "b8c02f0ab531b2e2349abef8f351c8532d844ec2", "ts": 1771792905.2266831, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "529683ff09d480ab7ebc9d9ce5e11d0101cdba8e", "content": "{\n  \"name\": \"E1_m3_cost_shift_logsigmoid_v4_fallbacks_scalar\",\n  \"intuition\": \"Crossover of a stable cost-shifted Bradley-Terry preference loss: per-example = -logsigmoid(alpha*(clamp(log_prob_w-log_prob_l) + clamp(beta*clamp(delta_z)))) with strict clamping for numerical stability, optional objective-signal fallbacks (delta_z/cost_gap/delta_cost/cost_a-cost_b) for robustness, and a bounded per-example loss to satisfy dynamic range gates.\",\n  \"pseudocode\": \"Inputs: batch dict with log_prob_w, log_prob_l (or fallbacks), optional delta_z (or fallbacks); extra may contain hyperparams.\\n\\n1) Read lw = batch['log_prob_w'] (fallbacks: 'logp_w', 'chosen_logprob')\\n   Read ll = batch['log_prob_l'] (fallbacks: 'logp_l', 'rejected_logprob')\\n   If either missing: return a scalar zero built from an existing tensor.\\n\\n2) Read hyperparameters (alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, per_clip) from extra/hyperparams with defaults.\\n\\n3) Read dz = batch['delta_z'] (fallbacks: 'cost_gap', 'delta_cost');\\n   If still missing and cost_a and cost_b exist: dz = cost_a - cost_b; else dz = 0 tensor like lw.\\n\\n4) Compute clamped margin d = clamp(lw - ll, -d_clip, d_clip)\\n5) Compute dzc = clamp(dz, -z_clip, z_clip)\\n6) Compute shift = clamp(beta * dzc, -shift_clip, shift_clip)\\n7) Compute effective margin d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n8) Per-example loss: per = -logsigmoid(alpha * d_eff)\\n9) Clamp per to [0, per_clip]\\n10) Return mean(per) as a scalar tensor.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Preference logits (winner/loser). Use canonical keys, with common fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor to satisfy dynamic gates.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    # Objective delta signal: prefer delta_z; otherwise use common aliases or derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d=log_prob_w-log_prob_l. An additive bounded shift beta*dz incorporates an auxiliary objective-difference signal (delta_z or cost-derived proxy) in a swap-consistent way when dz is winner-minus-loser. Clamping of d, dz, shift, and final per-example loss improves numerical stability and keeps outputs within expected dynamic range.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or fallbacks) are tensors with matching shape\",\n      \"optional batch['delta_z'] (or cost_gap/delta_cost/cost_a-cost_b) is broadcastable to log_prob tensors\",\n      \"returns a scalar torch.Tensor (mean loss)\"\n    ]\n  }\n}"}
