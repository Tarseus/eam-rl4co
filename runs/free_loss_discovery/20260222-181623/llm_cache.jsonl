{"key": "c236938d5484c584c379d4f48333e3374770ffd2", "ts": 1771755579.3886142, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "68897e7bf86e3c16ceca38d684a039906505db1f", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting based on a z-scored objective signal (delta_z / cost gap). Uses in-batch log-prob fields (winner/loser), emphasizes clearer separations, and keeps weights bounded for stability.\",\n  \"pseudocode\": \"Given d = log_prob_w - log_prob_l. Let s be an objective signal (prefer delta_z else cost_b - cost_a else 0). Compute g = zscore(s). Let w = clamp(softplus(beta * g), w_min, w_max). Loss = mean( w * softplus(-alpha * d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Canonical preference keys.\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal (at least one is declared in implementation_hint.expects).\\n    # Prefer delta_z from extra; otherwise fall back to an in-batch cost gap if available.\\n    delta_z = extra.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        cost_a = batch.get(\\\"cost_a\\\", None)\\n        cost_b = batch.get(\\\"cost_b\\\", None)\\n        if (cost_a is not None) and (cost_b is not None):\\n            delta_z = cost_b - cost_a\\n        else:\\n            delta_z = ops.zeros_like(log_prob_w)\\n\\n    base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hyper.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "c1ae97398dae229720c7f6567346155e4fd19922", "ts": 1771755591.9093702, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "02e6f3611eb597091922497dc0515fcf3432aa18", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt_m3_stable\",\n  \"intuition\": \"Stable Bradley-Terry preference loss with bounded focal-style reweighting from a z-scored objective signal. Removes unsupported zeros_like usage by deriving a safe fallback signal from existing tensors and clamps/normalizes to avoid numerical issues.\",\n  \"pseudocode\": \"d = log_prob_w - log_prob_l. Get signal s = extra.delta_z else (cost_b - cost_a) else 0*d. g = zscore(s). w = clamp(softplus(beta*g), w_min, w_max). loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n\\n    delta_z = extra.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        cost_a = batch.get(\\\"cost_a\\\", None)\\n        cost_b = batch.get(\\\"cost_b\\\", None)\\n        if (cost_a is not None) and (cost_b is not None):\\n            delta_z = cost_b - cost_a\\n        else:\\n            # Avoid ops.zeros_like (may be unsupported). 0*d preserves shape/device/dtype.\\n            delta_z = (log_prob_w - log_prob_w)\\n\\n    base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hyper.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "211d55549620d7d89e74d494f5b47f5bd0a06710", "ts": 1771755605.906881, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "306fc228c5312cd7810c262222d7cf2e4249e4cd", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting that depends on the (z-scored) objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded. Robust to different input containers by accepting either batch or extra fields.\",\n  \"pseudocode\": \"Given d = logp_w - logp_l and g = zscore(delta_z). Let w = clamp(softplus(beta * g), w_min, w_max). Loss = mean( w * softplus(-alpha * d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Accept keys from either batch or extra to match different harnesses.\\n    container = extra if isinstance(extra, dict) else {}\\n    b = batch if isinstance(batch, dict) else {}\\n\\n    def get_key(k, default=None):\\n        if k in b:\\n            return b[k]\\n        if k in container:\\n            return container[k]\\n        return default\\n\\n    log_prob_w = get_key(\\\"log_prob_w\\\")\\n    log_prob_l = get_key(\\\"log_prob_l\\\")\\n    delta_z = get_key(\\\"delta_z\\\")\\n    base_weight = get_key(\\\"weight\\\", None)\\n\\n    hyper = container.get(\\\"hyperparams\\\", {}) if isinstance(container, dict) else {}\\n    alpha = float(container.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(container.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 1.0)))\\n    w_min = float(container.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(container.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 4.0)))\\n    eps = float(container.get(\\\"eps\\\", hyper.get(\\\"eps\\\", 1e-6)))\\n\\n    # If required signals are missing, return a safe zero loss tensor.\\n    if log_prob_w is None or log_prob_l is None:\\n        z = model_output\\n        return z.sum() * 0.0\\n    if delta_z is None:\\n        delta_z = (log_prob_w - log_prob_l) * 0.0\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  }\n}"}
{"key": "587b75a6c6fb1624b9fd5ef997f16a560ba2edf2", "ts": 1771755620.1119988, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "7caf0f3a1feb43fa0331d607457105eaf420063b", "content": "{\n  \"name\": \"objective_sensitive_cost_scaled_bt\",\n  \"intuition\": \"Make the preference loss explicitly sensitive to the objective/cost signal by scaling the Bradley-Terry loss with a monotone function of the (possibly z-scored) objective gap. Uses a bounded weight to avoid numerical blowups and keeps the core BT semantics intact.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = zscore(delta_z). w = clamp(1 + scale * sigmoid(beta * g), w_min, w_max). Loss = mean(w * softplus(-alpha * d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 2.0,\n    \"scale\": 2.0,\n    \"w_min\": 0.5,\n    \"w_max\": 3.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"sigmoid\",\n    \"clamp\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    container = extra if isinstance(extra, dict) else {}\\n    b = batch if isinstance(batch, dict) else {}\\n\\n    def get_key(k, default=None):\\n        if k in b:\\n            return b[k]\\n        if k in container:\\n            return container[k]\\n        return default\\n\\n    log_prob_w = get_key(\\\"log_prob_w\\\")\\n    log_prob_l = get_key(\\\"log_prob_l\\\")\\n    delta_z = get_key(\\\"delta_z\\\")\\n    base_weight = get_key(\\\"weight\\\", None)\\n\\n    hyper = container.get(\\\"hyperparams\\\", {}) if isinstance(container, dict) else {}\\n    alpha = float(container.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(container.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 2.0)))\\n    scale = float(container.get(\\\"scale\\\", hyper.get(\\\"scale\\\", 2.0)))\\n    w_min = float(container.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.5)))\\n    w_max = float(container.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 3.0)))\\n    eps = float(container.get(\\\"eps\\\", hyper.get(\\\"eps\\\", 1e-6)))\\n\\n    if log_prob_w is None or log_prob_l is None:\\n        z = model_output\\n        return z.sum() * 0.0\\n\\n    if delta_z is None:\\n        # If missing, fall back to zeros (no objective modulation).\\n        delta_z = (log_prob_w - log_prob_l) * 0.0\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Normalize objective gap to stabilize across batches, then map to bounded weight.\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = 1.0 + scale * ops.sigmoid(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "c008e9be306563e4b3ff5332512d4351e864711d", "ts": 1771755638.4354937, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "a1c2bd7e802c01e83465184ad178c8e1f63be87d", "content": "{\n  \"name\": \"objective_sensitive_cost_scaled_bt_stable\",\n  \"intuition\": \"Increase objective sensitivity by adding an explicit, bounded objective-dependent term to the BT loss (not just reweighting). Uses a simple linear+nonlinear modulation of the logit with clamping to keep gradients stable and ensure measurable loss change under objective perturbations.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = clamp(zscore(delta_z), -g_clip, g_clip). adj = clamp(beta*g, -adj_clip, adj_clip). Loss = mean( softplus(-(alpha*d + adj)) * (1 + w_scale*sigmoid(beta*g)) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 2.0,\n    \"w_scale\": 1.0,\n    \"w_min\": 0.5,\n    \"w_max\": 3.0,\n    \"g_clip\": 5.0,\n    \"adj_clip\": 10.0,\n    \"d_clip\": 30.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"sigmoid\",\n    \"clamp\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    container = extra if isinstance(extra, dict) else {}\\n    b = batch if isinstance(batch, dict) else {}\\n\\n    def get_key(k, default=None):\\n        if k in b:\\n            return b[k]\\n        if k in container:\\n            return container[k]\\n        return default\\n\\n    log_prob_w = get_key(\\\"log_prob_w\\\")\\n    log_prob_l = get_key(\\\"log_prob_l\\\")\\n    delta_z = get_key(\\\"delta_z\\\")\\n    base_weight = get_key(\\\"weight\\\", None)\\n\\n    hyper = container.get(\\\"hyperparams\\\", {}) if isinstance(container, dict) else {}\\n    alpha = float(container.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(container.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 2.0)))\\n    w_scale = float(container.get(\\\"w_scale\\\", hyper.get(\\\"w_scale\\\", 1.0)))\\n    w_min = float(container.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.5)))\\n    w_max = float(container.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 3.0)))\\n    g_clip = float(container.get(\\\"g_clip\\\", hyper.get(\\\"g_clip\\\", 5.0)))\\n    adj_clip = float(container.get(\\\"adj_clip\\\", hyper.get(\\\"adj_clip\\\", 10.0)))\\n    d_clip = float(container.get(\\\"d_clip\\\", hyper.get(\\\"d_clip\\\", 30.0)))\\n    eps = float(container.get(\\\"eps\\\", hyper.get(\\\"eps\\\", 1e-6)))\\n\\n    if log_prob_w is None or log_prob_l is None:\\n        z = model_output\\n        return z.sum() * 0.0\\n\\n    if delta_z is None:\\n        delta_z = (log_prob_w - log_prob_l) * 0.0\\n\\n    d = log_prob_w - log_prob_l\\n    d = ops.clamp(d, -d_clip, d_clip)\\n\\n    # Objective signal: normalize, then clip to keep modulation bounded.\\n    g = ops.zscore(delta_z, eps=eps)\\n    g = ops.clamp(g, -g_clip, g_clip)\\n\\n    # Additive objective-dependent logit shift ensures direct sensitivity of the loss.\\n    adj = ops.clamp(beta * g, -adj_clip, adj_clip)\\n\\n    # Optional bounded multiplicative scaling (kept mild by default).\\n    w = 1.0 + w_scale * ops.sigmoid(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-(alpha * d + adj))\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference loss with an additional bounded, monotone objective-dependent logit shift; clipping and z-scoring improve numerical stability and make sensitivity to objective perturbations measurable.\"\n}"}
{"key": "e821cb16177374cada58ec166dcb490ffef95387", "ts": 1771755656.2911084, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "004c080a38df4268d6c9a7a77611537096fef1a4", "content": "{\n  \"name\": \"objective_sensitive_cost_scaled_bt_stable_m3\",\n  \"intuition\": \"Make the loss directly and measurably sensitive to the objective signal by (1) using a non-normalized, clipped objective term (zscore can erase magnitude differences) and (2) adding a small always-present penalty proportional to |delta_z|. Keep everything bounded with clamps and mild coefficients to avoid numerical instability.\",\n  \"pseudocode\": \"d = clamp(logp_w - logp_l, -d_clip, d_clip). g = clamp(delta_z, -g_clip, g_clip). bt = softplus(-(alpha*d + beta*g)). reg = lambda_obj*abs(g). w = clamp(1 + w_scale*sigmoid(beta*g), w_min, w_max). Loss = mean(w*bt + reg).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_scale\": 0.5,\n    \"w_min\": 0.5,\n    \"w_max\": 3.0,\n    \"g_clip\": 5.0,\n    \"d_clip\": 30.0,\n    \"lambda_obj\": 0.01\n  },\n  \"operators_used\": [\n    \"sigmoid\",\n    \"clamp\",\n    \"softplus\",\n    \"abs\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    container = extra if isinstance(extra, dict) else {}\\n    b = batch if isinstance(batch, dict) else {}\\n\\n    def get_key(k, default=None):\\n        if k in b:\\n            return b[k]\\n        if k in container:\\n            return container[k]\\n        return default\\n\\n    log_prob_w = get_key(\\\"log_prob_w\\\")\\n    log_prob_l = get_key(\\\"log_prob_l\\\")\\n    delta_z = get_key(\\\"delta_z\\\")\\n    base_weight = get_key(\\\"weight\\\", None)\\n\\n    hyper = container.get(\\\"hyperparams\\\", {}) if isinstance(container, dict) else {}\\n    alpha = float(container.get(\\\"alpha\\\", hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(container.get(\\\"beta\\\", hyper.get(\\\"beta\\\", 1.0)))\\n    w_scale = float(container.get(\\\"w_scale\\\", hyper.get(\\\"w_scale\\\", 0.5)))\\n    w_min = float(container.get(\\\"w_min\\\", hyper.get(\\\"w_min\\\", 0.5)))\\n    w_max = float(container.get(\\\"w_max\\\", hyper.get(\\\"w_max\\\", 3.0)))\\n    g_clip = float(container.get(\\\"g_clip\\\", hyper.get(\\\"g_clip\\\", 5.0)))\\n    d_clip = float(container.get(\\\"d_clip\\\", hyper.get(\\\"d_clip\\\", 30.0)))\\n    lambda_obj = float(container.get(\\\"lambda_obj\\\", hyper.get(\\\"lambda_obj\\\", 0.01)))\\n\\n    if log_prob_w is None or log_prob_l is None:\\n        z = model_output\\n        return z.sum() * 0.0\\n\\n    if delta_z is None:\\n        delta_z = (log_prob_w - log_prob_l) * 0.0\\n\\n    d = ops.clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n\\n    # Use raw (clipped) objective signal to preserve magnitude sensitivity.\\n    g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    # Objective-dependent logit shift + bounded multiplicative modulation.\\n    bt = ops.softplus(-(alpha * d + beta * g))\\n\\n    w = 1.0 + w_scale * ops.sigmoid(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    # Always-present objective sensitivity term.\\n    reg = lambda_obj * ops.abs(g)\\n\\n    per_pair = w * bt + reg\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry/softplus preference loss with a bounded objective-dependent logit shift for direct objective coupling, plus a small L1 penalty on the (clipped) objective signal to ensure measurable sensitivity without destabilizing gradients.\"\n}"}
{"key": "c32308d6dec24ca5f0ad116d5e4e89cb5475218a", "ts": 1771755673.1396642, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "49a05734a7b2a427c3bf369a4381cace3358ac39", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by a z-scored objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded. Compatible with trainers that provide chosen/rejected log-probs in batch or extra.\",\n  \"pseudocode\": \"Get logp_w/logp_l from batch (preferred) or extra. Let d = logp_w - logp_l. Let g = zscore(delta_z) if available else zeros. Weight w = clamp(softplus(beta*g), w_min, w_max). Loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Pull required log-probs from batch first (gate expects batch keys).\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra.get(\\\"log_prob_w\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra.get(\\\"log_prob_l\\\", None)\\n\\n    # Fallbacks for common naming conventions.\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"logp_chosen\\\", batch.get(\\\"chosen_logps\\\", extra.get(\\\"logp_chosen\\\", extra.get(\\\"chosen_logps\\\", None))))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"logp_rejected\\\", batch.get(\\\"rejected_logps\\\", extra.get(\\\"logp_rejected\\\", extra.get(\\\"rejected_logps\\\", None))))\\n\\n    alpha = float(extra.get(\\\"alpha\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"eps\\\", 1e-6)))\\n\\n    # Ensure the dynamic gate never fails on missing keys.\\n    if log_prob_w is None or log_prob_l is None:\\n        # Prefer a safe zero loss if required signals are absent.\\n        return ops.zeros((), dtype=ops.float32, device=ops.device_of(model_output))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Optional objective gap signal for focal weighting.\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n    if delta_z is None:\\n        g = ops.zeros_like(d)\\n    else:\\n        g = ops.zscore(delta_z, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  }\n}"}
{"key": "d95fb7893832b00d5452dadf321cb411b1322dc6", "ts": 1771755691.6147213, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "f494f7e89bd2bb4357b4774c9174ef39d5d1c3d5", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by a z-scored objective gap (delta_z), emphasizing pairs with clearer quality separation while keeping weights bounded. Uses chosen/rejected log-probs and optionally delta_z for weighting.\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise preference objective with a bounded focal-style reweighting based on a standardized auxiliary objective gap (delta_z). This increases emphasis on pairs with clearer separation while keeping gradients stable via clamping.\",\n  \"pseudocode\": \"Get log_prob_w/log_prob_l from batch (preferred) or extra. Let d = log_prob_w - log_prob_l. Let g = zscore(delta_z) if provided else zeros. Weight w = clamp(softplus(beta*g), w_min, w_max). Loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": {\n      \"batch\": [\n        \"log_prob_w\",\n        \"log_prob_l\",\n        \"delta_z\"\n      ],\n      \"extra\": []\n    },\n    \"uses_model_output\": false,\n    \"notes\": \"Requires chosen/rejected log-probs and supports optional delta_z for focal weighting. If delta_z is missing, weights default to 1 via g=0. Reads from batch first; falls back to extra for compatibility.\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Pull required log-probs from batch first (gate expects batch keys).\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra.get(\\\"log_prob_w\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra.get(\\\"log_prob_l\\\", None)\\n\\n    # Fallbacks for common naming conventions.\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"logp_chosen\\\", batch.get(\\\"chosen_logps\\\", extra.get(\\\"logp_chosen\\\", extra.get(\\\"chosen_logps\\\", None))))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"logp_rejected\\\", batch.get(\\\"rejected_logps\\\", extra.get(\\\"logp_rejected\\\", extra.get(\\\"rejected_logps\\\", None))))\\n\\n    alpha = float(extra.get(\\\"alpha\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"eps\\\", 1e-6)))\\n\\n    # If required signals are absent, return a safe scalar zero.\\n    if log_prob_w is None or log_prob_l is None:\\n        return ops.zeros((), dtype=ops.float32, device=ops.device_of(model_output))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Optional objective gap signal for focal weighting.\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n    if delta_z is None:\\n        g = ops.zeros_like(d)\\n    else:\\n        g = ops.zscore(delta_z, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\"\n}"}
{"key": "4a10552ad2697fbdefc1295c8a42b3a7d533cc23", "ts": 1771755706.1647599, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "f11590103a9f29db52810f42632713b7493afb0e", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry pairwise preference loss with bounded focal-style reweighting driven by a z-scored auxiliary gap (delta_z). Emphasizes pairs with clearer separation while keeping weights clamped for stability. Uses log_prob_w/log_prob_l as primary inputs.\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\"\n    ]\n  },\n  \"pseudocode\": \"Read log_prob_w/log_prob_l from batch. d = log_prob_w - log_prob_l. If delta_z exists: g = zscore(delta_z) else g = 0. w = clamp(softplus(beta*g), w_min, w_max). If weight exists: w *= weight. loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required inputs per implementation_hint.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n\\n    # Hyperparameters (read-only; no global state).\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    # If required signals are absent, return a safe scalar zero.\\n    if log_prob_w is None or log_prob_l is None:\\n        return ops.zeros((), dtype=ops.float32, device=ops.device_of(model_output))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Optional auxiliary signal for focal-style weighting.\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        g = ops.zeros_like(d)\\n    else:\\n        g = ops.zscore(delta_z, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry (logistic) pairwise preference objective with a bounded focal-like reweighting using a standardized auxiliary gap delta_z. Clamping keeps weights in a stable range, improving robustness while still emphasizing informative pairs.\"\n}"}
{"key": "2aab5fa6c53efbf7fa3399785af34f9dd7e35546", "ts": 1771755720.3900888, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "5f7e6edfaaf6738d69c47ef3f0c62cf89f3fde96", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry pairwise preference loss with bounded focal-style reweighting driven by a z-scored objective gap signal (delta_z). Emphasizes informative pairs while clamping weights for stability.\",\n  \"pseudocode\": \"Read log_prob_w/log_prob_l from batch. d = log_prob_w - log_prob_l. Read delta_z (objective gap); g = zscore(delta_z). w = clamp(softplus(beta*g), w_min, w_max). If weight exists: w *= weight. loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required inputs per implementation_hint.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n\\n    # Hyperparameters (read-only; no global state).\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    # If required signals are absent, return a safe scalar zero.\\n    if log_prob_w is None or log_prob_l is None or delta_z is None:\\n        return ops.zeros((), dtype=ops.float32, device=ops.device_of(model_output))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Objective-driven focal-style weighting via standardized delta_z.\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry (logistic) pairwise preference objective with a bounded focal-like reweighting using a standardized objective gap signal (delta_z). Clamping keeps weights in a stable range to improve robustness while still emphasizing informative pairs.\"\n}"}
{"key": "f9854937334409ef58a206a2be51913c2d7dd32a", "ts": 1771755735.8955598, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "0bbd61e8fab44cbfaa02e11e037c91cd40fa4a0b", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with focal-style reweighting based on a (z-scored) objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded. Uses robust key fallbacks so it can read log-probabilities from either batch or extra.\",\n  \"pseudocode\": \"Let logp_w, logp_l be winner/loser log-probs from batch/extra. d = logp_w - logp_l. Let g = zscore(delta_z). Weight w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( (w * base_weight) * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer batch for required tensors; fall back to extra for compatibility.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", extra.get(\\\"log_prob_w\\\", None))\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", extra.get(\\\"log_prob_l\\\", None))\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n\\n    # Optional base weight can come from either batch or extra.\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    # If any required key is missing, return a zero loss tied to model_output to keep gradients well-defined.\\n    if (log_prob_w is None) or (log_prob_l is None) or (delta_z is None):\\n        return (model_output * 0).sum()\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"batch.log_prob_w\",\n      \"batch.log_prob_l\",\n      \"batch.delta_z\"\n    ],\n    \"optional\": [\n      \"batch.weight\",\n      \"extra.weight\",\n      \"extra.hyperparams\",\n      \"extra.alpha\",\n      \"extra.beta\",\n      \"extra.w_min\",\n      \"extra.w_max\",\n      \"extra.eps\"\n    ],\n    \"mode\": \"preference\"\n  }\n}"}
{"key": "5846c60eac9cabe941407187ce4def206812f743", "ts": 1771755753.3028543, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "46db51b093bba5d9901f0b04d5ad78fa98320466", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with focal-style reweighting based on a (z-scored) objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded. Uses robust key fallbacks so it can read log-probabilities from either batch or extra.\",\n  \"pseudocode\": \"Let logp_w, logp_l be winner/loser log-probs from batch/extra. d = logp_w - logp_l. Let g = zscore(delta_z). Weight w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( (w * base_weight) * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer batch for required tensors; fall back to extra for compatibility.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None and isinstance(extra, dict):\\n        log_prob_w = extra.get(\\\"log_prob_w\\\", None)\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None and isinstance(extra, dict):\\n        log_prob_l = extra.get(\\\"log_prob_l\\\", None)\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None and isinstance(extra, dict):\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    # Optional base weight can come from either batch or extra.\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None and isinstance(extra, dict):\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"eps\\\", 1e-6))\\n\\n    # If any required key is missing, return a zero loss tied to model_output to keep gradients well-defined.\\n    if (log_prob_w is None) or (log_prob_l is None) or (delta_z is None):\\n        return (model_output * 0).sum()\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise_preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\",\n      \"hyperparams\",\n      \"alpha\",\n      \"beta\",\n      \"w_min\",\n      \"w_max\",\n      \"eps\"\n    ]\n  }\n}"}
{"key": "1a1ed273deba647e78c84b06d9364fb8455bd75f", "ts": 1771755769.9899461, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "e6e59e115c2e86dad13462365a73601c27d226cb", "content": "{\n  \"name\": \"clamped_zscore_cost_scale_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a cost/objective-dependent scale that is guaranteed to change with delta_z. Uses a bounded, monotone weight derived from a tanh of a z-scored objective gap to avoid numerical blowups while staying sensitive.\",\n  \"pseudocode\": \"Get logp_w, logp_l and delta_z. d = logp_w - logp_l. g = zscore(delta_z). w = 1 + k * tanh(beta * g) clamped to [w_min,w_max]. Loss = mean(w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 2.0,\n    \"k\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"tanh\",\n    \"clamp\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None and isinstance(extra, dict):\\n        log_prob_w = extra.get(\\\"log_prob_w\\\", None)\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None and isinstance(extra, dict):\\n        log_prob_l = extra.get(\\\"log_prob_l\\\", None)\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None and isinstance(extra, dict):\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None and isinstance(extra, dict):\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 2.0))\\n    k = float((extra.get(\\\"k\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"k\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"eps\\\", 1e-6))\\n\\n    if (log_prob_w is None) or (log_prob_l is None) or (delta_z is None):\\n        return (model_output * 0).sum()\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Make objective dependence strong and bounded (avoids near-constant softplus for large g).\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = 1.0 + k * ops.tanh(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "9280b83fc87879c5a248f653f4b96a41b827b27a", "ts": 1771755786.7568893, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "e1b76f69b2e5b6acc0851d83c7cefadf2aa0a887", "content": "{\n  \"name\": \"clamped_zscore_additive_margin_bt\",\n  \"intuition\": \"Make the preference loss explicitly depend on the objective by shifting the Bradley-Terry logit with a bounded, monotone margin derived from the (optionally z-scored) objective gap. This produces a non-negligible loss change under objective perturbations while keeping numerics stable via tanh/clamp.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = zscore(delta_z). m = clamp(k * tanh(beta * g), -m_max, m_max). Loss = mean( softplus(-(alpha*d + m)) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 2.0,\n    \"k\": 2.0,\n    \"m_max\": 2.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"tanh\",\n    \"clamp\",\n    \"softplus\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None and isinstance(extra, dict):\\n        log_prob_w = extra.get(\\\"log_prob_w\\\", None)\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None and isinstance(extra, dict):\\n        log_prob_l = extra.get(\\\"log_prob_l\\\", None)\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None and isinstance(extra, dict):\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None and isinstance(extra, dict):\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 2.0))\\n    k = float((extra.get(\\\"k\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"k\\\", 2.0))\\n    m_max = float((extra.get(\\\"m_max\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"m_max\\\", 2.0))\\n    eps = float((extra.get(\\\"eps\\\", None) if isinstance(extra, dict) else None) or hp.get(\\\"eps\\\", 1e-6))\\n\\n    if (log_prob_w is None) or (log_prob_l is None) or (delta_z is None):\\n        return (model_output * 0).sum()\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Bounded monotone objective margin; additive influence is harder to wash out than multiplicative scaling.\\n    g = ops.zscore(delta_z, eps=eps)\\n    m = k * ops.tanh(beta * g)\\n    m = ops.clamp(m, -m_max, m_max)\\n\\n    logits = alpha * d + m\\n    per_pair = ops.softplus(-logits)\\n\\n    if base_weight is not None:\\n        per_pair = per_pair * base_weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "08a692ff5a782beba1f6b6ed29e170599ec0d03d", "ts": 1771755806.0060418, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "3f60479aacd441c578ee916e34da78a40ace16fb", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by the z-scored objective gap, emphasizing pairs with clearer quality separation while bounding weights for stability. Falls back gracefully across common batch/extra key conventions.\",\n  \"pseudocode\": \"Let d = logp_w - logp_l (from batch/extra fallbacks). Let g = zscore(delta_z, eps). Let w = clamp(softplus(beta * g), w_min, w_max). Loss = mean( weight * w * softplus(-alpha * d) ), with weight defaulting to 1.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (preferred) OR extra[...] equivalents\",\n      \"batch/extra contains one of: delta_z, objective_gap, reward_gap, delta (used for z-scoring weights); if absent, uses zeros (no focal reweighting effect)\",\n      \"optional batch/extra weight for per-pair scaling\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Pull common fields with robust fallbacks across batch/extra naming conventions.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", extra.get(\\\"log_prob_w\\\", None))\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", extra.get(\\\"log_prob_l\\\", None))\\n\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"logp_w\\\", extra.get(\\\"logp_w\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"logp_l\\\", extra.get(\\\"logp_l\\\", None))\\n\\n    # If still missing, fall back to standard preference pair names.\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"log_probs_w\\\", extra.get(\\\"log_probs_w\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"log_probs_l\\\", extra.get(\\\"log_probs_l\\\", None))\\n\\n    # Delta signal used for focal-style weighting; fall back to zeros if absent.\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"objective_gap\\\", extra.get(\\\"objective_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"reward_gap\\\", extra.get(\\\"reward_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"delta\\\", extra.get(\\\"delta\\\", None))\\n\\n    # Optional base weight.\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n    if base_weight is None:\\n        base_weight = batch.get(\\\"pair_weight\\\", extra.get(\\\"pair_weight\\\", None))\\n\\n    # Hyperparameters.\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    # Ensure we have tensors; if delta is absent, use zeros matching log_prob_w.\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(log_prob_w)\\n\\n    d = log_prob_w - log_prob_l\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
