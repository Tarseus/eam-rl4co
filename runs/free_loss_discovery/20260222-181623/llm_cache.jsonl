,\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.15))\\n    beta = float(hyper.get(\\\"beta\\\", 0.35))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 20.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 12.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 4.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 24.0))\\n    cap = float(hyper.get(\\\"cap\\\", 3.5))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping is used for numerical stability; the smooth tanh cap keeps the per-example loss within a bounded range without hard clipping.\"\n}"}
