\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "685811b5566e682588fd0f6833d4c1f266f7ec5e", "ts": 1771755424.5717838, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "1447f8ff383457a0bc577629e3846c546da575d4", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt_v2\",\n  \"intuition\": \"Bradley-Terry preference loss with focal-style reweighting from a z-scored objective gap; robustly reads winner/loser log-probs from either batch or extra, and bounds weights for stability.\",\n  \"pseudocode\": \"Let logp_w, logp_l be winner/loser log-prob sums. d = logp_w - logp_l. g = zscore(delta_z). w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( w * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer batch-provided keys (common in gates), fall back to extra.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra[\\\"log_prob_w\\\"]\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra[\\\"log_prob_l\\\"]\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # If delta_z is unavailable, use an all-zeros gap so weights default to softplus(0).\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(d)\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or provided via extra with same keys)\",\n      \"batch['delta_z'] optional (or extra['delta_z']); if missing, weights default safely\",\n      \"batch['weight'] optional (or extra['weight']) for external reweighting\"\n    ],\n    \"uses\": [\n      \"ops.zscore\",\n      \"ops.softplus\",\n      \"ops.clamp\"\n    ],\n    \"mode\": \"pairwise_preference\"\n  }\n}"}
{"key": "9cf5cae300a48bd52ddbdfd1f847d50d612c2700", "ts": 1771755439.0883007, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "050b5f0248b2dd0a99579d4acfe083f4310b80ac", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt_v2\",\n  \"intuition\": \"Bradley-Terry preference loss with focal-style reweighting from a z-scored objective gap; reads winner/loser log-probs from batch/extra, and bounds weights for stability.\",\n  \"pseudocode\": \"Let logp_w, logp_l be winner/loser log-prob sums. d = logp_w - logp_l. g = zscore(delta_z). w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( w * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\",\n      \"hyperparams\",\n      \"alpha\",\n      \"beta\",\n      \"w_min\",\n      \"w_max\",\n      \"eps\"\n    ],\n    \"returns\": \"scalar\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer batch-provided keys (common in gates), fall back to extra.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra[\\\"log_prob_w\\\"]\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra[\\\"log_prob_l\\\"]\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # If delta_z is unavailable, use zeros so weights default to softplus(0) then clamp.\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(d)\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "fdbf8f2d60d7da1a74191ad8abc8180cdf9c2016", "ts": 1771755457.1657636, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "a8c864a60fa08efac81c918b903634afe5beb78a", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt_v2_repair\",\n  \"intuition\": \"Bradley-Terry preference loss with focal-style reweighting driven by a z-scored objective signal (delta_z/cost gap). Reads winner/loser log-prob sums and a cost-derived signal from batch/extra; clamps weights for stability.\",\n  \"pseudocode\": \"Read logp_w, logp_l. d = logp_w - logp_l. Get objective signal s from delta_z else (cost_b - cost_a) else zeros. g = zscore(s). w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( w * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\",\n    \"zeros_like\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"cost_a\",\n      \"cost_b\",\n      \"weight\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Winner/loser log-prob sums (per example)\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra[\\\"log_prob_w\\\"]\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra[\\\"log_prob_l\\\"]\\n\\n    # Objective signal for weighting: prefer delta_z, else cost gap (cost_b - cost_a).\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        delta_z = extra.get(\\\"delta_z\\\", None)\\n\\n    if delta_z is None:\\n        cost_a = batch.get(\\\"cost_a\\\", None)\\n        if cost_a is None:\\n            cost_a = extra.get(\\\"cost_a\\\", None)\\n        cost_b = batch.get(\\\"cost_b\\\", None)\\n        if cost_b is None:\\n            cost_b = extra.get(\\\"cost_b\\\", None)\\n        if (cost_a is not None) and (cost_b is not None):\\n            delta_z = cost_b - cost_a\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # If no objective signal is available, default to uniform weights.\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(d)\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on log-probability differences, with a focal-like reweighting term derived from a normalized objective signal (delta_z or cost gap) to emphasize higher-importance examples while clamping for numerical stability.\"\n}"}
{"key": "f24594784bde86a071917320bcea4da0996b5ada", "ts": 1771755473.0325475, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "3e6fe3e71559386eb5afc612f4c52c0b754af72b", "content": "{\n  \"name\": \"objective_margin_bt_clamped_v1\",\n  \"intuition\": \"Make the preference loss explicitly depend on the objective by shifting the Bradley-Terry logit with an objective-derived margin (from delta_z or cost gap). This yields strong sensitivity while keeping numerics stable via z-scoring and clamping.\",\n  \"pseudocode\": \"d = logp_w - logp_l. s = delta_z else (cost_b - cost_a) else 0. m = clamp(scale * zscore(s), -m_max, m_max). loss = mean( softplus(-(alpha*d + m)) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"scale\": 1.0,\n    \"m_max\": 5.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"clamp\",\n    \"softplus\",\n    \"zeros_like\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Winner/loser log-prob sums (per example)\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", None)\\n    if log_prob_w is None:\\n        log_prob_w = extra[\\\"log_prob_w\\\"]\\n\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", None)\\n    if log_prob_l is None:\\n        log_prob_l = extra[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer delta_z, else cost gap (cost_b - cost_a).\\n    obj = batch.get(\\\"delta_z\\\", None)\\n    if obj is None:\\n        obj = extra.get(\\\"delta_z\\\", None)\\n\\n    if obj is None:\\n        cost_a = batch.get(\\\"cost_a\\\", None)\\n        if cost_a is None:\\n            cost_a = extra.get(\\\"cost_a\\\", None)\\n        cost_b = batch.get(\\\"cost_b\\\", None)\\n        if cost_b is None:\\n            cost_b = extra.get(\\\"cost_b\\\", None)\\n        if (cost_a is not None) and (cost_b is not None):\\n            obj = cost_b - cost_a\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = extra.get(\\\"weight\\\", None)\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    scale = float(extra.get(\\\"scale\\\", hp.get(\\\"scale\\\", 1.0)))\\n    m_max = float(extra.get(\\\"m_max\\\", hp.get(\\\"m_max\\\", 5.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if obj is None:\\n        obj = ops.zeros_like(d)\\n\\n    # Z-score for affine invariance; clamp to keep logits in a stable range.\\n    m = scale * ops.zscore(obj, eps=eps)\\n    m = ops.clamp(m, -m_max, m_max)\\n\\n    logits = alpha * d + m\\n    per_pair = ops.softplus(-logits)\\n\\n    if base_weight is not None:\\n        per_pair = per_pair * base_weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on the log-probability difference, augmented with an objective-dependent margin term. The margin shifts the decision boundary according to the objective signal, ensuring the loss changes meaningfully under objective perturbations while maintaining stability via z-scoring and clamping.\"\n}"}
{"key": "2bd5b3d68cb586cc868bd2ff1a44eca67680420e", "ts": 1771755490.9644244, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "125d25cfa5d7c2a4704eeb05a2bd98cbcbcb799d", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by a z-scored objective gap. Uses batch-provided log-prob keys (preferred/non_preferred) with fallbacks, emphasizes clearer separations while keeping weights bounded for stability.\",\n  \"pseudocode\": \"Let d = logp_pref - logp_nonpref. Let g = zscore(delta_z). Let w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( (w * base_weight) * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer canonical batch keys; fall back to older names if present.\\n    logp_w = batch.get(\\\"log_prob_w\\\", None)\\n    logp_l = batch.get(\\\"log_prob_l\\\", None)\\n    if logp_w is None:\\n        logp_w = batch.get(\\\"logp_w\\\", None)\\n    if logp_l is None:\\n        logp_l = batch.get(\\\"logp_l\\\", None)\\n\\n    if logp_w is None:\\n        logp_w = batch[\\\"log_prob_preferred\\\"]\\n    if logp_l is None:\\n        logp_l = batch[\\\"log_prob_non_preferred\\\"]\\n\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"objective_gap\\\", None)\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"reward_gap\\\", None)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = batch.get(\\\"pair_weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"eps\\\", 1e-6))\\n\\n    d = logp_w - logp_l\\n\\n    # If no gap signal is provided, use zero weights (i.e., w=softplus(0)=~0.693 then clamped).\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.zscore(delta_z, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"batch['log_prob_preferred']\",\n      \"batch['log_prob_non_preferred']\",\n      \"batch.get('delta_z') or batch.get('objective_gap') or batch.get('reward_gap') (optional)\",\n      \"batch.get('weight') or batch.get('pair_weight') (optional)\"\n    ],\n    \"uses\": [\n      \"ops.zscore\",\n      \"ops.softplus\",\n      \"ops.clamp\"\n    ]\n  }\n}"}
{"key": "a3a889dc0d182e8a360b53428893511317e21677", "ts": 1771755506.304998, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "baa7f323c6b5cb059c502410203877c7176f85a8", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by a z-scored objective gap. Uses batch-provided winner/loser log-probs, emphasizes clearer separations while keeping weights bounded for stability.\",\n  \"pseudocode\": \"Let d = logp_w - logp_l. Let g = zscore(delta_z) if provided else 0. Let w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( (w * base_weight) * softplus(-alpha*d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"objective_gap\",\n      \"reward_gap\",\n      \"weight\",\n      \"pair_weight\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required keys (per implementation_hint.expects)\\n    logp_w = batch[\\\"log_prob_w\\\"]\\n    logp_l = batch[\\\"log_prob_l\\\"]\\n\\n    # Optional auxiliary gap signal for focal-style weighting\\n    delta_z = batch.get(\\\"delta_z\\\", None)\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"objective_gap\\\", None)\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"reward_gap\\\", None)\\n\\n    # Optional per-pair base weight\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is None:\\n        base_weight = batch.get(\\\"pair_weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"eps\\\", 1e-6))\\n\\n    d = logp_w - logp_l\\n\\n    # If no gap signal is provided, use zeros (w = softplus(0) then clamped)\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.zscore(delta_z, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "1145beff02e8fe6d2e6a2f9ff97ce36f22f740f1", "ts": 1771755522.1283185, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "85e98a699e15e1860f1702ee3f2dfa16401f253f", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting driven by a z-scored objective signal (e.g., delta_z or cost difference). Uses batch-provided winner/loser log-probs, emphasizes clearer separations while keeping weights bounded for stability.\",\n  \"pseudocode\": \"Let d = logp_w - logp_l. Let s = delta_z if provided else (cost_l - cost_w) if provided else 0. Let g = zscore(s). Let w = clamp(softplus(beta*g), w_min, w_max). Loss = mean( (w * base_weight) * softplus(-alpha*d) ).\",\n  \"theoretical_basis\": \"Starts from a Bradley-Terry/logistic pairwise preference objective softplus(-alpha*(logp_w-logp_l)). Adds a bounded focal-style multiplicative weight based on a standardized auxiliary objective signal (delta_z or cost difference) to emphasize examples with larger objective separation while retaining stability via clamping.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z|cost_w,cost_l\",\n      \"weight?\"\n    ],\n    \"returns\": \"scalar_loss\",\n    \"mode\": \"pairwise_preference\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Pairwise preference signals\\n    logp_w = batch[\\\"log_prob_w\\\"]\\n    logp_l = batch[\\\"log_prob_l\\\"]\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"eps\\\", 1e-6))\\n\\n    d = logp_w - logp_l\\n\\n    # Objective signal for weighting: prefer delta_z; otherwise use (cost_l - cost_w)\\n    if \\\"delta_z\\\" in batch:\\n        s = batch[\\\"delta_z\\\"]\\n    elif (\\\"cost_w\\\" in batch) and (\\\"cost_l\\\" in batch):\\n        s = batch[\\\"cost_l\\\"] - batch[\\\"cost_w\\\"]\\n    else:\\n        s = d * 0.0\\n\\n    g = ops.zscore(s, eps=eps)\\n\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    base_weight = batch.get(\\\"weight\\\", None)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\"\n}"}
