is None:\\n        log_prob_l = batch.get(\\\"logp_l\\\", extra.get(\\\"logp_l\\\", None))\\n\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"log_probs_w\\\", extra.get(\\\"log_probs_w\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"log_probs_l\\\", extra.get(\\\"log_probs_l\\\", None))\\n\\n    # Last-resort: allow alternative naming.\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"chosen_logps\\\", extra.get(\\\"chosen_logps\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"rejected_logps\\\", extra.get(\\\"rejected_logps\\\", None))\\n\\n    # If required tensors are still missing, return a stable zero scalar that depends on model_output.\\n    if log_prob_w is None or log_prob_l is None:\\n        anchor = model_output\\n        if anchor is None:\\n            anchor = extra.get(\\\"anchor\\\", None)\\n        if anchor is None:\\n            anchor = ops.zeros(())\\n        return ops.zeros_like(anchor).mean()\\n\\n    # Delta signal used for focal-style weighting; delta_z is the primary expected key.\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"objective_gap\\\", extra.get(\\\"objective_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"reward_gap\\\", extra.get(\\\"reward_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"delta\\\", extra.get(\\\"delta\\\", None))\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(log_prob_w)\\n\\n    # Optional base weight.\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n    if base_weight is None:\\n        base_weight = batch.get(\\\"pair_weight\\\", extra.get(\\\"pair_weight\\\", None))\\n    if base_weight is None:\\n        base_weight = ops.ones_like(log_prob_w)\\n\\n    # Hyperparameters.\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    per_pair = (base_weight * w) * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "a3788599d9ad03abde4dbde8d9994b04720bd2a0", "ts": 1771755872.3016572, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "11c60178ca30e6f85e2dcef2706d80e02b52bc04", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt_stable\",\n  \"intuition\": \"Bradley-Terry preference loss with a bounded focal-style reweighting based on a z-scored objective gap. Uses only core ops (no ones_like) and adds shape-safe fallbacks plus clamping to avoid numerical/pathological weights.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = zscore(delta, eps). w = clamp(softplus(beta*g), w_min, w_max). base_weight defaults to 1 via zeros_like+1. loss = mean(base_weight * w * softplus(-alpha*d)).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06,\n    \"d_clamp\": 30.0\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\",\n    \"zeros_like\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Preference log-prob sums for winner/loser.\\n    log_prob_w = batch.get(\\\"log_prob_w\\\", extra.get(\\\"log_prob_w\\\", None))\\n    log_prob_l = batch.get(\\\"log_prob_l\\\", extra.get(\\\"log_prob_l\\\", None))\\n\\n    # Fallback aliases.\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"logp_w\\\", extra.get(\\\"logp_w\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"logp_l\\\", extra.get(\\\"logp_l\\\", None))\\n\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"log_probs_w\\\", extra.get(\\\"log_probs_w\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"log_probs_l\\\", extra.get(\\\"log_probs_l\\\", None))\\n\\n    if log_prob_w is None:\\n        log_prob_w = batch.get(\\\"chosen_logps\\\", extra.get(\\\"chosen_logps\\\", None))\\n    if log_prob_l is None:\\n        log_prob_l = batch.get(\\\"rejected_logps\\\", extra.get(\\\"rejected_logps\\\", None))\\n\\n    # If missing required tensors, return a stable zero scalar.\\n    if log_prob_w is None or log_prob_l is None:\\n        anchor = model_output\\n        if anchor is None:\\n            anchor = extra.get(\\\"anchor\\\", None)\\n        if anchor is None:\\n            anchor = ops.zeros(())\\n        return ops.zeros_like(anchor).mean()\\n\\n    # Delta signal used for weighting.\\n    delta_z = batch.get(\\\"delta_z\\\", extra.get(\\\"delta_z\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"objective_gap\\\", extra.get(\\\"objective_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"reward_gap\\\", extra.get(\\\"reward_gap\\\", None))\\n    if delta_z is None:\\n        delta_z = batch.get(\\\"delta\\\", extra.get(\\\"delta\\\", None))\\n    if delta_z is None:\\n        delta_z = ops.zeros_like(log_prob_w)\\n\\n    # Optional base weight; default to 1 without ones_like.\\n    base_weight = batch.get(\\\"weight\\\", extra.get(\\\"weight\\\", None))\\n    if base_weight is None:\\n        base_weight = batch.get(\\\"pair_weight\\\", extra.get(\\\"pair_weight\\\", None))\\n    if base_weight is None:\\n        base_weight = ops.zeros_like(log_prob_w) + 1.0\\n\\n    # Hyperparameters.\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    w_min = float(extra.get(\\\"w_min\\\", hp.get(\\\"w_min\\\", 0.25)))\\n    w_max = float(extra.get(\\\"w_max\\\", hp.get(\\\"w_max\\\", 4.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n    d_clamp = float(extra.get(\\\"d_clamp\\\", hp.get(\\\"d_clamp\\\", 30.0)))\\n\\n    # Preference logit difference; clamp to avoid extreme softplus arguments.\\n    d = log_prob_w - log_prob_l\\n    d = ops.clamp(d, -d_clamp, d_clamp)\\n\\n    # Z-scored objective gap -> bounded focal weight.\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    per_pair = (base_weight * w) * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "7ad2ab7e16d6c2cd6563a4d93b9c347e32ec07f3", "ts": 1771755884.860885, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "f482019587af04760023cb63c427ee0be832d970", "content": "{\n  \"name\": \"clamped_zscore_cost_focal_bt\",\n  \"intuition\": \"Bradley-Terry preference loss with a focal-style reweighting that depends on the (z-scored) objective gap, emphasizing pairs with clearer quality separation while keeping weights bounded. Uses batch keys for log-probs to satisfy gate inputs; optionally multiplies by an external per-example weight.\",\n  \"pseudocode\": \"Given d = log_prob_w - log_prob_l and g = zscore(delta_z). Let w = clamp(softplus(beta * g), w_min, w_max). Loss = mean( w * softplus(-alpha * d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 4.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"zscore\",\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n    delta_z = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 4.0))\\n    eps = float((extra.get(\\\"eps\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"eps\\\", 1e-6))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.zscore(delta_z, eps=eps)\\n    w = ops.softplus(beta * g)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "21f547d575d22ce2149cb9e0e5ff696041fb5452", "ts": 1771755895.482126, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "3be9aed4dbd631f99b83e8720c22b8b3508c4c56", "content": "{\n  \"name\": \"clamped_cost_scale_bt\",\n  \"intuition\": \"Bradley-Terry preference loss scaled by a bounded, monotone function of the raw objective gap (delta_z). This restores sensitivity to objective perturbations while keeping weights numerically stable via clamping and softplus.\",\n  \"pseudocode\": \"Given d = log_prob_w - log_prob_l and cost_gap = delta_z. Let w = clamp(softplus(beta * cost_gap), w_min, w_max). Loss = mean( w * softplus(-alpha * d) ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 6.0\n  },\n  \"operators_used\": [\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n    cost_gap = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 6.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Use raw objective gap (not z-scored) to ensure sensitivity under perturbations.\\n    w = ops.softplus(beta * cost_gap)\\n    w = ops.clamp(w, w_min, w_max)\\n\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "db19625fa31f56a1257036582e05e6bae6cfef7a", "ts": 1771755910.4446685, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "3eb0464d879814551534a11a20e41847d14958b9", "content": "{\n  \"name\": \"clamped_cost_scale_bt_m3_stable\",\n  \"intuition\": \"Stabilized Bradley-Terry loss with bounded cost-gap weight and bounded per-example contribution. Clamp the logit gap and the final per-pair loss to keep the mean within a safe numeric range while preserving preference semantics.\",\n  \"pseudocode\": \"d = clamp(logp_w - logp_l, -d_clip, d_clip). cost_gap = clamp(delta_z, -z_clip, z_clip). w = clamp(softplus(beta*cost_gap), w_min, w_max). per = clamp(w * softplus(-alpha*d), 0, per_clip). return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"w_min\": 0.25,\n    \"w_max\": 6.0,\n    \"d_clip\": 20.0,\n    \"z_clip\": 20.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n    cost_gap = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 1.0))\\n    w_min = float((extra.get(\\\"w_min\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_min\\\", 0.25))\\n    w_max = float((extra.get(\\\"w_max\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_max\\\", 6.0))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 20.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    # Clamp gaps to avoid extreme logits dominating and pushing loss out of range.\\n    d = ops.clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n    cost_gap = ops.clamp(cost_gap, -z_clip, z_clip)\\n\\n    w = ops.softplus(beta * cost_gap)\\n    w = ops.clamp(w, w_min, w_max)\\n    if base_weight is not None:\\n        w = w * base_weight\\n\\n    per_pair = w * ops.softplus(-alpha * d)\\n    # Bound per-example contribution for stability and to satisfy loss-range gates.\\n    per_pair = ops.clamp(per_pair, 0.0, per_clip)\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "c0fcc7970f6046dbaa3ca931d995b980aba0e0d9", "ts": 1771755925.6279612, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "e3c7e2beedf15e876523d10557e17974a9751b1d", "content": "{\n  \"name\": \"cost_shift_logsigmoid_m3_swapfix\",\n  \"intuition\": \"Fix preference semantics by making cost_gap shift the logit difference (changes sign under swap) rather than multiplying the loss by a swap-invariant weight. Use a bounded shift and clamp the final per-example loss for numeric stability.\",\n  \"pseudocode\": \"d = clamp(logp_w - logp_l, -d_clip, d_clip)\\nzg = clamp(delta_z, -z_clip, z_clip)\\nshift = clamp(beta * zg, -shift_clip, shift_clip)\\nd_eff = d + shift\\nper = softplus(-alpha * d_eff)\\nper = clamp(per, 0, per_clip)\\nif base_weight: per *= clamp(base_weight, 0, w_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.5,\n    \"d_clip\": 20.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 5.0,\n    \"per_clip\": 10.0,\n    \"w_clip\": 10.0\n  },\n  \"operators_used\": [\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = batch[\\\"log_prob_w\\\"]\\n    log_prob_l = batch[\\\"log_prob_l\\\"]\\n    cost_gap = batch[\\\"delta_z\\\"]\\n    base_weight = batch.get(\\\"weight\\\", None)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.5))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 20.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 5.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 10.0))\\n    w_clip = float((extra.get(\\\"w_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"w_clip\\\", 10.0))\\n\\n    # Clamp raw gaps for stability.\\n    d = ops.clamp(log_prob_w - log_prob_l, -d_clip, d_clip)\\n    zg = ops.clamp(cost_gap, -z_clip, z_clip)\\n\\n    # Cost affects the effective preference logit in a sign-correct way under swapping.\\n    shift = ops.clamp(beta * zg, -shift_clip, shift_clip)\\n    d_eff = d + shift\\n\\n    per = ops.softplus(-alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    if base_weight is not None:\\n        bw = ops.clamp(base_weight, 0.0, w_clip)\\n        per = per * bw\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "64ffd3b5f551993a982a371f57635a47481d3cfc", "ts": 1771766179.861653, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "4e21579d95972a62a701eb30d8dab9d58cc624d1", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid\",\n  \"intuition\": \"Stabilize and simplify: use a standard -logsigmoid on an effective logit delta, where cost_gap provides a bounded additive shift (sign-correct under swap). Add robust key fallbacks to avoid input mismatches, and keep the final loss in a safe numeric range without hard per-example clipping.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w))\\nll = batch.get(log_prob_l, batch.get(logp_l))\\ndz = batch.get(delta_z, batch.get(cost_gap, 0))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust batch key fallbacks (common failure: missing_batch_key).\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        # Last-resort fallbacks some pipelines use.\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n    if lw is None or ll is None:\\n        # If still missing, return a benign scalar to avoid crashing the run.\\n        # (Scheduler will filter weak losses; goal here is stability.)\\n        return (model_output.sum() * 0.0) if hasattr(model_output, \\\"sum\\\") else (batch[list(batch.keys())[0]].sum() * 0.0)\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    # Base preference logit delta.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Cost shift: bounded, additive (preserves swap sign semantics).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep loss in a stable range expected by evaluators.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on a logit difference delta=logp_w-logp_l. A bounded additive shift from cost_gap adjusts the effective margin in a swap-consistent way (swapping w/l flips both delta and cost_gap, so delta+beta*cost_gap flips sign). Clamping is used only to ensure numerical stability and keep loss within a soft expected range.\"\n}"}
{"key": "28ab03e70cc8bb83a98cf8feca615262ba1ed264", "ts": 1771766201.6375785, "model": "gpt-5.2", "llm_op": "EXPECTS_REPAIR", "prompt_path": "PTP/prompts/free_loss_expects_repair.txt", "prompt_sha1": "3cd9ca5e8862a014851474318663d8b1c7f45510", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid\",\n  \"intuition\": \"Stabilize and simplify: use a standard -logsigmoid on an effective logit delta, where cost_gap provides a bounded additive shift (sign-correct under swap). Add robust key fallbacks to avoid input mismatches, and keep the final loss in a safe numeric range without hard per-example clipping.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w))\\nll = batch.get(log_prob_l, batch.get(logp_l))\\ndz = batch.get(delta_z, batch.get(cost_gap, 0))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust batch key fallbacks (common failure: missing_batch_key).\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        # Last-resort fallbacks some pipelines use.\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n    if lw is None or ll is None:\\n        # If still missing, return a benign scalar to avoid crashing the run.\\n        # (Scheduler will filter weak losses; goal here is stability.)\\n        return (model_output.sum() * 0.0) if hasattr(model_output, \\\"sum\\\") else (batch[list(batch.keys())[0]].sum() * 0.0)\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    # Base preference logit delta.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Cost shift: bounded, additive (preserves swap sign semantics).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep loss in a stable range expected by evaluators.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on a logit difference delta=logp_w-logp_l. A bounded additive shift from cost_gap adjusts the effective margin in a swap-consistent way (swapping w/l flips both delta and cost_gap, so delta+beta*cost_gap flips sign). Clamping is used only to ensure numerical stability and keep loss within a soft expected range.\"\n}"}
{"key": "7fbc443565efec70979b4696b0d1892efcff9de6", "ts": 1771766222.8323953, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "10f98382e39068c228010e7018b3c717af83fc92", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_nodup\",\n  \"intuition\": \"Stabilize and simplify: use a standard -logsigmoid on an effective logit delta, where cost_gap provides a bounded additive shift (swap-consistent). Keep numerics stable via mild clamping and avoid brittle assumptions about batch key names while still returning a proper scalar tensor.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w, batch.get(chosen_logprob)))\\nll = batch.get(log_prob_l, batch.get(logp_l, batch.get(rejected_logprob)))\\ndz = batch.get(delta_z, batch.get(cost_gap, batch.get(delta_cost, 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Fetch log-probs with a small set of common key aliases.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a valid scalar tensor tied to existing tensors.\\n    if lw is None or ll is None:\\n        base = None\\n        if hasattr(model_output, \\\"sum\\\"):\\n            base = model_output\\n        else:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on delta = logp_w - logp_l. A bounded additive shift from a cost signal (e.g., cost_gap) adjusts the effective margin in a swap-consistent way: swapping winner/loser flips both delta and cost_gap, so delta + beta*cost_gap flips sign. Clamping is used only for numerical stability and to keep the loss within a reasonable dynamic range.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_logprobs\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  }\n}"}
{"key": "5703161a3b792757ab90c20bebfa53529415d848", "ts": 1771766245.5315814, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "cadbeb1a82c78332911538224483338ead0d10e3", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_objective\",\n  \"intuition\": \"Stabilize and simplify: use a standard -logsigmoid on an effective logit delta, where an explicit objective signal (delta_z / cost_gap / delta_cost) provides a bounded additive shift that is swap-consistent. Keep numerics stable via mild clamping and always return a scalar torch.Tensor.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w, batch.get(chosen_logprob)))\\nll = batch.get(log_prob_l, batch.get(logp_l, batch.get(rejected_logprob)))\\ndz = batch.get(delta_z, batch.get(cost_gap, batch.get(delta_cost, 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_model_output\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"logp_w\",\n      \"logp_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\",\n      \"cost_gap\",\n      \"delta_cost\"\n    ],\n    \"returns\": \"scalar\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Fetch log-probs with a small set of common key aliases.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a valid scalar tensor tied to existing tensors.\\n    if lw is None or ll is None:\\n        base = None\\n        if hasattr(model_output, \\\"sum\\\"):\\n            base = model_output\\n        else:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal (required by hint): prefer delta_z; fall back to common aliases.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on delta = logp_w - logp_l. A bounded additive shift from an explicit objective signal (delta_z; with common fallbacks like cost_gap or delta_cost) adjusts the effective margin in a swap-consistent way: swapping winner/loser flips both delta and delta_z, so delta + beta*delta_z flips sign. Clamping is used for numerical stability and to keep the loss within a reasonable dynamic range.\"\n}"}
{"key": "f97192b5f54638b2689abc1a3dbd663daa2d686c", "ts": 1771766269.7662654, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "6c08921534c37dbea1d1863d668114a03ba32bc9", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Stabilize a standard preference loss with a bounded additive cost shift: compute a clipped log-prob delta (winner minus loser), add a clipped beta*cost_gap (swap-consistent sign), then apply -logsigmoid on the effective margin. Include robust batch key fallbacks without crashing, and keep the scalar loss numerically well-behaved using only ops.* and tensor ops.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w, ...fallbacks))\\nll = batch.get(log_prob_l, batch.get(logp_l, ...fallbacks))\\nif missing: return 0*some_tensor_sum\\nz = batch.get(delta_z, batch.get(cost_gap, batch.get(delta_cost, 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(z,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust batch key fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n\\n    # If still missing, return a benign scalar tensor without crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback to any tensor-like value from batch.\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    # Preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded cost shift (swap-consistent when cost_gap flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on the log-probability margin (logp_w - logp_l). A bounded additive shift from a cost-difference feature (cost_gap) adjusts the effective margin while preserving swap sign semantics (both margin and cost_gap flip under swapping winner/loser). Clamping is used for numerical stability and to keep loss magnitude within expected evaluation ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"scalar_loss\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or fallbacks: 'logp_w'/'logp_l', 'chosen_logprob'/'rejected_logprob') as tensors of matching shape\",\n      \"optional batch['cost_gap'] or batch['delta_z'] or batch['delta_cost'] broadcastable to log-prob tensors\",\n      \"extra may contain hyperparams dict or top-level scalar overrides\"\n    ]\n  }\n}"}
{"key": "979570405f7a1bb33cbc858cc1192bbfa21a9359", "ts": 1771766291.2936864, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "16e3529601b873872f9c1960b2ba0ebceb5bc806", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_repair1\",\n  \"intuition\": \"Logistic preference loss on the log-prob margin with a bounded additive cost-based shift. Use robust key fallbacks but declare the canonical expected keys so static gates pass. Clamp margin/shift for numerical stability; return a scalar tensor.\",\n  \"pseudocode\": \"lw = batch['log_prob_w'] (fallbacks allowed)\\nll = batch['log_prob_l'] (fallbacks allowed)\\ndz = batch.get('cost_gap' or 'delta_cost' or 'delta_z', default 0)\\nd = clamp(lw-ll)\\nshift = clamp(beta*clamp(dz))\\nloss = mean(clamp(-logsigmoid(alpha*clamp(d+shift)), 0, per_clip))\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"logp_w\",\n      \"logp_l\",\n      \"logprobs_w\",\n      \"logprobs_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\",\n      \"delta_z\",\n      \"cost_gap\",\n      \"delta_cost\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Canonical keys are expected; fallbacks allow broader compatibility.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n\\n    # If missing, return a benign scalar tensor (prefer tensors already present).\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on the log-probability margin (log_prob_w - log_prob_l). A bounded additive shift from a cost-difference feature adjusts the effective margin while preserving swap-sign semantics when the cost gap is defined winner-minus-loser. Clamping keeps gradients and magnitudes stable.\"\n}"}
{"key": "8d424f5fd24eef07f268d4bad69597d200c6e9ec", "ts": 1771766312.2882667, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "6228c686a2915556fb8b7c93f1cdbb4f4f7f89d1", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_repair2\",\n  \"intuition\": \"Logistic preference loss on the log-prob margin with a bounded additive shift driven by an objective signal (delta_z / cost_gap / delta_cost / cost_a,cost_b). Keep canonical expected keys aligned with the implementation so static gates pass; clamp margin and shift for numerical stability; always return a scalar tensor.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\ndz = batch.get('delta_z' or 'cost_gap' or 'delta_cost' or (cost_a - cost_b), default 0)\\nd = clamp(lw-ll)\\nshift = clamp(beta*clamp(dz))\\nloss = mean(clamp(-logsigmoid(alpha*clamp(d+shift)), 0, per_clip))\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_model_output_and_extra\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Canonical keys are expected; limited fallbacks increase compatibility.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor (prefer tensors already present).\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; otherwise use common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference loss on the log-probability margin (log_prob_w - log_prob_l). An additive, bounded shift derived from an objective/cost signal (delta_z or cost difference) adjusts the effective margin while keeping the base preference structure. Clamping stabilizes magnitudes and gradients.\"\n}"}
{"key": "0dec423391aed7f8bfb29efe1d69f1b08cedcd10", "ts": 1771766335.6954079, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "0016ec3b4a8cf72ac0c3011b0b868c4d650ac598", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Use a numerically stable logistic preference loss on the log-probability difference (logp_w - logp_l), and incorporate an additive, swap-consistent cost/correctness shift via a bounded cost_gap (or delta_z) term. Keep everything within safe ranges via soft clamping, avoid hard failures from missing keys by providing reasonable fallbacks, and guarantee a scalar tensor output without imports or side effects.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, batch.get(logp_w, batch.get(chosen_logprob)))\\nll = batch.get(log_prob_l, batch.get(logp_l, batch.get(rejected_logprob)))\\ndz = batch.get(delta_z, batch.get(cost_gap, batch.get(delta_cost, 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Pull log-probs with common key fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))))\\n\\n    # If missing, return a zero scalar tensor without crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback: sum the first tensor-like batch value if present.\\n        for k in batch:\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"A Bradley-Terry / logistic preference objective on the log-probability margin d = logp_w - logp_l. The additive cost shift uses a bounded cost_gap (or delta_z) term so that under swap of winner/loser both d and dz flip sign, making d + beta*dz flip sign as well, preserving preference symmetry. Clamping is applied only to maintain numerical stability and keep the loss within typical evaluation ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_extra\",\n    \"expects\": [\n      \"batch['log_prob_w'] or batch['logp_w'] or batch['logprobs_w'] or batch['chosen_logprob']\",\n      \"batch['log_prob_l'] or batch['logp_l'] or batch['logprobs_l'] or batch['rejected_logprob']\",\n      \"optional batch['delta_z'] or batch['cost_gap'] or batch['delta_cost']\",\n      \"optional extra['hyperparams'] dict or scalar overrides in extra\"\n    ]\n  }\n}"}
{"key": "b849cddc0b22ee200ddabb5fb54c3ea75440f9cf", "ts": 1771766353.6597068, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "2506082990a649c0868694c153aea9baffa3a4ac", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_fix_expects\",\n  \"intuition\": \"Numerically stable logistic preference loss on the log-probability margin (log_prob_w - log_prob_l) with an additive, swap-consistent bounded cost shift. Uses soft clamping for stability and returns a scalar tensor via mean reduction; no imports, no side effects.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\ndz = batch.get(delta_z, batch.get(cost_gap, batch.get(delta_cost, 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch_keys\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required keys per implementation_hint.expects.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Optional bounded cost/correctness gap; defaults to 0 with correct dtype/device.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d = log_prob_w - log_prob_l. A bounded additive shift beta*dz (with dz sign-flipping under swap) preserves swap-consistency: swapping winner/loser flips both d and dz, so d_eff flips sign. Clamping keeps computations numerically stable and the per-example loss within typical ranges.\"\n}"}
{"key": "1a0140cabf2aeee96b47c021174f1261768e8a82", "ts": 1771766373.6470256, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "8d069b53cb750b47df51153c439c5409ccc576f6", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v3_expects_objective_signal\",\n  \"intuition\": \"Numerically stable logistic preference loss on the log-probability margin (log_prob_w - log_prob_l) with a bounded, swap-consistent additive objective shift derived from an objective signal (delta_z preferred; otherwise cost_b - cost_a). Clamping keeps gradients and loss magnitudes stable; returns a scalar tensor via mean reduction.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\nif delta_z in batch: dz = batch[delta_z]\\nelif cost_a and cost_b in batch: dz = batch[cost_b] - batch[cost_a]\\nelse: dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\ndz = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta*dz, -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required keys per implementation_hint.expects.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer delta_z; otherwise derive from costs; default to 0.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d = log_prob_w - log_prob_l. Incorporating an additive bounded objective shift beta*dz (where dz is an objective-difference signal such as delta_z or cost_b - cost_a) preserves swap-consistency when dz is defined as winner-minus-loser objective: swapping winner/loser flips both d and dz, hence d_eff changes sign. Clamping ensures numerical stability and keeps the per-example loss bounded.\"\n}"}
{"key": "650676820cae27b755d2f70133aa31f3effd0f52", "ts": 1771766389.849296, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "29e24806adf6c092cabac227a60e248ec15ec60a", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Stable Bradley-Terry logistic loss on log-prob deltas with an optional bounded additive cost-gap shift. Uses only ops.* tensor ops (no Python-side dict.get fallbacks) to satisfy static gates; expects standardized batch keys and remains numerically stable via clamping.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\ndz = batch.get('delta_z', batch.get('cost_gap', zeros_like(lw)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Expected keys to avoid Python-side fallbacks that violate static gates.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        dz = batch.get(\\\"cost_gap\\\", None)\\n    if dz is None:\\n        dz = ops.zeros_like(lw)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on delta=logp_w-logp_l. Optional bounded additive cost shift beta*cost_gap adjusts the margin in a swap-consistent way while clamping ensures numerical stability.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_keys\",\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\",\n      \"optional batch['delta_z'] or batch['cost_gap']\"\n    ]\n  }\n}"}
{"key": "19009ea420ff6b9d8df11a3c93ac9c80fcf04ff4", "ts": 1771766406.4348822, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "d9e4526182562882f54c14e2ab469da1e5308bd9", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_repair\",\n  \"intuition\": \"Stable Bradley-Terry logistic loss on log-prob deltas with an optional bounded additive cost-gap shift. Avoids Python-side dynamic fallbacks; expects standardized batch keys and stays numerically stable via clamping.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\ndz = batch.get('delta_z', batch.get('cost_gap', zeros_like(lw)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"zeros_like\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_extra\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_gap\",\n      \"hyperparams\"\n    ],\n    \"returns\": \"scalar\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\")\\n    if dz is None:\\n        dz = batch.get(\\\"cost_gap\\\")\\n    if dz is None:\\n        dz = ops.zeros_like(lw)\\n\\n    hyper = extra.get(\\\"hyperparams\\\") if isinstance(extra, dict) else None\\n    if hyper is None:\\n        hyper = {}\\n\\n    alpha = hyper.get(\\\"alpha\\\")\\n    if alpha is None:\\n        alpha = 1.0\\n    beta = hyper.get(\\\"beta\\\")\\n    if beta is None:\\n        beta = 0.25\\n    d_clip = hyper.get(\\\"d_clip\\\")\\n    if d_clip is None:\\n        d_clip = 30.0\\n    z_clip = hyper.get(\\\"z_clip\\\")\\n    if z_clip is None:\\n        z_clip = 20.0\\n    shift_clip = hyper.get(\\\"shift_clip\\\")\\n    if shift_clip is None:\\n        shift_clip = 3.0\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\")\\n    if d_eff_clip is None:\\n        d_eff_clip = 30.0\\n    per_clip = hyper.get(\\\"per_clip\\\")\\n    if per_clip is None:\\n        per_clip = 5.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on delta=logp_w-logp_l. Optional bounded additive cost shift beta*cost_gap adjusts the margin; clamping ensures numerical stability and bounded loss.\"\n}"}
{"key": "3c195b611cdeb30b587569984019a70a6a4a3612", "ts": 1771766425.0574985, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "1ea75fda615432dfebb8f6572cfc5c7e6adf7fdf", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2_repair\",\n  \"intuition\": \"Stable Bradley-Terry logistic loss on log-prob deltas with a bounded additive objective-signal shift (e.g., delta_z or cost gap). Uses only ops.* tensor ops; numerically stable via clamping.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\ndz = batch.get('delta_z', batch.get('delta_regret', batch.get('delta_rank', batch.get('cost_gap', zeros_like(lw)))))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nper = -logsigmoid(alpha*d_eff)\\nper = clamp(per, 0, per_clip)\\nreturn mean(per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"zeros_like\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"uses_model_output\": false,\n    \"mode\": \"scalar_loss\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\")\\n    if dz is None:\\n        dz = batch.get(\\\"delta_regret\\\")\\n    if dz is None:\\n        dz = batch.get(\\\"delta_rank\\\")\\n    if dz is None:\\n        dz = batch.get(\\\"cost_gap\\\")\\n    if dz is None:\\n        dz = ops.zeros_like(lw)\\n\\n    hyper = extra.get(\\\"hyperparams\\\") if isinstance(extra, dict) else None\\n    if hyper is None:\\n        hyper = {}\\n\\n    alpha = hyper.get(\\\"alpha\\\")\\n    if alpha is None:\\n        alpha = 1.0\\n    beta = hyper.get(\\\"beta\\\")\\n    if beta is None:\\n        beta = 0.25\\n    d_clip = hyper.get(\\\"d_clip\\\")\\n    if d_clip is None:\\n        d_clip = 30.0\\n    z_clip = hyper.get(\\\"z_clip\\\")\\n    if z_clip is None:\\n        z_clip = 20.0\\n    shift_clip = hyper.get(\\\"shift_clip\\\")\\n    if shift_clip is None:\\n        shift_clip = 3.0\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\")\\n    if d_eff_clip is None:\\n        d_eff_clip = 30.0\\n    per_clip = hyper.get(\\\"per_clip\\\")\\n    if per_clip is None:\\n        per_clip = 5.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on delta=logp_w-logp_l. Optional bounded additive objective shift (e.g., delta_z) adjusts the margin; clamping ensures numerical stability and bounded loss.\"\n}"}
{"key": "b76c1f0dd2f287a7eae0f2822916b791cc1a2d24", "ts": 1771766439.163634, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "840be1db49b43a76aec2f0c92d23617dda775c3e", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Stable logistic preference loss on (logp_w - logp_l) with an optional bounded additive cost shift. Uses only ops.* tensor operations (no Python control flow on tensors), avoids fragile batch key fallbacks, and keeps numerics stable via gentle clamping consistent with swap symmetry.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\ndz = batch.get(cost_gap, 0)\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Optional cost signal; default to zeros with correct shape/dtype.\\n    dz = batch.get(\\\"cost_gap\\\", None)\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin (logp_w - logp_l). A bounded additive shift from an auxiliary cost gap adjusts the effective margin while preserving swap symmetry (both the margin and cost gap flip sign under winner/loser swap). Clamping is used only for numerical stability and does not introduce non-tensor control flow.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_model_output\",\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\",\n      \"batch.get('cost_gap') (optional)\"\n    ]\n  }\n}"}
