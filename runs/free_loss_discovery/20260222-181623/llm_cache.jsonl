cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 1.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded objective shift, kept sign-consistent under swap.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Softplus-squashed amplitude: in [0, 1) (for sps>0), preserves sign via multiplication by dzc.\\n    # This keeps objective sensitivity while avoiding large additive shifts.\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * ops.abs(dzc)))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on margin d = logp_w - logp_l. Incorporates an additive objective/cost-derived shift that flips sign under winner/loser swap, preserving preference symmetry. Uses clamping and a softplus-based squashing of the objective shift to maintain numerical stability and keep per-example losses within an expected soft range while remaining sensitive to objective signals.\"\n}"}
{"key": "57a4dfda20d85bbbb3cd6ebe4f402a8ed3f1a237", "ts": 1771792723.5982838, "model": "gpt-5.2", "llm_op": "E2", "prompt_path": "PTP/prompts/free_loss_e2.txt", "prompt_sha1": "136450b8ecba8a87e177f8dce253c874003d541d", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_clamped_v1\",\n  \"description\": \"Consensus-stable Bradley-Terry logistic preference loss on the log-probability margin with a bounded additive objective/cost shift (prefers delta_z, otherwise cost_b - cost_a), and careful clamping to keep the effective margin and per-example loss within a safe range.\",\n  \"intuition\": \"All parents share the same stable core: clamp the log-prob margin, add a bounded shift from an objective signal, then apply -logsigmoid and mean-reduce. This child keeps that structure, ensures objective sensitivity when signals exist, preserves swap-consistency when dz is winner-minus-loser, and clamps the per-example loss to avoid out-of-range failures.\",\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_a\",\n      \"cost_b\"\n    ],\n    \"returns\": \"scalar\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Core required signals.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer explicit delta_z; else derive from costs; else 0.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    # Clamp base margin and objective shift for numerical stability.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep per-example losses in the expected safe range.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d = log_prob_w - log_prob_l. An auxiliary objective delta signal dz (prefer delta_z, otherwise cost_b - cost_a) is incorporated as an additive bounded shift beta*dz, producing an effective margin d_eff = d + shift. When dz is defined as winner-minus-loser objective, swapping winner/loser flips both d and dz, so d_eff changes sign and the loss remains swap-consistent. Clamping d, dz, shift, d_eff, and the per-example loss improves numerical stability and prevents out-of-range loss magnitudes.\"\n}"}
{"key": "95b149ab4345c436f3d51b46a0309d0547ea097b", "ts": 1771792741.8996856, "model": "gpt-5.2", "llm_op": "EXPECTS_REPAIR", "prompt_path": "PTP/prompts/free_loss_expects_repair.txt", "prompt_sha1": "bfbfb37b741de325e3c56efe24cf7d25e5cfe5ab", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_clamped_v1\",\n  \"intuition\": \"All parents share the same stable core: clamp the log-prob margin, add a bounded shift from an objective signal, then apply -logsigmoid and mean-reduce. This child keeps that structure, ensures objective sensitivity when signals exist, preserves swap-consistency when dz is winner-minus-loser, and clamps the per-example loss to avoid out-of-range failures.\",\n  \"pseudocode\": \"\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Core required signals.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer explicit delta_z; else derive from costs; else 0.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    # Clamp base margin and objective shift for numerical stability.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep per-example losses in the expected safe range.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin d = log_prob_w - log_prob_l. An auxiliary objective delta signal dz (prefer delta_z, otherwise cost_b - cost_a) is incorporated as an additive bounded shift beta*dz, producing an effective margin d_eff = d + shift. When dz is defined as winner-minus-loser objective, swapping winner/loser flips both d and dz, so d_eff changes sign and the loss remains swap-consistent. Clamping d, dz, shift, d_eff, and the per-example loss improves numerical stability and prevents out-of-range loss magnitudes.\"\n}"}
{"key": "91300b52c5ed7135fc79d93095e9f93478dfab25", "ts": 1771792764.5731294, "model": "gpt-5.2", "llm_op": "E2", "prompt_path": "PTP/prompts/free_loss_e2.txt", "prompt_sha1": "a867e20b16f7a4c51143c4b0e71fdf36393dfa3e", "content": "{\"name\":\"m3_stable_cost_shift_logsigmoid_v4_softplus_cap\",\"intuition\":\"Consensus stable pattern: preference loss on log-prob margin (lw-ll) with a bounded additive objective/cost shift that preserves swap-consistency. Make it slightly novel/smoother by using softplus(-alpha*d_eff) (equivalent to -logsigmoid) and a soft cap via tanh to avoid rare loss-out-of-range without hard per-example clipping. Keep robust key fallbacks to avoid input-mismatch failures and always return a scalar tensor.\",\"theoretical_basis\":\"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\",\"operators_used\":[\"clamp\",\"softplus\",\"tanh\"],\"hyperparams\":{\"alpha\":1.0,\"beta\":0.25,\"d_clip\":30.0,\"z_clip\":20.0,\"shift_clip\":3.0,\"d_eff_clip\":30.0,\"cap\":5.0},\"implementation_hint\":{\"mode\":\"combine\",\"expects\":[\"log_prob_w\",\"log_prob_l\",\"delta_z\"],\"optional\":[\"logp_w\",\"logp_l\",\"chosen_logprob\",\"rejected_logprob\",\"cost_gap\",\"delta_cost\",\"cost_a\",\"cost_b\"],\"returns\":\"scalar_tensor\"},\"code\":\"def generated_loss(batch, model_output, extra):\\n    # Robust key fallbacks for log-probabilities.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor tied to available tensors.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\"}"}
{"key": "86adadae7a46d1247dd0ba55376f16356f433626", "ts": 1771792790.6962814, "model": "gpt-5.2", "llm_op": "EXPECTS_REPAIR", "prompt_path": "PTP/prompts/free_loss_expects_repair.txt", "prompt_sha1": "13b1c8e94feaf58771475adbf7c7bede8ac49fb5", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_cap\",\n  \"intuition\": \"Consensus stable pattern: preference loss on log-prob margin (lw-ll) with a bounded additive objective/cost shift that preserves swap-consistency. Make it slightly novel/smoother by using softplus(-alpha*d_eff) (equivalent to -logsigmoid) and a soft cap via tanh to avoid rare loss-out-of-range without hard per-example clipping. Keep robust key fallbacks to avoid input-mismatch failures and always return a scalar tensor.\",\n  \"pseudocode\": \"\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"cap\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"softplus\",\n    \"tanh\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust key fallbacks for log-probabilities.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor tied to available tensors.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\"\n}"}
{"key": "3f001cf0b275ffa603f79723c365ebe77e74b07d", "ts": 1771792815.552474, "model": "gpt-5.2", "llm_op": "E2", "prompt_path": "PTP/prompts/free_loss_e2.txt", "prompt_sha1": "0ea337da0acc34b640175e8f702dce45b9e48ec3", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_softplus_gate\",\n  \"intuition\": \"Consensus-stable Bradley-Terry preference loss on the log-prob margin (log_prob_w - log_prob_l) with a bounded, swap-consistent additive objective shift (delta_z preferred; else cost_gap/delta_cost; else cost_b-cost_a). To improve objective sensitivity without destabilizing scale, apply a mild softplus-based gating factor that depends on |objective_delta|, while keeping all signals clamped to safe ranges and returning a scalar tensor.\",\n  \"theoretical_basis\": \"Starts from the standard logistic pairwise preference objective: L = E[-log sigma(alpha * d_eff)], where d_eff is an effective margin. Incorporates an auxiliary objective difference dz via an additive bounded shift beta*dz to preserve swap-consistency when dz is defined as winner-minus-loser objective (swapping winner/loser flips both d and dz). Adds a bounded multiplicative gate g(dz)=1+gate_scale*(softplus(k*|dz|)-softplus(0)) to ensure nontrivial sensitivity to the objective magnitude while maintaining numerical stability through clamping of d, dz, shift, and final loss.\",\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"gate_k\": 0.2,\n    \"gate_scale\": 0.25,\n    \"gate_clip\": 1.0,\n    \"per_clip\": 5.0\n  },\n  \"implementation_hint\": {\n    \"mode\": \"combine\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust log-prob key fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing required tensors, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal: prefer delta_z; then cost_gap/delta_cost; else derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get(name, default):\\n        if isinstance(extra, dict) and (name in extra):\\n            return float(extra.get(name))\\n        return float(hp.get(name, default))\\n\\n    alpha = _get(\\\"alpha\\\", 1.0)\\n    beta = _get(\\\"beta\\\", 0.25)\\n    d_clip = _get(\\\"d_clip\\\", 30.0)\\n    z_clip = _get(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get(\\\"d_eff_clip\\\", 30.0)\\n    gate_k = _get(\\\"gate_k\\\", 0.2)\\n    gate_scale = _get(\\\"gate_scale\\\", 0.25)\\n    gate_clip = _get(\\\"gate_clip\\\", 1.0)\\n    per_clip = _get(\\\"per_clip\\\", 5.0)\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent if dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Mild objective-magnitude gating to avoid objective insensitivity.\\n    # gate >= 1, and is bounded to [1, 1+gate_clip].\\n    base_sp = ops.softplus(dzc * 0.0)\\n    mag = ops.softplus(gate_k * ops.clamp(dzc, -z_clip, z_clip)) + ops.softplus(gate_k * ops.clamp(-dzc, -z_clip, z_clip))\\n    mag = 0.5 * mag\\n    gate_raw = gate_scale * ops.clamp(mag - base_sp, 0.0, gate_clip)\\n    gate = 1.0 + gate_raw\\n\\n    per = gate * (-ops.logsigmoid(alpha * d_eff))\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\"\n}"}
