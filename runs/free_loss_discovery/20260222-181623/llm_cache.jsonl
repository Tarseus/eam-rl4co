at((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n    eps = float((extra.get(\\\"eps\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"eps\\\", 1e-6))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Smooth bounded shift: odd in dzc (swap-consistent) and bounded in [-shift_clip, shift_clip].\\n    denom = shift_clip if shift_clip > eps else eps\\n    shift = shift_clip * ops.tanh((beta * dzc) / denom)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the margin d=logp_w-logp_l. An auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) can enter as an additive shift of the margin while preserving swap-consistency when defined winner-minus-loser (both d and dz flip sign under swapping). Using a tanh-shaped shift (bounded, smooth, odd) reduces sensitivity to the raw scale of dz and avoids hard clipping discontinuities, improving stability while maintaining bounded influence. Clamping d, dz, and d_eff provides numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\"\n}"}
{"key": "2fc1878457634757a7cdf973d8cfa3f348abed7c", "ts": 1771814012.1702464, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "f8bd65a230f399fccb236b0f717a1388cdb42834", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_cap_M2_tuned_r1\",\n  \"intuition\": \"Keep the robust, swap-consistent cost-shifted preference loss, but tune hyperparameters to (a) increase sensitivity to the auxiliary objective via a slightly larger beta and shift_clip, (b) reduce unnecessary saturation by tightening extreme margin clamps, and (c) avoid any loss-range issues by lowering the smooth cap while keeping it positive (so the tanh-based cap path remains active).\",\n  \"pseudocode\": \"Inputs: batch dict with winner/loser log-probs and optional objective delta; model_output tensor-like; extra dict.\\n1) Read lw from batch['log_prob_w'|'logp_w'|'chosen_logprob']; ll from batch['log_prob_l'|'logp_l'|'rejected_logprob'].\\n2) If lw or ll missing: return 0 * sum(any available tensor) to produce a scalar tensor.\\n3) Read objective delta dz from batch['delta_z'|'cost_gap'|'delta_cost']; else if cost_a and cost_b exist set dz = cost_a - cost_b; else dz = 0.\\n4) Load hyperparams alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, cap from extra/hyperparams with defaults.\\n5) Compute margin d = clamp(lw - ll, -d_clip, d_clip).\\n6) Clamp dz: dzc = clamp(dz, -z_clip, z_clip); shift = clamp(beta * dzc, -shift_clip, shift_clip).\\n7) Effective margin: d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip).\\n8) Per-example loss: per = softplus(-alpha * d_eff).\\n9) Smooth cap (optional): per = cap * 0.5 * (tanh(per / cap) + 1) if cap > 0.\\n10) Return mean(per) as scalar tensor.\",\n  \"hyperparams\": {\n    \"alpha\": 1.15,\n    \"beta\": 0.35,\n    \"d_clip\": 20.0,\n    \"z_clip\": 12.0,\n    \"shift_clip\": 4.0,\n    \"d_eff_clip\": 24.0,\n    \"cap\": 3.5\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"softplus\",\n    \"tanh\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust key fallbacks for log-probabilities.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor tied to available tensors.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\",\n  \"implementation_hint\": {\n    \"mode\": \"free_loss\",\n    \"expects\": [\n      \"batch\",\n      \"model_output\",\n      \"extra\"\n    ]\n  }\n}"}
