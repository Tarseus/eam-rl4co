m\\\"):\\n                    base = v\\n                    break\\n        if base is None:\\n            return 0.0\\n        return base.sum() * 0.0\\n\\n    # Objective signal: prefer delta_z; then cost_gap/delta_cost; else derive from costs.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n\\n    def _get(name, default):\\n        if isinstance(extra, dict) and (name in extra):\\n            return float(extra.get(name))\\n        return float(hp.get(name, default))\\n\\n    alpha = _get(\\\"alpha\\\", 1.0)\\n    beta = _get(\\\"beta\\\", 0.25)\\n    d_clip = _get(\\\"d_clip\\\", 30.0)\\n    z_clip = _get(\\\"z_clip\\\", 20.0)\\n    shift_clip = _get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = _get(\\\"d_eff_clip\\\", 30.0)\\n    gate_k = _get(\\\"gate_k\\\", 0.2)\\n    gate_scale = _get(\\\"gate_scale\\\", 0.25)\\n    gate_clip = _get(\\\"gate_clip\\\", 1.0)\\n    per_clip = _get(\\\"per_clip\\\", 5.0)\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent if dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Mild objective-magnitude gating to avoid objective insensitivity.\\n    # gate >= 1, and is bounded to [1, 1+gate_clip].\\n    base_sp = ops.softplus(dzc * 0.0)\\n    mag = ops.softplus(gate_k * ops.clamp(dzc, -z_clip, z_clip)) + ops.softplus(gate_k * ops.clamp(-dzc, -z_clip, z_clip))\\n    mag = 0.5 * mag\\n    gate_raw = gate_scale * ops.clamp(mag - base_sp, 0.0, gate_clip)\\n    gate = 1.0 + gate_raw\\n\\n    per = gate * (-ops.logsigmoid(alpha * d_eff))\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Starts from the standard logistic pairwise preference objective: L = E[-log sigma(alpha * d_eff)], where d_eff is an effective margin. Incorporates an auxiliary objective difference dz via an additive bounded shift beta*dz to preserve swap-consistency when dz is defined as winner-minus-loser objective (swapping winner/loser flips both d and dz). Adds a bounded multiplicative gate g(dz)=1+gate_scale*(softplus(k*|dz|)-softplus(0)) to ensure nontrivial sensitivity to the objective magnitude while maintaining numerical stability through clamping of d, dz, shift, and final loss.\"\n}"}
{"key": "4d143795da4be3eb1ea971f955e21d542867636a", "ts": 1771792858.5019326, "model": "gpt-5.2", "llm_op": "E1", "prompt_path": "PTP/prompts/free_loss_crossover.txt", "prompt_sha1": "60a6856a6d30d32fac6a020abafa7ce11abc4be1", "content": "{\"name\":\"e1_stable_cost_shift_logsigmoid_v2_blend\",\"intuition\":\"Blend both parents' stable logistic preference core with robust objective-signal handling. Use -logsigmoid on a clamped effective margin (log_prob_w-log_prob_l + beta*dz), where dz is taken from delta_z/cost_gap/delta_cost or derived from cost_a-cost_b. All components are bounded to keep gradients and loss within a soft range, while remaining swap-consistent when dz flips with preference ordering.\",\"theoretical_basis\":\"Bradley-Terry / logistic preference loss on delta=logp_w-logp_l. A bounded additive shift beta*dz incorporates an external objective difference signal; when dz is defined as winner-minus-loser objective, swapping winner/loser flips both delta and dz, preserving antisymmetry of the effective margin. Clamping ensures numerical stability and bounded per-example contribution.\",\"operators_used\":[\"clamp\",\"logsigmoid\"],\"hyperparams\":{\"alpha\":1.0,\"beta\":0.25,\"d_clip\":30.0,\"z_clip\":20.0,\"shift_clip\":3.0,\"d_eff_clip\":30.0,\"per_clip\":5.0},\"implementation_hint\":{\"expects\":[\"log_prob_w\",\"log_prob_l\",\"delta_z\"],\"allows_missing\":[\"delta_z\"]},\"code\":\"def generated_loss(batch, model_output, extra):\\n    # Preference log-prob margin.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a benign scalar tensor.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases; else derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\"}"}
