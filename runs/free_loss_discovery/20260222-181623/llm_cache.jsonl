{"key": "91dc7668d4899bd7fc221cbb80723157381d58d1", "ts": 1771766467.487868, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "d7b989e38c9af8b9cdd5fe5df3a313547b267841", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v3_add_expects_delta_z\",\n  \"intuition\": \"Stable logistic preference loss on the log-probability margin (logp_w - logp_l) with an optional bounded additive shift from an objective delta signal (delta_z). Uses only ops.* tensor ops, keeps numerics stable via clamping, and preserves swap symmetry when delta_z is provided.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\ndz = batch.get(delta_z, 0)\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on the log-probability margin (logp_w - logp_l). A bounded additive shift from an auxiliary objective delta signal (delta_z) adjusts the effective margin while preserving swap symmetry (both the margin and delta_z flip sign under winner/loser swap). Clamping is used for numerical stability.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  }\n}"}
{"key": "bda6d17719df22e9bd169380ed5348071f090d6c", "ts": 1771766490.7198985, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "c23a2d0c62e09fb0c7a3e3d105be700ff9a72323", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Use the standard logistic preference loss on the log-prob delta (winner minus loser), with an optional bounded additive shift derived from a cost signal (delta_z/cost_gap). Keep everything numerically stable via symmetric clamps and avoid hard failures by supporting common batch key variants.\",\n  \"pseudocode\": \"lw = batch.get(log_prob_w, logp_w, logprobs_w, chosen_logprob)\\nll = batch.get(log_prob_l, logp_l, logprobs_l, rejected_logprob)\\ndz = batch.get(delta_z, cost_gap, delta_cost, 0)\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nloss = clamp(loss, 0, per_clip)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Preference log-probs: support common key variants.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))))\\n\\n    # If keys are missing, return a benign scalar tensor without crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        any_v = batch[next(iter(batch))]\\n        return any_v.sum() * 0.0\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Hyperparams can come either at top-level of extra or under extra['hyperparams'].\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp(w) - logp(l). An optional bounded additive cost-derived shift adjusts the effective margin while remaining swap-consistent when the cost signal is defined as a winner-minus-loser gap. Symmetric clamping preserves gradients in the typical operating range and prevents numerical blow-ups.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_output\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or key variants: logp_w/logp_l, logprobs_w/logprobs_l, chosen_logprob/rejected_logprob)\",\n      \"optional batch['delta_z'] or batch['cost_gap'] or batch['delta_cost']\",\n      \"extra may contain hyperparams either directly or in extra['hyperparams']\"\n    ]\n  }\n}"}
{"key": "6f122a709bc60be65c26cb0a803288d5d102b206", "ts": 1771766507.9861262, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "9cc85e25e7d8b6afbfb226d33fba9b5ac2a2da46", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v3\",\n  \"intuition\": \"Use a stable logistic preference loss on the log-prob delta (winner minus loser). Optionally incorporate a bounded additive shift from a cost gap signal. Keep numerical stability via symmetric clamping, while explicitly expecting the canonical log-prob keys required by the gate.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\ndz = batch.get('delta_z', batch.get('cost_gap', batch.get('delta_cost', 0)))\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nloss = clamp(loss, 0, per_clip)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Canonical required keys (keeps implementation_hint.expects consistent with code).\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp(w) - logp(l). A bounded additive cost-derived shift adjusts the effective margin when a winner-minus-loser cost gap is available. Symmetric clamping keeps the objective numerically stable while preserving gradients in the typical operating regime.\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ]\n  }\n}"}
{"key": "9f11119f31f852604703bef124b87eaad291568f", "ts": 1771766527.5013978, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "4101441e51b15615b2a21e51d2ac082607ed2e22", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4\",\n  \"intuition\": \"Use a stable logistic preference loss on the log-prob delta (winner minus loser). Incorporate a bounded additive shift computed from an objective signal (prefer delta_z; otherwise derive from cost_a/cost_b). Keep numerical stability via symmetric clamping, and explicitly declare an objective signal in implementation_hint.expects to satisfy the gate.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\nif 'delta_z' in batch: dz = batch['delta_z']\\nelif 'cost_a' in batch and 'cost_b' in batch: dz = batch['cost_b'] - batch['cost_a']\\nelse: dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\ndz = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta*dz, -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nloss = clamp(loss, 0, per_clip)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required canonical keys for preference learning.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer delta_z; otherwise derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp(w) - logp(l). A bounded additive shift uses an objective signal (delta_z or cost_b - cost_a) to adjust the effective margin when available. Symmetric clamping and logsigmoid preserve numerical stability while keeping informative gradients in typical ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ]\n  }\n}"}
{"key": "d69fa8cc07e577835860a6c264a4942f24bd1805", "ts": 1771766548.573482, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "d86f339d256198c0414697d773a2b1132d77c8a4", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4b\",\n  \"intuition\": \"Use a stable logistic preference loss on the log-prob delta (winner minus loser). Incorporate a bounded additive shift computed from an objective signal (prefer delta_z; otherwise derive from cost_a/cost_b). Keep numerical stability via symmetric clamping, and explicitly declare an objective signal in implementation_hint.expects to satisfy the gate.\",\n  \"pseudocode\": \"lw = batch['log_prob_w']\\nll = batch['log_prob_l']\\nif 'delta_z' in batch: dz = batch['delta_z']\\nelif 'cost_a' in batch and 'cost_b' in batch: dz = batch['cost_b'] - batch['cost_a']\\nelse: dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\ndz = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta*dz, -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = -logsigmoid(alpha*d_eff)\\nloss = clamp(loss, 0, per_clip)\\nreturn mean(loss)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z|cost_a+cost_b\"\n    ],\n    \"mode\": \"preference\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Canonical keys for preference learning.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Objective signal: prefer delta_z; otherwise derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp(w) - logp(l). A bounded additive shift uses an objective signal (delta_z or cost_b - cost_a) to adjust the effective margin when available. Symmetric clamping and logsigmoid preserve numerical stability while keeping informative gradients in typical ranges.\"\n}"}
{"key": "a11a632f5b912c30829632280125f91f37a54516", "ts": 1771766569.5284767, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "b6ec9070d985552583f479371a1c8bc3e4761653", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Use a numerically stable logistic preference loss on the log-probability margin (winner minus loser). Optionally incorporate a bounded additive cost-gap shift that preserves swap symmetry (both margin and cost flip sign on swap). Keep implementation minimal and stable with conservative clamping, and avoid crashing if optional cost fields are missing.\",\n  \"pseudocode\": \"lw = batch[log_prob_w or logp_w or chosen_logprob]\\nll = batch[log_prob_l or logp_l or rejected_logprob]\\ndz = batch[delta_z or cost_gap or delta_cost or 0]\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = mean(-logsigmoid(alpha*d_eff))\\nreturn loss\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required preference signal: winner/loser log-probabilities with common key fallbacks.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If essential keys are missing, return a well-typed zero scalar without touching global state.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback: use any tensor in batch.\\n        for v in batch.values():\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0\\n\\n    # Optional cost / auxiliary shift (defaults to zero if absent).\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Hyperparameters: read from extra[\\\"hyperparams\\\"] if present.\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive shift; swap-consistent if dz flips with (w,l) swap.\\n    shift = ops.clamp(beta * ops.clamp(dz, -z_clip, z_clip), -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic preference loss.\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference modeling: P(wins) = sigmoid(alpha*(logp_w-logp_l + beta*cost_gap)). The loss is -log(sigmoid(.)) averaged over the batch. Clamping is used only for numerical stability and does not change the basic monotonic preference objective within typical ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_model_output\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (preferred) or batch['logp_w']/batch['logp_l'] or batch['chosen_logprob']/batch['rejected_logprob']\",\n      \"optional batch['delta_z'] or batch['cost_gap'] or batch['delta_cost'] (defaults to 0)\",\n      \"extra may contain extra['hyperparams'] with alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip\"\n    ]\n  }\n}"}
{"key": "e4070f064aa372f8d12ad2e0272a2d9394cfc7f2", "ts": 1771766585.39054, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "2184bc280390e1a642752f769bd500511064911a", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v2\",\n  \"intuition\": \"Use a numerically stable logistic preference loss on the log-probability margin (winner minus loser). Optionally incorporate a bounded additive cost-gap shift that preserves swap symmetry (both margin and cost flip sign on swap). Keep implementation minimal and stable with conservative clamping, and avoid crashing if optional cost fields are missing.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\ndz = batch.get(delta_z or cost_gap or delta_cost, 0)\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = mean(-logsigmoid(alpha*d_eff))\\nreturn loss\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"cost_gap\",\n      \"delta_cost\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required preference signal.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Optional cost / auxiliary shift (defaults to zero if absent).\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Hyperparameters: read from extra[\\\"hyperparams\\\"] if present.\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive shift; swap-consistent if dz flips with (w,l) swap.\\n    shift = ops.clamp(beta * ops.clamp(dz, -z_clip, z_clip), -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic preference loss.\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference modeling: P(wins) = sigmoid(alpha*(logp_w-logp_l + beta*cost_gap)). The loss is -log(sigmoid(.)) averaged over the batch. Clamping is used only for numerical stability and does not change the basic monotonic preference objective within typical ranges.\"\n}"}
{"key": "9d1806b41e414d73942171be56d65583f28b209f", "ts": 1771766603.8121207, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "4404d1a0038404ac6a817e414ee2d86303a2496e", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v3\",\n  \"intuition\": \"Use a numerically stable logistic preference loss on the log-probability margin (winner minus loser). Incorporate an optional bounded additive cost-based shift derived from (cost_b - cost_a), which preserves swap symmetry when winner/loser (and thus a/b) are swapped. If cost signals are missing, default shift to zero while still producing a valid scalar loss.\",\n  \"pseudocode\": \"lw = batch[log_prob_w]\\nll = batch[log_prob_l]\\nif cost_a and cost_b exist:\\n  dz = cost_b - cost_a\\nelse if delta_z exists:\\n  dz = delta_z\\nelse:\\n  dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\nshift = clamp(beta*clamp(dz,-z_clip,z_clip), -shift_clip, shift_clip)\\nd_eff = clamp(d+shift, -d_eff_clip, d_eff_clip)\\nloss = mean(-logsigmoid(alpha*d_eff))\\nreturn loss\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Required preference signal.\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    # Optional objective/cost signal (must be declared in implementation_hint.expects).\\n    # Prefer explicit per-sample costs if present; otherwise fall back to delta_z.\\n    ca = batch.get(\\\"cost_a\\\", None)\\n    cb = batch.get(\\\"cost_b\\\", None)\\n    if (ca is not None) and (cb is not None):\\n        dz = cb - ca\\n    else:\\n        dz = batch.get(\\\"delta_z\\\", None)\\n        if dz is None:\\n            dz = lw * 0.0\\n\\n    # Hyperparameters: read from extra[\\\"hyperparams\\\"] if present.\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n\\n    # Base margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive shift; swap-consistent if (cost_a,cost_b) or delta_z flips on swap.\\n    shift = ops.clamp(beta * ops.clamp(dz, -z_clip, z_clip), -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic preference loss.\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference modeling with an additive objective shift: P(wins) = sigmoid(alpha*(logp_w - logp_l + beta*dz)), where dz is an auxiliary objective difference (preferably cost_b - cost_a, otherwise delta_z). The loss is -log(sigmoid(.)) averaged over the batch. Clamping is used for numerical stability while preserving monotonicity in typical operating ranges.\",\n  \"implementation_hint\": {\n    \"mode\": \"preference\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"cost_a\",\n      \"cost_b\",\n      \"delta_z\"\n    ],\n    \"returns\": \"scalar_loss\"\n  }\n}"}
