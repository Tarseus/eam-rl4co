{"key": "23f5dd66e0a2a752e2225e7927b6e363d8d14032", "ts": 1771792645.1767068, "model": "gpt-5.2", "llm_op": "E1", "prompt_path": "PTP/prompts/free_loss_crossover.txt", "prompt_sha1": "6e4328c9f5bff46a231c5306fb56eaf883ba56f8", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_keyfallback_v4\",\n  \"intuition\": \"Crossover: keep the strong stable core logistic preference loss from parent0, and add the robust batch-key fallbacks and bounded per-example clipping from parent1 to avoid input mismatches and keep loss in-range. Uses an additive, swap-consistent objective/cost shift (delta_z/cost_gap/delta_cost) with conservative clamping for numerical stability.\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp_w - logp_l, implemented as -logsigmoid(alpha * d_eff). Incorporates an additive bounded shift beta*dz (dz from an objective/cost difference signal) which preserves swap symmetry when dz is winner-minus-loser aligned. Clamping on delta, shift, and per-example loss keeps gradients and values numerically stable and within evaluator soft ranges.\",\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"logp_w\",\n      \"logp_l\",\n      \"logprobs_w\",\n      \"logprobs_l\",\n      \"chosen_logprob\",\n      \"rejected_logprob\",\n      \"cost_gap\",\n      \"delta_cost\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Hyperparameters\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = hyper.get(\\\"per_clip\\\", 5.0)\\n\\n    # Robust batch key fallbacks for log-probs\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n\\n    # If still missing, return a benign scalar tensor to avoid crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback: sum over any tensor in batch.\\n        k0 = list(batch.keys())[0]\\n        return batch[k0].sum() * 0.0\\n\\n    # Objective/cost delta signal with fallbacks\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Stable, bounded effective margin\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep within evaluator soft range and avoid rare outliers.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\"\n}"}
{"key": "6450c5db2bcacdbcc74225ceb705816b88b300b4", "ts": 1771792662.8103132, "model": "gpt-5.2", "llm_op": "EXPECTS_REPAIR", "prompt_path": "PTP/prompts/free_loss_expects_repair.txt", "prompt_sha1": "ad6559505c2191d995d7d0bda454973b24cd828d", "content": "{\n  \"name\": \"e1_stable_cost_shift_logsigmoid_keyfallback_v4\",\n  \"intuition\": \"Crossover: keep the strong stable core logistic preference loss from parent0, and add the robust batch-key fallbacks and bounded per-example clipping from parent1 to avoid input mismatches and keep loss in-range. Uses an additive, swap-consistent objective/cost shift (delta_z/cost_gap/delta_cost) with conservative clamping for numerical stability.\",\n  \"pseudocode\": \"\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Hyperparameters\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = hyper.get(\\\"alpha\\\", 1.0)\\n    beta = hyper.get(\\\"beta\\\", 0.25)\\n    d_clip = hyper.get(\\\"d_clip\\\", 30.0)\\n    z_clip = hyper.get(\\\"z_clip\\\", 20.0)\\n    shift_clip = hyper.get(\\\"shift_clip\\\", 3.0)\\n    d_eff_clip = hyper.get(\\\"d_eff_clip\\\", 30.0)\\n    per_clip = hyper.get(\\\"per_clip\\\", 5.0)\\n\\n    # Robust batch key fallbacks for log-probs\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", None))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", None))\\n    if lw is None or ll is None:\\n        lw = batch.get(\\\"logprobs_w\\\", batch.get(\\\"chosen_logprob\\\", None))\\n        ll = batch.get(\\\"logprobs_l\\\", batch.get(\\\"rejected_logprob\\\", None))\\n\\n    # If still missing, return a benign scalar tensor to avoid crashing.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        # Fallback: sum over any tensor in batch.\\n        k0 = list(batch.keys())[0]\\n        return batch[k0].sum() * 0.0\\n\\n    # Objective/cost delta signal with fallbacks\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        dz = lw * 0.0\\n\\n    # Stable, bounded effective margin\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    # Keep within evaluator soft range and avoid rare outliers.\\n    per = ops.clamp(per, 0.0, per_clip)\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic preference objective on delta = logp_w - logp_l, implemented as -logsigmoid(alpha * d_eff). Incorporates an additive bounded shift beta*dz (dz from an objective/cost difference signal) which preserves swap symmetry when dz is winner-minus-loser aligned. Clamping on delta, shift, and per-example loss keeps gradients and values numerically stable and within evaluator soft ranges.\"\n}"}
{"key": "2123c01b9f124f801abfd92301a9bf8b3d3373a4", "ts": 1771792684.2751365, "model": "gpt-5.2", "llm_op": "E2", "prompt_path": "PTP/prompts/free_loss_e2.txt", "prompt_sha1": "ec979d6a8561976881649b0a47521c175212e2c2", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_shift_mix\",\n  \"author\": \"consensus_extraction_e2\",\n  \"description\": \"Bradley-Terry style preference loss on log-prob margin with a bounded, swap-consistent additive objective shift. Uses a softplus-squashed shift to remain sensitive to objective while keeping numerics stable; clamps margin/shift and per-example loss to satisfy soft-range expectations. Includes limited key fallbacks to reduce missing_batch_key errors.\",\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\",\n    \"softplus\"\n  ],\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0,\n    \"shift_softplus_scale\": 1.0\n  },\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"notes\": \"Will also accept common aliases: logp_w/logp_l or chosen_logprob/rejected_logprob for log-probs; cost_gap/delta_cost or cost_a-cost_b for objective signal.\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Fetch log-probs with a small set of common key aliases.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If required fields are missing, return a valid scalar tensor tied to an existing tensor.\\n    if lw is None or ll is None:\\n        base = model_output if hasattr(model_output, \\\"sum\\\") else None\\n        if base is None:\\n            for k in batch.keys():\\n                v = batch.get(k, None)\\n                if hasattr(v, \\\"sum\\\"):\\n                    base = v\\n                    break\\n        return (base.sum() * 0.0) if base is not None else 0.0\\n\\n    # Objective/cost signal: prefer delta_z, then common aliases, then derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        dz = (ca - cb) if (ca is not None and cb is not None) else (lw * 0.0)\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float(hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float(hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float(hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float(hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float(hyper.get(\\\"per_clip\\\", 5.0))\\n    sps = float(hyper.get(\\\"shift_softplus_scale\\\", 1.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded objective shift, kept sign-consistent under swap.\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n\\n    # Softplus-squashed amplitude: in [0, 1) (for sps>0), preserves sign via multiplication by dzc.\\n    # This keeps objective sensitivity while avoiding large additive shifts.\\n    amp = 1.0 - ops.exp(-ops.softplus(sps * ops.abs(dzc)))\\n    shift = ops.clamp(beta * dzc * amp, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference loss on margin d = logp_w - logp_l. Incorporates an additive objective/cost-derived shift that flips sign under winner/loser swap, preserving preference symmetry. Uses clamping and a softplus-based squashing of the objective shift to maintain numerical stability and keep per-example losses within an expected soft range while remaining sensitive to objective signals.\"\n}"}
