\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference learning on the log-probability margin d = log_prob_w - log_prob_l. An auxiliary scalar delta signal (prefer delta_z, else cost_b - cost_a) is added as a bounded shift beta*dz to modulate the effective margin. If delta_z is defined as winner-minus-loser objective, swapping winner/loser flips both d and dz, preserving swap-consistency. Clamping d, dz, shift, and per-example losses improves numerical stability and avoids extreme gradients.\",\n  \"implementation_hint\": {\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\"\n    ],\n    \"uses\": [\n      \"ops.clamp\",\n      \"ops.logsigmoid\"\n    ],\n    \"mode\": \"pairwise\"\n  }\n}"}
{"key": "5ea8ff1f676fe3fb77420e123e91db4ff26b82fd", "ts": 1771793263.6135643, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "8316e6dd162c28006c56b44e47a0d16cce65e154", "content": "{\n  \"name\": \"e2_consensus_cost_shift_logsigmoid_clamped_v3c\",\n  \"intuition\": \"Stable Bradley-Terry core: clamp the log-prob margin, add a bounded auxiliary shift from an objective delta signal when present, then apply -logsigmoid and mean-reduce. Keeps swap-consistency when delta_z is winner-minus-loser, preserves objective sensitivity via a clipped additive shift, and clamps per-example loss for numerical safety using only allowed ops.\",\n  \"pseudocode\": \"lw, ll = batch.log_prob_w, batch.log_prob_l\\nif batch has delta_z: dz = delta_z\\nelse if batch has cost_a and cost_b: dz = cost_b - cost_a\\nelse: dz = 0\\n\\nd = clamp(lw-ll, -d_clip, d_clip)\\ndz = clamp(dz, -z_clip, z_clip)\\nshift = clamp(beta*dz, -shift_clip, shift_clip)\\nd_eff = clamp(d + shift, -d_eff_clip, d_eff_clip)\\nloss_per = clamp(-logsigmoid(alpha*d_eff), 0, per_clip)\\nreturn mean(loss_per)\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"per_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"logsigmoid\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    lw = batch[\\\"log_prob_w\\\"]\\n    ll = batch[\\\"log_prob_l\\\"]\\n\\n    dz = batch.get(\\\"delta_z\\\", None)\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if (ca is not None) and (cb is not None):\\n            dz = cb - ca\\n        else:\\n            dz = lw * 0.0\\n\\n    hp = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hp.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hp.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"d_eff_clip\\\", 30.0))\\n    per_clip = float((extra.get(\\\"per_clip\\\") if isinstance(extra, dict) else None) or hp.get(\\\"per_clip\\\", 5.0))\\n\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    per = -ops.logsigmoid(alpha * d_eff)\\n    per = ops.clamp(per, 0.0, per_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Logistic (Bradley-Terry) preference learning on the log-probability margin d = log_prob_w - log_prob_l. An auxiliary scalar delta signal (prefer delta_z, else cost_b - cost_a) is added as a bounded shift beta*dz to modulate the effective margin. If delta_z is defined as winner-minus-loser objective, swapping winner/loser flips both d and dz, preserving swap-consistency. Clamping d, dz, shift, and per-example losses improves numerical stability and avoids extreme gradients.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch\",\n    \"expects\": [\n      \"batch['log_prob_w']\",\n      \"batch['log_prob_l']\",\n      \"optional: batch['delta_z']\",\n      \"optional: batch['cost_a'], batch['cost_b']\",\n      \"optional: extra['hyperparams'] or extra[...] scalars\"\n    ]\n  }\n}"}
{"key": "fdee616eb346e45e590447def5a3740a20f17dca", "ts": 1771793291.9695532, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "8c870248e22553eb545ac69a8a36eeecadbfb969", "content": "{\n  \"name\": \"m3_stable_cost_shift_logsigmoid_v4_softplus_cap\",\n  \"intuition\": \"Consensus stable pattern: preference loss on log-prob margin (lw-ll) with a bounded additive objective/cost shift that preserves swap-consistency. Make it slightly novel/smoother by using softplus(-alpha*d_eff) (equivalent to -logsigmoid) and a soft cap via tanh to avoid rare loss-out-of-range without hard per-example clipping. Keep robust key fallbacks to avoid input-mismatch failures and always return a scalar tensor.\",\n  \"pseudocode\": \"Inputs: batch dict with winner/loser log-probs and optional objective delta; model_output tensor-like; extra dict.\\n1) Read lw from batch['log_prob_w'|'logp_w'|'chosen_logprob']; ll from batch['log_prob_l'|'logp_l'|'rejected_logprob'].\\n2) If lw or ll missing: return 0 * sum(any available tensor) to produce a scalar tensor.\\n3) Read objective delta dz from batch['delta_z'|'cost_gap'|'delta_cost']; else if cost_a and cost_b exist set dz = cost_a - cost_b; else dz = 0.\\n4) Load hyperparams alpha, beta, d_clip, z_clip, shift_clip, d_eff_clip, cap from extra/hyperparams with defaults.\\n5) Compute margin d = clamp(lw - ll, -d_clip, d_clip).\\n6) Clamp dz: dzc = clamp(dz, -z_clip, z_clip); shift = clamp(beta * dzc, -shift_clip, shift_clip).\\n7) Effective margin: d_eff = clamp(d + shift, -d_eff_clip, d_eff_clip).\\n8) Per-example loss: per = softplus(-alpha * d_eff).\\n9) Smooth cap (optional): per = cap * 0.5 * (tanh(per / cap) + 1) if cap > 0.\\n10) Return mean(per) as scalar tensor.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"d_clip\": 30.0,\n    \"z_clip\": 20.0,\n    \"shift_clip\": 3.0,\n    \"d_eff_clip\": 30.0,\n    \"cap\": 5.0\n  },\n  \"operators_used\": [\n    \"clamp\",\n    \"softplus\",\n    \"tanh\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Robust key fallbacks for log-probabilities.\\n    lw = batch.get(\\\"log_prob_w\\\", batch.get(\\\"logp_w\\\", batch.get(\\\"chosen_logprob\\\", None)))\\n    ll = batch.get(\\\"log_prob_l\\\", batch.get(\\\"logp_l\\\", batch.get(\\\"rejected_logprob\\\", None)))\\n\\n    # If missing, return a benign scalar tensor tied to available tensors.\\n    if lw is None or ll is None:\\n        if hasattr(model_output, \\\"sum\\\"):\\n            return model_output.sum() * 0.0\\n        for k in batch.keys():\\n            v = batch.get(k, None)\\n            if hasattr(v, \\\"sum\\\"):\\n                return v.sum() * 0.0\\n        return 0.0 * 0.0\\n\\n    # Objective/cost signal: prefer delta_z; fall back to common aliases or derive from cost_a/cost_b.\\n    dz = batch.get(\\\"delta_z\\\", batch.get(\\\"cost_gap\\\", batch.get(\\\"delta_cost\\\", None)))\\n    if dz is None:\\n        ca = batch.get(\\\"cost_a\\\", None)\\n        cb = batch.get(\\\"cost_b\\\", None)\\n        if ca is not None and cb is not None:\\n            dz = ca - cb\\n        else:\\n            dz = lw * 0.0\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    d_clip = float((extra.get(\\\"d_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_clip\\\", 30.0))\\n    z_clip = float((extra.get(\\\"z_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"z_clip\\\", 20.0))\\n    shift_clip = float((extra.get(\\\"shift_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"shift_clip\\\", 3.0))\\n    d_eff_clip = float((extra.get(\\\"d_eff_clip\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"d_eff_clip\\\", 30.0))\\n    cap = float((extra.get(\\\"cap\\\") if isinstance(extra, dict) else None) or hyper.get(\\\"cap\\\", 5.0))\\n\\n    # Base preference margin.\\n    d = ops.clamp(lw - ll, -d_clip, d_clip)\\n\\n    # Bounded additive objective shift (swap-consistent when dz flips under swap).\\n    dzc = ops.clamp(dz, -z_clip, z_clip)\\n    shift = ops.clamp(beta * dzc, -shift_clip, shift_clip)\\n\\n    d_eff = ops.clamp(d + shift, -d_eff_clip, d_eff_clip)\\n\\n    # Stable logistic loss; softplus(-x) == -logsigmoid(x) up to numerical details.\\n    per = ops.softplus(-alpha * d_eff)\\n\\n    # Smoothly cap to keep within evaluator's soft range without hard clipping.\\n    # Maps per in [0, +inf) to [0, cap].\\n    if cap > 0.0:\\n        per = cap * (0.5 * (ops.tanh(per / cap) + 1.0))\\n\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry style preference optimization uses a logistic loss on the log-probability margin d=logp_w-logp_l. Incorporating an auxiliary objective delta (delta_z / cost_gap / delta_cost / cost_a-cost_b) as an additive bounded shift d_eff=d+beta*dz preserves swap-consistency when dz is defined as winner-minus-loser objective (both d and dz flip sign under swapping). Clamping dz and d is used for numerical stability; a smooth cap keeps per-example loss within a soft expected range to reduce rare outliers.\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_pref\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"uses\": [\n      \"delta_z\"\n    ]\n  }\n}"}
