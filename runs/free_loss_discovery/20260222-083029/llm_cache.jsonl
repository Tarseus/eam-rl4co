{"key": "5866db05b823a34f27149240ba0d70281cf35e8a", "ts": 1771731231.2870717, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "8b83818e932ddba907892c7c1a621e8a922e7773", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v3_nodup_fix1\",\n  \"intuition\": \"Bradley-Terry style preference loss with an additive bounded margin derived from an objective/cost gap signal. Uses only tensor-safe ops, clamps both the gap contribution and combined logit-difference to maintain numerical stability, and optionally supports per-example weights. Designed to behave like standard BT when no gap is provided.\",\n  \"pseudocode\": \"Fetch log_prob_w/log_prob_l from batch/model_output/extra. Fetch delta_z (gap) similarly; if missing use 0 tensor. Compute d=log_prob_w-log_prob_l. g=clamp(delta_z,-g_clip,g_clip). x=clamp(alpha*d + beta*g,-x_clip,x_clip). per=-logsigmoid(x). If weight present multiply. per=clamp(per,0,loss_clip). Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def get_first(keys):\\n        for k in keys:\\n            v = batch.get(k, None)\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required inputs are missing, return a stable scalar tensor derived from any available tensor.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])\\n        if ref is None:\\n            return 0.0 * 1.0\\n        return ref.sum() * 0.0\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"batch_and_model_output\",\n    \"expects\": [\n      \"batch['log_prob_w'] and batch['log_prob_l'] (or equivalents in model_output/extra)\",\n      \"optional gap signal: batch/model_output/extra['delta_z'|'cost_gap'|'objective_gap'|'gap']\",\n      \"optional weights: batch/model_output/extra['weight'|'pair_weight'|'w']\",\n      \"ops.logsigmoid and ops.clamp available\"\n    ]\n  }\n}"}
{"key": "25ac0627ee761d5b94ffb9d8ec5c77e10f664717", "ts": 1771731249.1299071, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "d2fa24a2022088ef8773ac16653da0f208849a95", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v3_nodup_fix2\",\n  \"intuition\": \"Bradley-Terry preference loss with an additive bounded margin from an optional gap/cost signal. Clamps the gap and combined logit difference for numerical stability, supports optional per-example weights, and reduces to standard BT when no gap is present.\",\n  \"pseudocode\": \"Get log_prob_w/log_prob_l; if missing return a stable zero scalar derived from any available tensor. Get optional delta_z (gap) and optional weight. Set hyperparams from extra.hyperparams. Compute d=log_prob_w-log_prob_l. If gap missing set g=0 like d*0; else g=clamp(delta_z,-g_clip,g_clip). Compute x=clamp(alpha*d + beta*g,-x_clip,x_clip). per=-logsigmoid(x). If weight present per*=weight. Clamp per to [0,loss_clip]. Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def pick(keys):\\n        for k in keys:\\n            v = batch.get(k, None) if isinstance(batch, dict) else None\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = pick([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = pick([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required inputs are missing, return a stable scalar tensor derived from any available tensor.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = pick([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\", \\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n        if ref is None:\\n            return 0.0 * 1.0\\n        return ref.sum() * 0.0\\n\\n    delta_z = pick([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = pick([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float(hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float(hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float(hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\"\n    ]\n  }\n}"}
{"key": "60b443d6bf984f9c20f34ab2b495a3b029dbcdc3", "ts": 1771731266.767006, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "c550ed273570b4a45b2057fa55bdb2fed4e7386a", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v3_nodup_fix3\",\n  \"intuition\": \"Bradley-Terry preference loss augmented with an optional bounded objective gap signal (delta_z). When delta_z is present, it shifts the logit difference by a scaled margin term; otherwise it reduces to standard BT. Includes clamping for numerical stability and optional per-example weights.\",\n  \"pseudocode\": \"Fetch log_prob_w/log_prob_l. Fetch optional delta_z and optional weight. Read hyperparams from extra.hyperparams. Compute d=log_prob_w-log_prob_l. If delta_z missing set g=0 like d*0 else g=clamp(delta_z,-g_clip,g_clip). Compute x=clamp(alpha*d + beta*g,-x_clip,x_clip). per=-logsigmoid(x). If weight present per*=weight. Clamp per to [0,loss_clip]. Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\",\n      \"weight\"\n    ],\n    \"mode\": \"pairwise_preference_with_objective_gap\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def pick(keys):\\n        for k in keys:\\n            v = batch.get(k, None) if isinstance(batch, dict) else None\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = pick([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = pick([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required inputs are missing, return a stable scalar tensor derived from any available tensor.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = pick([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\", \\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n        if ref is None:\\n            return 0.0 * 1.0\\n        return ref.sum() * 0.0\\n\\n    delta_z = pick([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = pick([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float(hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float(hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float(hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float(hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "d493ede5573eb15922e855d16b19304fed2ef048", "ts": 1771731285.9255629, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "de93d0df88a80574e3a664cd631f442fb8b39ffd", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v2_r1\",\n  \"intuition\": \"Bradley-Terry style pairwise preference loss with an additive bounded margin derived from an objective gap signal. Designed to be numerically stable via clamping of the gap, the combined logit, and the per-example loss. Avoids normalization/z-scoring and uses only tensor-safe ops.\",\n  \"pseudocode\": \"Read log_prob_w/log_prob_l from batch/model_output/extra. Read optional delta_z (gap) and optional weight. d=log_prob_w-log_prob_l. g=clamp(delta_z,-g_clip,g_clip) else 0. x=clamp(alpha*d + beta*g,-x_clip,x_clip). per=-logsigmoid(x). If weight, per*=weight. per=clamp(per,0,loss_clip). Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def _get_any(keys):\\n        for k in keys:\\n            v = batch.get(k, None)\\n            if v is not None:\\n                return v\\n            if isinstance(model_output, dict):\\n                v = model_output.get(k, None)\\n                if v is not None:\\n                    return v\\n            if isinstance(extra, dict):\\n                v = extra.get(k, None)\\n                if v is not None:\\n                    return v\\n        return None\\n\\n    log_prob_w = _get_any([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = _get_any([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required tensors are missing, return a safe scalar tensor without crashing.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = _get_any([\\\"delta_z\\\", \\\"weight\\\", \\\"pair_weight\\\"])\\n        if ref is None:\\n            return 0.0\\n        return ref.sum() * 0.0\\n\\n    delta_z = _get_any([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = _get_any([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float(((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0)))\\n    beta = float(((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25)))\\n    g_clip = float(((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0)))\\n    x_clip = float(((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0)))\\n    loss_clip = float(((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\"\n    ]\n  }\n}"}
