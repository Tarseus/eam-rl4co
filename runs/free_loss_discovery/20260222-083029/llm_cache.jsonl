d_logp\\\", \\\"logprob_l\\\"])\\n\\n    # Required inputs; if missing, return a safe zero scalar to avoid forward crashes.\\n    if log_prob_w is None or log_prob_l is None:\\n        # Create a scalar tensor from any available tensor, else fall back to 0.0.\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])  # best-effort reference\\n        if ref is None:\\n            return (0.0 * 1.0)\\n        return (ref.sum() * 0.0)\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "df9de655d98accb399a697494d1bf9d434e983f6", "ts": 1771731019.5052526, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "37acbe165159d1b00f48d816e47fc20635e79b55", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v2b\",\n  \"intuition\": \"Simplified Bradley-Terry pairwise preference loss with an optional bounded additive margin derived from an objective/cost gap. Uses only tensor-safe ops; clamps the gap contribution, the combined logit, and the per-example loss to keep gradients well-behaved and avoid numeric overflow. If the gap is absent, it cleanly reduces to standard BT on log-prob differences.\",\n  \"pseudocode\": \"Read log_prob_w/log_prob_l from batch/model_output/extra (common aliases). Optionally read delta_z (objective/cost gap) and weight. d = log_prob_w - log_prob_l. g = clamp(delta_z, -g_clip, g_clip) else 0. x = clamp(alpha*d + beta*g, -x_clip, x_clip). per = -logsigmoid(x). If weight exists, per *= weight. per = clamp(per, 0, loss_clip). Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def get_first(keys):\\n        for k in keys:\\n            v = batch.get(k, None) if isinstance(batch, dict) else None\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required inputs are missing, return a safe scalar tensor without crashing.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])  # best-effort tensor reference\\n        if ref is None:\\n            return (0.0 * 1.0)\\n        return (ref.sum() * 0.0)\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise likelihood: minimizing -log(sigmoid(d)) encourages higher log-probability for the preferred (winner) sample over the rejected (loser) sample. Adding a bounded gap term acts as a calibrated margin shift based on an external objective/cost difference while clamping maintains numerical stability.\",\n  \"implementation_hint\": {\n    \"expects\": {\n      \"batch\": [\n        \"log_prob_w/logp_w/chosen_logp\",\n        \"log_prob_l/logp_l/rejected_logp\",\n        \"optional: delta_z/cost_gap/objective_gap/gap\",\n        \"optional: weight/pair_weight\"\n      ],\n      \"model_output\": [\n        \"log_prob_w/logp_w/chosen_logp\",\n        \"log_prob_l/logp_l/rejected_logp\"\n      ],\n      \"extra\": [\n        \"optional: hyperparams dict with alpha,beta,g_clip,x_clip,loss_clip\",\n        \"optional: alpha,beta,g_clip,x_clip,loss_clip (top-level)\"\n      ]\n    },\n    \"mode\": \"pairwise_ranking\"\n  }\n}"}
