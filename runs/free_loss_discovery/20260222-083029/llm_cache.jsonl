w is None:\\n            log_prob_w = model_output.get(\\\"log_prob_w\\\", model_output.get(\\\"chosen_logprob\\\", model_output.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = model_output.get(\\\"log_prob_l\\\", model_output.get(\\\"rejected_logprob\\\", model_output.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = model_output.get(\\\"delta_z\\\", model_output.get(\\\"reward_diff\\\", model_output.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = model_output.get(\\\"weight\\\", model_output.get(\\\"weights\\\", None))\\n\\n    if extra is not None:\\n        if log_prob_w is None:\\n            log_prob_w = extra.get(\\\"log_prob_w\\\", extra.get(\\\"chosen_logprob\\\", extra.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = extra.get(\\\"log_prob_l\\\", extra.get(\\\"rejected_logprob\\\", extra.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = extra.get(\\\"delta_z\\\", extra.get(\\\"reward_diff\\\", extra.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = extra.get(\\\"weight\\\", extra.get(\\\"weights\\\", None))\\n\\n    # If required signals are missing, return a safe zero scalar.\\n    if log_prob_w is None or log_prob_l is None or delta_z is None:\\n        base = None\\n        if log_prob_w is not None:\\n            base = log_prob_w\\n        elif log_prob_l is not None:\\n            base = log_prob_l\\n        elif delta_z is not None:\\n            base = delta_z\\n        else:\\n            base = ops.zeros(())\\n        return (base * 0.0).mean()\\n\\n    hp = (extra or {}).get(\\\"hyperparams\\\", {}) if extra is not None else {}\\n    alpha = float((extra or {}).get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    t0 = float((extra or {}).get(\\\"t0\\\", hp.get(\\\"t0\\\", 0.0)))\\n    k = float((extra or {}).get(\\\"k\\\", hp.get(\\\"k\\\", 1.0)))\\n    clamp_c = float((extra or {}).get(\\\"clamp_c\\\", hp.get(\\\"clamp_c\\\", 3.0)))\\n    eps = float((extra or {}).get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-4)))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.clamp(ops.zscore(delta_z), -clamp_c, clamp_c)\\n    temp = ops.softplus(t0 + k * g) + eps\\n\\n    per_pair = -ops.logsigmoid(alpha * d / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "0b8b84eaca36a60f2e5b9f63c232e8f4e459f85d", "ts": 1771720380.310486, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "c1aef1345a57f787d48bdcd45997163415d5dec9", "content": "{\n  \"name\": \"clamped_gap_temp_bt_v3_sensitive\",\n  \"intuition\": \"Make the loss explicitly sensitive to the objective gap by adding a small, bounded margin term to the Bradley-Terry logit. Keep normalization/clamping for stability; keep everything batch/model_output first. This avoids near-invariance that can happen when delta_z only modulates a temperature.\",\n  \"pseudocode\": \"d = log_prob_w - log_prob_l. g = clamp(zscore(delta_z), -c, c). margin = m_scale * g. temp = softplus(t0) + eps. loss = mean( -logsigmoid((alpha*d + margin)/temp) * weight ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"t0\": 0.0,\n    \"eps\": 0.0001,\n    \"clamp_c\": 3.0,\n    \"m_scale\": 0.25\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"softplus\",\n    \"zscore\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = None\\n    log_prob_l = None\\n    delta_z = None\\n    weight = None\\n\\n    if batch is not None:\\n        log_prob_w = batch.get(\\\"log_prob_w\\\", batch.get(\\\"chosen_logprob\\\", batch.get(\\\"logp_chosen\\\", None)))\\n        log_prob_l = batch.get(\\\"log_prob_l\\\", batch.get(\\\"rejected_logprob\\\", batch.get(\\\"logp_rejected\\\", None)))\\n        delta_z = batch.get(\\\"delta_z\\\", batch.get(\\\"reward_diff\\\", batch.get(\\\"score_diff\\\", None)))\\n        weight = batch.get(\\\"weight\\\", batch.get(\\\"weights\\\", None))\\n\\n    if (log_prob_w is None or log_prob_l is None or delta_z is None) and model_output is not None:\\n        if log_prob_w is None:\\n            log_prob_w = model_output.get(\\\"log_prob_w\\\", model_output.get(\\\"chosen_logprob\\\", model_output.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = model_output.get(\\\"log_prob_l\\\", model_output.get(\\\"rejected_logprob\\\", model_output.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = model_output.get(\\\"delta_z\\\", model_output.get(\\\"reward_diff\\\", model_output.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = model_output.get(\\\"weight\\\", model_output.get(\\\"weights\\\", None))\\n\\n    if extra is not None:\\n        if log_prob_w is None:\\n            log_prob_w = extra.get(\\\"log_prob_w\\\", extra.get(\\\"chosen_logprob\\\", extra.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = extra.get(\\\"log_prob_l\\\", extra.get(\\\"rejected_logprob\\\", extra.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = extra.get(\\\"delta_z\\\", extra.get(\\\"reward_diff\\\", extra.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = extra.get(\\\"weight\\\", extra.get(\\\"weights\\\", None))\\n\\n    if log_prob_w is None or log_prob_l is None or delta_z is None:\\n        base = None\\n        if log_prob_w is not None:\\n            base = log_prob_w\\n        elif log_prob_l is not None:\\n            base = log_prob_l\\n        elif delta_z is not None:\\n            base = delta_z\\n        else:\\n            base = ops.zeros(())\\n        return (base * 0.0).mean()\\n\\n    hp = (extra or {}).get(\\\"hyperparams\\\", {}) if extra is not None else {}\\n    alpha = float((extra or {}).get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    t0 = float((extra or {}).get(\\\"t0\\\", hp.get(\\\"t0\\\", 0.0)))\\n    eps = float((extra or {}).get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-4)))\\n    clamp_c = float((extra or {}).get(\\\"clamp_c\\\", hp.get(\\\"clamp_c\\\", 3.0)))\\n    m_scale = float((extra or {}).get(\\\"m_scale\\\", hp.get(\\\"m_scale\\\", 0.25)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Normalized, bounded objective gap to keep gradients stable.\\n    g = ops.clamp(ops.zscore(delta_z), -clamp_c, clamp_c)\\n\\n    # Explicit objective sensitivity via a bounded margin shift.\\n    margin = m_scale * g\\n\\n    # Keep temperature fixed (positive) to avoid washing out objective sensitivity.\\n    temp = ops.softplus(t0) + eps\\n\\n    per_pair = -ops.logsigmoid((alpha * d + margin) / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise loss on logit difference. Objective gap enters as an additive margin (after z-score + clamp) to guarantee measurable sensitivity while remaining numerically stable. Temperature is kept positive via softplus.\"\n}"}
