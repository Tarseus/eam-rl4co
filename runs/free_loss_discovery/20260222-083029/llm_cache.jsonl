{"key": "4216ddf35dfc4902446001d44b675d58e018c004", "ts": 1771720243.1999123, "model": "gpt-5.2", "llm_op": "E1_GENERATE", "prompt_path": "PTP/prompts/free_loss_generation.txt", "prompt_sha1": "0e3f3d9d056caa560c52640b6b28bba2690a8724", "content": "{\n  \"name\": \"clamped_gap_temp_bt\",\n  \"intuition\": \"Bradley-Terry pairwise loss with a temperature adapted to normalized objective gap, so large-quality differences get emphasized while extreme gaps are clamped for stability.\",\n  \"pseudocode\": \"Let d = log_prob_w - log_prob_l, g = clamp(zscore(delta_z), -c, c). Define temp = softplus(t0 + k * g) + eps. Loss = mean( -logsigmoid( alpha * d / temp ) * weight ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"t0\": 0.0,\n    \"k\": 1.0,\n    \"clamp_c\": 3.0,\n    \"eps\": 1e-4\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"softplus\",\n    \"zscore\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\",\n      \"weight\"\n    ],\n    \"returns\": \"scalar\",\n    \"mode\": \"pairwise\"\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = extra[\\\"log_prob_w\\\"]\\n    log_prob_l = extra[\\\"log_prob_l\\\"]\\n    delta_z = extra[\\\"delta_z\\\"]\\n    weight = extra.get(\\\"weight\\\", None)\\n\\n    alpha = float(extra.get(\\\"alpha\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"alpha\\\", 1.0)))\\n    t0 = float(extra.get(\\\"t0\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"t0\\\", 0.0)))\\n    k = float(extra.get(\\\"k\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"k\\\", 1.0)))\\n    clamp_c = float(extra.get(\\\"clamp_c\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"clamp_c\\\", 3.0)))\\n    eps = float(extra.get(\\\"eps\\\", extra.get(\\\"hyperparams\\\", {}).get(\\\"eps\\\", 1e-4)))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.clamp(ops.zscore(delta_z), -clamp_c, clamp_c)\\n    temp = ops.softplus(t0 + k * g) + eps\\n\\n    per_pair = -ops.logsigmoid(alpha * d / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\\n\"\n}"}
