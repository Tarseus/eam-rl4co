  if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])\\n        if ref is None:\\n            return (0.0 * 1.0)\\n        return ref.sum() * 0.0\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\"\n    ]\n  }\n}"}
{"key": "4b1f1664c2adabd4dabfae84774f522242597400", "ts": 1771731415.7098296, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "7f5f880fd4d12d107a12881bbee7a9cc216554d1", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v4_dedup\",\n  \"intuition\": \"Bradley-Terry style pairwise preference loss with an optional bounded objective-gap margin term. Uses only tensor-safe ops, clamps the gap and combined score for stability, and supports optional per-example weights while avoiding any dataset-wide statistics or global state.\",\n  \"pseudocode\": \"Fetch log_prob_w and log_prob_l from batch/model_output/extra. Optionally fetch delta_z (objective gap) and weight. Compute d = log_prob_w - log_prob_l. If delta_z present, clamp g = clamp(delta_z, -g_clip, g_clip) else g = 0. Form x = clamp(alpha*d + beta*g, -x_clip, x_clip). Compute per_example = softplus(-x). If weight present, multiply per_example by weight. Clamp per_example to [0, loss_clip] and return mean.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"softplus\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def _get_first(keys):\\n        for k in keys:\\n            v = batch.get(k, None) if isinstance(batch, dict) else None\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = _get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = _get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # Best-effort safe scalar if required inputs are missing.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = _get_first([\\\"delta_z\\\", \\\"weight\\\", \\\"pair_weight\\\"])\\n        if ref is None:\\n            return 0.0 * 1.0\\n        return ref.sum() * 0.0\\n\\n    delta_z = _get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = _get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n\\n    # softplus(-x) == -logsigmoid(x), but avoids relying on logsigmoid being available.\\n    per = ops.softplus(-x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Pairwise Bradley-Terry / logistic preference modeling: minimizing softplus(-(log p_w - log p_l)) encourages the winner to have higher log-probability than the loser. An additive, clipped objective-gap t