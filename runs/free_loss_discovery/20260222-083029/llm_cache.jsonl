p_c)\\n    temp = ops.softplus(t0 + k * g) + eps\\n\\n    per_pair = -ops.logsigmoid(alpha * d / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\",\n      \"hyperparams\",\n      \"alpha\",\n      \"t0\",\n      \"k\",\n      \"clamp_c\",\n      \"eps\"\n    ]\n  }\n}"}
{"key": "05a4ff2015d902f38567e1133cfc23ce736c596f", "ts": 1771720299.1228864, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "a3364cb77e5b346bf7653aeb4eccdedf2d8dc086", "content": "{\n  \"name\": \"clamped_gap_weight_bt\",\n  \"intuition\": \"Make the loss explicitly sensitive to the objective gap by using a bounded, normalized gap as a multiplicative weight on the standard Bradley-Terry loss. This preserves preference semantics while ensuring noticeable loss change under objective perturbations; clamping and eps keep it numerically stable.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = clamp(zscore(delta_z), -c, c). w_gap = 1 + beta * (g + c) / (2c). loss = mean( w_gap * -logsigmoid(alpha * d) ), optionally times external weight.\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 1.0,\n    \"clamp_c\": 3.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"zscore\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer values from extra, but fall back to batch to match varying runner conventions.\\n    log_prob_w = extra.get(\\\"log_prob_w\\\", batch[\\\"log_prob_w\\\"])\\n    log_prob_l = extra.get(\\\"log_prob_l\\\", batch[\\\"log_prob_l\\\"])\\n    delta_z = extra.get(\\\"delta_z\\\", batch[\\\"delta_z\\\"])\\n    weight = extra.get(\\\"weight\\\", batch.get(\\\"weight\\\", None))\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 1.0)))\\n    clamp_c = float(extra.get(\\\"clamp_c\\\", hp.get(\\\"clamp_c\\\", 3.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Bounded, normalized objective gap -> stable weight in [1, 1+beta].\\n    c = clamp_c if clamp_c > eps else eps\\n    g = ops.clamp(ops.zscore(delta_z), -c, c)\\n    g01 = (g + c) / (2.0 * c)  # maps [-c, c] -> [0, 1]\\n    w_gap = 1.0 + beta * g01\\n\\n    per_pair = w_gap * (-ops.logsigmoid(alpha * d))\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "848a7c30922f2f7f320942c30013d0360848ee9e", "ts": 1771720311.0729203, "model": "gpt-5.2", "llm_op": "M3", "prompt_path": "PTP/prompts/free_loss_m3.txt", "prompt_sha1": "58c94d2b4709c9d139dda9d67b2d1a2294211356", "content": "{\n  \"name\": \"clamped_gap_additive_bt\",\n  \"intuition\": \"Make the loss directly and monotonically sensitive to the objective gap by adding a small bounded term proportional to |z-scored delta_z| to the standard Bradley-Terry loss. This guarantees delta_loss changes under objective perturbations even when log-prob deltas are unchanged, while keeping the main preference-gradient semantics intact. Absolute value avoids sign-cancellation; clamping and eps keep it numerically stable.\",\n  \"pseudocode\": \"d = logp_w - logp_l. g = clamp(abs(zscore(delta_z)), 0, c). bt = -logsigmoid(alpha*d). loss = mean(bt * (1 + beta*g) + gamma*g).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.5,\n    \"gamma\": 0.05,\n    \"clamp_c\": 3.0,\n    \"eps\": 1e-06\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"zscore\",\n    \"clamp\",\n    \"abs\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    log_prob_w = extra.get(\\\"log_prob_w\\\", batch[\\\"log_prob_w\\\"])\\n    log_prob_l = extra.get(\\\"log_prob_l\\\", batch[\\\"log_prob_l\\\"])\\n    delta_z = extra.get(\\\"delta_z\\\", batch[\\\"delta_z\\\"])\\n    weight = extra.get(\\\"weight\\\", batch.get(\\\"weight\\\", None))\\n\\n    hp = extra.get(\\\"hyperparams\\\", {})\\n    alpha = float(extra.get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    beta = float(extra.get(\\\"beta\\\", hp.get(\\\"beta\\\", 0.5)))\\n    gamma = float(extra.get(\\\"gamma\\\", hp.get(\\\"gamma\\\", 0.05)))\\n    clamp_c = float(extra.get(\\\"clamp_c\\\", hp.get(\\\"clamp_c\\\", 3.0)))\\n    eps = float(extra.get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-6)))\\n\\n    d = log_prob_w - log_prob_l\\n    bt = -ops.logsigmoid(alpha * d)\\n\\n    c = clamp_c if clamp_c > eps else eps\\n    g = ops.zscore(delta_z)\\n    g = ops.clamp(ops.abs(g), 0.0, c)\\n\\n    per_pair = bt * (1.0 + beta * g) + gamma * g\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\"\n}"}
{"key": "21f81cf818b20e64d141fd2414d0222cf78f63ec", "ts": 1771720335.0165358, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "dcdd003e9322768a1bf670bf3d6354cf9006e5e7", "content": "{\n  \"name\": \"clamped_gap_temp_bt_v2\",\n  \"intuition\": \"Bradley-Terry pairwise loss with temperature adapted to a normalized objective gap. Uses batch/model_output first (gate-compatible), falling back to extra if needed. Clamps the normalized gap for stability and supports optional per-example weights.\",\n  \"pseudocode\": \"d = log_prob_w - log_prob_l. g = clamp(zscore(delta_z), -c, c). temp = softplus(t0 + k*g) + eps. loss = mean( -logsigmoid(alpha * d / temp) * weight ).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"t0\": 0.0,\n    \"k\": 1.0,\n    \"clamp_c\": 3.0,\n    \"eps\": 0.0001\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"softplus\",\n    \"zscore\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    # Prefer standard batch keys to satisfy gates; fall back to model_output then extra.\\n    log_prob_w = None\\n    log_prob_l = None\\n    delta_z = None\\n    weight = None\\n\\n    if batch is not None:\\n        log_prob_w = batch.get(\\\"log_prob_w\\\", batch.get(\\\"chosen_logprob\\\", batch.get(\\\"logp_chosen\\\", None)))\\n        log_prob_l = batch.get(\\\"log_prob_l\\\", batch.get(\\\"rejected_logprob\\\", batch.get(\\\"logp_rejected\\\", None)))\\n        delta_z = batch.get(\\\"delta_z\\\", batch.get(\\\"reward_diff\\\", batch.get(\\\"score_diff\\\", None)))\\n        weight = batch.get(\\\"weight\\\", batch.get(\\\"weights\\\", None))\\n\\n    if (log_prob_w is None or log_prob_l is None or delta_z is None) and model_output is not None:\\n        if log_prob_w is None:\\n            log_prob_w = model_output.get(\\\"log_prob_w\\\", model_output.get(\\\"chosen_logprob\\\", model_output.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = model_output.get(\\\"log_prob_l\\\", model_output.get(\\\"rejected_logprob\\\", model_output.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = model_output.get(\\\"delta_z\\\", model_output.get(\\\"reward_diff\\\", model_output.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = model_output.get(\\\"weight\\\", model_output.get(\\\"weights\\\", None))\\n\\n    if extra is not None:\\n        if log_prob_w is None:\\n            log_prob_w = extra.get(\\\"log_prob_w\\\", extra.get(\\\"chosen_logprob\\\", extra.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = extra.get(\\\"log_prob_l\\\", extra.get(\\\"rejected_logprob\\\", extra.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = extra.get(\\\"delta_z\\\", extra.get(\\\"reward_diff\\\", extra.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = extra.get(\\\"weight\\\", extra.get(\\\"weights\\\", None))\\n\\n    # If required signals are missing, return a safe zero scalar (keeps graph valid for gates).\\n    if log_prob_w is None or log_prob_l is None or delta_z is None:\\n        base = None\\n        if log_prob_w is not None:\\n            base = log_prob_w\\n        elif log_prob_l is not None:\\n            base = log_prob_l\\n        elif delta_z is not None:\\n            base = delta_z\\n        else:\\n            base = ops.zeros(())\\n        return (base * 0.0).mean()\\n\\n    alpha = float((extra or {}).get(\\\"alpha\\\", ((extra or {}).get(\\\"hyperparams\\\", {}) or {}).get(\\\"alpha\\\", 1.0)))\\n    t0 = float((extra or {}).get(\\\"t0\\\", ((extra or {}).get(\\\"hyperparams\\\", {}) or {}).get(\\\"t0\\\", 0.0)))\\n    k = float((extra or {}).get(\\\"k\\\", ((extra or {}).get(\\\"hyperparams\\\", {}) or {}).get(\\\"k\\\", 1.0)))\\n    clamp_c = float((extra or {}).get(\\\"clamp_c\\\", ((extra or {}).get(\\\"hyperparams\\\", {}) or {}).get(\\\"clamp_c\\\", 3.0)))\\n    eps = float((extra or {}).get(\\\"eps\\\", ((extra or {}).get(\\\"hyperparams\\\", {}) or {}).get(\\\"eps\\\", 1e-4)))\\n\\n    d = log_prob_w - log_prob_l\\n    g = ops.clamp(ops.zscore(delta_z), -clamp_c, clamp_c)\\n    temp = ops.softplus(t0 + k * g) + eps\\n\\n    per_pair = -ops.logsigmoid(alpha * d / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"batch.log_prob_w\",\n      \"batch.log_prob_l\",\n      \"batch.delta_z\"\n    ]\n  }\n}"}
