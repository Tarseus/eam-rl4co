     if log_prob_l is None:\\n            log_prob_l = model_output.get(\\\"log_prob_l\\\", model_output.get(\\\"rejected_logprob\\\", model_output.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = model_output.get(\\\"delta_z\\\", model_output.get(\\\"reward_diff\\\", model_output.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = model_output.get(\\\"weight\\\", model_output.get(\\\"weights\\\", None))\\n\\n    if extra is not None:\\n        if log_prob_w is None:\\n            log_prob_w = extra.get(\\\"log_prob_w\\\", extra.get(\\\"chosen_logprob\\\", extra.get(\\\"logp_chosen\\\", None)))\\n        if log_prob_l is None:\\n            log_prob_l = extra.get(\\\"log_prob_l\\\", extra.get(\\\"rejected_logprob\\\", extra.get(\\\"logp_rejected\\\", None)))\\n        if delta_z is None:\\n            delta_z = extra.get(\\\"delta_z\\\", extra.get(\\\"reward_diff\\\", extra.get(\\\"score_diff\\\", None)))\\n        if weight is None:\\n            weight = extra.get(\\\"weight\\\", extra.get(\\\"weights\\\", None))\\n\\n    if log_prob_w is None or log_prob_l is None or delta_z is None:\\n        base = None\\n        if log_prob_w is not None:\\n            base = log_prob_w\\n        elif log_prob_l is not None:\\n            base = log_prob_l\\n        elif delta_z is not None:\\n            base = delta_z\\n        else:\\n            base = ops.zeros(())\\n        return (base * 0.0).mean()\\n\\n    hp = (extra or {}).get(\\\"hyperparams\\\", {}) if extra is not None else {}\\n    alpha = float((extra or {}).get(\\\"alpha\\\", hp.get(\\\"alpha\\\", 1.0)))\\n    t0 = float((extra or {}).get(\\\"t0\\\", hp.get(\\\"t0\\\", 0.0)))\\n    eps = float((extra or {}).get(\\\"eps\\\", hp.get(\\\"eps\\\", 1e-4)))\\n    clamp_c = float((extra or {}).get(\\\"clamp_c\\\", hp.get(\\\"clamp_c\\\", 3.0)))\\n    m_scale = float((extra or {}).get(\\\"m_scale\\\", hp.get(\\\"m_scale\\\", 0.25)))\\n    logit_clamp = float((extra or {}).get(\\\"logit_clamp\\\", hp.get(\\\"logit_clamp\\\", 30.0)))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # Normalized, bounded objective gap to keep gradients stable.\\n    g = ops.clamp(ops.zscore(delta_z), -clamp_c, clamp_c)\\n    margin = m_scale * g\\n\\n    # ops.softplus expects a Tensor; tie dtype/device to d for safety.\\n    t0_t = d * 0.0 + t0\\n    temp = ops.softplus(t0_t) + eps\\n\\n    logits = (alpha * d + margin) / temp\\n    logits = ops.clamp(logits, -logit_clamp, logit_clamp)\\n\\n    per_pair = -ops.logsigmoid(logits)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise loss on log-prob difference. Objective gap enters as an additive bounded margin (z-score + clamp) to preserve preference semantics while remaining numerically stable. Temperature is positive via softplus on a Tensor.\"\n}"}
