return v\\n        return None\\n\\n    log_prob_w = get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # If required inputs are missing, return a safe scalar tensor without crashing.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])  # best-effort tensor reference\\n        if ref is None:\\n            return (0.0 * 1.0)\\n        return (ref.sum() * 0.0)\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise likelihood: minimizing -log(sigmoid(d)) encourages higher log-probability for the preferred (winner) sample over the rejected (loser) sample. Adding a bounded gap term acts as a calibrated margin shift based on an external objective/cost difference while clamping maintains numerical stability.\"\n}"}
{"key": "eedeac4bf87bc48916e648cf8be324924f6fcab6", "ts": 1771731061.6940346, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "30eb3c8490bf748d24a31e3437bd67edc95f331c", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v2b_fix_expects_repair1\",\n  \"intuition\": \"Bradley-Terry pairwise preference loss with an optional bounded additive margin derived from an objective/cost gap signal (e.g., delta_z). When the objective signal is absent, it reduces to standard BT on log-prob differences. Uses only tensor-safe ops with clamping for numerical stability.\",\n  \"pseudocode\": \"Fetch log_prob_w/log_prob_l. Fetch objective signal delta_z if present. d = log_prob_w - log_prob_l. g = clamp(delta_z, -g_clip, g_clip) else 0. x = clamp(alpha*d + beta*g, -x_clip, x_clip). per = -logsigmoid(x). If weight exists, per *= weight. per = clamp(per, 0, loss_clip). Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\",\n      \"delta_z\"\n    ],\n    \"optional\": [\n      \"weight\"\n    ]\n  },\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def get_first(keys):\\n        # Search batch -> model_output -> extra for the first present key.\\n        for k in keys:\\n            if isinstance(batch, dict) and k in batch and batch[k] is not None:\\n                return batch[k]\\n            if isinstance(model_output, dict) and k in model_output and model_output[k] is not None:\\n                return model_output[k]\\n            if isinstance(extra, dict) and k in extra and extra[k] is not None:\\n                return extra[k]\\n        return None\\n\\n    log_prob_w = get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # Objective signal (required by hint schema, but handled safely if missing).\\n    delta_z = get_first([\\\"delta_z\\\", \\\"delta_regret\\\", \\\"delta_rank\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    # Hyperparams from extra/hyperparams (Python floats are ok; no imports).\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    # If required inputs are missing, return a safe scalar tensor without crashing.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = delta_z if delta_z is not None else weight\\n        if ref is None:\\n            return 0.0 * 1.0\\n        return ref.sum() * 0.0\\n\\n    d = log_prob_w - log_prob_l\\n\\n    # If delta_z is missing, treat it as zero margin.\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"Bradley-Terry / logistic pairwise likelihood: minimizing -log(sigmoid(d)) encourages higher log-probability for the preferred sample over the rejected sample. An additional bounded objective-gap term (delta_z) shifts the decision boundary like a soft, calibrated margin; clamping keeps gradients and numerics stable.\"\n}"}
{"key": "141aeae0d3475bf0ce83759bf968917bb611f28e", "ts": 1771731087.9936328, "model": "gpt-5.2", "llm_op": "REPAIR", "prompt_path": "PTP/prompts/free_loss_repair.txt", "prompt_sha1": "3e5d276f8163750c0c8c9f5d74a9414ec3b56082", "content": "{\n  \"name\": \"m3_stable_bt_gap_margin_v2_fixdup\",\n  \"intuition\": \"Simplified Bradley-Terry pairwise loss with a bounded additive margin from an objective/cost gap. Uses only tensor-safe ops, clamps the combined logit and per-example loss for numerical stability, and keeps objective sensitivity explicit without normalization.\",\n  \"pseudocode\": \"Get log_prob_w/log_prob_l from batch/model_output/extra; if missing, return a zero scalar tensor (no crash). Get optional delta_z (objective gap) and optional weight. Compute d=log_prob_w-log_prob_l. If delta_z missing, set g=0 like d*0; else g=clamp(delta_z,-g_clip,g_clip). Compute x=clamp(alpha*d + beta*g,-x_clip,x_clip). per=-logsigmoid(x). If weight present, per*=weight. Clamp per to [0,loss_clip]. Return mean(per).\",\n  \"hyperparams\": {\n    \"alpha\": 1.0,\n    \"beta\": 0.25,\n    \"g_clip\": 5.0,\n    \"x_clip\": 10.0,\n    \"loss_clip\": 5.0\n  },\n  \"operators_used\": [\n    \"logsigmoid\",\n    \"clamp\"\n  ],\n  \"code\": \"def generated_loss(batch, model_output, extra):\\n    def get_first(keys):\\n        for k in keys:\\n            v = batch.get(k, None)\\n            if v is not None:\\n                return v\\n            v = model_output.get(k, None) if isinstance(model_output, dict) else None\\n            if v is not None:\\n                return v\\n            v = extra.get(k, None) if isinstance(extra, dict) else None\\n            if v is not None:\\n                return v\\n        return None\\n\\n    log_prob_w = get_first([\\\"log_prob_w\\\", \\\"logp_w\\\", \\\"chosen_logp\\\", \\\"logprob_w\\\"])\\n    log_prob_l = get_first([\\\"log_prob_l\\\", \\\"logp_l\\\", \\\"rejected_logp\\\", \\\"logprob_l\\\"])\\n\\n    # Required inputs; if missing, return a safe zero scalar tensor to avoid forward crashes.\\n    if log_prob_w is None or log_prob_l is None:\\n        ref = log_prob_w if log_prob_w is not None else log_prob_l\\n        if ref is None:\\n            ref = get_first([\\\"delta_z\\\", \\\"weight\\\"])  # best-effort reference\\n        if ref is None:\\n            return (0.0 * 1.0)\\n        return (ref.sum() * 0.0)\\n\\n    delta_z = get_first([\\\"delta_z\\\", \\\"cost_gap\\\", \\\"objective_gap\\\", \\\"gap\\\"])\\n    weight = get_first([\\\"weight\\\", \\\"pair_weight\\\", \\\"w\\\"])\\n\\n    hyper = extra.get(\\\"hyperparams\\\", {}) if isinstance(extra, dict) else {}\\n    alpha = float((extra.get(\\\"alpha\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"alpha\\\", 1.0))\\n    beta = float((extra.get(\\\"beta\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"beta\\\", 0.25))\\n    g_clip = float((extra.get(\\\"g_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"g_clip\\\", 5.0))\\n    x_clip = float((extra.get(\\\"x_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"x_clip\\\", 10.0))\\n    loss_clip = float((extra.get(\\\"loss_clip\\\", None) if isinstance(extra, dict) else None) or hyper.get(\\\"loss_clip\\\", 5.0))\\n\\n    d = log_prob_w - log_prob_l\\n\\n    if delta_z is None:\\n        g = d * 0.0\\n    else:\\n        g = ops.clamp(delta_z, -g_clip, g_clip)\\n\\n    x = ops.clamp(alpha * d + beta * g, -x_clip, x_clip)\\n    per = -ops.logsigmoid(x)\\n\\n    if weight is not None:\\n        per = per * weight\\n\\n    per = ops.clamp(per, 0.0, loss_clip)\\n    return per.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"log_prob_w\",\n      \"log_prob_l\"\n    ],\n    \"optional\": [\n      \"delta_z\",\n      \"weight\"\n    ]\n  }\n}"}
