p_c)\\n    temp = ops.softplus(t0 + k * g) + eps\\n\\n    per_pair = -ops.logsigmoid(alpha * d / temp)\\n    if weight is not None:\\n        per_pair = per_pair * weight\\n\\n    return per_pair.mean()\",\n  \"theoretical_basis\": \"\",\n  \"implementation_hint\": {\n    \"mode\": \"pairwise\",\n    \"expects\": [\n      \"batch['log_prob_w'] or extra['log_prob_w']\",\n      \"batch['log_prob_l'] or extra['log_prob_l']\",\n      \"batch['delta_z'] or extra['delta_z']\",\n      \"optional: batch['weight'] or extra['weight']\"\n    ]\n  }\n}"}
