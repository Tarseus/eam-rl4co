  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f006_005_d805ac13",
    "ir": {
      "name": "loss_margin_rank_blend_tanh_max_advantage_weight_norm",
      "intuition": "Inject weight normalization to ensure scale-invariance by normalizing pair weights across the batch, preventing dominance from large weights and stabilizing training dynamics. This enforces an explicit normalization constraint on the weighting factor derived from advantage and pairwise instance weight.",
      "pseudocode": "lpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nadv_w = batch['advantage_w']\nadv_l = batch['advantage_l']\nweight = batch.get('weight', ones_like(lpw))\nalpha = ...\nadv_max = maximum(adv_w, adv_l)\nmargin = alpha * (lpw - lpl)\nsmooth_margin = tanh(clamp(margin, -10, 10))\nhinge = relu(1 - smooth_margin)\nraw_loss = hinge * abs(adv_max) * weight\nnorm_factor = mean(weight)\nnorm_loss = raw_loss / norm_factor\nfinal_loss = mean(norm_loss)",
      "hyperparams": {
        "paradigm_family": "pairwise_margin_advantage_blend",
        "signal_family": "advantage_combined_max",
        "link_family": "tanh_relu",
        "agg_family": "mean",
        "constraint_family": "weight_normalization"
      },
      "operators_used": [
        "maximum",
        "sub",
        "mul",
        "clamp",
        "tanh",
        "abs",
        "relu",
        "ones_like",
        "mean",
        "div"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_w",
          "advantage_l",
          "advantage_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    adv_max = ops.maximum(adv_w, adv_l)\n    margin = ops.sub(lpw, lpl)\n    scaled_margin = ops.mul(alpha, margin)\n    clamped_margin = ops.clamp(scaled_margin, -10.0, 10.0)\n    smooth_margin = ops.tanh(clamped_margin)\n    hinge = ops.relu(ops.sub(ops.ones_like(smooth_margin), smooth_margin))\n    raw_loss = ops.mul(ops.mul(ops.abs(adv_max), hinge), weight)\n    norm_factor = ops.mean(weight)\n    # avoid division by zero\n    norm_factor = ops.maximum(norm_factor, 1e-8)\n    norm_loss = ops.div(raw_loss, norm_factor)\n    return ops.mean(norm_loss)",
      "theoretical_basis": ""
    }
  },
