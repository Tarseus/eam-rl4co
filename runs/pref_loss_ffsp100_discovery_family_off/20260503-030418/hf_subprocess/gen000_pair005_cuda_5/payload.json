      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f000_009_17d5ddb9",
    "ir": {
      "name": "loss_logsigmoid_001_cost_sum_clamped_gap",
      "intuition": "Fixed affine invariance violation by ensuring the loss depends only on the relative difference between log probabilities and a properly clamped cost gap term. Added stable clamp to the cost gap adjustment and carefully scaled it to prevent large delta under perturbations, improving stability. Kept sum aggregation consistent with original design.",
      "pseudocode": "gap = clamp(cost_b - cost_a, -1, 1)\nx = alpha * scale * (log_prob_w - log_prob_l) - 0.1 * gap\nloss = sum(-logsigmoid(clamp(x, -20, 20)) * weight)",
      "hyperparams": {
        "scale": 1.9496803035382082,
        "paradigm_family": "pairwise_margin",
        "signal_family": "cost_gap",
        "link_family": "logsigmoid",
        "agg_family": "sum",
        "constraint_family": "clamp_stabilized"
      },
      "operators_used": [
        "logsigmoid",
        "clamp",
        "mul",
        "sum",
        "sub"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "cost_a",
          "cost_b"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap_raw = cost_b - cost_a\n    gap = ops.clamp(gap_raw, -1.0, 1.0)\n    x = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), ops.mul(0.1, gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = ops.neg(ops.logsigmoid(x))\n    if weight is not None:\n        loss = ops.mul(loss, weight)\n    return ops.sum(loss)",
      "theoretical_basis": ""
    }
  },
