    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    regret = batch['delta_regret']\n    adv_gap = adv_w - adv_l\n    gap_norm = ops.normalize(adv_gap)\n    safe_regret = ops.abs(regret) + 1e-6\n    scaled_diff = (lpw - lpl) / safe_regret\n    diff_squared = ops.pow(ops.sub(scaled_diff, gap_norm), 2)\n    penalty = ops.tanh(diff_squared)\n    loss = ops.mean(penalty * weight)\n    return loss",
