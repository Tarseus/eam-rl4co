    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    advantage_gap = batch['advantage_gap']\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    rank_weight = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.1, 10.0)\n    margin = ops.sub(lpw, lpl)\n    x = ops.clamp(ops.sub(ops.mul(alpha, margin), ops.mul(beta, advantage_gap)), -20.0, 20.0)\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(ops.mul(loss_per_pair, weight), rank_weight)\n    norm = ops.sum(ops.mul(weight, rank_weight)) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n    return loss",
