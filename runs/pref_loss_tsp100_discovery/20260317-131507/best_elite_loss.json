  "ir": {
    "name": "pairwise_margin_with_bias_and_clip_normalized",
    "intuition": "To enhance stability and prevent outlier margin values from dominating, this loss applies explicit clipping to the biased margin and normalizes the weighted loss sum to 1, ensuring scale-invariance and controlled dynamic range while preserving pairwise weighted margin with bias.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nabs_delta_rank_mean = mean(abs(delta_rank)) + 1e-6\ngamma = extra.get('gamma', 1.5)\nbeta = 0.05 * abs_delta_rank_mean\nweighted_margin = alpha * margin - beta * delta_rank\nbiased_margin = weighted_margin + gamma * bias\nx = clamp(biased_margin, -10, 10)\nloss_per_pair = -logsigmoid(x)\nweighted_loss = loss_per_pair * weight\nnorm = sum(weighted_loss) + epsilon\nloss = sum(weighted_loss) / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_sum",
      "constraint_family": "clipping_with_explicit_normalization"
    },
    "operators_used": [
