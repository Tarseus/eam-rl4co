  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_delta_rank_weighted_margin_scaled_shifted_v3",
    "intuition": "To significantly reduce similarity to existing losses and improve novelty, this loss changes the margin formulation by scaling delta_rank relative to log_prob difference before combining, and replaces the fixed additive shift with a scaled sigmoid-based smooth shift that adapts margins into a safer numeric range. Margin is computed as (log_prob_w - log_prob_l) multiplied by a factor depending on delta_rank, rather than subtracting delta_rank directly. This nonlinear scaling decreases overlap with previous linear margin adjustments, improving distinctiveness. A sigmoid-based smooth shift avoids hard clamps, maintains numeric stability, and yields stable gradient signals. Weight normalization is preserved. These modifications ensure the loss is distinct, numerically stable, and respects pairwise margin paradigms with delta_rank as ranking signal.",
    "pseudocode": "margin = (log_prob_w - log_prob_l) * sigmoid(gamma * delta_rank)\nshifted_margin = margin + shift * (sigmoid(margin) - 0.5)\nclamped_margin = clamp(shifted_margin, -15, 15)\nloss_per_pair = -logsigmoid(clamped_margin)\nweighted_loss_sum = sum(loss_per_pair * weight)\nnorm = sum(weight) + eps\nloss = weighted_loss_sum / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_sum",
      "constraint_family": "scaled_shifted_margin_smooth_shift"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "clamp",
      "mul",
      "neg",
      "sum",
      "add",
      "div",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    delta_rank = batch['delta_rank']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 1.5)))\n    shift = float(extra.get('shift', extra.get('hyperparams', {}).get('shift', 0.7)))\n\n    margin_base = ops.sub(lpw, lpl)\n    scale = ops.sigmoid(ops.mul(gamma, delta_rank))\n    margin = ops.mul(margin_base, scale)\n\n    smooth_shift = ops.mul(shift, ops.sub(ops.sigmoid(margin), 0.5))\n    shifted_margin = ops.add(margin, smooth_shift)\n    clamped_margin = ops.clamp(shifted_margin, -15.0, 15.0)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(clamped_margin))\n\n    weighted_loss_sum = ops.sum(ops.mul(loss_per_pair, weight))\n    norm = ops.sum(weight) + eps\n    loss = ops.div(weighted_loss_sum, norm)\n\n    return loss",
    "theoretical_basis": ""
  },
