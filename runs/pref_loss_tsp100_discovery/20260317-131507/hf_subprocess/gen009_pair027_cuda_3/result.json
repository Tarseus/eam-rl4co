  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_weighted_advantage_loss_simple_sum_to_one_v3",
    "intuition": "The original candidate failed evaluation due to requiring 'advantage_gap', which may not always be available. To fix this, I removed the 'advantage_gap' dependency and replaced it with a stable margin based only on log probabilities and delta_rank weighting. I simplified the margin calculation to sigmoid of log_prob difference scaled by alpha, and used softplus-based rank weighting symmetrized carefully. The loss is a negated logsigmoid of the margin. Weight normalization and pairwise structure are preserved. This ensures the loss passes static/dynamic gates by only requiring guaranteed keys and keeps the loss meaningful, differentiable, and normalized. Thus, I fixed the missing key error by eliminating 'advantage_gap' and maintaining signal expressiveness via 'delta_rank' and likelihood gap.",
    "pseudocode": "rank_weight_raw = softplus(gamma * delta_rank + 1.0)\nrank_weight_sym = 1.0 / (1.0 + abs(rank_weight_raw - 1.0))\nmargin = sigmoid(alpha * (log_prob_w - log_prob_l))\nloss_per_pair = -logsigmoid(margin)\nweighted_loss = loss_per_pair * weight * rank_weight_sym\nloss = sum(weighted_loss) / (sum(weight * rank_weight_sym) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_weighted_normalized",
      "signal_family": "delta_rank_only",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "symmetry_with_explicit_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "sigmoid",
      "softplus",
      "abs",
      "add",
      "sub",
      "mul",
      "div",
      "sum",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n\n    rank_weight_raw = ops.softplus(ops.add(ops.mul(gamma, delta_rank), 1.0))\n    rank_weight_sym = ops.div(1.0, ops.add(1.0, ops.abs(ops.sub(rank_weight_raw, 1.0))))\n\n    margin = ops.sigmoid(ops.mul(alpha, ops.sub(lpw, lpl)))\n    loss_per_pair = ops.neg(ops.logsigmoid(margin))\n\n    weighted_loss = ops.mul(loss_per_pair, ops.mul(weight, rank_weight_sym))\n    norm = ops.sum(ops.mul(weight, rank_weight_sym)) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n    return loss",
    "theoretical_basis": ""
  },
