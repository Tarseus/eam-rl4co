  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_delta_regret_exp_normalized_relu",
    "intuition": "Shift paradigm to pairwise regret difference signal with exponential decay link and normalized weighted aggregation, using a ReLU constraint to penalize only positive regret differences, promoting preference learning driven by regret improvements normalized across pairs.",
    "pseudocode": "delta_regret = delta_regret\nscaled = clamp(alpha * delta_regret, 0, 10)\nloss_per_pair = weight * relu(1 - exp(-scaled) * (log_prob_w - log_prob_l))\nnormalized_loss = sum(loss_per_pair) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_regret",
      "signal_family": "delta_regret",
      "link_family": "exp_decay",
      "agg_family": "sum_normalized",
      "constraint_family": "relu_nonnegative"
    },
    "operators_used": [
      "exp",
      "relu",
      "clamp",
      "sum",
      "div",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scaled = ops.clamp(alpha * delta_regret, 0.0, 10.0)\n    decay_link = ops.exp(ops.neg(scaled))\n    margin = lpw - lpl\n    inner = ops.sub(1.0, ops.mul(decay_link, margin))\n    loss_per_pair = ops.mul(weight, ops.relu(inner))\n    loss = ops.div(ops.sum(loss_per_pair), ops.sum(weight) + 1e-12)\n    return loss",
    "theoretical_basis": ""
  },
