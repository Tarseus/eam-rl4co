  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "stable_pairwise_cost_regret_interaction_exp_logmean_loss",
    "intuition": "Fixed the missing 'cost_gap' issue by replacing it with 'delta_rank', which is a related quality signal available in the batch, ensuring compatibility and compliance with gate requirements. Maintained clamping and stable log computations for numerical stability. This repair preserves the original loss structure but uses 'delta_rank' instead of the missing 'cost_gap' to enable successful evaluation.",
    "pseudocode": "interaction = exp(beta * clamp(delta_rank, -10,10) * clamp(delta_regret, -10,10))\nweighted_interaction = weight * interaction\nmean_w_interaction = sum(weighted_interaction) / sum(weight)\nloss = -alpha * log(clamp(mean_w_interaction, eps))\ndiff = mean(log_prob_w - log_prob_l)\nloss = loss * diff\nreturn loss.mean()",
    "hyperparams": {
      "paradigm_family": "pairwise_interaction",
      "signal_family": "delta_rank_delta_regret",
      "link_family": "exp",
      "agg_family": "log_mean",
      "constraint_family": "positive_strict",
      "other_hparams": "alpha,beta"
    },
    "operators_used": [
      "exp",
      "mul",
      "sum",
      "log",
      "neg",
      "div",
      "clamp",
      "mean",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    delta_regret = batch['delta_regret']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n\n    delta_rank_clamped = ops.clamp(delta_rank, min=-10.0, max=10.0)\n    delta_regret_clamped = ops.clamp(delta_regret, min=-10.0, max=10.0)\n\n    interaction = ops.exp(ops.mul(beta, ops.mul(delta_rank_clamped, delta_regret_clamped)))\n    weighted_interaction = ops.mul(weight, interaction)\n    sum_w_interaction = ops.sum(weighted_interaction)\n    sum_weight = ops.sum(weight).clamp(min=eps)\n    mean_w_interaction = sum_w_interaction / sum_weight\n    mean_w_interaction_clamped = mean_w_interaction.clamp(min=eps)\n\n    loss = ops.neg(ops.mul(alpha, ops.log(mean_w_interaction_clamped)))\n\n    diff = lpw - lpl\n    diff_mean = ops.mean(diff)\n    loss = loss * diff_mean\n\n    return loss.mean()",
    "theoretical_basis": ""
  },
