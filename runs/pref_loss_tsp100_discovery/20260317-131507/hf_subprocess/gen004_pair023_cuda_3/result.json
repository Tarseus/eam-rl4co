  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_005_cost_shifted_normalized_l2_repaired_v6",
    "intuition": "Fixed affine_invariance_violation by normalizing the cost difference with mean-centering before applying beta, which preserves invariance under affine shifts of costs. Also ensured norm is clamped safely to avoid division by near-zero values. This change addresses the failure by normalizing the cost gap around zero, preventing biased cost scaling and preserving the intended theoretical property.",
    "pseudocode": "norm = sqrt(sum(weight^2))\nnorm = clamp(norm, eps, +inf)\ncost_diff = cost_b - cost_a\ncost_diff_centered = cost_diff - mean(cost_diff)\nlogit = alpha * scale * (log_prob_w - log_prob_l) / norm - beta * cost_diff_centered / norm\nlogit = clamp(logit, -20, 20)\nlosses = -logsigmoid(logit)\nloss = sum(weight * losses)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "scale_invariance"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "sqrt",
      "mul",
      "div",
      "sub",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n\n    norm_raw = ops.sqrt(ops.sum(weight * weight))\n    norm = ops.clamp(norm_raw, eps, 1e30)  # clamp to avoid near-zero norm safely\n\n    diff_log_prob = lpw - lpl\n    diff_cost = cost_b - cost_a\n\n    mean_diff_cost = ops.sum(weight * diff_cost) / (ops.sum(weight) + eps)\n    diff_cost_centered = diff_cost - mean_diff_cost\n\n    logit = (alpha * scale * diff_log_prob / norm) - (beta * diff_cost_centered / norm)\n    logit = ops.clamp(logit, -20.0, 20.0)\n    losses = -ops.logsigmoid(logit)\n    loss = ops.sum(weight * losses)\n    return loss",
    "theoretical_basis": ""
  },
