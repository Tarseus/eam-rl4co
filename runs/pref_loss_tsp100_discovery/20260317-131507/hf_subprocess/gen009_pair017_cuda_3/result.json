  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_adv_weighted_rank_normalized_loss",
    "intuition": "Removed dependency on missing 'advantage_gap' key by replacing it with 'delta_rank' as the quality signal to modulate pair weights. Preserved symmetry and normalization by applying a sigmoid scaling on clamped delta_rank difference, combined with weight. Margin transformed with a stable linear scaling that mixes log probability margin and scaled delta_rank. This fixes the missing key failure while maintaining the original candidate's intent to weight pairs by advantage-like signals and rank differences, ensuring pass of gates requiring 'delta_rank' only.",
    "pseudocode": "rank_weight_raw = clamp(1.0 + gamma * delta_rank, 0.1, 10.0)\nsym_rank_weight = exp(-abs(rank_weight_raw - 1.0))\nadv_weight = sigmoid(kappa * delta_rank)\nmargin = alpha * (log_prob_w - log_prob_l) - beta * delta_rank\nloss_per_pair = -logsigmoid(margin)\ncombined_weight = weight * sym_rank_weight * adv_weight\nloss = sum(loss_per_pair * combined_weight) / (sum(combined_weight) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_advantage_weighted_normalized",
      "signal_family": "delta_rank_modulated",
      "link_family": "logsigmoid_linear_margin",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "symmetry_with_rank_modulation",
      "other_hparams": "kappa=2.0"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "exp",
      "sum",
      "div",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    kappa = float(extra.get('kappa', extra.get('hyperparams', {}).get('kappa', 2.0)))\n\n    rank_weight_raw = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.1, 10.0)\n    sym_rank_weight = ops.exp(ops.neg(ops.abs(ops.sub(rank_weight_raw, 1.0))))\n\n    adv_weight = ops.sigmoid(ops.mul(kappa, delta_rank))\n\n    margin = ops.sub(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(beta, delta_rank))\n    loss_per_pair = ops.neg(ops.logsigmoid(margin))\n\n    combined_weight = ops.mul(ops.mul(weight, sym_rank_weight), adv_weight)\n    weighted_loss = ops.mul(loss_per_pair, combined_weight)\n\n    norm = ops.sum(combined_weight) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n\n    return loss",
    "theoretical_basis": ""
  },
