  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_regret_margin_loss_fixed",
    "intuition": "This pairwise margin-based hinge loss penalizes pairs where the margin, computed as a weighted difference between log probabilities adjusted by delta_regret and a fixed margin threshold, is violated. It uses only guaranteed keys to avoid missing data issues.",
    "pseudocode": "margin = alpha * (log_prob_w - log_prob_l) - beta * delta_regret - margin_threshold\nmargin_violation = clamp(margin_threshold - margin, min=0)\nweight_factor = weight * (1 + gamma * delta_regret)\nloss = sum(weight_factor * margin_violation) / (sum(weight_factor) + eps)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin_regret_only",
      "signal_family": "delta_regret_only",
      "link_family": "hinge",
      "agg_family": "weighted_mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "clamp",
      "mul",
      "sum",
      "add",
      "sub",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    margin_threshold = float(extra.get('margin_threshold', 0.5))\n\n    margin = ops.sub(ops.sub(ops.mul(alpha, ops.sub(lpw, lpl)), ops.mul(beta, delta_regret)), margin_threshold)\n    margin_violation = ops.clamp(ops.sub(margin_threshold, margin), 0.0, float('inf'))\n    weight_factor = ops.mul(weight, ops.add(1.0, ops.mul(gamma, delta_regret)))\n\n    numerator = ops.sum(ops.mul(weight_factor, margin_violation))\n    denominator = ops.sum(weight_factor) + eps\n    loss = ops.div(numerator, denominator)\n    return loss",
    "theoretical_basis": ""
  },
