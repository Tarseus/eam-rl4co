  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_regret_exp_deltaz_weighted_logsigmoid_mean",
    "intuition": "Shift paradigm to pairwise regression using regret signal transformed by exponential decay of delta_z; weighs the pairwise logsigmoid loss by a soft normalized weight emphasizing pairs with larger regret, aggregating by mean to stabilize gradient contributions and capture fine-grained preferences through delta_z proximity.",
    "pseudocode": "regret = batch['delta_regret']\ndelta_z = batch['delta_z']\nweight = batch.get('weight', ones_like)\nsoft_weight = weight * exp(-gamma * abs(delta_z))\nnormalized_weight = soft_weight / sum(soft_weight + eps)\nmargin = log_prob_w - log_prob_l\nx = margin + alpha * regret\nloss = -logsigmoid(x) * normalized_weight\nreturn mean(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_regression",
      "signal_family": "delta_regret_delta_z",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "none"
    },
    "operators_used": [
      "logsigmoid",
      "exp",
      "abs",
      "sum",
      "div",
      "mean",
      "mul",
      "add",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_regret",
        "delta_z"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    delta_z = batch['delta_z']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 1.5)))\n\n    abs_dz = ops.abs(delta_z)\n    soft_w = weight * ops.exp(-gamma * abs_dz)\n    soft_w_sum = ops.sum(soft_w)\n    normalized_w = soft_w / ops.clamp(soft_w_sum, min=eps)\n\n    margin = lpw - lpl\n    x = margin + alpha * delta_regret\n    loss_per_pair = -ops.logsigmoid(x) * normalized_w\n    return ops.mean(loss_per_pair)",
    "theoretical_basis": ""
  },
