  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advantage_gap_weighted_sumlog_logsigmoid_clamped_repaired",
    "intuition": "The original candidate failed because it requires the 'advantage_gap' key which was missing from the batch. To fix this, I replaced the dependence on 'advantage_gap' with 'delta_regret', another valid pairwise quality signal that should be provided. The logic remains the same, aggregating a weighted logsigmoid loss on a log-transformed margin clamped for gradient stability, now using delta_regret to maintain preference signal guidance.",
    "pseudocode": "margin = log_prob_w - log_prob_l\nrelu_margin = relu(margin)\nlog_margin = log(1 + relu_margin)\nadjusted = log_margin + beta * delta_regret\nclamped = clamp(adjusted, -10, 10)\nloss_per_pair = -logsigmoid(clamped) * weight\nloss = sum(loss_per_pair)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_regret",
      "link_family": "logsigmoid",
      "agg_family": "sum_log_transform",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "log",
      "relu",
      "mul",
      "add",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    margin = lpw - lpl\n    relu_margin = ops.relu(margin)\n    log_margin = ops.log(1.0 + relu_margin)\n    adjusted = log_margin + beta * delta_regret\n    clamped = ops.clamp(adjusted, -10.0, 10.0)\n    loss_per_pair = -ops.logsigmoid(clamped) * weight\n    loss = ops.sum(loss_per_pair)\n    return loss",
    "theoretical_basis": ""
  },
