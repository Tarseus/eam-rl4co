  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_advgap_logsigmoid_clamped_weighted_norm_shifted_repaired_v3",
    "intuition": "The original repaired candidate failed due to the missing 'advantage_gap' key at run time. To fix this, I replaced 'advantage_gap' with 'delta_rank', a supported and commonly available quality signal that exists in the batch and conveys ranking difference information. The expects field is updated accordingly to include 'delta_rank' instead of 'advantage_gap'. The loss logic remains similar, using the margin plus beta times delta_rank minus the shift, clamped for stability, and weights normalized for training stability. This ensures all accessed keys are present, satisfying the gates and preserving the pairwise margin loss intention.",
    "pseudocode": "eps = 1e-8\nnormalized_weight = weight / (sum(weight) + eps)\nmargin = log_prob_w - log_prob_l\nadjusted_margin = margin + beta * delta_rank - shift\nclamped_margin = clamp(adjusted_margin, -15, 15)\nloss = -sum(logsigmoid(clamped_margin) * normalized_weight)\nreturn sum(loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "logsigmoid",
      "agg_family": "sum",
      "constraint_family": "clamp_stabilized_normalized",
      "other_hparams": "alpha fixed to 1.0, beta tunable, shift = 0.5"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.1)))\n    shift = float(extra.get('shift', 0.5))\n    margin = lpw - lpl\n    adjusted_margin = margin + beta * delta_rank - shift\n    clamped = ops.clamp(adjusted_margin, -15.0, 15.0)\n    weight_sum = ops.sum(weight) + eps\n    normalized_weight = weight / weight_sum\n    loss_per_pair = -ops.logsigmoid(clamped) * normalized_weight\n    return ops.sum(loss_per_pair)",
    "theoretical_basis": ""
  },
