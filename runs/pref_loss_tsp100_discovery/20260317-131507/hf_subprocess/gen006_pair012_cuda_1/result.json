  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_weighted_advantage_loss_delta_rank_repaired",
    "intuition": "Removed dependency on missing 'advantage_gap' key by reformulating the loss to rely on 'delta_rank' only; kept the smooth margin with tanh over (log_prob_w - log_prob_l) scaled by alpha and weighted the loss by squared rank_weight and sample weights. This ensures the loss can compute safely without missing keys and still emphasize ranking signal as intended.",
    "pseudocode": "rank_weight = clamp(1.0 + gamma * delta_rank, 0.1, 10.0)\nsmooth_margin = tanh(alpha * (log_prob_w - log_prob_l))\nloss_per_pair = -logsigmoid(smooth_margin)\nrank_weight_sq = rank_weight * rank_weight\nweighted_loss = loss_per_pair * weight * rank_weight_sq\nloss = sum(weighted_loss) / (sum(weight * rank_weight_sq) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin_rank_weighted",
      "signal_family": "delta_rank_only",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "smooth_transform",
      "other_hparams": ""
    },
    "operators_used": [
      "logsigmoid",
      "tanh",
      "clamp",
      "mul",
      "sum",
      "add",
      "div",
      "sub",
      "neg"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n    rank_weight = ops.clamp(ops.add(1.0, ops.mul(gamma, delta_rank)), 0.1, 10.0)\n    margin = ops.sub(lpw, lpl)\n    x = ops.tanh(ops.mul(alpha, margin))\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    rank_weight_sq = ops.mul(rank_weight, rank_weight)\n    weighted_loss = ops.mul(ops.mul(loss_per_pair, weight), rank_weight_sq)\n    norm = ops.sum(ops.mul(weight, rank_weight_sq)) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n    return loss",
    "theoretical_basis": ""
  },
