  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "scale_invariant_pairwise_loss_v2_repaired",
    "intuition": "Removed dependency on the missing 'advantage_gap' signal to fix the 'missing_key' failure. Replaced advantage_gap with delta_rank in the margin calculation, as delta_rank is available and correlated with ranking differences. Retained the softplus-based rank weighting and exponential symmetric weighting for stable, scale-aware weighting and normalization. This preserves the original loss's pairwise ranking sensitivity and normalized weighted aggregation while ensuring all expected keys are accessible, making the loss valid and pass all gates.",
    "pseudocode": "rank_weight_raw = 1 + softplus(gamma * delta_rank - 1)\nsym_rank_weight = exp(-abs(delta_rank))\nmargin = log_prob_w - log_prob_l + alpha * delta_rank\nloss_per_pair = -logsigmoid(margin)\nweighted_loss = loss_per_pair * weight * sym_rank_weight * rank_weight_raw\nnorm = sum(weight * sym_rank_weight * rank_weight_raw) + epsilon\nloss = sum(weighted_loss) / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_rank_weighted_normalized",
      "signal_family": "delta_rank_only",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_mean",
      "constraint_family": "soft_symmetric_weighting_normalization"
    },
    "operators_used": [
      "logsigmoid",
      "mul",
      "add",
      "sub",
      "neg",
      "abs",
      "exp",
      "sum",
      "div",
      "softplus"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    gamma = float(extra.get('gamma', extra.get('hyperparams', {}).get('gamma', 0.5)))\n\n    def softplus(x):\n        return ops.log(ops.add(ops.exp(x), 1.0))\n\n    rank_weight_raw = ops.add(1.0, softplus(ops.sub(ops.mul(gamma, delta_rank), 1.0)))\n    sym_rank_weight = ops.exp(ops.neg(ops.abs(delta_rank)))\n\n    margin = ops.add(ops.sub(lpw, lpl), ops.mul(alpha, delta_rank))\n    loss_per_pair = ops.neg(ops.logsigmoid(margin))\n\n    weighted_loss = ops.mul(ops.mul(ops.mul(loss_per_pair, weight), sym_rank_weight), rank_weight_raw)\n    norm = ops.sum(ops.mul(ops.mul(weight, sym_rank_weight), rank_weight_raw)) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n\n    return loss",
    "theoretical_basis": ""
  },
