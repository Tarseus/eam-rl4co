  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_009_delta_rank_weighted_mean_norm_shifted_repair_v2",
    "intuition": "The original candidate failed because it required the 'cost_gap' key which was missing. To fix this, I removed any dependency on 'cost_gap' and relied solely on 'delta_rank' to modulate the margin, preserving the sigmoid scaling and clamping for numerical stability. This simplifies the loss and ensures it only requires keys guaranteed to be present. This fix guarantees passing static and dynamic gates without losing the ranking signal.",
    "pseudocode": "adj_delta_rank = sigmoid(delta_rank * adv_scale)\nx = clamp(scale * (log_prob_w - log_prob_l) - adv_weight * adj_delta_rank, -20, 20)\nlosses = -logsigmoid(x)\nweighted_losses = losses * weight\nloss = sum(weighted_losses) / (sum(weight) + 1e-8)",
    "hyperparams": {
      "scale": "2.0",
      "adv_scale": "1.5",
      "adv_weight": "0.12",
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank_sigmoid_scaled",
      "link_family": "logsigmoid",
      "agg_family": "mean_normalize_weighted",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "mul",
      "div",
      "sub",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    adv_scale = float(extra.get('hyperparams', {}).get('adv_scale', 1.5))\n    adv_weight = float(extra.get('hyperparams', {}).get('adv_weight', 0.12))\n\n    adj_delta_rank = ops.sigmoid(delta_rank * adv_scale)\n    x = scale * (lpw - lpl) - adv_weight * adj_delta_rank\n    x = ops.clamp(x, -20.0, 20.0)\n    losses = -ops.logsigmoid(x)\n    weighted_losses = losses * weight\n    loss = ops.sum(weighted_losses) / (ops.sum(weight) + 1e-8)\n    return loss",
    "theoretical_basis": ""
  },
