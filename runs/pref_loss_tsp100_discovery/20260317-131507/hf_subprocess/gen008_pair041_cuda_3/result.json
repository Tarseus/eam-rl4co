  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_delta_regret_pairwise_dif_ratio_normalized",
    "intuition": "Shift from margin-based losses to a ratio-based contrast on delta_regret that compares the relative difference between winning and losing log probabilities scaled by the regret difference. This uses a sigmoid link on the relative regret-normalized advantage ratio, aggregates by a weighted normalized sum, and constrains by enforcing positivity and scale invariance via ratios rather than margins. This paradigm avoids direct subtraction margins, introduces a signal contrast that is multiplicative and normalized differently, enhancing novelty and robustness to scale changes in regret.",
    "pseudocode": "regret_diff = abs(delta_regret) + epsilon\nadv_ratio = (log_prob_w - log_prob_l) / regret_diff\npos_adv_ratio = relu(adv_ratio)\nloss_terms = -logsigmoid(pos_adv_ratio)\nweighted_loss = loss_terms * weight\nnorm = sum(weight)\nfinal_loss = sum(weighted_loss) / norm",
    "hyperparams": {
      "paradigm_family": "pairwise_ratio",
      "signal_family": "delta_regret",
      "link_family": "logsigmoid",
      "agg_family": "normalized_weighted_sum",
      "constraint_family": "pos_ratio_scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "relu",
      "neg",
      "mul",
      "sum",
      "sub",
      "abs",
      "div",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n\n    regret_diff = ops.add(ops.abs(delta_regret), eps)\n    adv_ratio = ops.div(ops.sub(lpw, lpl), regret_diff)\n    pos_adv_ratio = ops.relu(adv_ratio)\n    loss_terms = ops.neg(ops.logsigmoid(pos_adv_ratio))\n\n    weighted_loss = ops.mul(loss_terms, weight)\n    norm = ops.sum(weight) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n\n    return loss",
    "theoretical_basis": ""
  },
