  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f000_008_a10ec70e",
    "ir": {
      "name": "loss_rank_gap_tanh_advantage",
      "intuition": "Shift from margin-based pairwise losses to a rank-based loss using a bounded non-linear transformation (tanh) on advantage signals to stabilize training and better capture preference strength.",
      "pseudocode": "rank_gap = rank_gap(advantage_w - advantage_l)\nscaled_gap = tanh(beta * rank_gap)\nloss = mean(weight * (1 - scaled_gap))",
      "hyperparams": {
        "paradigm_family": "pairwise_rank_based",
        "signal_family": "advantage_gap",
        "link_family": "tanh",
        "agg_family": "mean",
        "constraint_family": "none"
      },
      "operators_used": [
        "rank_gap",
        "tanh",
        "mean",
        "sub",
        "mul",
        "add"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "advantage_w",
          "advantage_l"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    adv_w = batch['advantage_w']\n    adv_l = batch['advantage_l']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 1.0)))\n    gap = adv_w - adv_l\n    rank_g = ops.rank_gap(gap)\n    scaled_gap = ops.tanh(beta * rank_g)\n    loss = weight * (1 - scaled_gap)\n    return loss.mean()",
      "theoretical_basis": ""
    }
  },
