        ],
        "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
      },
      "f_ir": {
        "name": "loss_diff_squared_advantage",
        "intuition": "Use a regression paradigm on advantage differences, penalizing squared error between predicted preference margin (log_prob difference) and advantage signal, encouraging calibrated margin predictions.",
        "pseudocode": "predicted_margin = lpw - lpl\nerror = predicted_margin - advantage_gap\nloss = mean(weight * error^2)",
        "hyperparams": {
          "paradigm_family": "pairwise_regression",
          "signal_family": "advantage_gap",
          "link_family": "identity",
          "agg_family": "mean",
          "constraint_family": "none"
        },
        "operators_used": [
