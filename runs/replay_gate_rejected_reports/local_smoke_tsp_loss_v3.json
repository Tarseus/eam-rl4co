        "implementation_hint": {
          "expects": [
            "log_prob_w",
            "log_prob_l",
            "weight",
            "advantage_gap"
          ],
          "returns": "scalar",
          "mode": "pairwise"
        },
        "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv_gap = batch['advantage_gap']\n    pred_margin = ops.sub(lpw, lpl)\n    error = ops.sub(pred_margin, adv_gap)\n    squared_error = ops.mul(error, error)\n    if weight is not None:\n        weighted_error = ops.mul(squared_error, weight)\n    else:\n        weighted_error = squared_error\n    return ops.mean(weighted_error)",
