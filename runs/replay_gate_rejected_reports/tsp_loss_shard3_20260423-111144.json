        "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_regret = batch['delta_regret']\n    adv_gap = batch['advantage_gap']\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.5)))\n    gamma = float(extra.get('gamma', 0.1))\n\n    margin = ops.add(ops.sub(lpw, lpl), ops.mul(beta, adv_gap))\n    margin_shifted = ops.sub(margin, gamma)\n\n    pos_penalty = ops.relu(margin_shifted)                    # penalize over-margin\n    neg_penalty = ops.mul(ops.relu(ops.neg(margin_shifted)), delta_regret)  # scaled penalty for under-margin proportional to regret\n\n    loss_per_pair = ops.add(pos_penalty, neg_penalty)\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    return ops.mean(weighted_loss)",
        "theoretical_basis": ""
