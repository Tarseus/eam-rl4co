        "pseudocode": "regret = delta_regret\nmargin = log_prob_w - log_prob_l + beta * advantage_gap - gamma\npos_penalty = relu(margin)\nneg_penalty = relu(-margin) * delta_regret_factor\nloss_per_pair = pos_penalty + neg_penalty\nweighted_loss = loss_per_pair * weight\nfinal_loss = mean(weighted_loss)",
        "hyperparams": {
          "paradigm_family": "pairwise_regression",
          "signal_family": "delta_regret",
          "link_family": "relu_asymmetric",
          "agg_family": "mean",
          "constraint_family": "none"
