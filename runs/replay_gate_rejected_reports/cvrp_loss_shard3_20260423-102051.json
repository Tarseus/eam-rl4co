        "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    cost_gap = batch['cost_gap']\n    weight = batch.get('weight', ops.ones_like(lpw))\n\n    margin = ops.sub(lpw, lpl)\n    rev_margin = ops.sub(lpl, lpw)\n    sym_margin = ops.mul(ops.sub(margin, rev_margin), 0.5)\n\n    abs_cost_gap_mean = ops.mean(ops.abs(cost_gap)) + 1e-6\n    scale = ops.mul(0.1, abs_cost_gap_mean)\n\n    delta = 1.0\n    abs_cg = ops.abs(cost_gap)\n\n    sign_cg = ops.div(cost_gap, ops.add(abs_cg, eps))\n\n    mask_f = (abs_cg < delta).to(dtype=cost_gap.dtype)\n\n    adaptive_cost = ops.add(ops.mul(cost_gap, mask_f), ops.mul(ops.mul(delta, sign_cg), ops.sub(1.0, mask_f)))\n\n    adaptive_term = ops.mul(scale, adaptive_cost)\n\n    alpha = float(extra.get('alpha', 1.0))\n    bias = float(extra.get('bias', 0.5))\n\n    weighted_margin = ops.add(ops.sub(ops.mul(alpha, sym_margin), adaptive_term), bias)\n    clipped_margin = ops.clamp(weighted_margin, -10.0, 10.0)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(clipped_margin))\n\n    weighted_loss = ops.mul(loss_per_pair, weight)\n\n    loss = ops.div(ops.sum(weighted_loss), ops.sum(weight) + eps)\n    return loss",
