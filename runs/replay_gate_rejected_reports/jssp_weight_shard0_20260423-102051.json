      "g_ir": {
        "name": "all_pairs_gap_rank_blend_exp_mad",
        "intuition": "Weight all pairs by normalized positive gap blended with an exponential decay on rank difference, modulated by instance_obj_mad powered by gamma, emphasizing instance-level margin dispersion for robust conditioning under full all-pairs topology.",
        "implementation_hint": {
          "expects": [
            "objective",
            "rank",
            "instance_obj_mad"
          ],
          "returns": "PrefBatch",
          "mode": "pairwise"
        },
        "hyperparams": {
          "geometry_family": "dense_all_pairs",
          "cap_family": "uncapped_full",
          "weight_family": "gap_rank_blend",
          "constraint_family": "clamp"
        },
        "operators_used": [
          "all_pairs",
          "clamp",
          "sub",
          "div",
          "pow",
          "exp",
          "mul"
        ],
        "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    rank = feature_cache['rank']\n    instance_obj_mad = feature_cache['instance_obj_mad']\n    eps = 1e-6\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    if b_idx.numel() == 0:\n        return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_gap_rank_blend_exp_mad', 'weight_family': 'gap_rank_blend'})\n    gap = (objective[b_idx, loser_idx] - objective[b_idx, winner_idx]).clamp_min(0.0)\n    norm_gap = gap / instance_obj_mad[b_idx].clamp_min(eps)\n    alpha = float(extra.get('alpha', 1.0))\n    gamma = float(extra.get('gamma', 1.0))\n    rank_diff = (rank[b_idx, loser_idx] - rank[b_idx, winner_idx]).abs()\n    beta = float(extra.get('beta', 3.0))\n    base_weight = norm_gap.pow(alpha) * instance_obj_mad[b_idx].clamp_min(eps).pow(gamma)\n    blend = (-(beta * rank_diff)).exp()\n    raw_weight = base_weight * blend\n    weight = raw_weight.clamp(0.1, 3.5)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weight, meta={'builder': 'all_pairs_gap_rank_blend_exp_mad', 'weight_family': 'gap_rank_blend'})"
      },
      "f_ir": {
        "name": "refined_hyperparameter_tuning_M2_v3_unique",
        "intuition": "Stabilize normalization by clamping sums and replace direct weighted mean with safe division to fix runtime; preserve sigmoid margin on advantage_gap.",
        "pseudocode": "epsilon=1e-6\nnorm_adv = mean(abs(advantage_gap))\nnorm_adv = max(norm_adv, epsilon)\ndiff = (log_prob_w - log_prob_l) / norm_adv\nloss = -log(sigmoid(diff))\nweighted_loss = loss * weight\nloss_sum = sum(weighted_loss)\nweight_sum = sum(weight)\nloss = loss_sum / max(weight_sum, epsilon)\nreturn loss",
        "hyperparams": {
          "paradigm_family": "pairwise_margin",
          "signal_family": "advantage_gap",
          "link_family": "sigmoid",
          "agg_family": "weighted_sum_normalized",
          "constraint_family": "symmetric_smooth"
        },
        "operators_used": [
          "sigmoid",
          "log",
          "neg",
          "mul",
          "div",
          "sub",
          "sum",
          "mean",
          "abs",
          "maximum"
        ],
        "implementation_hint": {
          "expects": [
            "log_prob_w",
            "log_prob_l",
            "weight",
            "advantage_gap"
          ],
          "returns": "scalar",
          "mode": "pairwise"
        },
        "code": "def generated_loss(batch, model_output, extra):\n    epsilon = 1e-6\n    lpw = batch[\"log_prob_w\"]\n    lpl = batch[\"log_prob_l\"]\n    weight = batch[\"weight\"]\n    advantage_gap = batch[\"advantage_gap\"]\n    abs_adv = ops.abs(advantage_gap)\n    mean_abs_adv = ops.mean(abs_adv)\n    norm_adv = ops.maximum(mean_abs_adv, epsilon)\n    diff = ops.div(ops.sub(lpw, lpl), norm_adv)\n    sigmoid_diff = ops.sigmoid(diff)\n    loss = ops.neg(ops.log(ops.clamp(sigmoid_diff, min=epsilon)))\n    weighted_loss = ops.mul(loss, weight)\n    loss_sum = ops.sum(weighted_loss)\n    weight_sum = ops.sum(weight)\n    weight_sum_safe = ops.maximum(weight_sum, epsilon)\n    return ops.div(loss_sum, weight_sum_safe)",
        "theoretical_basis": ""
      },
