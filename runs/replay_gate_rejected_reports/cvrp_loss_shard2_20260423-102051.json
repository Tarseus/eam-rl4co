        "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    bias = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.5)))\n    learned_decay = float(extra.get('learned_decay', 3.0))\n\n    abs_delta_rank_mean = ops.mean(ops.abs(delta_rank)) + 1e-6\n    delta_rank_mean = ops.mean(delta_rank)\n    delta_rank_var = ops.mean(ops.pow(ops.sub(delta_rank, delta_rank_mean), 2)) + 1e-6\n\n    beta = ops.mul(0.15, ops.exp(ops.neg(ops.mul(learned_decay, delta_rank_var))))\n\n    bias_norm = ops.sub(\n        ops.sigmoid(ops.mul(5.0, ops.div(delta_rank, ops.add(abs_delta_rank_mean, 0.2)))),\n        0.5\n    )\n    scaled_bias = ops.mul(bias, bias_norm)\n\n    softplus_input = ops.mul(8.0, ops.sub(ops.div(ops.sqrt(delta_rank_var), ops.add(abs_delta_rank_mean, 1e-6)), 0.3))\n    softplus_margin_scale = ops.div(ops.log(ops.add(ops.exp(softplus_input), ops.ones_like(softplus_input))), 1.7)\n\n    margin = ops.sub(lpw, lpl)\n    scaled_margin = ops.mul(margin, softplus_margin_scale)\n\n    weighted_margin = ops.sub(ops.mul(alpha, scaled_margin), ops.mul(beta, delta_rank))\n    biased_margin = ops.add(weighted_margin, scaled_bias)\n    x = ops.clamp(biased_margin, -15.0, 15.0)\n\n    loss_per_pair = ops.neg(ops.logsigmoid(x))\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    loss = ops.sum(weighted_loss)\n    return loss",
