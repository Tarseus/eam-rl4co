        "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    epsilon = 1e-6\n    diff_raw = ops.sub(lpw, lpl)\n    weighted_diff_sum = ops.sum(ops.mul(diff_raw, weight))\n    weight_sum = ops.sum(weight)\n    mean_diff = ops.div(weighted_diff_sum, ops.maximum(weight_sum, epsilon))\n    adv_weighted_mean = ops.div(ops.sum(ops.mul(advantage_gap, weight)), ops.maximum(weight_sum, epsilon))\n    shift_raw = ops.add(mean_diff, ops.mul(0.1, adv_weighted_mean))\n    clamped_diff_shift = ops.clamp(shift_raw, -0.5, 0.5)\n    diff_centered = ops.sub(diff_raw, clamped_diff_shift)\n    norm_adv = ops.norm(ops.add(advantage_gap, epsilon))\n    norm_value = ops.maximum(ops.add(norm_adv, ops.softplus(ops.mul(0.1, ops.ones_like(norm_adv)))), epsilon)\n    stable_diff = ops.div(diff_centered, norm_value)\n    smooth_diff = ops.tanh(stable_diff)\n    scaled_diff = ops.mul(scale, smooth_diff)\n    loss = ops.neg(ops.logsigmoid(scaled_diff))\n    weighted_loss = ops.mul(loss, weight)\n    loss_sum = ops.sum(weighted_loss)\n    total_weight = ops.sum(weight)\n    return ops.div(loss_sum, ops.maximum(total_weight, epsilon))",
