        "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    advantage_gap = batch['advantage_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.5))\n    epsilon = 1e-6\n\n    norm_per_sample = ops.norm(advantage_gap)\n    mean_norm = ops.mean(norm_per_sample)\n\n    signed_dev = ops.sign(ops.sub(norm_per_sample, mean_norm))\n    mean_signed_dev = ops.mean(signed_dev)\n\n    margin_offset = ops.add(mean_norm, ops.mul(alpha * 0.1, mean_signed_dev))\n\n    norm_clamped = ops.maximum(norm_per_sample, epsilon)\n\n    diff = ops.sub(lpw, lpl)\n    x = ops.mul(ops.div(diff, norm_clamped), alpha * scale)\n\n    x = ops.sub(x, margin_offset)\n    x = ops.clamp(x, -20.0, 20.0)\n\n    loss = ops.neg(ops.logsigmoid(x))\n\n    loss = ops.mul(loss, weight)\n\n    loss_sum = ops.sum(loss)\n    weight_sum = ops.sum(weight)\n\n    loss_scaled = ops.div(loss_sum, ops.maximum(weight_sum, epsilon))\n\n    return loss_scaled",
