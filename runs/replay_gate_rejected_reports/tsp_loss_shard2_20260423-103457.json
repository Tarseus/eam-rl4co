          "sub"
        ],
        "implementation_hint": {
          "expects": [
            "log_prob_w",
            "log_prob_l",
            "weight",
            "cost_gap"
          ],
          "returns": "scalar",
          "mode": "pairwise"
        },
        "code": "def generated_loss(batch, model_output, extra):\n    epsilon = 1e-4\n    log_prob_w = batch['log_prob_w']\n    log_prob_l = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n\n    clamped_gap = ops.clamp(ops.abs(cost_gap), min=epsilon)\n    scale = 1.0 / clamped_gap\n    diff = log_prob_w - log_prob_l\n    scaled_diff = diff * weight * scale\n\n    loss = ops.mean(ops.logsigmoid(scaled_diff))\n    return loss",
