      "f_ir": {
        "name": "pairwise_pref_cost_gap_stabilized",
        "intuition": "Original loss scales the difference of log probabilities by the reciprocal of the absolute cost gap, which can cause numerical instability or extremely large gradients if cost_gap is near zero. This version stabilizes by clamping the denominator to a minimum epsilon (1e-4) to avoid huge scale values, and ensures weight is non-negative as required. This normalization prevents instability and overly large updates while preserving the pairwise preference signal based on cost gap.",
        "pseudocode": "clamped_gap = clamp(abs(cost_gap), min=1e-4) scale = 1 / clamped_gap diff = log_prob_w - log_prob_l scaled_diff = diff * weight * scale loss = mean(logsigmoid(scaled_diff))",
        "hyperparams": {
          "paradigm_family": "ranking",
          "signal_family": "costs",
          "link_family": "pairwise",
          "agg_family": "mean",
          "constraint_family": "preference"
        },
        "operators_used": [
