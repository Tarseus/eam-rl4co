        "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
      },
      "f_ir": {
        "name": "pairwise_margin_with_bias_clip_normalized_with_cost_gap_and_delta_rank_scaled",
        "intuition": "To reduce similarity with prior losses, introduced a dynamic scaling factor on the delta_rank term based on variance rather than mean absolute value, providing more nuanced regularization. Added normalization of delta_rank using its standard deviation plus epsilon to stabilize scaling. Adjusted gamma and alpha_cost to new values to balance margin clipping and penalty strength. Also replaced fixed bias with a learnable bias term passed via 'extra' for flexibility. These changes diversify the computation and improve novelty while maintaining effective pairwise margin behavior and leveraging the cost_gap signal as a quality measure.",
        "pseudocode": "margin = log_prob_w - log_prob_l\nstd_delta_rank = sqrt(var(delta_rank) + 1e-6)\nbeta = 0.1 * std_delta_rank\nweighted_margin = alpha * margin - beta * delta_rank\nbiased_margin = weighted_margin + gamma * bias\nclipped_margin = clamp(biased_margin, -8, 8)\nbase_loss = -logsigmoid(clipped_margin)\ncost_gap_norm = cost_gap / (mean(abs(cost_gap)) + 1e-6)\ncost_penalty = alpha_cost * cost_gap_norm\nloss_per_pair = base_loss + cost_penalty\nweighted_loss = loss_per_pair * weight\nnorm = sum(weighted_loss) + eps\nloss = sum(weighted_loss) / norm",
        "hyperparams": {
          "paradigm_family": "pairwise_margin",
          "signal_family": "delta_rank_and_cost_gap",
          "link_family": "logsigmoid_with_linear_penalty",
          "agg_family": "normalized_weighted_sum",
          "constraint_family": "clipping_with_explicit_normalization_and_penalty"
        },
        "operators_used": [
          "logsigmoid",
          "clamp",
          "mul",
          "add",
          "sub",
          "neg",
          "sum",
          "abs",
          "mean",
          "div",
          "var",
          "sqrt"
        ],
        "implementation_hint": {
          "expects": [
            "log_prob_w",
            "log_prob_l",
            "weight",
            "delta_rank",
            "cost_gap"
          ],
          "returns": "scalar",
          "mode": "pairwise"
        },
        "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    delta_rank = batch['delta_rank']\n    cost_gap = batch['cost_gap']\n\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    bias = float(extra.get('bias', extra.get('hyperparams', {}).get('bias', 0.3)))\n    gamma = float(extra.get('gamma', 1.0))\n    alpha_cost = float(extra.get('alpha_cost', 0.15))\n\n    var_delta_rank = ops.mean(ops.mul(delta_rank, delta_rank)) - ops.mul(ops.mean(delta_rank), ops.mean(delta_rank))\n    std_delta_rank = ops.sqrt(var_delta_rank + 1e-6)\n    beta = 0.1 * std_delta_rank\n\n    margin = ops.sub(lpw, lpl)\n    weighted_margin = ops.sub(ops.mul(alpha, margin), ops.mul(beta, delta_rank))\n    biased_margin = ops.add(weighted_margin, ops.mul(gamma, bias))\n    clipped_margin = ops.clamp(biased_margin, -8.0, 8.0)\n    base_loss = ops.neg(ops.logsigmoid(clipped_margin))\n\n    cost_gap_norm = ops.div(cost_gap, ops.mean(ops.abs(cost_gap)) + 1e-6)\n    cost_penalty = ops.mul(alpha_cost, cost_gap_norm)\n\n    loss_per_pair = ops.add(base_loss, cost_penalty)\n    weighted_loss = ops.mul(loss_per_pair, weight)\n    norm = ops.sum(weighted_loss) + eps\n    loss = ops.div(ops.sum(weighted_loss), norm)\n    return loss",
        "theoretical_basis": ""
