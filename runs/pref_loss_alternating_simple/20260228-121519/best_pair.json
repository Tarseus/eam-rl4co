  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_000_cost_tuned_scale",
    "intuition": "This loss is a pairwise logistic objective with an added cost-gap term: x = alpha*scale*(lpw-lpl) - 0.1*gap, then -logsigmoid(x). The clamp to [-20, 20] means overly large scale can push many examples into saturation, shrinking gradients and making learning less sensitive to nuanced lpw-lpl differences (especially when the gap term already shifts x). Reducing scale slightly keeps more pairs in the informative (non-saturated) region of logsigmoid, improving gradient signal while still providing a clear margin between winner and loser log-probs.",
    "pseudocode": "gap = detach(cost_b - cost_a)\nx = clamp(alpha*scale*(lpw-lpl) - 0.1*gap, -20, 20)\nloss = -logsigmoid(x)\nloss = mean(loss * weight if weight else loss)",
    "hyperparams": {
      "scale": 1.423
    },
    "operators_used": [
      "logsigmoid",
      "clamp"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "cost_a",
        "cost_b",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    x = alpha * scale * (lpw - lpl) - 0.1 * gap\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": ""
  },
