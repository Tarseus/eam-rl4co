  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_001_cost_normgap_softplus_tuned",
    "intuition": "Increase `scale` slightly to strengthen the preference logit (lpw-lpl) relative to the detached cost shaping, which can reduce underfitting when the cost term is small due to normalization. Decrease `gap_coef` modestly to avoid over-penalizing the margin with the bounded normalized gap; since ngap is already squashed, a smaller coefficient typically preserves stability while letting the preference signal dominate more consistently.",
    "pseudocode": "gap = detach(cost_b - cost_a)\nngap = gap / (1 + abs(gap))\nx = clamp(alpha*scale*(lpw-lpl) - gap_coef*ngap, -20, 20)\nloss = softplus(-x)\nloss = mean(loss * weight if weight else loss)",
    "hyperparams": {
      "scale": 1.55,
      "gap_coef": 0.07
    },
    "operators_used": [
      "softplus",
      "clamp",
      "abs"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "cost_a",
        "cost_b",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n\n    hp = extra.get('hyperparams', {}) if isinstance(extra, dict) else {}\n    alpha = float(extra.get('alpha', hp.get('alpha', 1.0))) if isinstance(extra, dict) else 1.0\n    scale = float(hp.get('scale', 1.423))\n    gap_coef = float(hp.get('gap_coef', 0.1))\n\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n\n    # Smoothly damp very large gaps so they don't dominate the logit.\n    ngap = gap / (1.0 + ops.abs(gap))\n\n    x = alpha * scale * (lpw - lpl) - gap_coef * ngap\n    x = ops.clamp(x, -20.0, 20.0)\n\n    # Numerically stable equivalent of -logsigmoid(x).\n    loss = ops.softplus(-x)\n    if weight is not None:\n        loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": ""
  },
