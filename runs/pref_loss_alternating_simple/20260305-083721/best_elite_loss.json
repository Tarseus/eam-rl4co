  "ir": {
    "name": "pairwise_preference_loss",
    "intuition": "This loss compares the log probabilities of two options (w and l) based on their preference signals, such as cost gap or advantage, using a pairwise approach. By applying a sigmoid function to their difference modulated by signals, it encourages higher log prob for preferred options, effectively modeling the preference distribution. Using pairwise signals ensures the loss directly encodes relative preferences, which is robust to scale differences and aligns with RL objectives.",
    "pseudocode": "loss = -logsigmoid(alpha * scale * (log_prob_w - log_prob_l) + preference_signal) \n loss = loss * weight \n return sum(loss) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum",
      "constraint_family": "none",
      "other_hparams": "alpha, scale"
    },
    "operators_used": [
      "logsigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    preference_signal = batch.get('cost_gap', None)\n    if preference_signal is None:\n        preference_signal = ops.zscore(batch['cost_gap'])\n    diff = alpha * scale * (lpw - lpl) + preference_signal\n    loss = -ops.logsigmoid(diff)\n    if weight is not None:\n        weighted_loss = loss * weight\n        return weighted_loss.sum() / (weight.sum() + 1e-12)\n    else:\n        return loss.sum() / loss.numel()",
