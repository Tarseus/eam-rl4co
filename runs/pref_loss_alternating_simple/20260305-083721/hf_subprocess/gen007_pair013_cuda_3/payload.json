  "g_entry": {
    "id": "g_ref",
    "ir": {
      "name": "ref_all_pairs_builder",
      "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
      "implementation_hint": {
        "expects": [
          "objective",
          "log_prob"
        ],
        "returns": "PrefBatch",
        "mode": "pairwise"
      },
      "hyperparams": {
        "geometry_family": "dense_all_pairs",
        "cap_family": "uncapped_full",
        "weight_family": "uniform_none",
        "constraint_family": "none"
      },
      "operators_used": [
        "ref_all_pairs"
      ],
      "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
    }
  },
  "f_entry": {
    "id": "f007_002_a0a9d68c",
    "ir": {
      "name": "pairwise_diff_logsigmoid_advantage_scaled_loss_v3",
      "intuition": "To reduce similarity with the previous pairwise_preference_loss and improve novelty, I replaced the original preference signal usage with a normalized and clipped advantage signal (cost_gap) to avoid direct linear scaling. I applied a sigmoid to the advantage signal for a smooth bounded range in (0,1) and introduced a learned scaling factor alpha multiplied inside the logsigmoid argument. Additionally, I used (log_prob_w - log_prob_l) multiplied by this scaled advantage as the argument to logsigmoid, thereby coupling the model likelihood difference with a modulated advantage signal nonlinearly. This differs structurally and semantically from previous losses, ensuring lower similarity while retaining discriminative power. Weighting and aggregation remain a weighted mean, and required keys include cost_gap as the advantage signal, satisfying constraints.",
      "pseudocode": "adv = batch['cost_gap']\nadv_norm = ops.clamp((adv - adv.mean()) / (adv.std() + 1e-12), -3, 3)\nadv_sigmoid = ops.sigmoid(adv_norm)\nalpha = float(extra.get('alpha', 1.0))\ndiff = (lpw - lpl) * (alpha * adv_sigmoid)\nloss = -ops.logsigmoid(diff)\nloss = loss * weight\nreturn loss.sum() / (weight.sum() + 1e-12)",
      "hyperparams": {
        "paradigm_family": "pairwise_preference",
        "signal_family": "advantage_signal",
        "link_family": "logsigmoid",
        "agg_family": "weighted_sum",
        "constraint_family": "none",
        "other_hparams": "alpha"
      },
      "operators_used": [
        "logsigmoid",
        "sigmoid",
        "clamp"
      ],
      "implementation_hint": {
        "expects": [
          "log_prob_w",
          "log_prob_l",
          "weight",
          "cost_gap"
        ],
        "returns": "scalar",
        "mode": "pairwise"
      },
      "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv = batch['cost_gap']\n    adv_mean = adv.mean()\n    adv_std = adv.std()\n    adv_norm = ops.clamp((adv - adv_mean) / (adv_std + 1e-12), -3.0, 3.0)\n    adv_sigmoid = ops.sigmoid(adv_norm)\n    alpha = float(extra.get('alpha', 1.0))\n    diff = (lpw - lpl) * (alpha * adv_sigmoid)\n    loss = -ops.logsigmoid(diff)\n    if weight is not None:\n        weighted_loss = loss * weight\n        return weighted_loss.sum() / (weight.sum() + 1e-12)\n    else:\n        return loss.mean()",
      "theoretical_basis": ""
    }
  },
