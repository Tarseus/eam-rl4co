    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "preference_logsigmoid_scaled_weighted_advantage_gap_loss",
    "intuition": "Scales the difference between winning and losing log probabilities, adds the advantage gap as a preference signal, applies a negative logsigmoid to compute loss, and weights the loss before averaging.",
    "pseudocode": "eps = 1e-8\nlpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nweight = batch.get('weight', ones_like(lpw))\nadvantage_gap = batch.get('advantage_gap', zeros_like(lpw))\ndiff = alpha * scale * (lpw - lpl) + advantage_gap\nloss = -logsigmoid(diff)\nreturn mean(weight * loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "advantage_gap",
