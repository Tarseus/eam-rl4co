    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_diff_logsigmoid_costgap_scaled_loss_v2_repaired",
    "intuition": "Replace missing advantage_gap with cost_gap as the preference signal; preserve original scaling and smoothing of log probability differences with tanh and sigmoid, and clamp to stabilize numeric behavior. Use cost difference as additive penalty. Weighting and normalization remain.",
    "pseudocode": "eps=1e-8\nlpw=batch['log_prob_w']\nlpl=batch['log_prob_l']\nweight=batch.get('weight', lpw.new_ones(lpw.shape))\nzeros=lpw.new_zeros(lpw.shape)\ncost_a=batch.get('cost_a', zeros)\ncost_b=batch.get('cost_b', zeros)\ncost_diff=(cost_b - cost_a).detach()\nadv=batch.get('cost_gap', cost_diff)\nalpha=extra.get('alpha', 1.0)\nscale=extra.get('hyperparams', {}).get('scale', 1.0)\nlambda_=extra.get('hyperparams', {}).get('lambda', 1.0)\ndiff=lpw - lpl\nscaled_diff=alpha * scale * diff\nsmooth_diff=ops.tanh(scaled_diff)\nadv_factor=ops.sigmoid(adv)\nclamped_adv_factor=ops.clamp(adv_factor, 0.01, 0.99)\nloss_per_pair = -ops.logsigmoid(smooth_diff * clamped_adv_factor) + lambda_ * cost_diff\nloss = (loss_per_pair * weight).sum() / (weight.sum() + eps)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum",
      "constraint_family": "clamp_stabilized",
      "other_hparams": "alpha, scale, lambda"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "tanh",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_a = batch.get('cost_a', zeros)\n    cost_b = batch.get('cost_b', zeros)\n    cost_diff = (cost_b - cost_a).detach()\n    adv = batch.get('cost_gap', cost_diff)\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    lambda_ = float(extra.get('hyperparams', {}).get('lambda', 1.0))\n    diff = lpw - lpl\n    scaled_diff = alpha * scale * diff\n    smooth_diff = ops.tanh(scaled_diff)\n    adv_factor = ops.sigmoid(adv)\n    clamped_adv_factor = ops.clamp(adv_factor, 0.01, 0.99)\n    loss_per_pair = -ops.logsigmoid(smooth_diff * clamped_adv_factor) + lambda_ * cost_diff\n    weighted_loss = loss_per_pair * weight\n    loss = weighted_loss.sum() / (weight.sum() + eps)\n    return loss",
    "theoretical_basis": ""
  },
