    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_signal_loss_normalized_clamped_scaled",
    "intuition": "This repair introduces explicit normalization of the preference signal (cost_gap) by z-scoring it to ensure zero mean and unit variance, which reduces scale-related instability. Additionally, it applies clamping to the combined margin (diff) within [-8, 8] to prevent numerical issues in logsigmoid, a tighter bound than before to improve stability. The loss uses a scaled difference of log probabilities weighted by alpha and scale hyperparameters, combined with the normalized preference signal, ensuring meaningful gradients and avoiding extreme values. The weighted sum aggregation respects sample importance, improving training dynamics and preventing similarity issues by adjusting the clamp range and explicit normalization.",
    "pseudocode": "preference_signal = ops.zscore(batch['cost_gap'])\ndiff = alpha * scale * (log_prob_w - log_prob_l) + preference_signal\ndiff_clamped = ops.clamp(diff, -8, 8)\nloss = -ops.logsigmoid(diff_clamped)\nloss_weighted = loss * weight\nreturn loss_weighted.sum() / (weight.sum() + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum",
      "constraint_family": "clamp_stabilized",
      "other_hparams": "alpha, scale"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "zscore"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    preference_signal = ops.zscore(batch['cost_gap'])\n    diff = alpha * scale * (lpw - lpl) + preference_signal\n    diff_clamped = ops.clamp(diff, -8.0, 8.0)\n    loss = -ops.logsigmoid(diff_clamped)\n    weighted_loss = loss * weight\n    return weighted_loss.sum() / (weight.sum() + 1e-12)",
    "theoretical_basis": ""
  },
