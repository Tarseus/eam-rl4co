  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_pref_loss_tanh_scaled",
    "intuition": "Repaired the loss by replacing the logsigmoid with a tanh-based margin ranking style loss which uses the scaled difference of log probabilities minus a margin derived from normalized cost_gap. This reduces similarity to prior losses by removing logsigmoid and introducing a margin with tanh that encourages a margin between preferred and less preferred items. The cost_gap is z-scored to normalize preference signals, ensuring stable training. The loss is weighted and averaged properly to maintain pairwise preference alignment while passing novelty gates.",
    "pseudocode": "normalized_cost_gap = ops.zscore(cost_gap)\ndiff = alpha * scale * (log_prob_w - log_prob_l) - margin * normalized_cost_gap\nloss = weight * (1 - ops.tanh(diff)) / 2\nreturn loss.sum() / weight.sum()",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal",
      "link_family": "tanh_margin",
      "agg_family": "weighted_sum",
      "constraint_family": "none",
      "other_hparams": "alpha, scale, margin"
    },
    "operators_used": [
      "tanh",
      "zscore"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    cost_gap = batch['cost_gap']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    margin = float(extra.get('hyperparams', {}).get('margin', 1.0))\n    normalized_cost_gap = ops.zscore(cost_gap)\n    diff = alpha * scale * (lpw - lpl) - margin * normalized_cost_gap\n    loss = weight * (1 - ops.tanh(diff)) / 2\n    return loss.sum() / (weight.sum() + 1e-12)",
    "theoretical_basis": ""
  },
