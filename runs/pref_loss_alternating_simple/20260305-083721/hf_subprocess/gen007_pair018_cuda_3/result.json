    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_regret_weighted_logistic_loss",
    "intuition": "Use pairwise regret magnitude to weight a logistic loss on log probability differences, aggregated by weighted mean for stability and simplicity.",
    "pseudocode": "lpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nregret = abs(batch['delta_regret'])\ndiff = lpw - lpl\nlogistic_loss = log(1 + exp(-diff))\nweighted_loss = logistic_loss * regret * weight\nloss = weighted_loss.sum() / weight.sum()\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_regret_weighted_logistic",
      "signal_family": "delta_regret",
      "link_family": "logistic",
      "agg_family": "weighted_mean",
