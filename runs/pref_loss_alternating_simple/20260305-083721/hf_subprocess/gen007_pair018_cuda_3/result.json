    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_regret"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_regret = batch['delta_regret']\n    regret = ops.abs(delta_regret)\n    diff = lpw - lpl\n    logistic_loss = ops.log(1 + ops.exp(-diff.clamp(max=50)))  # clamp for numerical stability\n    weighted_loss = logistic_loss * regret * weight\n    loss = weighted_loss.sum() / (weight.sum().clamp(min=eps))\n    return loss",
    "theoretical_basis": ""
  },
