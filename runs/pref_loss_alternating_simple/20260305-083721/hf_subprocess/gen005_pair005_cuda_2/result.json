  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_signal_loss_with_margin_and_entropy_regularization",
    "intuition": "To fix the novelty failure, I enhanced the original loss by adding an entropy regularization term to encourage exploration and reduce overfitting to the original preference signal. The margin parameter remains to separate the log_prob difference, but now the loss also includes a negative weighted sum of the entropy gap, promoting diversity in the model outputs. This addition makes the loss function structurally distinct and improves training dynamics by balancing preference discrimination with entropy maximization.",
    "pseudocode": "margin = float(extra.get('margin', 0.1))\nalpha = float(extra.get('alpha', 1.0))\nscale = float(extra.get('scale', 1.0))\nentropy_weight = float(extra.get('entropy_weight', 0.01))\npreference_signal = ops.zscore(batch['cost_gap'])\ndiff = alpha * scale * ((log_prob_w - log_prob_l) - margin) + preference_signal\nloss_preference = -ops.logsigmoid(diff)\nentropy_reg = -entropy_weight * entropy_gap\nloss = loss_preference + entropy_reg\nweighted_loss = loss * weight\nreturn weighted_loss.sum() / (weight.sum() + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal_plus_entropy",
      "link_family": "logsigmoid_plus_linear",
      "agg_family": "weighted_sum",
      "constraint_family": "none",
      "other_hparams": "alpha, scale, margin, entropy_weight"
    },
    "operators_used": [
      "logsigmoid",
      "zscore"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('scale', extra.get('hyperparams', {}).get('scale', 1.0)))\n    margin = float(extra.get('margin', 0.1))\n    entropy_weight = float(extra.get('entropy_weight', 0.01))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    preference_signal = ops.zscore(cost_gap)\n    entropy_gap = batch.get('entropy_gap', zeros)\n    diff = alpha * scale * ((lpw - lpl) - margin) + preference_signal\n    loss_preference = -ops.logsigmoid(diff)\n    entropy_reg = -entropy_weight * entropy_gap\n    loss = loss_preference + entropy_reg\n    weighted_loss = loss * weight\n    return weighted_loss.sum() / (weight.sum() + eps)",
    "theoretical_basis": ""
  },
