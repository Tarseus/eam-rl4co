  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_margin_scaled_exp_loss",
    "intuition": "To reduce similarity and improve novelty, I replaced the logsigmoid link with a smooth exponential-like loss using ops.softplus, which is numerically stable and differentiable. I introduced an adjustable scaling factor on the margin to control margin strength more flexibly. Additionally, I normalized cost_gap and explicitly weighted the loss by sample weights to maintain proper importance weighting. This fixes similarity failures by changing the link function and scaling strategy, while preserving the core idea of margin-enforced preference separation and cost gap normalization.",
    "pseudocode": "margin = extra.get('margin', 0.1)\nalpha = extra.get('alpha', 1.0)\nscale = extra.get('scale', 1.0)\ncost_gap_norm = ops.zscore(batch['cost_gap'])\ndiff = alpha * scale * ((log_prob_w - log_prob_l) - margin) + cost_gap_norm\nloss = ops.softplus(-diff)\nloss = loss * weight\nreturn sum(loss) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal",
      "link_family": "softplus",
      "agg_family": "weighted_sum",
      "constraint_family": "none",
      "other_hparams": "alpha, scale, margin"
    },
    "operators_used": [
      "softplus",
      "zscore"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('scale', extra.get('hyperparams', {}).get('scale', 1.0)))\n    margin = float(extra.get('margin', 0.1))\n    cost_gap = batch['cost_gap']\n    cost_gap_norm = ops.zscore(cost_gap)\n    diff = alpha * scale * ((lpw - lpl) - margin) + cost_gap_norm\n    loss = ops.softplus(-diff)\n    if weight is not None:\n        weighted_loss = loss * weight\n        return weighted_loss.sum() / (weight.sum() + 1e-12)\n    else:\n        return loss.mean()",
    "theoretical_basis": ""
  },
