    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_contrastive_advantage_temperature",
    "intuition": "A contrastive-style pairwise loss that models the relative preference as a softmax probability over the two candidates, scaling the log probability difference by a temperature parameter and weighting by the advantage gap. This shifts from margin or logistic losses to a contrastive probabilistic paradigm, using a softmax link and normalized weighted log-likelihood aggregation with a temperature scaling constraint.",
    "pseudocode": "temp = hyperparam_temperature\nscaled_diff = (log_prob_w - log_prob_l) / temp\nprob_w = exp(scaled_diff) / (1 + exp(scaled_diff))\nloss_i = -weight * advantage_gap * log(prob_w + eps)\nloss = sum(loss_i) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_contrastive",
      "signal_family": "cost_gap",
      "link_family": "softmax",
      "agg_family": "weighted_sum_norm",
      "constraint_family": "temperature_scaling"
    },
    "operators_used": [
      "exp",
      "log",
      "div",
      "add",
      "mul",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    temp = float(extra.get('hyperparams', {}).get('temperature', 1.0))\n    scaled_diff = (lpw - lpl) / temp\n    exp_diff = ops.exp(scaled_diff)\n    prob_w = exp_diff / (exp_diff + 1.0)\n    loss_per_pair = -cost_gap * ops.log(prob_w + eps) * weight\n    total_weight = weight.sum()\n    loss = loss_per_pair.sum() / (total_weight + eps)\n    return loss",
    "theoretical_basis": ""
  },
