    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_ranked_logistic_loss_with_entropy_reg",
    "intuition": "Smooth pairwise logistic loss with entropy regularization for confident predictions, using cost_gap as quality signal to avoid missing keys.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nprob = sigmoid(diff)\nlog_prob = log(prob + eps)\nlog_prob_neg = log(1 - prob + eps)\nentropy = -prob * log_prob - (1 - prob) * log_prob_neg\nloss_per_pair = -weight * log_prob + lambda_entropy * entropy\nloss = sum(loss_per_pair) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_probabilistic_ranking",
      "signal_family": "cost_gap_signal_included",
      "link_family": "sigmoid_log",
      "agg_family": "weighted_mean",
      "constraint_family": "entropy_regularization"
    },
    "operators_used": [
      "sigmoid",
      "log",
      "mul",
      "add",
      "sub",
      "neg",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    lambda_entropy = float(extra.get('lambda_entropy', 0.1))\n    diff = lpw - lpl\n    prob = ops.sigmoid(diff)\n    log_prob = ops.log(prob + eps)\n    log_prob_neg = ops.log(1.0 - prob + eps)\n    entropy = -prob * log_prob - (1.0 - prob) * log_prob_neg\n    loss_per_pair = -weight * log_prob + lambda_entropy * entropy\n    total_weight = weight.sum() + eps\n    return loss_per_pair.sum() / total_weight",
    "theoretical_basis": ""
  },
