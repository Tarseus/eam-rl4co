  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_diff_logsigmoid_costgap_scaled_loss_v2_sum_agg",
    "intuition": "Maintain the original pairwise loss with scaled and smoothed log probability differences gated by cost gap signals, safely fallback missing cost gap and use weighted sum aggregation with clamping for stability.",
    "pseudocode": "lpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nweight = batch.get('weight', ones)\nzeros = zeros_like(lpw)\ncost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\nalpha = extra.get('alpha', 1.0)\nscale = extra.get('hyperparams', {}).get('scale', 1.0)\nlambda_ = extra.get('hyperparams', {}).get('lambda', 1.0)\ndiff = lpw - lpl\nscaled_diff = alpha * scale * diff\nsmooth_diff = ops.tanh(scaled_diff)\ncost_factor = ops.sigmoid(cost_gap)\nclamped_cost_factor = ops.clamp(cost_factor, 0.01, 0.99)\nloss_per_pair = -ops.logsigmoid(smooth_diff * clamped_cost_factor) + lambda_ * cost_gap\nloss = (loss_per_pair * weight).sum() / (weight.sum() + 1e-8)\nreturn loss",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "tanh",
      "sigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    lambda_ = float(extra.get('hyperparams', {}).get('lambda', 1.0))\n    diff = lpw - lpl\n    scaled_diff = alpha * scale * diff\n    smooth_diff = ops.tanh(scaled_diff)\n    cost_factor = ops.sigmoid(cost_gap)\n    clamped_cost_factor = ops.clamp(cost_factor, 0.01, 0.99)\n    loss_per_pair = -ops.logsigmoid(smooth_diff * clamped_cost_factor) + lambda_ * cost_gap\n    weighted_loss = loss_per_pair * weight\n    loss = weighted_loss.sum() / (weight.sum() + eps)\n    return loss",
    "theoretical_basis": ""
  },
