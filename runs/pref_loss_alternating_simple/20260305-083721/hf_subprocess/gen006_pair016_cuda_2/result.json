    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_002_cost_gap_weighted_ratio",
    "intuition": "Use a ratio-based normalization of cost_gap signals only, avoiding unavailable advantage keys, preserving the original ratio and clamp stabilization idea.",
    "pseudocode": "gap = (cost_b - cost_a).detach()\nsignal_sum = ops.abs(gap) + 1e-6\ncombined_signal = (gap * 0.2) / signal_sum\nx = alpha * scale * (log_prob_w - log_prob_l) - beta * combined_signal\nx = ops.clamp(x, -20, 20)\nloss_i = -ops.logsigmoid(x) * weight\nloss = sum(loss_i) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap_ratio",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum_norm",
      "constraint_family": "clamp_stabilized",
      "other_hparams": "alpha,beta,scale"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "sum",
      "abs"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-6\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('beta', extra.get('hyperparams', {}).get('beta', 0.7)))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    gap = (cost_b - cost_a).detach()\n    abs_sum = ops.abs(gap) + eps\n    combined_signal = (0.2 * gap) / abs_sum\n    x = alpha * scale * (lpw - lpl) - beta * combined_signal\n    x = ops.clamp(x, -20.0, 20.0)\n    loss_per_pair = -ops.logsigmoid(x) * weight\n    total_weight = weight.sum()\n    return loss_per_pair.sum() / (total_weight + 1e-12)",
    "theoretical_basis": ""
  },
