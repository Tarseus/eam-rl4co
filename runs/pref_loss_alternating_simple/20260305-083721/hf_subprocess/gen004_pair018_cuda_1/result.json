  "g_ir": {
    "name": "ref_all_pairs_builder",
    "intuition": "Reference builder: all winner/loser pairs by objective ordering.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "dense_all_pairs",
      "cap_family": "uncapped_full",
      "weight_family": "uniform_none",
      "constraint_family": "none"
    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_preference_loss_v2",
    "intuition": "This repair introduces a non-linear scaling of the preference signal by applying a tanh transformation clipped between -1 and 1 to the cost_gap before combining it with the scaled log probability difference. This reduces linear redundancy and increases novelty by changing the interaction between signals. Additionally, the alpha and scale hyperparameters are combined into a single effective scaling factor, and the preference signal is centered and scaled with zscore to stabilize training. Weight handling is preserved with safe normalization. These changes maintain the original design but alter key internal computations, addressing the novelty failure.",
    "pseudocode": "scaled_diff = alpha * scale * (log_prob_w - log_prob_l)\npreference_scaled = ops.tanh(ops.clamp(ops.zscore(cost_gap), -1, 1))\ncombined = scaled_diff + preference_scaled\nloss = -ops.logsigmoid(combined)\nloss = loss * weight\nreturn sum(loss) / (sum(weight) + 1e-12)",
    "hyperparams": {
      "paradigm_family": "pairwise_preference",
      "signal_family": "preference_signal",
      "link_family": "logsigmoid",
      "agg_family": "weighted_sum",
      "constraint_family": "none",
      "other_hparams": "alpha, scale"
    },
    "operators_used": [
      "logsigmoid",
      "tanh",
      "clamp",
      "zscore"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    cost_gap = batch['cost_gap']\n    cost_z = ops.zscore(cost_gap)\n    cost_clamped = ops.clamp(cost_z, -1.0, 1.0)\n    preference_scaled = ops.tanh(cost_clamped)\n    scaled_diff = alpha * scale * (lpw - lpl)\n    combined = scaled_diff + preference_scaled\n    loss = -ops.logsigmoid(combined)\n    if weight is not None:\n        weighted_loss = loss * weight\n        return weighted_loss.sum() / (weight.sum() + 1e-12)\n    else:\n        return loss.mean()",
    "theoretical_basis": ""
  },
