    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rank_loss_exponential_normalized",
    "intuition": "This loss transforms the pairwise log probability differences into a softmax-like ranking probability using an exponential link, then computes a cross-entropy style loss normalized per instance. By shifting from sigmoid to softmax and normalizing losses per instance, it encourages correct ranking ordering with a probabilistic interpretation and stable gradients, leveraging delta_rank as the quality signal.",
    "pseudocode": "diff = log_prob_w - log_prob_l\nexp_diff = exp(alpha * scale * diff)\nprob_w = exp_diff / (1 + exp_diff)\nloss_raw = -weight * log(prob_w)\nloss = sum(loss_raw) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "delta_rank",
      "link_family": "exponential_softmax",
      "agg_family": "weighted_mean_normalized",
      "constraint_family": "none"
    },
    "operators_used": [
      "exp",
      "log",
      "div",
      "mul",
      "add",
      "sum"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    delta_rank = batch['delta_rank']\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n    diff = lpw - lpl\n    scaled_diff = alpha * scale * diff\n    exp_diff = ops.exp(scaled_diff)\n    prob_w = exp_diff / (1.0 + exp_diff)\n    loss_raw = -ops.log(prob_w + 1e-12) * weight\n    loss = loss_raw.sum() / (weight.sum() + 1e-12)\n    return loss",
    "theoretical_basis": ""
  },
