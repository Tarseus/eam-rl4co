    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    adv_gap = batch['advantage_gap']\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 0.5))\n    logits = alpha * (lpw - lpl) - beta * adv_gap.detach()\n    probs = torch.sigmoid(logits)\n    loss_per_pair = -torch.log(probs + 1e-12)\n    if weight is not None:\n        loss_per_pair = loss_per_pair * weight\n    return loss_per_pair.mean()",
