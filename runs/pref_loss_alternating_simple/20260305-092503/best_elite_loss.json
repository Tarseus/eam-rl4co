  "ir": {
    "name": "pairwise_bayesian_ranking_loss",
    "intuition": "Shift from margin-based losses to a probabilistic Bayesian ranking paradigm. Models pairwise preference as the posterior probability that the winning sequence is better than the losing one, using a sigmoid likelihood on the difference of predicted log probabilities adjusted by the advantage gap. The loss is the negative log-probability (cross-entropy) of the observed preference, weighted and averaged over pairs.",
    "pseudocode": "lpw = batch['log_prob_w']\nlpl = batch['log_prob_l']\nadv_gap = batch['advantage_gap']\nweight = batch.get('weight', None)\nprob = sigmoid(alpha * (lpw - lpl) - beta * adv_gap.detach())\nloss_per_pair = -(log(prob) * weight)\nreturn loss_per_pair.mean()",
