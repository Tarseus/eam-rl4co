    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    # Generate mask for pairs where winner score < loser score\n    mask = objective[:, :, None] < objective[:, None, :]\n    # Exclude pairs with equal scores to ensure strict preference\n    diff_mask = objective[:, :, None] != objective[:, None, :]\n    combined_mask = mask & diff_mask\n    b_idx, winner_idx, loser_idx = combined_mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'pairwise_dedup_less_strict'})"
