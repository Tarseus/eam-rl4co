    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    # Create mask where objective winner < loser\n    mask = objective[:, :, None] < objective[:, None, :]\n    # Remove pairs where objective scores are equal (deduplication)\n    diff_mask = objective[:, :, None] != objective[:, None, :]\n    combined_mask = mask & diff_mask\n    b_idx, winner_idx, loser_idx = combined_mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'all_pairs_dedup'})"
  },
