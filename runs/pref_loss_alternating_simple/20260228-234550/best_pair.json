    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_ranktemp_center",
    "intuition": "Use delta_rank as an ordinal preference-strength signal: pairs where the winner is much better (larger rank gap) should push a larger log-probability margin, while near-ties should be trained gently. Centering and clamping the rank gap makes the supervision robust to outliers and varying batch difficulty, and a temperature parameter controls how sharply rank differences translate into margin targets.",
    "pseudocode": "dr = detach(delta_rank)\ndr_n = clamp(zscore(dr), -z_clip, z_clip)\ntarget = tau * tanh(dr_n)\nmargin = alpha * scale * (log_prob_w - log_prob_l) - target\nloss = mean_w( softplus(-margin) )",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "delta_rank",
      "link_family": "softplus_margin",
      "agg_family": "weighted_mean",
      "constraint_family": "zscore_tanh_clamped",
      "other_hparams": "scale=1.0,tau=0.5,z_clip=3.0,margin_clip=20.0,eps=1e-8"
    },
    "operators_used": [
      "softplus",
      "zscore",
      "clamp",
      "tanh"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "delta_rank"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    delta_rank = batch['delta_rank']\n\n    hp = extra.get('hyperparams', {})\n    alpha = float(extra.get('alpha', hp.get('alpha', 1.0)))\n    scale = float(hp.get('scale', 1.0))\n    tau = float(hp.get('tau', 0.5))\n    z_clip = float(hp.get('z_clip', 3.0))\n    margin_clip = float(hp.get('margin_clip', 20.0))\n    eps = float(hp.get('eps', 1e-8))\n\n    dr = delta_rank.detach()\n    dr_n = ops.zscore(dr)\n    dr_n = ops.clamp(dr_n, -z_clip, z_clip)\n\n    target = tau * ops.tanh(dr_n)\n\n    margin = alpha * scale * (lpw - lpl) - target\n    margin = ops.clamp(margin, -margin_clip, margin_clip)\n\n    per = ops.softplus(-margin)\n    num = (per * weight).sum()\n    den = weight.sum() + eps\n    return num / den",
    "theoretical_basis": ""
  },
