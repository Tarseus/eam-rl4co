    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    cost_gap = batch['cost_gap']\n    alpha = float(extra.get('alpha', 1.5))\n    scale = float(extra.get('hyperparams', {}).get('scale', 3.0))\n    bias = 0.0\n    std_cost_gap = ops.max(ops.std(cost_gap), 1e-6)\n    scaled_cost_gap = cost_gap / std_cost_gap\n    diff = alpha * scale * (lpw - lpl) + bias\n    x = ops.clamp(diff, -20.0, 20.0)\n    loss = -ops.logsigmoid(x) * scaled_cost_gap\n    if weight is not None:\n        loss = loss * weight\n    return loss.sum()",
