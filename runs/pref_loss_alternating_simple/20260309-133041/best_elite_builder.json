        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {},
    "operators_used": [],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    gap_threshold = float(extra.get('gap_threshold', 0.15))\n    # Compute difference: winner_obj - loser_obj\n    diff = objective[:, :, None] - objective[:, None, :]\n    # Winner is strictly better (lower) by gap_threshold\n    mask = diff < -gap_threshold\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    weights = objective.new_ones(b_idx.size(0), dtype=objective.dtype)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weights, meta={'builder': 'objective_difference_threshold_corrected'})"
