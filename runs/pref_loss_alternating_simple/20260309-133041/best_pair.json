  "g_ir": {
    "name": "objective_difference_with_tiezone_clamp",
    "intuition": "Creates pairwise preferences by comparing objectives and applies a tie-zone constraint to filter out negligible differences, ensuring meaningful pairs with clamped weights.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "Euclidean",
      "cap_family": "pairwise",
      "weight_family": "clamped_binary",
      "constraint_family": "tiezone_filter"
    },
    "operators_used": [
      "compute_difference",
      "mask_better_pairs",
      "clamp",
      "tiezone_filter"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    diff = objective[:, :, None] - objective[:, None, :]\n    tiezone_threshold = 1e-3\n    # mask for strictly better pairs outside the tie zone\n    mask = (diff < -tiezone_threshold)\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    # compute raw weights as negative differences, clamp minimum at zero\n    raw_weights = (-diff[b_idx, winner_idx, loser_idx]).clamp(min=0)\n    # normalize weights to max 1 (clamp)\n    weights = raw_weights.clamp(max=1.0)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weights, meta={'builder': 'objective_difference_with_tiezone_clamp'})"
  },
  "f_ir": {
    "name": "loss_logsigmoid_010_cost_gap_weighted_mean_norm_clip_sigmoid_norm",
    "intuition": "Replace the weighted median aggregation with a weighted mean aggregation to smooth the final pairwise loss value while keeping the same sigmoid-based cost gap normalization and margin log-sigmoid loss structure. This yields a differentiable, stable, and scale-invariant loss with consistent pairwise semantics.",
    "pseudocode": "norm_cost_gap = sigmoid(cost_gap) + 1e-8\nx = clamp(alpha * scale * (log_prob_w - log_prob_l) - margin * cost_gap, -20, 20)\nloss = mean(weight * (-logsigmoid(x)) / norm_cost_gap)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap",
      "link_family": "logsigmoid",
      "agg_family": "weighted_mean",
      "constraint_family": "normalization_scale_invariant"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "mean",
      "mul",
      "div",
      "sub",
      "sigmoid",
      "add"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', ops.ones_like(lpw))\n    cost_gap = batch['cost_gap'].detach()\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 3.0))\n    margin = 0.12\n    norm_cost_gap = ops.add(ops.sigmoid(cost_gap), 1e-8)\n    x = ops.sub(ops.mul(alpha * scale, ops.sub(lpw, lpl)), ops.mul(margin, cost_gap))\n    x = ops.clamp(x, -20.0, 20.0)\n    raw_loss = -ops.logsigmoid(x)\n    weighted_loss = weight * raw_loss / norm_cost_gap\n    loss = ops.mean(weighted_loss)\n    return loss",
    "theoretical_basis": ""
  },
