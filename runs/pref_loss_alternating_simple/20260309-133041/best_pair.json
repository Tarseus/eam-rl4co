  "f_id": "f_ref",
  "g_ir": {
    "name": "objective_difference_with_tiezone_clamp",
    "intuition": "Creates pairwise preferences by comparing objectives and applies a tie-zone constraint to filter out negligible differences, ensuring meaningful pairs with clamped weights.",
    "implementation_hint": {
      "expects": [
        "objective",
        "log_prob"
      ],
      "returns": "PrefBatch",
      "mode": "pairwise"
    },
    "hyperparams": {
      "geometry_family": "Euclidean",
      "cap_family": "pairwise",
      "weight_family": "clamped_binary",
      "constraint_family": "tiezone_filter"
    },
    "operators_used": [
      "compute_difference",
      "mask_better_pairs",
      "clamp",
      "tiezone_filter"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    diff = objective[:, :, None] - objective[:, None, :]\n    tiezone_threshold = 1e-3\n    # mask for strictly better pairs outside the tie zone\n    mask = (diff < -tiezone_threshold)\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    # compute raw weights as negative differences, clamp minimum at zero\n    raw_weights = (-diff[b_idx, winner_idx, loser_idx]).clamp(min=0)\n    # normalize weights to max 1 (clamp)\n    weights = raw_weights.clamp(max=1.0)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=weights, meta={'builder': 'objective_difference_with_tiezone_clamp'})"
  },
  "f_ir": {
    "name": "ref_logsigmoid",
    "intuition": "Reference loss: negative logsigmoid on log-prob winner-loser gap.",
    "pseudocode": "loss = -logsigmoid(alpha*(log_prob_w-log_prob_l))",
    "hyperparams": {
      "alpha": 1.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "logprob_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "weight_optional"
    },
    "operators_used": [
      "logsigmoid"
    ],
    "implementation_hint": {
      "expects": [
        "cost_a",
        "cost_b",
        "log_prob_w",
        "log_prob_l",
        "weight"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    alpha = float(extra.get('alpha', 1.0))\n    logit = alpha * (batch['log_prob_w'] - batch['log_prob_l'])\n    w = batch.get('weight')\n    loss = -ops.logsigmoid(logit)\n    if w is not None:\n        loss = loss * w\n    return loss.mean()\n",
    "theoretical_basis": ""
  },
