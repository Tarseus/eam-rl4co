    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    d_rank = batch['delta_rank']\n    weight = batch['weight']\n\n    hp = extra.get('hyperparams', {}) if extra is not None else {}\n\n    alpha = hp.get('alpha_default', 1.0)\n    if extra is not None:\n        alpha = extra.get('alpha', hp.get('alpha', alpha))\n\n    scale = hp.get('scale', 1.0)\n    rank_temp = hp.get('rank_temp', 1.0)\n    z_clip = hp.get('z_clip', 3.0)\n    clamp_val = hp.get('clamp_val', 20.0)\n    w_max = hp.get('w_max', 1.0e6)\n    weight_eps = hp.get('weight_eps', 1e-12)\n\n    x = alpha * scale * (lpw - lpl)\n    x = ops.clamp(x, -clamp_val, clamp_val)\n    per = -ops.logsigmoid(x)\n\n    rn = ops.zscore(d_rank.detach())\n    rn = ops.clamp(rn, -z_clip, z_clip)\n\n    w0 = ops.clamp(weight, 0.0, w_max)\n    w_rank = ops.softplus(rank_temp * rn)\n    w_eff = w0 * w_rank\n\n    denom = w_eff.sum() + weight_eps\n    return (per * w_eff).sum() / denom",
