    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_004_cost_weighted_advantage_gap_nonlin_interaction_fixed",
    "intuition": "Computes a weighted pairwise loss using a nonlinear interaction between advantage_gap and cost_gap, ensuring stable defaults and normalization.",
    "pseudocode": "adv_tanh = tanh(gamma * advantage_gap)\ncost_tanh = tanh(delta * cost_gap)\ninteraction = adv_tanh * cost_tanh\nx = alpha * scale * (log_prob_w - log_prob_l) - beta * cost_gap - eta * interaction\nloss = sum(-logsigmoid(x) * weight) / sum(weight)",
    "hyperparams": {
      "paradigm_family": "pairwise_margin",
      "signal_family": "cost_gap_advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "normalized_sum",
      "constraint_family": "normalization",
      "alpha": 1.0,
      "scale": 1.9496803035382082,
      "beta": 0.1,
      "gamma": 0.5,
      "delta": 0.7,
      "eta": 0.3
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "tanh",
      "sum",
      "div",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_a",
        "cost_b"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-12\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('hyperparams', {}).get('beta', 0.1))\n    gamma = float(extra.get('hyperparams', {}).get('gamma', 0.5))\n    delta = float(extra.get('hyperparams', {}).get('delta', 0.7))\n    eta = float(extra.get('hyperparams', {}).get('eta', 0.3))\n    cost_a = batch['cost_a']\n    cost_b = batch['cost_b']\n    zeros = lpw.new_zeros(lpw.shape)\n    advantage_gap = batch.get('advantage_gap', zeros)\n    cost_gap = (cost_b - cost_a).detach()\n    adv_tanh = ops.tanh(gamma * advantage_gap)\n    cost_tanh = ops.tanh(delta * cost_gap)\n    interaction = adv_tanh * cost_tanh\n    x = alpha * scale * (lpw - lpl) - beta * cost_gap - eta * interaction\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    weighted_loss = loss * weight\n    denom = weight.sum()\n    loss = weighted_loss.sum() / (denom + eps)\n    return loss",
    "theoretical_basis": ""
  },
