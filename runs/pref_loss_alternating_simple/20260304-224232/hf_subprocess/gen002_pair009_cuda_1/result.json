    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_rankprod_advantage_exp_repaired",
    "intuition": "Use advantage_gap if available, else fallback to cost_gap derived from cost_b - cost_a, ensuring no KeyError and preserving original rank product loss idea.",
    "pseudocode": "adv_gap = advantage_gap if present else cost_gap if present else cost_b - cost_a else zeros\nadv_exp = exp(beta * adv_gap)\nprob_diff_exp = exp(alpha * (log_prob_l - log_prob_w))\nloss_elements = weight * adv_exp * prob_diff_exp\nloss = log(sum(loss_elements) / (sum(weight) + eps))",
    "hyperparams": {
      "paradigm_family": "pairwise_rankprod",
      "signal_family": "advantage_gap",
      "link_family": "exponential",
      "agg_family": "normalized_log_sum",
      "constraint_family": "positivity"
    },
    "operators_used": [
      "exp",
      "log",
      "sum",
      "div",
      "mul"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    # Try advantage_gap then cost_gap then cost_b - cost_a\n    if 'advantage_gap' in batch:\n        adv_gap = batch['advantage_gap']\n    else:\n        if 'cost_gap' in batch:\n            adv_gap = batch['cost_gap']\n        else:\n            cost_b = batch.get('cost_b', zeros)\n            cost_a = batch.get('cost_a', zeros)\n            adv_gap = cost_b - cost_a\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 1.0))\n    adv_exp = ops.exp(beta * adv_gap)\n    prob_diff_exp = ops.exp(alpha * (lpl - lpw))\n    weighted_terms = weight * adv_exp * prob_diff_exp\n    sum_weighted = weighted_terms.sum()\n    sum_weights = weight.sum()\n    loss = ops.log(sum_weighted / (sum_weights + eps))\n    return loss.mean()",
    "theoretical_basis": ""
  },
