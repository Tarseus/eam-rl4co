    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_rankprod_exp_advantage_gap_repaired",
    "intuition": "Shift from margin-based to a rank product paradigm by modeling pairwise preference as a product of exponential scores derived from log probabilities and advantage_gap signals, encouraging multiplicative ranking consistency. This replaces additive margins and logsigmoid links with a product-based ranking loss, aggregated by normalized log-sum and constrained by positivity to ensure stable gradients and meaningful ranking signals.",
    "pseudocode": "score_w = exp(alpha * log_prob_w + beta * advantage_w)\nscore_l = exp(alpha * log_prob_l + beta * advantage_l)\npairwise_prob = score_w / (score_w + score_l + epsilon)\nloss = -weight * log(pairwise_prob)\nnormalized_loss = sum(loss) / (sum(weight) + epsilon)",
    "hyperparams": {
      "paradigm_family": "pairwise_rankprod",
      "signal_family": "advantage",
      "link_family": "log",
      "agg_family": "normalized_log_sum",
      "constraint_family": "positivity",
      "alpha": 1.0,
      "beta": 0.7,
      "epsilon": 1e-12
    },
    "operators_used": [
      "exp",
      "log",
      "sum",
      "div",
      "mul",
      "sub"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = float(extra.get('epsilon', 1e-12))\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 0.7))\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch['weight']\n    zeros = lpw.new_zeros(lpw.shape)\n    adv_gap = batch.get('advantage_gap', zeros)\n    adv_w = -adv_gap.clamp(min=-1e8)  # Since adv_gap = adv_l - adv_w => adv_w = adv_l - adv_gap, but without adv_l, approximate\n    adv_l = adv_gap.clamp(min=-1e8)  # approximate adv_l as adv_gap\n    score_w = ops.exp(alpha * lpw + beta * adv_w)\n    score_l = ops.exp(alpha * lpl + beta * adv_l)\n    denom = score_w + score_l + eps\n    pairwise_prob = score_w / denom\n    loss = -ops.log(pairwise_prob.clamp(min=eps))\n    weighted_loss = loss * weight\n    normalized_loss = weighted_loss.sum() / (weight.sum() + eps)\n    return normalized_loss",
    "theoretical_basis": ""
  },
