    },
    "operators_used": [
      "ref_all_pairs"
    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_ranked_softplus_aggregated_gap",
    "intuition": "Introduce a pairwise ranking loss using a softplus link on the negative margin between the weighted log-probability difference and a nonlinear combination of advantage_gap and cost_gap signals. The loss aggregates by taking a weighted mean of the softplus outputs, and applies a strict monotonic ranking constraint by emphasizing pairs with higher combined quality gaps. This paradigm shifts from margin-based logsigmoid to a smooth ranking loss with nonlinear signal fusion and weighted mean aggregation.",
    "pseudocode": "combined_gap = advantage_gap * 0.7 + cost_gap * 0.3\nmargin = alpha * (log_prob_w - log_prob_l) - beta * combined_gap.detach()\nloss = weight * ops.softplus(-margin)\nreturn loss.sum() / (weight.sum() + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_ranking",
      "signal_family": "advantage_cost_combined",
      "link_family": "softplus",
      "agg_family": "weighted_mean",
      "constraint_family": "monotonic_ranking"
    },
    "operators_used": [
      "softplus",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    advantage_gap = batch.get('advantage_gap', zeros)\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 1.0))\n    combined_gap = 0.7 * advantage_gap + 0.3 * cost_gap\n    margin = alpha * (lpw - lpl) - beta * combined_gap.detach()\n    loss = ops.softplus(-margin)\n    weighted_loss = loss * weight\n    total_weight = weight.sum()\n    return weighted_loss.sum() / (total_weight + eps)",
    "theoretical_basis": ""
  },
