    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_logsigmoid_003_advantage_gap_scaled_shifted_fixed",
    "intuition": "Fix missing advantage_gap by deriving it safely from advantage_l and advantage_w if absent, preserving the original nonlinear margin and stability improvements.",
    "pseudocode": "advantage_gap = batch.get('advantage_gap', batch.get('advantage_l', zeros) - batch.get('advantage_w', zeros))\nmargin = 0.1 * ops.tanh(0.5 * advantage_gap.detach())\nloss = -ops.logsigmoid(alpha * scale * (log_prob_w - log_prob_l) - margin)\nloss = loss * weight\nreturn loss.mean()",
    "hyperparams": {
      "scale": 2.0,
      "paradigm_family": "pairwise_margin",
      "signal_family": "advantage_gap",
      "link_family": "logsigmoid",
      "agg_family": "mean",
      "constraint_family": "clamp_stabilized"
    },
    "operators_used": [
      "logsigmoid",
      "clamp",
      "tanh"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    advantage_gap = batch.get('advantage_gap', batch.get('advantage_l', zeros) - batch.get('advantage_w', zeros))\n    alpha = float(extra.get('alpha', extra.get('hyperparams', {}).get('alpha', 1.0)))\n    scale = float(extra.get('hyperparams', {}).get('scale', 2.0))\n    margin = 0.1 * ops.tanh(0.5 * advantage_gap.detach())\n    x = alpha * scale * (lpw - lpl) - margin\n    x = ops.clamp(x, -15.0, 15.0)\n    loss = -ops.logsigmoid(x)\n    loss = loss * weight\n    return loss.mean()",
    "theoretical_basis": ""
  },
