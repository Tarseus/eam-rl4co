    ],
    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "pairwise_rankprod_exp_aggregation_advantage_lagged_repaired",
    "intuition": "Shift from margin or ranking losses to a rank-product inspired loss that exponentially weights the negative difference in log probabilities scaled by a lagged advantage signal, aggregating by normalized exponential sums to emphasize consistent ordering and robustness to noise. This paradigm uses a multiplicative rank-based signal aggregation with an exponential link, leveraging advantage_w and advantage_l separately to capture asymmetric preferences. Repair replaces missing advantage signals with zeros to avoid KeyError.",
    "pseudocode": "score_w = exp(alpha * log_prob_w + beta * advantage_w.detach())\nscore_l = exp(alpha * log_prob_l + beta * advantage_l.detach())\nloss_per_pair = weight * (-log(score_w / (score_w + score_l) + 1e-12))\nloss = loss_per_pair.sum() / (weight.sum() + 1e-8)",
    "hyperparams": {
      "paradigm_family": "pairwise_rankprod",
      "signal_family": "advantage_separate",
      "link_family": "exponential_log_ratio",
      "agg_family": "weighted_normalized_sum",
      "constraint_family": "positivity_stability"
    },
    "operators_used": [
      "exp",
      "log",
      "sum",
      "div"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "advantage_w",
        "advantage_l"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    adv_w = batch.get('advantage_w', zeros)\n    adv_l = batch.get('advantage_l', zeros)\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 0.5))\n    # Detach advantage signals to prevent gradient through preference signals\n    score_w = ops.exp(alpha * lpw + beta * adv_w.detach())\n    score_l = ops.exp(alpha * lpl + beta * adv_l.detach())\n    denom = score_w + score_l + 1e-12\n    prob_w = score_w / denom\n    loss = -ops.log(prob_w.clamp(min=eps))\n    weighted_loss = loss * weight\n    total_weight = weight.sum()\n    return weighted_loss.sum() / (total_weight + eps)",
    "theoretical_basis": ""
  },
