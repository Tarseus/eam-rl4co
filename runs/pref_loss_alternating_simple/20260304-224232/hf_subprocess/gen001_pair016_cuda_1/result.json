    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "combined_crossover_loss_v2_repaired",
    "intuition": "Fix missing advantage_gap by safely deriving it from cost_gap or cost_b - cost_a, preserving original scaled log-prob and tanh-transformed advantage contribution with clamping and weighted mean.",
    "pseudocode": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', lpw.new_ones(lpw.shape))\n    zeros = lpw.new_zeros(lpw.shape)\n    cost_gap = batch.get('cost_gap', batch.get('cost_b', zeros) - batch.get('cost_a', zeros))\n    advantage_gap = cost_gap\n    alpha = float(extra.get('alpha', 1.0))\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.9496803035382082))\n    beta = float(extra.get('hyperparams', {}).get('beta', 0.5))\n    transformed_adv = ops.tanh(advantage_gap)\n    x = alpha * scale * (lpw - lpl) + beta * transformed_adv\n    x = ops.clamp(x, -20.0, 20.0)\n    loss = -ops.logsigmoid(x)\n    weighted_loss = loss * weight\n    total_weight = weight.sum()\n    return weighted_loss.sum() / (total_weight + eps)",
