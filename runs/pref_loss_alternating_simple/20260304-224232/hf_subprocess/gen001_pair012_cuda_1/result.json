    "code": "def generated_builder(feature_cache, extra):\n    objective = feature_cache['objective']\n    mask = objective[:, :, None] < objective[:, None, :]\n    b_idx, winner_idx, loser_idx = mask.nonzero(as_tuple=True)\n    return PrefBatch(mode='pairwise', pair_idx=(b_idx, winner_idx, loser_idx), weight=None, meta={'builder': 'ref_all_pairs'})\n"
  },
  "f_ir": {
    "name": "loss_pairwise_bregman_divergence_cost_gap",
    "intuition": "A novel pairwise loss leveraging Bregman divergence paradigm by modeling the difference between predicted log-probabilities and a scaled cost gap transformed via a convex function. This shifts from margin or probabilistic ranking losses to a divergence-based measure, encouraging model outputs to approximate a convex mapping of cost differences, enabling richer gradient signals and alternative training dynamics.",
    "pseudocode": "f(x) = x * log(x + eps) - x  # convex generator for Bregman divergence\nz = exp(log_prob_w - log_prob_l)\ntarget = relu(scale * cost_gap.detach()) + eps\nloss_per_pair = f(z) - f(target) - (z - target) * (log(z + eps) + 1)\nweighted_loss = loss_per_pair * weight\nreturn mean(weighted_loss)",
    "hyperparams": {
      "paradigm_family": "pairwise_bregman_divergence",
      "signal_family": "cost_gap",
      "link_family": "identity_log_exp",
      "agg_family": "weighted_mean",
      "constraint_family": "relu_eps_stabilized"
    },
    "operators_used": [
      "exp",
      "log",
      "relu",
      "subtraction",
      "multiplication",
      "mean"
    ],
    "implementation_hint": {
      "expects": [
        "log_prob_w",
        "log_prob_l",
        "weight",
        "cost_gap"
      ],
      "returns": "scalar",
      "mode": "pairwise"
    },
    "code": "def generated_loss(batch, model_output, extra):\n    eps = 1e-8\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    cost_gap = batch['cost_gap']\n    scale = float(extra.get('hyperparams', {}).get('scale', 1.0))\n\n    z = ops.exp(lpw - lpl)\n    target = ops.relu(scale * cost_gap.detach()) + eps\n\n    def f(x):\n        return x * ops.log(x + eps) - x\n\n    fx = f(z)\n    ft = f(target)\n    grad_ft = ops.log(target + eps) + 1.0\n\n    loss_per_pair = fx - ft - (z - target) * grad_ft\n\n    if weight is not None:\n        loss_per_pair = loss_per_pair * weight\n\n    return loss_per_pair.mean()",
    "theoretical_basis": ""
  },
