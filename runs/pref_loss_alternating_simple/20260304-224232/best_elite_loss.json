    "code": "def generated_loss(batch, model_output, extra):\n    lpw = batch['log_prob_w']\n    lpl = batch['log_prob_l']\n    weight = batch.get('weight', None)\n    advantage_gap = batch['advantage_gap']\n    cost_gap = batch['cost_gap']\n    alpha = float(extra.get('alpha', 1.0))\n    beta = float(extra.get('beta', 1.0))\n    combined_gap = 0.7 * advantage_gap + 0.3 * cost_gap\n    margin = alpha * (lpw - lpl) - beta * combined_gap.detach()\n    loss = ops.softplus(-margin)\n    if weight is not None:\n        weighted_loss = loss * weight\n        total_weight = weight.sum()\n        return weighted_loss.sum() / (total_weight + 1e-8)\n    else:\n        return loss.mean()",
